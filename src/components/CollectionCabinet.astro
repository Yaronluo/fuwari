const filterItems = [
	{ key: "all", label: "全部收藏", icon: "♡" },
	{ key: "movie", label: "电影格", icon: "◉" },
	{ key: "anime", label: "番剧格", icon: "✦" },
	{ key: "music", label: "音乐格", icon: "♫" },
];

const collectionGroups = [
	{ key: "movie", label: "电影放映格", eyebrow: "CINEMA SHELF", icon: "🎞", note: "嘘——喜欢的电影藏在这里(˶ᵔ ᵕ ᵔ˶)" },
	{ key: "anime", label: "番剧收藏格", eyebrow: "ANIME SHELF", icon: "✦", note: "下一集，也要一起看下去呀 (｡•̀ᴗ-)✧" },
	{ key: "music", label: "唱片试听格", eyebrow: "RECORD SHELF", icon: "♫", note: "旋律会从柜子里悄悄响起来" },
];
---

<collection-cabinet class="collection-cabinet">
	<section class="cabinet-hero">
		<span class="cabinet-hero-tape" aria-hidden="true"></span>
		<div class="cabinet-hero-copy">
			<div class="cabinet-eyebrow"><span>✦</span> MY LITTLE COLLECTION <span>♡</span></div>
			<h1>小小收藏馆</h1>
			<p>把喜欢的作品与旋律，放进不会落灰的小格子里。</p>
			<div class="cabinet-summary" aria-label="收藏统计">
				<span><strong>{collectionItems.length}</strong> 件收藏</span>
				<i></i>
				<span><strong>{collectionItems.filter((item) => item.category === "movie").length}</strong> 部电影</span>
				<i></i>
				<span><strong>{collectionItems.filter((item) => item.category === "anime").length}</strong> 部番剧</span>
				<i></i>
				<span><strong>{collectionItems.filter((item) => item.category === "music").length}</strong> 首音乐</span>
			</div>
		</div>
		<div class="cabinet-hero-visual" aria-hidden="true">
			<div class="mini-shelf">
				<span class="mini-book mini-book-one"></span>
				<span class="mini-book mini-book-two"></span>
				<span class="mini-book mini-book-three"></span>
				<span class="mini-record">♫</span>
			</div>
			<span class="hero-visual-star">✦</span>
			<span class="hero-visual-heart">♡</span>
		</div>
	</section>

	<nav class="cabinet-filters" aria-label="收藏分类">
		{filterItems.map((filter, index) => (
			<button
				type="button"
				class:list={["cabinet-filter", { "is-active": index === 0 }]}
				data-filter={filter.key}
				aria-pressed={index === 0 ? "true" : "false"}
			>
				<span aria-hidden="true">{filter.icon}</span>{filter.label}
			</button>
		))}
		<span class="cabinet-visible-count" aria-live="polite">{collectionItems.length} 件收藏</span>
	</nav>

	<section class="collection-showcase" aria-label="收藏内容">
		{collectionGroups.map((group) => (
			<section class="collection-shelf-group" data-collection-group={group.key}>
				<header class="collection-shelf-header">
					<div class="collection-shelf-icon" aria-hidden="true">{group.icon}</div>
					<div>
						<span>{group.eyebrow}</span>
						<h2>{group.label}</h2>
					</div>
					<p>{group.note}</p>
					<i aria-hidden="true">{collectionItems.filter((item) => item.category === group.key).length}</i>
				</header>
				<div class="collection-grid">
					{collectionItems.filter((item) => item.category === group.key).map((item) => {
						const index = collectionItems.indexOf(item);
						return (
							<article class="collection-card" data-category={item.category} style={`--card-index: ${index};`}>
								<span class="collection-card-tape" aria-hidden="true"></span>
								<div class="collection-media">
									<span class="collection-vinyl" aria-hidden="true"><i></i></span>
									<div class="collection-cover">
										<img src={item.image} alt={`${item.title}封面`} loading={index < 3 ? "eager" : "lazy"} decoding="async" />
										<span class="collection-cover-shade" aria-hidden="true"></span>
										<span class="collection-cover-sparkle" aria-hidden="true">✦</span>
									</div>
								</div>
								<div class="collection-card-copy">
									<p class="collection-card-original">{item.original}</p>
									<h2>{item.title}</h2>
									<p class="collection-card-note">{item.note}</p>
									<div class="collection-card-tags">
										{item.tags.map((tag) => <span>{tag}</span>)}
									</div>
								</div>
								<span class="collection-card-doodle" aria-hidden="true">(˶ᵔ ᵕ ᵔ˶)</span>
							</article>
						);
					})}
				</div>
				<div class="collection-shelf-board" aria-hidden="true"><span></span></div>
			</section>
		))}
	</section>

	<section class="collection-next">
		<div class="collection-next-icon" aria-hidden="true">🎁</div>
		<div>
			<span>NEXT FAVORITE</span>
			<h2>下一件喜欢的东西，会是什么呢？</h2>
			<p>这里还留着空位，等新的动画、音乐和故事住进来。</p>
		</div>
		<span class="collection-next-sparkle" aria-hidden="true">✦</span>
	</section>
</collection-cabinet>

<script>
	class CollectionCabinetElement extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready === "true") return;
			this.dataset.ready = "true";
			this.dataset.activeFilter = "all";
			const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-filter]"));
			const cards = Array.from(this.querySelectorAll<HTMLElement>("[data-category]"));
			const groups = Array.from(this.querySelectorAll<HTMLElement>("[data-collection-group]"));
			const count = this.querySelector<HTMLElement>(".cabinet-visible-count");

			for (const button of buttons) {
				button.addEventListener("click", () => {
					const filter = button.dataset.filter || "all";
					this.dataset.activeFilter = filter;
					for (const item of buttons) {
						const active = item === button;
						item.classList.toggle("is-active", active);
						item.setAttribute("aria-pressed", String(active));
					}
					let visible = 0;
					for (const card of cards) {
						const show = filter === "all" || card.dataset.category === filter;
						card.hidden = !show;
						if (show) visible += 1;
					}
					for (const group of groups) {
						group.hidden = filter !== "all" && group.dataset.collectionGroup !== filter;
					}
					if (count) count.textContent = `${visible} 件收藏`;
				});
			}
		}
	}

	if (!customElements.get("collection-cabinet")) {
		customElements.define("collection-cabinet", CollectionCabinetElement);
	}
</script>

<style>
	.collection-cabinet {
		display: block;
		width: 100%;
		color: var(--text-color);
	}

	.cabinet-hero,
	.collection-card,
	.collection-next {
		border: 1px solid color-mix(in srgb, var(--primary) 15%, var(--glass-border));
		background:
			linear-gradient(145deg, rgb(255 255 255 / 0.48), transparent 48%),
			color-mix(in srgb, var(--glass-card) 95%, var(--primary) 2%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.72), 0 1.2rem 3rem rgb(113 75 67 / 0.07);
		backdrop-filter: blur(18px) saturate(118%);
	}

	.cabinet-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 18rem;
		align-items: center;
		min-height: 17rem;
		padding: 2.3rem 2.6rem;
		overflow: hidden;
		border-radius: 2rem;
	}

	.cabinet-hero::before,
	.cabinet-hero::after {
		position: absolute;
		border-radius: 50%;
		content: "";
		pointer-events: none;
	}

	.cabinet-hero::before {
		top: -5rem;
		right: -2rem;
		width: 18rem;
		height: 18rem;
		background: radial-gradient(circle, color-mix(in srgb, var(--primary) 18%, transparent), transparent 68%);
	}

	.cabinet-hero::after {
		bottom: -7rem;
		left: 30%;
		width: 17rem;
		height: 17rem;
		background: radial-gradient(circle, rgb(245 204 146 / 0.16), transparent 68%);
	}

	.cabinet-hero-tape {
		position: absolute;
		top: 0;
		left: 3.2rem;
		width: 5rem;
		height: 0.55rem;
		border-radius: 0 0 0.3rem 0.3rem;
		background: repeating-linear-gradient(120deg, rgb(255 255 255 / 0.22) 0 0.45rem, transparent 0.45rem 0.8rem), color-mix(in srgb, var(--primary) 45%, transparent);
		transform: rotate(-1.5deg);
	}

	.cabinet-hero-copy {
		position: relative;
		z-index: 2;
	}

	.cabinet-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.55rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.13em;
	}

	.cabinet-hero h1 {
		margin: 0;
		color: color-mix(in srgb, var(--text-color) 88%, #6f4b43);
		font-size: clamp(2.2rem, 5vw, 4.25rem);
		font-weight: 900;
		letter-spacing: -0.055em;
		line-height: 1.08;
	}

	.cabinet-hero-copy > p {
		margin: 0.9rem 0 1.25rem;
		color: color-mix(in srgb, var(--text-color) 55%, transparent);
		font-size: 1rem;
	}

	.cabinet-summary {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: color-mix(in srgb, var(--text-color) 55%, transparent);
		font-size: 0.84rem;
	}

	.cabinet-summary strong {
		margin-right: 0.18rem;
		color: var(--primary);
		font-size: 1.35rem;
		font-weight: 900;
	}

	.cabinet-summary i {
		width: 0.22rem;
		height: 0.22rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 58%, transparent);
	}

	.cabinet-hero-visual {
		position: relative;
		z-index: 2;
		display: grid;
		place-items: center;
		min-height: 12rem;
	}

	.mini-shelf {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0.5rem;
		width: 13rem;
		height: 8.5rem;
		padding: 1.5rem 1.4rem 1.3rem;
		border: 1px solid color-mix(in srgb, var(--primary) 19%, transparent);
		border-radius: 4.5rem 4.5rem 1.3rem 1.3rem;
		background: linear-gradient(160deg, rgb(255 255 255 / 0.5), color-mix(in srgb, var(--primary) 8%, transparent));
		box-shadow: inset 0 -0.6rem 0 color-mix(in srgb, #b98470 15%, transparent), 0 1rem 2rem rgb(119 78 66 / 0.11);
		transform: rotate(1.5deg);
	}

	.mini-book {
		display: block;
		width: 1.65rem;
		border-radius: 0.35rem 0.35rem 0.12rem 0.12rem;
		box-shadow: inset -0.25rem 0 rgb(255 255 255 / 0.18);
	}

	.mini-book-one { height: 4.6rem; background: #e989a4; transform: rotate(-4deg); }
	.mini-book-two { height: 5.4rem; background: #82b6ce; }
	.mini-book-three { height: 4.2rem; background: #e6b565; transform: rotate(4deg); }

	.mini-record {
		display: grid;
		place-items: center;
		width: 3.8rem;
		height: 3.8rem;
		margin-left: 0.35rem;
		border: 0.55rem solid #57423e;
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 70%, white);
		color: white;
		font-size: 0.85rem;
		box-shadow: 0 0.4rem 0.9rem rgb(88 56 50 / 0.18);
	}

	.hero-visual-star,
	.hero-visual-heart {
		position: absolute;
		color: color-mix(in srgb, var(--primary) 55%, transparent);
	}

	.hero-visual-star { top: 0.1rem; right: 1rem; font-size: 1.4rem; transform: rotate(10deg); }
	.hero-visual-heart { right: 0.2rem; bottom: 0.6rem; font-size: 1.8rem; transform: rotate(-9deg); }

	.cabinet-filters {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1.25rem 0 1rem;
		padding: 0 0.25rem;
	}

	.cabinet-filter {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.58rem 0.9rem;
		border: 1px solid color-mix(in srgb, var(--primary) 14%, var(--glass-border));
		border-radius: 999px;
		background: color-mix(in srgb, var(--glass-card) 85%, transparent);
		color: color-mix(in srgb, var(--text-color) 62%, transparent);
		font-size: 0.82rem;
		font-weight: 750;
		transition: 180ms ease;
	}

	.cabinet-filter > span {
		color: var(--primary);
	}

	.cabinet-filter:hover,
	.cabinet-filter.is-active {
		border-color: color-mix(in srgb, var(--primary) 32%, transparent);
		background: color-mix(in srgb, var(--primary) 12%, var(--glass-card));
		color: var(--primary);
		box-shadow: 0 0.45rem 1rem color-mix(in srgb, var(--primary) 10%, transparent);
		transform: translateY(-1px);
	}

	.cabinet-visible-count {
		margin-left: auto;
		color: color-mix(in srgb, var(--text-color) 38%, transparent);
		font-size: 0.78rem;
	}

	.collection-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.collection-cabinet[data-active-filter="music"] .collection-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.collection-card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 0.75rem 0.75rem 1rem;
		overflow: hidden;
		border-radius: 1.45rem;
		transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
	}

	.collection-card:hover {
		border-color: color-mix(in srgb, var(--primary) 28%, var(--glass-border));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), 0 1.3rem 2.8rem rgb(113 75 67 / 0.12);
		transform: translateY(-0.3rem) rotate(calc((var(--card-index) - 2) * 0.04deg));
	}

	.collection-card[hidden] { display: none; }

	.collection-card[data-category="music"] {
		background:
			radial-gradient(circle at 88% 14%, color-mix(in srgb, var(--primary) 11%, transparent), transparent 34%),
			linear-gradient(145deg, rgb(255 255 255 / 0.5), transparent 48%),
			color-mix(in srgb, var(--glass-card) 95%, #f6d9de 3%);
	}

	.collection-card-tape {
		position: absolute;
		z-index: 3;
		top: 0;
		left: 50%;
		width: 3.8rem;
		height: 0.4rem;
		border-radius: 0 0 0.2rem 0.2rem;
		background: color-mix(in srgb, var(--primary) 34%, transparent);
		transform: translateX(-50%) rotate(-1deg);
	}

	.collection-card-number {
		position: absolute;
		z-index: 3;
		top: 1rem;
		left: 1rem;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.72);
		color: var(--primary);
		font-size: 0.68rem;
		font-weight: 900;
		box-shadow: 0 0.35rem 0.8rem rgb(95 61 54 / 0.1);
		backdrop-filter: blur(8px);
	}

	.collection-media {
		position: relative;
		min-width: 0;
	}

	.collection-cover {
		position: relative;
		z-index: 1;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--primary) 9%, var(--glass-card));
	}

	.collection-vinyl {
		display: none;
	}

	.collection-card[data-category="music"] .collection-media {
		padding-right: 2.2rem;
	}

	.collection-card[data-category="music"] .collection-cover {
		aspect-ratio: 1;
		border-radius: 1.05rem;
		box-shadow: 0 0.75rem 1.6rem rgb(78 48 48 / 0.16);
	}

	.collection-card[data-category="music"] .collection-vinyl {
		position: absolute;
		z-index: 0;
		top: 50%;
		right: 0.15rem;
		display: block;
		width: 62%;
		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 0.12);
		border-radius: 50%;
		background:
			radial-gradient(circle, color-mix(in srgb, var(--primary) 76%, #f4b3c3) 0 10%, #f6d8df 10.5% 12%, #201b1d 12.5% 18%, transparent 18.5%),
			repeating-radial-gradient(circle, #322a2d 0 2px, #171416 2px 4px);
		box-shadow: 0 0.8rem 1.5rem rgb(43 30 33 / 0.24), inset 0 0 0 1px rgb(255 255 255 / 0.05);
		transform: translateY(-50%);
		transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.collection-card[data-category="music"] .collection-vinyl::after {
