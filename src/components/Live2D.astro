---
/**
 * Live2D 看板娘组件
 * 基于 stevenjoezhang/live2d-widget
 * 仅在桌面端（屏幕宽度 >= 768px）加载
 * 不加载默认 waifu.css，使用自定义样式避免与页面布局冲突
 */
---

<script is:inline>
(function () {
    var live2d_path = "https://fastly.jsdelivr.net/npm/live2d-widgets@0/";

    function loadExternalResource(url, type) {
        return new Promise(function(resolve, reject) {
            if (type === "css") {
                if (document.querySelector('link[href="' + url + '"]')) return resolve(url);
                var tag = document.createElement("link");
                tag.rel = "stylesheet";
                tag.href = url;
                tag.setAttribute("data-swup-persist", "");
                tag.onload = function() { resolve(url); };
                tag.onerror = function() { reject(url); };
                document.head.appendChild(tag);
            } else if (type === "js") {
                if (document.querySelector('script[src="' + url + '"]')) return resolve(url);
                var tag = document.createElement("script");
                tag.src = url;
                tag.setAttribute("data-swup-persist", "");
                tag.onload = function() { resolve(url); };
                tag.onerror = function() { reject(url); };
                document.head.appendChild(tag);
            }
        });
    }

    function ensureWaifuVisible() {
        var waifu = document.getElementById("waifu");
        if (waifu) {
            waifu.style.bottom = "0";
            waifu.style.display = "";
            waifu.style.opacity = "1";
        }
    }

    function initLive2D() {
        if (screen.width < 768) return;

        // 如果已经加载过且元素还在，只需确保可见
        if (window.__live2dLoaded) {
            ensureWaifuVisible();
            return;
        }

        Promise.all([
            loadExternalResource("https://cdn.jsdelivr.net/npm/font-awesome/css/font-awesome.min.css", "css"),
            loadExternalResource(live2d_path + "waifu.css", "css"),
            loadExternalResource(live2d_path + "live2d.min.js", "js"),
            loadExternalResource(live2d_path + "waifu-tips.js", "js")
        ]).then(function() {
            window.__live2dLoaded = true;
            initWidget({
                waifuPath: live2d_path + "waifu-tips.json",
                cdnPath: "https://fastly.jsdelivr.net/gh/fghrsh/live2d_api/",
                tools: ["hitokoto", "asteroids", "switch-model", "switch-texture", "photo", "info", "quit"]
            });
        }).catch(function(err) {
            console.warn("Live2D 加载失败:", err);
        });
    }

    // 首次加载
    initLive2D();

    // 每次 swup 页面切换后，必须彻底销毁旧的看板娘并重新初始化
    // 因为旧页面的 DOM 元素被替换了，看板娘绑定的悬停提示等事件监听器会全部失效
    function setupSwup() {
        window.swup.hooks.on("page:view", function() {
            if (screen.width < 768) return;
            
            // 彻底移除旧元素
            var oldWaifu = document.getElementById("waifu");
            var oldToggle = document.getElementById("waifu-toggle");
            if (oldWaifu) oldWaifu.remove();
            if (oldToggle) oldToggle.remove();
            
            // 重新初始化并绑定事件
            if (typeof initWidget !== "undefined") {
                initWidget({
                    waifuPath: live2d_path + "waifu-tips.json",
                    cdnPath: "https://fastly.jsdelivr.net/gh/fghrsh/live2d_api/",
                    tools: ["hitokoto", "asteroids", "switch-model", "switch-texture", "photo", "info", "quit"]
                });
            }
        });
    }

    if (window.swup) {
        setupSwup();
    } else {
        document.addEventListener("swup:enable", setupSwup);
    }
})();
</script>

<style is:global>
    /* ===== Live2D 看板娘自定义样式（替代默认 waifu.css） ===== */

    /* 显示/隐藏切换按钮 */
    #waifu-toggle {
        background-color: #fa0;
        border-radius: 5px;
        bottom: 66px;
        color: #fff;
        cursor: pointer;
        font-size: 12px;
        left: 0;
        margin-left: -100px;
        padding: 5px 2px 5px 5px;
        position: fixed;
        transition: margin-left 1s;
        width: 60px;
        writing-mode: vertical-rl;
        z-index: 99999;
    }

    #waifu-toggle.waifu-toggle-active {
        margin-left: -50px;
    }

    #waifu-toggle.waifu-toggle-active:hover {
        margin-left: -30px;
    }

    /* 主容器：固定左下角，限制尺寸，不阻挡页面 */
    #waifu {
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        z-index: 99999 !important;
        line-height: 0;
        margin-bottom: -10px;
        transform: translateY(3px);
        transition: transform .3s ease-in-out, bottom 3s ease-in-out;
        pointer-events: none !important;
        /* 不设 width/height，让内容自适应 */
    }

    #waifu:hover {
        transform: translateY(0);
    }

    /* 对话气泡 */
    #waifu-tips {
        animation: shake 50s ease-in-out 5s infinite;
        background-color: rgba(236, 217, 188, .5);
        border: 1px solid rgba(224, 186, 140, .62);
        border-radius: 12px;
        box-shadow: 0 3px 15px 2px rgba(191, 158, 118, .2);
        font-size: 14px;
        line-height: 24px;
        margin: -30px 20px;
        min-height: 70px;
        opacity: 0;
        overflow: hidden;
        padding: 5px 10px;
        position: absolute;
        text-overflow: ellipsis;
        transition: opacity 1s;
        width: 250px;
        word-break: break-all;
        pointer-events: auto;
    }

    @keyframes shake {
        2% { transform: translate(.5px, -1.5px) rotate(-.5deg); }
        4% { transform: translate(.5px, 1.5px) rotate(1.5deg); }
        6% { transform: translate(1.5px, 1.5px) rotate(1.5deg); }
        8% { transform: translate(2.5px, 1.5px) rotate(.5deg); }
        10% { transform: translate(.5px, 2.5px) rotate(.5deg); }
        12% { transform: translate(1.5px, 1.5px) rotate(.5deg); }
        14% { transform: translate(.5px, .5px) rotate(1.5deg); }
        16% { transform: translate(-1.5px, -.5px) rotate(1.5deg); }
        18% { transform: translate(.5px, .5px) rotate(1.5deg); }
        20% { transform: translate(2.5px, 2.5px) rotate(1.5deg); }
        22% { transform: translate(.5px, -1.5px) rotate(1.5deg); }
        24% { transform: translate(-1.5px, 1.5px) rotate(-.5deg); }
        26% { transform: translate(1.5px, .5px) rotate(1.5deg); }
        28% { transform: translate(-.5px, -.5px) rotate(-.5deg); }
        30% { transform: translate(1.5px, -.5px) rotate(-.5deg); }
        32% { transform: translate(2.5px, -1.5px) rotate(1.5deg); }
        34% { transform: translate(2.5px, 2.5px) rotate(-.5deg); }
        36% { transform: translate(.5px, -1.5px) rotate(.5deg); }
        38% { transform: translate(.5px, -1.5px) rotate(-.5deg); }
        40% { transform: translate(-.5px, 2.5px) rotate(.5deg); }
        42% { transform: translate(2.5px, -.5px) rotate(.5deg); }
        44% { transform: translate(1.5px, .5px) rotate(.5deg); }
        46% { transform: translate(-1.5px, 2.5px) rotate(.5deg); }
        48% { transform: translate(-.5px, .5px) rotate(1.5deg); }
        50% { transform: translate(.5px, .5px) rotate(-.5deg); }
        52% { transform: translate(2.5px, -.5px) rotate(1.5deg); }
        54% { transform: translate(-1.5px, 1.5px) rotate(.5deg); }
        56% { transform: translate(2.5px, 2.5px) rotate(1.5deg); }
        58% { transform: translate(.5px, 2.5px) rotate(.5deg); }
        60% { transform: translate(2.5px, -.5px) rotate(1.5deg); }
        62% { transform: translate(-1.5px, .5px) rotate(1.5deg); }
        64% { transform: translate(-1.5px, 1.5px) rotate(1.5deg); }
        66% { transform: translate(.5px, 2.5px) rotate(1.5deg); }
        68% { transform: translate(2.5px, -1.5px) rotate(1.5deg); }
        70% { transform: translate(2.5px, 2.5px) rotate(.5deg); }
        72% { transform: translate(-.5px, 1.5px) rotate(1.5deg); }
        74% { transform: translate(-.5px, 1.5px) rotate(.5deg); }
        76% { transform: translate(-.5px, 2.5px) rotate(1.5deg); }
        78% { transform: translate(-1.5px, .5px) rotate(-.5deg); }
        80% { transform: translate(1.5px, -.5px) rotate(1.5deg); }
        82% { transform: translate(-.5px, .5px) rotate(1.5deg); }
        84% { transform: translate(1.5px, 2.5px) rotate(1.5deg); }
        86% { transform: translate(2.5px, 1.5px) rotate(.5deg); }
        88% { transform: translate(-1.5px, .5px) rotate(1.5deg); }
        90% { transform: translate(-1.5px, -.5px) rotate(-.5deg); }
        92% { transform: translate(-1.5px, -1.5px) rotate(1.5deg); }
        94% { transform: translate(.5px, .5px) rotate(-.5deg); }
        96% { transform: translate(2.5px, -.5px) rotate(-.5deg); }
        98% { transform: translate(-.5px, -1.5px) rotate(-.5deg); }
        0%, to { transform: translate(0, 0) rotate(0); }
    }

    /* Live2D 画布 */
    #live2d {
        cursor: grab;
        height: 300px;
        position: relative;
        width: 300px;
        pointer-events: auto;
    }

    /* 工具栏 */
    #waifu-tool {
        color: #aaa;
        opacity: 0;
        position: absolute;
        right: -10px;
        top: 70px;
        transition: opacity 1s;
        pointer-events: auto;
        z-index: 100000 !important;
    }

    #waifu:hover #waifu-tool {
        opacity: 1;
    }

    #waifu-tool span {
        color: #7b8c9d;
        cursor: pointer;
        display: block;
        line-height: 36px;
        text-align: center;
        transition: color .3s;
    }

    #waifu-tool span:hover {
        color: #0684bd;
    }

    /* 移动端隐藏 */
    @media (max-width: 767px) {
        #waifu {
            display: none !important;
        }
        #waifu-toggle {
            display: none !important;
        }
    }
</style>
