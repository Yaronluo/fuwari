---
import { Icon } from "astro-icon/components";
import { type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const links = Astro.props.links;
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed absolute transition-all right-4 px-2 py-2 pointer-events-auto shadow-xl"]}>
    {links.map((link) => link.children?.length ? (
        <details class="mobile-nav-group">
            <summary class="mobile-nav-summary">
                <span class="mobile-nav-summary-label">
                    {link.name}
                </span>
                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="mobile-nav-chevron" />
            </summary>
            <div class="mobile-nav-children">
                {link.children.map((child) => (
                    <a href={child.external ? child.url : url(child.url)} class="mobile-nav-child group" target={child.external ? "_blank" : null}>
                        <span class="mobile-nav-child-copy">
                            <span>{child.name}</span>
                            {child.description && <small>{child.description}</small>}
                        </span>
                        <Icon name="material-symbols:arrow-forward-rounded" class="mobile-nav-child-arrow" />
                    </a>
                ))}
            </div>
        </details>
    ) : (
        <a href={link.external ? link.url : url(link.url)} class="group flex justify-between items-center py-2 pl-3 pr-1 rounded-lg gap-8
            hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition
        "
           target={link.external ? "_blank" : null}
        >
            <div class="transition text-black/75 dark:text-white/75 font-bold group-hover:text-[var(--primary)] group-active:text-[var(--primary)]">
                {link.name}
            </div>
            {!link.external && <Icon name="material-symbols:chevron-right-rounded"
                  class="transition text-[1.25rem] text-[var(--primary)]"
            >
            </Icon>}
            {link.external && <Icon name="fa6-solid:arrow-up-right-from-square"
                  class="transition text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
            >
            </Icon>}
        </a>
    ))}
</div>

<style>
    #nav-menu-panel {
        width: 11rem;
        min-width: 0;
        max-width: calc(100vw - 1.5rem);
        padding: 0.45rem;
        overflow: hidden;
        background: linear-gradient(155deg, rgb(255 255 255 / 0.38), color-mix(in srgb, var(--cream-base) 48%, transparent));
        border: 1px solid color-mix(in srgb, white 62%, var(--primary) 14%);
        border-radius: var(--radius-large);
        backdrop-filter: blur(30px) saturate(155%);
        -webkit-backdrop-filter: blur(30px) saturate(155%);
        box-shadow: 0 1rem 2.5rem rgb(112 77 67 / 0.14), inset 0 1px 0 rgb(255 255 255 / 0.75);
    }
    #nav-menu-panel::after {
        content: "✦";
        position: absolute;
        top: 0.35rem;
        right: 0.8rem;
        color: color-mix(in srgb, var(--primary) 58%, transparent);
        font-size: 0.7rem;
        pointer-events: none;
    }
    :global(.dark) #nav-menu-panel {
        background: linear-gradient(155deg, rgb(28 23 25 / 0.56), color-mix(in srgb, var(--cream-base) 42%, transparent));
        border-color: rgb(255 255 255 / 0.1);
        box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.25), inset 0 1px 0 rgb(255 255 255 / 0.08);
    }
    .mobile-nav-group {
        border-radius: 0.9rem;
    }
    #nav-menu-panel > a {
        gap: 1rem;
        padding-left: 0.7rem;
        padding-right: 0.3rem;
    }
    .mobile-nav-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.4rem 0.3rem 0.4rem 0.7rem;
        border-radius: 0.75rem;
        color: rgb(0 0 0 / 0.75);
        font-weight: 700;
        list-style: none;
        cursor: pointer;
        transition: color 180ms ease, background-color 180ms ease;
    }
    .mobile-nav-summary::-webkit-details-marker { display: none; }
    .mobile-nav-summary:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--primary) 34%, transparent);
        outline-offset: 1px;
    }
    .mobile-nav-summary-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .mobile-nav-chevron {
        width: 1.2rem;
        height: 1.2rem;
        color: var(--primary);
        transition: transform 180ms ease;
    }
    .mobile-nav-group[open] .mobile-nav-summary {
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 8%, transparent);
    }
    .mobile-nav-group[open] .mobile-nav-chevron {
        transform: rotate(180deg);
    }
    .mobile-nav-children {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin: 0.4rem 0 0.1rem;
        padding: 0.1rem;
    }
    .mobile-nav-child {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 2.25rem;
        padding: 0.25rem 0.45rem 0.25rem 0.7rem;
        border: 1px solid rgb(255 255 255 / 0.68);
        border-radius: 0.85rem;
        background: linear-gradient(105deg, rgb(255 255 255 / 0.34), color-mix(in srgb, var(--primary) 7%, transparent));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.62), 0 0.25rem 0.55rem rgb(112 77 67 / 0.035);
        transition: background-color 180ms ease, transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }
    .mobile-nav-child:hover,
    .mobile-nav-child:active {
        border-color: color-mix(in srgb, var(--primary) 25%, white);
        background: linear-gradient(105deg, color-mix(in srgb, var(--primary) 12%, white), color-mix(in srgb, var(--cream-base) 70%, white));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.72), 0 0.4rem 0.8rem rgb(112 77 67 / 0.08);
    }
    .mobile-nav-child:active { transform: scale(0.985); }
    .mobile-nav-child-copy {
        display: flex;
        min-width: 0;
        flex: 1;
        flex-direction: column;
        line-height: 1.25;
    }
    .mobile-nav-child-copy > span {
        color: rgb(0 0 0 / 0.72);
        font-size: 0.74rem;
        font-weight: 800;
        transition: color 180ms ease;
    }
    .mobile-nav-child-copy small {
        margin-top: 0.18rem;
        color: rgb(0 0 0 / 0.38);
        font-size: 0.62rem;
        line-height: 1.2;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }
    .mobile-nav-child:hover .mobile-nav-child-copy > span { color: var(--primary); }
    .mobile-nav-child-arrow {
        width: 0.82rem;
        height: 0.82rem;
        flex: none;
        color: color-mix(in srgb, var(--primary) 72%, transparent);
        transition: transform 180ms ease;
    }
    .mobile-nav-child:hover .mobile-nav-child-arrow { transform: translateX(0.15rem); }
    :global(.dark) .mobile-nav-summary { color: rgb(255 255 255 / 0.75); }
    :global(.dark) .mobile-nav-children {
        background: transparent;
    }
    :global(.dark) .mobile-nav-child { border-color: rgb(255 255 255 / 0.08); background: color-mix(in srgb, var(--cream-base) 44%, transparent); }
    :global(.dark) .mobile-nav-child-copy > span { color: rgb(255 255 255 / 0.75); }
    :global(.dark) .mobile-nav-child-copy small { color: rgb(255 255 255 / 0.38); }
</style>
