---
import WidgetLayout from "./WidgetLayout.astro";
import { Icon } from "astro-icon/components";
import { getSiteContentStats } from "../../utils/content-utils";

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;

// ===== 在这里修改你的建站日期 =====
const SITE_START_DATE = "2025-12-01";
const UMAMI_API_BASE = "https://cloud.umami.is/analytics/us";
const UMAMI_SHARE_ID = "1Dc4PAeDKgLAox0M";
const contentStats = await getSiteContentStats();
const formatNumber = new Intl.NumberFormat("zh-CN");
---

<WidgetLayout name="站点统计" id="site-stats" class={className} style={style} icon="material-symbols:analytics-outline-rounded">
    <div class="stats-board">
        <!-- 运行时间 -->
        <div class="stats-live">
            <span class="stats-live-pulse" aria-hidden="true"></span>
            <div class="stats-live-text">
                <span class="stats-label">已运行</span>
                <span id="site-running-time" class="stats-live-value">加载中...</span>
            </div>
            <Icon name="material-symbols:timer-outline-rounded" class="stats-live-icon" />
        </div>

        <!-- 访问数据 -->
        <div class="stats-tiles">
            <div class="stats-tile">
                <Icon name="material-symbols:today-outline-rounded" class="stats-tile-icon is-today" />
                <span class="stats-tile-label">今日访问</span>
                <span id="umami-site-today-visitors" class="stats-tile-value">--</span>
            </div>
            <div class="stats-tile">
                <Icon name="material-symbols:group-outline-rounded" class="stats-tile-icon is-visitors" />
                <span class="stats-tile-label">总访客</span>
                <span id="umami-site-visitors" class="stats-tile-value">--</span>
            </div>
            <div class="stats-tile">
                <Icon name="material-symbols:trending-up-rounded" class="stats-tile-icon is-pageviews" />
                <span class="stats-tile-label">总访问</span>
                <span id="umami-site-pageviews" class="stats-tile-value">--</span>
            </div>
        </div>

        <div class="stats-divider" aria-hidden="true"><span>内容</span></div>

        <div class="stats-content">
            <div class="stats-cell">
                <span>文章字数</span>
                <strong data-count-to={contentStats.wordCount}>{formatNumber.format(contentStats.wordCount)}</strong>
            </div>
            <div class="stats-cell">
                <span>文章数量</span>
                <strong data-count-to={contentStats.postCount}>{formatNumber.format(contentStats.postCount)}</strong>
            </div>
            <div class="stats-cell">
                <span>分类</span>
                <strong data-count-to={contentStats.categoryCount}>{formatNumber.format(contentStats.categoryCount)}</strong>
            </div>
            <div class="stats-cell">
                <span>标签</span>
                <strong data-count-to={contentStats.tagCount}>{formatNumber.format(contentStats.tagCount)}</strong>
            </div>
        </div>
    </div>
</WidgetLayout>

<!-- 运行时间与 Umami 统计脚本 -->
<script is:inline define:vars={{ SITE_START_DATE, UMAMI_API_BASE, UMAMI_SHARE_ID }}>
    (() => {
        const formatNumber = new Intl.NumberFormat('zh-CN');

        function prefersReducedMotion() {
            return typeof window.matchMedia === 'function'
                && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        /* 数字滚动动画：让统计数字在出现时「滚」到目标值 */
        function countUp(el, target, duration = 900) {
            if (!el || !Number.isFinite(target)) return;
            if (prefersReducedMotion() || typeof requestAnimationFrame !== 'function') {
                el.textContent = formatNumber.format(target);
                return;
            }
            if (el.dataset.counting === '1') return;
            el.dataset.counting = '1';
            const started = performance.now();
            const step = (now) => {
                const progress = Math.min((now - started) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = formatNumber.format(Math.round(target * eased));
                if (progress < 1) {
                    requestAnimationFrame(step);
                } else {
                    el.dataset.counting = '0';
                }
            };
            requestAnimationFrame(step);
        }

        function animateStaticStats(root) {
            root.querySelectorAll('[data-count-to]').forEach((el) => {
                const target = Number(el.dataset.countTo);
                if (!Number.isFinite(target)) return;
                countUp(el, target, 1100);
            });
        }

        function updateRunningTime() {
            // 与站点其他「起航日」口径保持一致：按香港时间零点解析，
            // 否则 new Date("2025-12-01") 是 UTC 零点，比 HKT 早 8 小时。
            const startDate = new Date(`${SITE_START_DATE}T00:00:00+08:00`);
            const now = new Date();
            const diff = now.getTime() - startDate.getTime();
            const el = document.getElementById('site-running-time');

            if (!el) return;
            if (diff < 0) {
                el.textContent = '即将启航 ✨';
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            el.textContent = `${days} 天 ${hours} 时 ${minutes} 分 ${seconds} 秒`;
        }

        async function loadUmamiStats(root) {
            const visitorsEl = document.getElementById('umami-site-visitors');
            const pageviewsEl = document.getElementById('umami-site-pageviews');
            const todayVisitorsEl = document.getElementById('umami-site-today-visitors');
            if (!visitorsEl || !pageviewsEl || !todayVisitorsEl) return;

            try {
                const shareResponse = await fetch(`${UMAMI_API_BASE}/api/share/${UMAMI_SHARE_ID}`, {
                    headers: { Accept: 'application/json' },
                });
                if (!shareResponse.ok) throw new Error(`Umami share request failed: ${shareResponse.status}`);

                const share = await shareResponse.json();
                if (!share.websiteId || !share.token) throw new Error('Umami share response is incomplete');

                const query = new URLSearchParams({
                    startAt: String(new Date(`${SITE_START_DATE}T00:00:00+08:00`).getTime()),
                    endAt: String(Date.now()),
                });
                const dateParts = new Intl.DateTimeFormat('en-US', {
                    timeZone: 'Asia/Hong_Kong', year: 'numeric', month: '2-digit', day: '2-digit',
                }).formatToParts(new Date());
                const part = (type) => dateParts.find((item) => item.type === type)?.value;
                const todayStart = new Date(`${part('year')}-${part('month')}-${part('day')}T00:00:00+08:00`).getTime();
                const todayQuery = new URLSearchParams({ startAt: String(todayStart), endAt: String(Date.now()) });
                const requestOptions = {
                        headers: {
                            Accept: 'application/json',
                            'x-umami-share-token': share.token,
                            'x-umami-share-context': '1',
                        },
                    };
                const [statsResponse, todayResponse] = await Promise.all([
                    fetch(`${UMAMI_API_BASE}/api/websites/${share.websiteId}/stats?${query}`, requestOptions),
                    fetch(`${UMAMI_API_BASE}/api/websites/${share.websiteId}/stats?${todayQuery}`, requestOptions),
                ]);
                if (!statsResponse.ok || !todayResponse.ok) throw new Error('Umami stats request failed');

                const [stats, todayStats] = await Promise.all([statsResponse.json(), todayResponse.json()]);
                countUp(visitorsEl, Number(stats.visitors) || 0, 900);
                countUp(pageviewsEl, Number(stats.pageviews) || 0, 900);
                countUp(todayVisitorsEl, Number(todayStats.visitors) || 0, 700);
                root.dataset.statsState = 'loaded';
            } catch (error) {
                console.error('[SiteStats] Failed to load Umami statistics.', error);
                visitorsEl.textContent = '暂不可用';
                pageviewsEl.textContent = '暂不可用';
                todayVisitorsEl.textContent = '暂不可用';
                root.dataset.statsState = 'error';
            }
        }

        function initSiteStats() {
            const root = document.getElementById('site-stats');
            if (!root || root.dataset.statsState === 'loading' || root.dataset.statsState === 'loaded') return;

            root.dataset.statsState = 'loading';
            updateRunningTime();
            animateStaticStats(root);
            if (window.__siteStatsTimer) clearInterval(window.__siteStatsTimer);
            window.__siteStatsTimer = setInterval(updateRunningTime, 1000);
            loadUmamiStats(root);
        }

        initSiteStats();

        if (window.swup && !window.__siteStatsUmamiHookRegistered) {
            window.__siteStatsUmamiHookRegistered = true;
            window.swup.hooks.on('page:view', initSiteStats);
        } else if (!window.swup) {
            document.addEventListener('swup:enable', () => {
                if (!window.__siteStatsUmamiHookRegistered) {
                    window.__siteStatsUmamiHookRegistered = true;
                    window.swup.hooks.on('page:view', initSiteStats);
                }
            }, { once: true });
        }
    })();
</script>

<style>
    .stats-board {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0 0.15rem 0.15rem;
    }

    /* ---- 运行时间 ---- */
    .stats-live {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.6rem;
        border-radius: 0.7rem;
        border: 1px dashed color-mix(in srgb, var(--tea) 34%, transparent);
        background: color-mix(in srgb, var(--tea) 7%, transparent);
    }
    .stats-live-pulse {
        position: relative;
        flex: none;
        width: 0.44rem;
        height: 0.44rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--tea) 82%, transparent);
    }
    .stats-live-pulse::after {
        content: "";
        position: absolute;
        inset: -0.22rem;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--tea) 55%, transparent);
        animation: stats-pulse 2.4s ease-out infinite;
    }
    .stats-live-text {
        display: flex;
        flex-direction: column;
        gap: 0.05rem;
        min-width: 0;
    }
    .stats-label {
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }
    .stats-live-value {
        font-size: 0.78rem;
        font-weight: 800;
        color: var(--text-strong);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .stats-live-icon {
        width: 1.15rem;
        height: 1.15rem;
        flex: none;
        margin-left: auto;
        color: color-mix(in srgb, var(--tea) 78%, transparent);
    }

    /* ---- 访问数据三宫格 ---- */
    .stats-tiles {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.38rem;
    }
    .stats-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.1rem;
        padding: 0.45rem 0.2rem 0.5rem;
        border-radius: 0.68rem;
        border: 1px solid color-mix(in srgb, var(--primary) 12%, var(--glass-border));
        background: linear-gradient(160deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.14));
        transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.32s ease, box-shadow 0.32s ease;
    }
    .stats-tile-icon {
        width: 1.05rem;
        height: 1.05rem;
    }
    .stats-tile-icon.is-today { color: var(--primary); }
    .stats-tile-icon.is-visitors { color: var(--azusa-blue); }
    .stats-tile-icon.is-pageviews { color: var(--mio-purple); }
    .stats-tile-label {
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--text-muted);
        white-space: nowrap;
    }
    .stats-tile-value {
        font-size: 0.86rem;
        font-weight: 800;
        color: var(--text-strong);
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
    }
    .stats-tile:hover {
        transform: translateY(-0.14rem);
        border-color: color-mix(in srgb, var(--primary) 30%, var(--glass-border));
        box-shadow: 0 0.5rem 1rem color-mix(in srgb, var(--primary) 12%, transparent);
    }

    /* ---- 分隔 ---- */
    .stats-divider {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        color: color-mix(in srgb, var(--primary) 52%, transparent);
    }
    .stats-divider::before,
    .stats-divider::after {
        content: "";
        flex: 1 1 auto;
        height: 1px;
        background: repeating-linear-gradient(
            90deg,
            color-mix(in srgb, var(--primary) 26%, transparent) 0 0.24rem,
            transparent 0.24rem 0.48rem
        );
    }

    /* ---- 内容统计 ---- */
    .stats-content {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem 0.6rem;
    }
    .stats-cell {
        display: flex;
        flex-direction: column;
        gap: 0.06rem;
    }
    .stats-cell span {
        font-size: 0.64rem;
        font-weight: 500;
        color: var(--text-muted);
    }
    .stats-cell strong {
        font-size: 0.92rem;
        font-weight: 800;
        color: var(--text-strong);
        font-variant-numeric: tabular-nums;
    }

    @keyframes stats-pulse {
        0% { opacity: 0.9; transform: scale(0.7); }
        70% { opacity: 0; transform: scale(1.5); }
        100% { opacity: 0; transform: scale(1.5); }
    }

    :global(.dark) .stats-tile {
        background: linear-gradient(160deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01));
    }
    :global(.dark) .stats-live {
        background: color-mix(in srgb, var(--tea) 10%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
        .stats-live-pulse::after {
            animation: none;
        }
        .stats-tile,
        .stats-tile:hover {
            transition: none;
            transform: none;
        }
    }
</style>
