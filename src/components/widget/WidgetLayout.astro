---
import { Icon } from "astro-icon/components";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";

interface Props {
	id: string;
	name?: string;
	icon?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
	isCard?: boolean;
}
const { id, name, icon, isCollapsed, collapsedHeight, style, isCard = true } = Astro.props;
const className = Astro.props.class;
---
<widget-layout data-id={id} data-is-collapsed={String(isCollapsed)} class:list={["pb-4", {"card-base widget-card": isCard}, className]} style={style}>
	{isCard && <span class="widget-card-glass" aria-hidden="true"></span>}
    <div class="widget-heading font-bold transition text-lg text-neutral-900 dark:text-neutral-100 flex items-center gap-2.5 ml-4 mt-4 mb-3">
        {icon && <span class="widget-heading-icon"><Icon name={icon} /></span>}
        {name}
    </div>
    <div id={id} class:list={["collapse-wrapper px-4", {"collapsed overflow-hidden": isCollapsed}]}>
        <slot></slot>
    </div>
    {isCollapsed && <div class="expand-btn px-4 -mb-2">
        <button class="btn-plain rounded-lg w-full h-9">
            <div class="text-[var(--primary)] flex items-center justify-center gap-2 -translate-x-2">
                <Icon name="material-symbols:more-horiz" class="text-[1.75rem]"></Icon> {i18n(I18nKey.more)}
            </div>
        </button>
    </div>}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
    .widget-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-color: color-mix(in srgb, var(--primary) 13%, var(--glass-border));
        background: transparent;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.72),
            0 0.7rem 1.8rem rgb(119 80 69 / 0.065);
    }
	.widget-card-glass {
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			linear-gradient(145deg, rgb(255 255 255 / 0.34), transparent 45%),
			color-mix(in srgb, var(--glass-card) 94%, var(--primary) 3%);
		backdrop-filter: blur(40px);
		-webkit-backdrop-filter: blur(40px);
		pointer-events: none;
	}
    .widget-card::before {
        content: "";
        position: absolute;
        z-index: -1;
        top: -2.6rem;
        right: -2.2rem;
        width: 6.4rem;
        height: 6.4rem;
        border-radius: 999px;
        background: radial-gradient(circle, color-mix(in srgb, var(--primary) 13%, transparent), transparent 68%);
        pointer-events: none;
    }
    .widget-card::after {
        content: "✦";
        position: absolute;
        top: 0.85rem;
        right: 1rem;
        color: color-mix(in srgb, var(--primary) 48%, transparent);
        font-size: 0.7rem;
        text-shadow: -0.55rem 0.45rem 0 color-mix(in srgb, var(--primary) 20%, transparent);
        pointer-events: none;
    }
    .widget-heading {
        position: relative;
        z-index: 1;
        letter-spacing: 0.01em;
    }
    .widget-heading-icon {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        flex: none;
        border: 1px solid color-mix(in srgb, var(--primary) 16%, white);
        border-radius: 0.72rem;
        color: var(--primary);
        background: linear-gradient(145deg, color-mix(in srgb, var(--primary) 13%, white), rgb(255 255 255 / 0.32));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.72);
        transform: rotate(-2deg);
    }
    .widget-heading-icon :global(svg) {
        width: 1.05rem;
        height: 1.05rem;
    }
    :global(.dark) .widget-card {
        border-color: color-mix(in srgb, var(--primary) 18%, var(--glass-border));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07), 0 0.8rem 2rem rgb(0 0 0 / 0.16);
    }
	:global(.dark) .widget-card-glass {
		background:
			linear-gradient(145deg, rgb(255 255 255 / 0.035), transparent 48%),
			color-mix(in srgb, var(--glass-card) 95%, var(--primary) 4%);
	}
    :global(.dark) .widget-heading-icon {
        border-color: color-mix(in srgb, var(--primary) 24%, transparent);
        background: color-mix(in srgb, var(--primary) 12%, transparent);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    }
    .collapsed {
        height: var(--collapsedHeight);
    }
</style>

<script>
    class WidgetLayout extends HTMLElement {
        constructor() {
            super();

            if (this.dataset.isCollapsed !== "true")
                return;

            const id = this.dataset.id;
            const btn = this.querySelector('.expand-btn');
            const wrapper = this.querySelector(`#${id}`)
            btn!.addEventListener('click', () => {
                wrapper!.classList.remove('collapsed');
                btn!.classList.add('hidden');
            })
        }
    }

    if (!customElements.get("widget-layout")) {
        customElements.define("widget-layout", WidgetLayout);
    }
</script>
