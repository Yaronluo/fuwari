---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-3">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mt-4 mb-4
       w-[8.5rem] h-[8.5rem] overflow-hidden rounded-full active:scale-95 shadow-sm hover:shadow-md transition-all">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center rounded-full">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-3xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto w-full h-full object-cover"></ImageWrapper>
    </a>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1.5 dark:text-neutral-50 transition">{config.name}</div>
        <div class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-3 transition"></div>
        <div class="text-center text-sm text-neutral-400 mb-3.5 transition">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="transition-all rounded-full h-10 w-10 active:scale-90 flex items-center justify-center text-neutral-500 hover:text-white hover:bg-[var(--primary)] hover:shadow-lg hover:shadow-[var(--primary)]/20">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="transition-all rounded-full h-10 gap-2 px-4 font-bold active:scale-95 flex items-center justify-center text-neutral-500 hover:text-white hover:bg-[var(--primary)] hover:shadow-lg hover:shadow-[var(--primary)]/20">
                <Icon name={config.links[0].icon} class="text-[1.5rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>

        <!-- 纯爱番语录区 -->
        <div class="mt-4 pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-700/50">
            <div id="romance-quote-text" class="text-center text-sm text-neutral-500 italic font-serif leading-relaxed transition-colors">
                加载中...
            </div>
            <div id="romance-quote-author" class="text-right text-xs text-neutral-400 mt-2 transition-colors">
            </div>
        </div>
    </div>
</div>

<script>
    // 与首页保持同一套纯爱番来源，避免侧栏随机到友情、战斗或群像作品。
    const romanceQuotes = [
        { text: "我所知道的关于你的事情，希望能再多一点。", author: "《月色真美》" },
        { text: "我深信着，我喜欢的人也能喜欢上自己，我认为这就是奇迹。", author: "《月色真美》" },
        { text: "我想告诉你，我喜欢你，这份心情，直到永远。", author: "《玉子爱情故事》" },
        { text: "我的心，因为你而跳动。", author: "《玉子爱情故事》" },
        { text: "只要能看着你，我就觉得很幸福了。", author: "《好想告诉你》" },
        { text: "我想把自己的心意，好好地传达给你。", author: "《好想告诉你》" },
        { text: "不管你变成什么样，我都会一直喜欢你。", author: "《擅长捉弄的高木同学》" },
        { text: "与你相遇之后，每一天都变得很有趣。", author: "《擅长捉弄的高木同学》" },
        { text: "我只想，每一天都能看到你的笑容。", author: "《堀与宫村》" },
        { text: "我喜欢的，是只有我知道的那个你。", author: "《堀与宫村》" }
    ];

    function loadRomanceQuote() {
        const quoteBox = document.getElementById('romance-quote-text');
        const authorBox = document.getElementById('romance-quote-author');
        if (quoteBox && authorBox) {
            const randomQuote = romanceQuotes[Math.floor(Math.random() * romanceQuotes.length)];
            quoteBox.innerHTML = `「${randomQuote.text}」`;
            authorBox.innerText = `—— ${randomQuote.author}`;
        }
    }

    // 初始化
    loadRomanceQuote();

    // 适配 Swup 路由，每次跳转页面刷新语录
    if (window.swup) {
        window.swup.hooks.on('page:view', loadRomanceQuote);
    } else {
        document.addEventListener('swup:enable', () => {
            window.swup.hooks.on('page:view', loadRomanceQuote);
        });
    }
</script>
