---
import { Icon } from "astro-icon/components";
import { getSortedPostsList } from "../../utils/content-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;

// 只把「日期 + 标题 + 链接」传给浏览器，月历、农历与节日都在客户端计算
const calendarPosts = (await getSortedPostsList())
	.map((post) => ({
		date: post.data.published.toISOString().slice(0, 10),
		title: post.data.title,
		url: getPostUrlBySlug(post.slug),
	}))
	.sort((left, right) => left.date.localeCompare(right.date));
---

<WidgetLayout
	name="日历"
	id="site-calendar"
	class:list={[className]}
	style={style}
	icon="material-symbols:calendar-month-outline-rounded"
>
	<calendar-widget class="cal" data-posts={JSON.stringify(calendarPosts)}>
		<div class="cal-head">
			<button class="cal-nav" type="button" data-cal="prev" aria-label="上个月">
				<Icon name="material-symbols:chevron-left-rounded" />
			</button>
			<button
				class="cal-title"
				type="button"
				data-cal="title"
				aria-haspopup="dialog"
				aria-expanded="false"
				aria-label="选择月份"
			>
				<span data-cal="label">日历</span>
				<span class="cal-caret" aria-hidden="true"></span>
			</button>
			<button class="cal-nav" type="button" data-cal="next" aria-label="下个月">
				<Icon name="material-symbols:chevron-right-rounded" />
			</button>
		</div>

		<div class="cal-week" aria-hidden="true">
			<span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
		</div>
		<div class="cal-grid" data-cal="grid"></div>

		<div class="cal-daylist" data-cal="daylist" hidden></div>

		<div class="cal-foot">
			<p class="cal-next" data-cal="next-festival"></p>
			<a class="cal-count" data-cal="count" href="/archive/" hidden></a>
		</div>

		<div class="cal-picker" data-cal="picker" role="dialog" aria-label="选择月份" hidden>
			<div class="cal-picker-head">
				<button class="cal-picker-arrow" type="button" data-cal="year-prev" aria-label="上一年">
					<Icon name="material-symbols:chevron-left-rounded" />
				</button>
				<strong data-cal="picker-year"></strong>
				<button class="cal-picker-arrow" type="button" data-cal="year-next" aria-label="下一年">
					<Icon name="material-symbols:chevron-right-rounded" />
				</button>
			</div>
			<div class="cal-picker-months" data-cal="picker-months"></div>
			<button class="cal-picker-today" type="button" data-cal="picker-today">回到今天</button>
		</div>

		<span class="cal-sr" data-cal="announce" aria-live="polite"></span>
	</calendar-widget>
</WidgetLayout>

<script>
	import {
		addDays,
		daysInMonth,
		getDayInfo,
		isSupportedYear,
		lunarDayName,
		lunarMonthName,
		nextFestival,
		type SolarDate,
		weekdayOf,
	} from "../../utils/lunar";

	interface PostEntry {
		date: string;
		title: string;
		url: string;
	}

	interface Refs {
		grid: HTMLElement;
		title: HTMLButtonElement;
		label: HTMLElement;
		picker: HTMLElement | null;
		pickerYear: HTMLElement | null;
		pickerMonths: HTMLElement | null;
		dayList: HTMLElement | null;
		nextFestivalText: HTMLElement | null;
		count: HTMLAnchorElement | null;
		announce: HTMLElement | null;
	}

	const WEEK_LABELS = ["日", "一", "二", "三", "四", "五", "六"];
	const DAYS_PER_GRID = 42;
	const SWIPE_THRESHOLD = 36;
	const pad = (value: number): string => String(value).padStart(2, "0");
	const dateKeyOf = (year: number, month: number, day: number): string => `${year}-${pad(month)}-${pad(day)}`;

	function readToday(): SolarDate {
		const now = new Date();
		return { year: now.getFullYear(), month: now.getMonth() + 1, day: now.getDate() };
	}

	function parsePosts(raw: string): PostEntry[] {
		try {
			const value: unknown = JSON.parse(raw);
			if (!Array.isArray(value)) return [];
			return value.filter((item): item is PostEntry => {
				if (typeof item !== "object" || item === null) return false;
				const entry = item as Partial<PostEntry>;
				return typeof entry.date === "string" && typeof entry.title === "string" && typeof entry.url === "string";
			});
		} catch {
			return [];
		}
	}

	class CalendarWidget extends HTMLElement {
		private posts: PostEntry[] = [];
		private postsByDate = new Map<string, PostEntry[]>();
		private today: SolarDate = { year: 1970, month: 1, day: 1 };
		private view: { year: number; month: number } = { year: 1970, month: 1 };
		private focusKey = "";
		private dayListKey = "";
		private pickerYear = 1970;
		private pointerStart: { x: number; y: number } | null = null;
		private suppressClickUntil = 0;
		private timer: number | undefined;
		private refs: Refs | null = null;

		connectedCallback(): void {
			if (this.dataset.ready === "1") return;
			this.dataset.ready = "1";

			this.posts = parsePosts(this.dataset.posts ?? "");
			for (const post of this.posts) {
				const group = this.postsByDate.get(post.date);
				if (group) group.push(post);
				else this.postsByDate.set(post.date, [post]);
			}

			this.today = readToday();
			this.view = { year: this.today.year, month: this.today.month };
			this.focusKey = dateKeyOf(this.today.year, this.today.month, this.today.day);

			if (!this.collectRefs()) return;
			this.bindEvents();
			this.render();
			this.renderCountdown();

			this.timer = window.setInterval(() => this.checkDayChange(), 60_000);
			document.addEventListener("visibilitychange", this.onVisibility);
			document.addEventListener("pointerdown", this.onDocumentPointerDown, true);
		}

		disconnectedCallback(): void {
			if (this.timer !== undefined) window.clearInterval(this.timer);
			this.timer = undefined;
			document.removeEventListener("visibilitychange", this.onVisibility);
			document.removeEventListener("pointerdown", this.onDocumentPointerDown, true);
		}

		private collectRefs(): boolean {
			const grid = this.querySelector<HTMLElement>('[data-cal="grid"]');
			const title = this.querySelector<HTMLButtonElement>('[data-cal="title"]');
			const label = this.querySelector<HTMLElement>('[data-cal="label"]');
			if (grid === null || title === null || label === null) return false;

			this.refs = {
				grid,
				title,
				label,
				picker: this.querySelector<HTMLElement>('[data-cal="picker"]'),
				pickerYear: this.querySelector<HTMLElement>('[data-cal="picker-year"]'),
				pickerMonths: this.querySelector<HTMLElement>('[data-cal="picker-months"]'),
				dayList: this.querySelector<HTMLElement>('[data-cal="daylist"]'),
				nextFestivalText: this.querySelector<HTMLElement>('[data-cal="next-festival"]'),
				count: this.querySelector<HTMLAnchorElement>('[data-cal="count"]'),
				announce: this.querySelector<HTMLElement>('[data-cal="announce"]'),
			};
			return true;
		}

		private bindEvents(): void {
			this.querySelector('[data-cal="prev"]')?.addEventListener("click", () => this.shiftMonth(-1));
			this.querySelector('[data-cal="next"]')?.addEventListener("click", () => this.shiftMonth(1));
			this.querySelector('[data-cal="year-prev"]')?.addEventListener("click", () => this.changePickerYear(-1));
			this.querySelector('[data-cal="year-next"]')?.addEventListener("click", () => this.changePickerYear(1));
			this.querySelector('[data-cal="picker-today"]')?.addEventListener("click", () => {
				this.closePicker(false);
				this.goToToday();
			});

			const refs = this.refs;
			if (refs === null) return;
			refs.title.addEventListener("click", () => this.togglePicker());
			refs.grid.addEventListener("click", this.onGridClick);
			refs.grid.addEventListener("focusin", this.onGridFocus);
			refs.grid.addEventListener("keydown", this.onGridKeydown);
			refs.grid.addEventListener("pointerdown", this.onGridPointerDown);
			refs.grid.addEventListener("pointerup", this.onGridPointerUp);
			refs.grid.addEventListener("pointercancel", this.onGridPointerCancel);
			this.addEventListener("keydown", this.onWidgetKeydown);
		}

		private render(announce = true): void {
			const refs = this.refs;
			if (refs === null) return;

			const { year, month } = this.view;
			const headerLabel = `${year} 年 ${month} 月`;
			refs.label.textContent = headerLabel;
			refs.title.setAttribute("aria-label", `${headerLabel}，点击选择月份`);

			const firstWeekday = weekdayOf(year, month, 1);
			const start = addDays(year, month, 1, -firstWeekday);
			const todayKey = dateKeyOf(this.today.year, this.today.month, this.today.day);

			const keys: string[] = [];
			for (let index = 0; index < DAYS_PER_GRID; index += 1) {
				const date = addDays(start.year, start.month, start.day, index);
				keys.push(dateKeyOf(date.year, date.month, date.day));
			}

			if (!keys.includes(this.focusKey)) {
				this.focusKey = dateKeyOf(year, month, 1);
			}

			refs.grid.textContent = "";
			refs.grid.dataset.month = `${year}-${pad(month)}`;
			for (let index = 0; index < DAYS_PER_GRID; index += 1) {
				const date = addDays(start.year, start.month, start.day, index);
				const key = keys[index] ?? "";
				// 第一格固定是周日的列，所以列号直接取 index % 7
				const weekday = index % 7;
				refs.grid.append(this.buildCell(date, key, todayKey, weekday));
			}

			this.renderCount();
			this.hideDayList();
			if (announce) {
				const count = this.postsOfMonth(year, month).length;
				this.announce(`${headerLabel}${count > 0 ? `，${count} 篇文章` : ""}`);
			}
		}

		private buildCell(date: SolarDate, key: string, todayKey: string, weekday: number): HTMLElement {
			const inMonth = date.year === this.view.year && date.month === this.view.month;
			const info = getDayInfo(date.year, date.month, date.day);
			const posts = inMonth ? (this.postsByDate.get(key) ?? []) : [];
			const isToday = key === todayKey;

			let element: HTMLElement;
			if (!inMonth || posts.length > 1) {
				const button = document.createElement("button");
				button.type = "button";
				element = button;
			} else if (posts.length === 1) {
				const link = document.createElement("a");
				link.href = posts[0].url;
				element = link;
			} else {
				element = document.createElement("span");
			}

			const classes = ["cal-day"];
			if (!inMonth) classes.push("is-outside");
			if (isToday) classes.push("is-today");
			if (posts.length > 0) classes.push("is-posted");
			element.className = classes.join(" ");
			element.dataset.date = key;
			if (!inMonth) element.dataset.outside = "1";
			if (inMonth && posts.length > 0) element.dataset.action = "1";
			element.tabIndex = key === this.focusKey ? 0 : -1;

			const number = document.createElement("span");
			number.className = "cal-day-num";
			number.textContent = String(date.day);
			number.setAttribute("aria-hidden", "true");
			element.append(number);

			const sub = document.createElement("span");
			sub.className = "cal-day-sub";
			sub.setAttribute("aria-hidden", "true");
			if (inMonth && info.label !== "") {
				sub.textContent = info.label;
				sub.classList.add(`is-${info.tone}`);
			}
			element.append(sub);

			if (inMonth && posts.length > 0) {
				element.title = posts.length === 1 ? posts[0].title : `共 ${posts.length} 篇文章`;
			}

			element.setAttribute("aria-label", this.ariaLabelOf(date, weekday, info, posts, inMonth, isToday));
			return element;
		}

		private ariaLabelOf(
			date: SolarDate,
			weekday: number,
			info: ReturnType<typeof getDayInfo>,
			posts: PostEntry[],
			inMonth: boolean,
			isToday: boolean,
		): string {
			const segments: string[] = [];
			if (isToday) segments.push("今天");
			segments.push(`${date.year} 年 ${date.month} 月 ${date.day} 日`);
			segments.push(`星期${WEEK_LABELS[weekday] ?? ""}`);

			if (inMonth) {
				if (info.festival !== null) segments.push(info.festival.name);
				else if (info.term !== null) segments.push(info.term);
				if (info.lunar !== null) {
					segments.push(`农历${lunarMonthName(info.lunar.month, info.lunar.isLeap)}${lunarDayName(info.lunar.day)}`);
				}
				if (posts.length === 1) segments.push(`1 篇文章：${posts[0].title}`);
				else if (posts.length > 1) segments.push(`${posts.length} 篇文章`);
			} else {
				segments.push("点击切换到该月份");
			}

			return segments.join("，");
		}

		private renderCount(): void {
			const count = this.refs?.count ?? null;
			if (count === null) return;

			const monthPosts = this.postsOfMonth(this.view.year, this.view.month);
			const latest = this.latestPost();
			if (latest === null) {
				count.hidden = true;
				return;
			}

			count.hidden = false;
			if (monthPosts.length > 0) {
				const newest = monthPosts[monthPosts.length - 1] ?? latest;
				count.href = newest.url;
				count.textContent = `本月 ${monthPosts.length} 篇`;
				count.setAttribute("aria-label", `本月有 ${monthPosts.length} 篇文章，阅读最新一篇：${newest.title}`);
			} else {
				count.href = latest.url;
				count.textContent = `最近更新 ${latest.date.slice(5)}`;
				count.setAttribute("aria-label", `本月还没有文章，阅读最近更新：${latest.title}`);
			}
		}

		private renderCountdown(): void {
			const target = this.refs?.nextFestivalText ?? null;
			if (target === null) return;

			target.classList.remove("is-soon");
			target.textContent = "";

			const upcoming = nextFestival(this.today.year, this.today.month, this.today.day);
			if (upcoming === null) {
				target.textContent = "节日表已覆盖 1900–2100 年";
				return;
			}

			if (upcoming.days === 0) {
				target.append("今天是 ", this.emphasis(upcoming.name));
				target.classList.add("is-soon");
				return;
			}

			if (upcoming.days <= 3) target.classList.add("is-soon");
			target.append("距离 ", this.emphasis(upcoming.name), " 还有 ", this.emphasis(String(upcoming.days)), " 天");
		}

		private emphasis(text: string): HTMLElement {
			const element = document.createElement("strong");
			element.className = "cal-em";
			element.textContent = text;
			return element;
		}

		private announce(text: string): void {
			const region = this.refs?.announce ?? null;
			if (region !== null) region.textContent = text;
		}

		private postsOfMonth(year: number, month: number): PostEntry[] {
			const prefix = `${year}-${pad(month)}`;
			const result: PostEntry[] = [];
			for (const [key, group] of this.postsByDate) {
				if (key.startsWith(prefix)) result.push(...group);
			}
			return result.sort((left, right) => left.date.localeCompare(right.date));
		}

		private latestPost(): PostEntry | null {
			const todayKey = dateKeyOf(this.today.year, this.today.month, this.today.day);
			let latest: PostEntry | null = null;
			let fallback: PostEntry | null = null;
			for (const post of this.posts) {
				if (fallback === null || post.date > fallback.date) fallback = post;
				if (post.date > todayKey) continue;
				if (latest === null || post.date > latest.date) latest = post;
			}
			return latest ?? fallback;
		}

		private parseKey(key: string): SolarDate {
			const [year, month, day] = key.split("-").map(Number);
			return { year: year ?? 1970, month: month ?? 1, day: day ?? 1 };
		}

		private goTo(year: number, month: number, day: number): void {
			if (!isSupportedYear(year)) return;
			this.focusKey = dateKeyOf(year, month, day);
			if (year !== this.view.year || month !== this.view.month) {
				this.view = { year, month };
				this.render();
			} else {
				this.syncTabStops();
			}
			this.focusCell(this.focusKey);
		}

		private goToToday(): void {
			this.today = readToday();
			this.goTo(this.today.year, this.today.month, this.today.day);
		}

		private focusCell(key: string): void {
			const grid = this.refs?.grid ?? null;
			if (grid === null) return;
			grid.querySelector<HTMLElement>(`[data-date="${key}"]`)?.focus({ preventScroll: true });
		}

		private syncTabStops(): void {
			const grid = this.refs?.grid ?? null;
			if (grid === null) return;
			for (const cell of grid.querySelectorAll<HTMLElement>("[data-date]")) {
				cell.tabIndex = cell.dataset.date === this.focusKey ? 0 : -1;
			}
		}

		private shiftMonth(delta: number, day = this.focusDay()): void {
			const base = new Date(Date.UTC(this.view.year, this.view.month - 1 + delta, 1));
			const year = base.getUTCFullYear();
			const month = base.getUTCMonth() + 1;
			if (!isSupportedYear(year)) return;

			const isTodayMonth = year === this.today.year && month === this.today.month;
			const targetDay = isTodayMonth ? this.today.day : Math.min(day, daysInMonth(year, month));
			this.goTo(year, month, targetDay);
		}

		private focusDay(): number {
			const day = this.parseKey(this.focusKey).day;
			return day >= 1 && day <= 31 ? day : 1;
		}

		private moveFocus(delta: number): void {
			const date = this.parseKey(this.focusKey);
			const next = addDays(date.year, date.month, date.day, delta);
			if (!isSupportedYear(next.year)) return;
			this.goTo(next.year, next.month, next.day);
		}

		private togglePicker(): void {
			const picker = this.refs?.picker ?? null;
			if (picker === null) return;
			if (picker.hidden) this.openPicker();
			else this.closePicker(true);
		}

		private openPicker(): void {
			const refs = this.refs;
			if (refs === null || refs.picker === null) return;
			this.hideDayList();
			this.pickerYear = this.view.year;
			refs.picker.hidden = false;
			refs.title.setAttribute("aria-expanded", "true");
			this.renderPicker();
			refs.pickerMonths?.querySelector<HTMLElement>(`[data-month="${this.view.month}"]`)?.focus();
		}

		private closePicker(returnFocus: boolean): void {
			const refs = this.refs;
			if (refs === null || refs.picker === null) return;
			refs.picker.hidden = true;
			refs.title.setAttribute("aria-expanded", "false");
			if (returnFocus) refs.title.focus();
		}

		private changePickerYear(delta: number): void {
			if (!isSupportedYear(this.pickerYear + delta)) return;
			this.pickerYear += delta;
			this.renderPicker();
		}

		private renderPicker(): void {
			const refs = this.refs;
			if (refs === null) return;
			if (refs.pickerYear !== null) refs.pickerYear.textContent = `${this.pickerYear} 年`;
			const container = refs.pickerMonths;
			if (container === null) return;

			container.textContent = "";
			for (let month = 1; month <= 12; month += 1) {
				const button = document.createElement("button");
				button.type = "button";
				button.className = "cal-picker-month";
				button.dataset.month = String(month);
				button.textContent = `${month} 月`;

				const count = this.postsOfMonth(this.pickerYear, month).length;
				if (count > 0) button.classList.add("has-posts");
				if (this.pickerYear === this.view.year && month === this.view.month) button.classList.add("is-current");
				if (this.pickerYear === this.today.year && month === this.today.month) button.classList.add("is-today");

				button.setAttribute("aria-label", `${this.pickerYear} 年 ${month} 月${count > 0 ? `，${count} 篇文章` : ""}`);
				if (this.pickerYear === this.view.year && month === this.view.month) button.setAttribute("aria-current", "date");

				button.addEventListener("click", () => {
					this.closePicker(false);
					this.goTo(this.pickerYear, month, 1);
				});
				container.append(button);
			}
		}

		private showDayList(key: string): void {
			const list = this.refs?.dayList ?? null;
			const posts = this.postsByDate.get(key) ?? [];
			if (list === null || posts.length === 0) return;

			this.closePicker(false);
			this.dayListKey = key;
			const date = this.parseKey(key);

			list.textContent = "";
			const head = document.createElement("div");
			head.className = "cal-daylist-head";

			const heading = document.createElement("span");
			heading.textContent = `${date.month} 月 ${date.day} 日 · ${posts.length} 篇`;

			const close = document.createElement("button");
			close.type = "button";
			close.className = "cal-daylist-close";
			close.setAttribute("aria-label", "关闭文章列表");
			close.textContent = "×";
			close.addEventListener("click", () => {
				this.hideDayList();
				this.focusCell(key);
			});

			head.append(heading, close);
			list.append(head);

			for (const post of posts) {
				const link = document.createElement("a");
				link.className = "cal-daylist-link";
				link.href = post.url;
				link.textContent = post.title;
				list.append(link);
			}

			list.hidden = false;
			this.announce(`${date.month} 月 ${date.day} 日共 ${posts.length} 篇文章`);
			list.querySelector<HTMLAnchorElement>(".cal-daylist-link")?.focus({ preventScroll: true });
		}

		private hideDayList(): void {
			const list = this.refs?.dayList ?? null;
			if (list === null) return;
			list.hidden = true;
			list.textContent = "";
			this.dayListKey = "";
		}

		private checkDayChange(): void {
			const previous = this.today;
			const next = readToday();
			if (next.year === previous.year && next.month === previous.month && next.day === previous.day) return;

			const followingTodayMonth = this.view.year === previous.year && this.view.month === previous.month;
			this.today = next;
			if (followingTodayMonth) {
				this.view = { year: next.year, month: next.month };
				this.focusKey = dateKeyOf(next.year, next.month, next.day);
			}
			this.render();
			this.renderCountdown();
			if (this.refs?.picker && !this.refs.picker.hidden) this.renderPicker();
		}

		private onVisibility = (): void => {
			if (document.visibilityState === "visible") this.checkDayChange();
		};

		private onDocumentPointerDown = (event: PointerEvent): void => {
			const refs = this.refs;
			if (refs === null || refs.picker === null || refs.picker.hidden) return;
			if (!(event.target instanceof Node)) return;
			if (refs.picker.contains(event.target) || refs.title.contains(event.target)) return;
			this.closePicker(false);
		};

		private onWidgetKeydown = (event: KeyboardEvent): void => {
			if (event.key !== "Escape") return;
			const refs = this.refs;
			if (refs === null) return;
			if (refs.picker !== null && !refs.picker.hidden) {
				event.preventDefault();
				this.closePicker(true);
				return;
			}
			if (refs.dayList !== null && !refs.dayList.hidden) {
				event.preventDefault();
				const key = this.dayListKey;
				this.hideDayList();
				if (key !== "") this.focusCell(key);
			}
		};

		private onGridClick = (event: MouseEvent): void => {
			if (performance.now() < this.suppressClickUntil) {
				event.preventDefault();
				event.stopPropagation();
				return;
			}

			const cell = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-date]") : null;
			if (cell === null) return;
			const key = cell.dataset.date ?? "";

			if (cell.dataset.outside === "1") {
				event.preventDefault();
				const date = this.parseKey(key);
				this.goTo(date.year, date.month, date.day);
				return;
			}

			if ((this.postsByDate.get(key)?.length ?? 0) > 1) {
				event.preventDefault();
				this.showDayList(key);
			}
		};

		private onGridFocus = (event: FocusEvent): void => {
			const cell = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-date]") : null;
			const key = cell?.dataset.date;
			if (key === undefined || key === this.focusKey) return;
			this.focusKey = key;
			this.syncTabStops();
		};

		private onGridKeydown = (event: KeyboardEvent): void => {
			const offsets: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 };
			const offset = offsets[event.key];
			if (offset !== undefined) {
				event.preventDefault();
				this.moveFocus(offset);
				return;
			}

			if (event.key === "Home" || event.key === "End") {
				event.preventDefault();
				const date = this.parseKey(this.focusKey);
				const weekday = weekdayOf(date.year, date.month, date.day);
				this.moveFocus(event.key === "Home" ? -weekday : 6 - weekday);
				return;
			}

			if (event.key === "PageUp" || event.key === "PageDown") {
				event.preventDefault();
				this.shiftMonth(event.key === "PageUp" ? -1 : 1, this.focusDay());
				return;
			}

			if (event.key === "t" || event.key === "T") {
				event.preventDefault();
				this.goToToday();
			}
		};

		private onGridPointerDown = (event: PointerEvent): void => {
			if (event.pointerType === "mouse") return;
			this.pointerStart = { x: event.clientX, y: event.clientY };
		};

		private onGridPointerUp = (event: PointerEvent): void => {
			const start = this.pointerStart;
			this.pointerStart = null;
			if (start === null) return;

			const deltaX = event.clientX - start.x;
			const deltaY = event.clientY - start.y;
			if (Math.abs(deltaX) < SWIPE_THRESHOLD || Math.abs(deltaX) < Math.abs(deltaY) * 1.4) return;

			this.suppressClickUntil = performance.now() + 350;
			this.shiftMonth(deltaX < 0 ? 1 : -1);
		};

		private onGridPointerCancel = (): void => {
			this.pointerStart = null;
		};
	}

	if (!customElements.get("calendar-widget")) {
		customElements.define("calendar-widget", CalendarWidget);
	}
</script>

