---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed = tags.length >= 20;

const counts = tags.map((t) => t.count);
const minCount = Math.min(...counts, 1);
const maxCount = Math.max(...counts, 1);
const span = Math.max(maxCount - minCount, 1);
const totalCount = counts.reduce((sum, count) => sum + count, 0);

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---
<WidgetLayout name={i18n(I18nKey.tags)} id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style} icon="material-symbols:tag-rounded">
    <div class="tag-cloud">
        <div class="tag-cloud-head">
            <span><strong>{tags.length}</strong> 个标签</span>
            <span class="tag-cloud-hint">共出现 {totalCount} 次</span>
        </div>
        <div class="tag-cloud-list">
            {tags.map((t, index) => {
                const weight = (t.count - minCount) / span;
                const tilt = [-1.4, 1.1, -0.7, 1.6][index % 4];
                return (
                    <a
                        class="tag-chip"
                        href={getTagUrl(t.name)}
                        aria-label={`View all posts with the ${t.name.trim()} tag`}
                        style={`--w: ${weight.toFixed(2)}; --tilt: ${tilt}deg; --tag-delay: ${140 + index * 80}ms;`}
                    >
                        <span class="tag-chip-name">{t.name.trim()}</span>
                        <span class="tag-chip-count">{t.count}</span>
                    </a>
                );
            })}
        </div>
    </div>
</WidgetLayout>

<style>
    .tag-cloud {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0 0.15rem 0.15rem;
    }
    .tag-cloud-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 0.66rem;
        color: var(--text-muted);
        letter-spacing: 0.02em;
    }
    .tag-cloud-head strong {
        font-size: 0.86rem;
        font-weight: 800;
        color: color-mix(in srgb, var(--primary) 78%, var(--text-strong));
        font-variant-numeric: tabular-nums;
    }
    .tag-cloud-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
    }
    .tag-chip {
        display: inline-flex;
        align-items: baseline;
        gap: 0.24rem;
        padding: calc(0.24rem + var(--w, 0) * 0.1rem) calc(0.6rem + var(--w, 0) * 0.24rem);
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--primary) calc(14% + var(--w, 0) * 18%), var(--glass-border));
        background: color-mix(in srgb, var(--primary) calc(4% + var(--w, 0) * 9%), transparent);
        color: var(--text-body);
        text-decoration: none;
        font-size: calc(0.72rem + var(--w, 0) * 0.12rem);
        line-height: 1.25;
        transform: rotate(var(--tilt, 0deg));
        animation: tag-pop 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: var(--tag-delay, 140ms);
        transition:
            transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.35s ease,
            background 0.35s ease,
            box-shadow 0.35s ease;
    }
    .tag-chip-name {
        font-weight: 600;
        letter-spacing: 0.01em;
    }
    .tag-chip-count {
        font-size: 0.58rem;
        font-weight: 800;
        color: color-mix(in srgb, var(--primary) 62%, var(--text-muted));
        font-variant-numeric: tabular-nums;
        transition: color 0.3s ease;
    }
    .tag-chip:hover {
        transform: rotate(0deg) translateY(-0.14rem) scale(1.04);
        border-color: color-mix(in srgb, var(--primary) 44%, var(--glass-border));
        background: color-mix(in srgb, var(--primary) 13%, transparent);
        box-shadow: 0 0.5rem 1rem color-mix(in srgb, var(--primary) 14%, transparent);
    }
    .tag-chip:hover .tag-chip-count {
        color: var(--primary);
    }
    @keyframes tag-pop {
        from {
            opacity: 0;
            transform: rotate(var(--tilt, 0deg)) scale(0.82);
        }
        to {
            opacity: 1;
            transform: rotate(var(--tilt, 0deg)) scale(1);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .tag-chip {
            animation: none;
        }
        .tag-chip:hover {
            transform: rotate(var(--tilt, 0deg));
        }
    }
</style>
