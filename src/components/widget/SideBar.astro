---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Tag from "./Tags.astro";
import Series from './Series.astro'
import SiteStats from './SiteStats.astro'
import Calendar from './Calendar.astro'
import { pathsEqual, url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
    series?: string
}

const className = Astro.props.class;
const series = Astro.props.series;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
---
<div id="sidebar" class:list={[className, "w-full"]}>

    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4">
        {series && (
            <div id="series" class="flex flex-col w-full gap-4">
                <Series series={series}></Series>
            </div>
        )}
        
        <div id="sidebar-widgets" class="flex flex-col w-full gap-4 transition-swup-fade">
            {isHomePage && (
                <Calendar class="onload-animation" style="animation-delay: 150ms"></Calendar>
            )}
            {isHomePage && (
                <Categories class="onload-animation" style="animation-delay: 200ms"></Categories>
            )}
            {isHomePage && (
                <Tag class="onload-animation" style="animation-delay: 250ms"></Tag>
            )}
            {isHomePage && (
                <SiteStats class="onload-animation" style="animation-delay: 300ms"></SiteStats>
            )}
        </div>
    </div>
</div>
