---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Tag from "./Tags.astro";
import Series from './Series.astro'
import SiteStats from './SiteStats.astro'
import Calendar from './Calendar.astro'
import TodayNote from './TodayNote.astro'
import { pathsEqual, url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
    series?: string
}

const className = Astro.props.class;
const series = Astro.props.series;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
---
<div id="sidebar" class:list={[className, "w-full"]}>

    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4">
        {series && (
            <div id="series" class="flex flex-col w-full gap-4">
                <Series series={series}></Series>
            </div>
        )}
        
        <div id="sidebar-widgets" class="flex flex-col w-full gap-4 transition-swup-fade">
            {isHomePage && (
                <TodayNote class="onload-animation" style="animation-delay: 120ms"></TodayNote>
            )}
            {isHomePage && (
                <Calendar class="onload-animation" style="animation-delay: 180ms"></Calendar>
            )}
            {isHomePage && (
                <Categories class="onload-animation" style="animation-delay: 240ms"></Categories>
            )}
            {isHomePage && (
                <Tag class="onload-animation" style="animation-delay: 300ms"></Tag>
            )}
            {isHomePage && (
                <SiteStats class="onload-animation" style="animation-delay: 360ms"></SiteStats>
            )}
        </div>
    </div>
</div>

<style>
    /* 手账式编号：每张侧栏卡片自动获得 01 / 02 / 03 … 的编号 */
    #sidebar-widgets {
        counter-reset: widget-index;
    }
    #sidebar-widgets > :global(widget-layout) {
        counter-increment: widget-index;
    }
    #sidebar-widgets > :global(widget-layout) :global(.widget-heading)::after {
        content: counter(widget-index, decimal-leading-zero);
        flex: none;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        line-height: 1;
        color: color-mix(in srgb, var(--primary) 44%, transparent);
        font-variant-numeric: tabular-nums;
        padding: 0.18rem 0.32rem;
        border-radius: 0.4rem;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, transparent);
        background: color-mix(in srgb, var(--primary) 6%, transparent);
    }
</style>
