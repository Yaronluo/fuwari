---
import { profileConfig } from "../config";
import ImageWrapper from "./misc/ImageWrapper.astro";
import { Icon } from "astro-icon/components";
---

<script is:inline>
    // A hard reload should paint the hero we already know immediately; only a
    // first visit and Swup navigations get the entrance choreography.
    (() => {
        const root = document.documentElement;
        const navEntry = performance.getEntriesByType('navigation')[0];
        // `readyState === 'loading'` means this runs while the document is
        // still being parsed, i.e. it is the initial paint - not a page swap.
        const initialPaint = document.readyState === 'loading';
        if (initialPaint && navEntry && navEntry.type === 'reload') {
            root.classList.add('hero-no-enter');
        } else {
            root.classList.remove('hero-no-enter');
        }
    })();
</script>

<div id="hero-section" class="relative w-full h-[calc(100vh-6.5rem)] min-h-[500px] flex flex-col items-center justify-center">
    <div class="hero-doodles" aria-hidden="true">
        <span class="hero-doodle hero-doodle--note">♫</span>
        <span class="hero-doodle hero-doodle--spark">✦</span>
        <span class="hero-doodle hero-doodle--ribbon">୨୧</span>
        <span class="hero-doodle hero-doodle--heart">♡</span>
        <span class="hero-doodle hero-doodle--tune">♪</span>
        <span class="hero-doodle hero-doodle--star">✧</span>
        <span class="hero-doodle hero-doodle--bloom">❀</span>
        <span class="hero-doodle hero-doodle--chime">♬</span>
    </div>

    <!-- Main Content Area -->
    <div class="hero-main-content w-full max-w-[var(--page-width)] mx-auto px-6 md:px-12 flex flex-col md:flex-row items-center justify-between gap-12 md:gap-8 z-10">
        
        <!-- Left: Text & Social (Ordered 2nd on mobile, 1st on desktop) -->
        <div class="hero-copy order-2 md:order-1 flex flex-col items-center md:items-start text-center md:text-left flex-1 w-full md:w-auto mt-6 md:mt-0">
            <div class="hero-copy-intro">
                <div class="hero-kicker hero-rise" style="animation-delay: 70ms" aria-hidden="true">
                    <span class="hero-kicker-note">♫</span>
                    <span>放学后的生活手账</span>
                    <span class="hero-kicker-heart">୨୧</span>
                </div>

                <h1 class="hero-title hero-rise text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black/80 dark:text-white/90 leading-tight md:whitespace-nowrap" style="animation-delay: 150ms">
                    Hi everyone, I'm <span class="whitespace-nowrap"><span class="hero-name-mark text-[var(--primary)]">{profileConfig.name}</span><span class="hero-title-charm animate-wave" aria-hidden="true"><Icon name="material-symbols:favorite-rounded" /></span></span>
                </h1>
                <h2 class="hero-bio hero-rise text-xl md:text-2xl text-black/70 dark:text-white/70 font-medium leading-relaxed" style="animation-delay: 260ms">
                    {profileConfig.bio}
                </h2>

                <div class="hero-tags" aria-label="生活关键词">
                    <span class="hero-tag hero-pop" style="animation-delay: 350ms"><span aria-hidden="true">♡</span>认真生活</span>
                    <span class="hero-tag hero-pop" style="animation-delay: 415ms"><span aria-hidden="true">♫</span>快乐追番</span>
                    <span class="hero-tag hero-pop" style="animation-delay: 480ms"><span aria-hidden="true">✦</span>慢慢成长</span>
                </div>
            </div>
            
            <!-- Social Icons -->
            <div class="hero-socials flex flex-wrap justify-center md:justify-start gap-4">
                {profileConfig.links.map((link, index) => {
                    const nameLower = link.name.toLowerCase();
                    let brandClass = "default-link";
                    if (nameLower.includes("github")) brandClass = "github-link";
                    else if (nameLower.includes("qq")) brandClass = "qq-link";
                    else if (nameLower.includes("bilibili")) brandClass = "bilibili-link";
                    else if (nameLower === "x" || nameLower.includes("twitter")) brandClass = "x-link";
                    else if (nameLower.includes("instagram")) brandClass = "instagram-link";
                    
                    return (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.name}
                           class={`social-hero-link hero-pop w-10 h-10 rounded-full backdrop-blur-md border border-white/40 dark:border-white/10 flex items-center justify-center hover:scale-110 hover:-translate-y-1 transition-all duration-300 shadow-lg hover:shadow-xl ${brandClass}`}
                           style={`animation-delay: ${index * 70 + 545}ms;`}>
                            <Icon name={link.icon} class="text-xl" />
                        </a>
                    );
                })}
            </div>
        </div>

        <!-- Right: Avatar (Ordered 1st on mobile, 2nd on desktop) -->
        <div class="avatar-scene hero-avatar-in order-1 md:order-2 flex-shrink-0 flex items-center justify-center w-56 h-56 md:w-72 md:h-72 lg:w-[22rem] lg:h-[22rem]" style="animation-delay: 210ms">
            <div class="avatar-float">
                <span class="avatar-tape" aria-hidden="true"></span>
                <span class="avatar-spark avatar-spark--one" aria-hidden="true">✦</span>
                <span class="avatar-spark avatar-spark--two" aria-hidden="true">♡</span>
                <button id="hero-avatar-button" class="avatar-photo" type="button" aria-label="点一下平泽唯头像">
                    <span class="avatar-image-shell">
                        <ImageWrapper
                            src={profileConfig.avatar || ""}
                            alt="Avatar"
                            class="w-full h-full object-cover"
                            loading="eager"
                            decoding="sync"
                            fetchpriority="high"
                        />
                    </span>
                </button>
                <span class="avatar-bubble" aria-live="polite">うんたん♪</span>
                <span class="avatar-caption hero-pop" aria-hidden="true" style="animation-delay: 680ms">今日份开心</span>
                <span class="avatar-burst" aria-hidden="true">
                    <span class="avatar-burst-item">♡</span>
                    <span class="avatar-burst-item">♪</span>
                    <span class="avatar-burst-item">✦</span>
                    <span class="avatar-burst-item">♫</span>
                    <span class="avatar-burst-item">୨୧</span>
                    <span class="avatar-burst-item">❀</span>
                    <span class="avatar-burst-item">✧</span>
                </span>
            </div>
        </div>
        
    </div>

    <!-- Bottom: Pure Love Quote & Scroll Down -->
    <div class="hero-bottom absolute bottom-8 left-0 w-full flex flex-col items-center justify-center space-y-3 z-10 onload-animation" style="animation-delay: 620ms;">
        <pure-love-quote class="hero-quote block text-black/60 dark:text-white/60 text-sm md:text-base font-serif font-medium tracking-wide cursor-pointer text-center" role="button" tabindex="0" title="点击刷新台词" aria-label="换一句台词">
            <span class="hero-quote-heart" aria-hidden="true">♡</span>
            <span class="hero-quote-content">「<span class="quote-text">正在寻找灵魂深处的共鸣...</span>」</span>
            <span class="quote-author text-xs font-normal ml-2 opacity-70 hidden md:inline-block"></span>
        </pure-love-quote>
        
        <button id="scroll-down-btn" class="hero-scroll-btn text-[var(--primary)] transition-colors p-2 mt-2" aria-label="Scroll down">
            <span class="hero-scroll-ring" aria-hidden="true"></span>
            <span class="hero-scroll-ring hero-scroll-ring--late" aria-hidden="true"></span>
            <Icon name="material-symbols:keyboard-arrow-down-rounded" class="hero-scroll-icon text-4xl" />
        </button>
    </div>
</div>

<style>
    #hero-section {
        isolation: isolate;
        overflow: hidden;
    }

    /* ---------------------------------------------------------------------
       Entrance choreography.
       The independent translate/rotate/scale properties are used on purpose:
       they compose with (instead of clobbering) the decorative transforms
       that the pills, the tape and the caption already carry.
       ------------------------------------------------------------------- */
    @keyframes hero-rise {
        0% {
            opacity: 0;
            translate: 0 1.15rem;
            filter: blur(0.42rem);
        }
        60% {
            opacity: 1;
            filter: blur(0);
        }
        100% {
            opacity: 1;
            translate: 0 0;
            filter: blur(0);
        }
    }

    @keyframes hero-pop {
        0% {
            opacity: 0;
            scale: 0.8;
            translate: 0 0.7rem;
        }
        60% {
            opacity: 1;
        }
        100% {
            opacity: 1;
            scale: 1;
            translate: 0 0;
        }
    }

    @keyframes hero-avatar-in {
        0% {
            opacity: 0;
            scale: 0.76;
            rotate: -7deg;
            translate: 0 -0.7rem;
        }
        62% {
            opacity: 1;
        }
        100% {
            opacity: 1;
            scale: 1;
            rotate: 0deg;
            translate: 0 0;
        }
    }

    .hero-rise {
        animation: hero-rise 760ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    .hero-pop {
        animation: hero-pop 660ms cubic-bezier(0.34, 1.42, 0.5, 1) backwards;
    }

    .hero-avatar-in {
        animation: hero-avatar-in 900ms cubic-bezier(0.34, 1.32, 0.5, 1) backwards;
    }

    /* A refresh keeps the hero still instead of replaying the entrance. */
    :global(html.hero-no-enter) .hero-rise,
    :global(html.hero-no-enter) .hero-pop,
    :global(html.hero-no-enter) .hero-avatar-in,
    :global(html.hero-no-enter) .hero-name-mark::before,
    :global(html.hero-no-enter) .hero-title-charm::before {
        animation: none !important;
    }

    /* The hero drifts up and dissolves while it leaves the viewport, so the
       article list below arrives without a hard cut. */
    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            #hero-section {
                animation: hero-scroll-exit linear both;
                animation-timeline: view();
                animation-range: exit 0% exit 78%;
            }
        }
    }

    @keyframes hero-scroll-exit {
        from {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        to {
            opacity: 0.24;
            transform: translateY(-2.6rem) scale(0.985);
        }
    }

    .hero-main-content {
        position: relative;
    }

    .hero-copy {
        position: relative;
        max-width: 48rem;
    }

    .hero-copy-intro {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: center;
    }

    @media (min-width: 768px) {
        .hero-copy-intro {
            align-items: flex-start;
        }
    }

    .hero-kicker {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.7rem;
        padding: 0.4rem 0.75rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 34%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--card-bg) 60%, transparent);
        color: color-mix(in srgb, var(--primary) 86%, #885f56);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        box-shadow: 0 0.6rem 1.5rem rgb(169 104 113 / 0.08);
        backdrop-filter: blur(12px);
        overflow: hidden;
        transform: rotate(-1deg);
    }

    /* A slow light sweep travels across the pill every few seconds. */
    .hero-kicker::after {
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg,
            transparent 34%,
            color-mix(in srgb, var(--primary) 26%, transparent) 50%,
            transparent 66%);
        content: "";
        pointer-events: none;
        translate: -130% 0;
        animation: hero-kicker-shine 5.4s ease-in-out 1.6s infinite;
    }

    @keyframes hero-kicker-shine {
        0%, 58% { translate: -130% 0; }
        88%, 100% { translate: 130% 0; }
    }

    .hero-kicker-note {
        animation: hero-kicker-note-pulse 2.8s ease-in-out infinite;
    }

    @keyframes hero-kicker-note-pulse {
        0%, 100% { scale: 1; rotate: -6deg; }
        50% { scale: 1.2; rotate: 8deg; }
    }

    .hero-kicker-note,
    .hero-kicker-heart {
        font-size: 0.85rem;
        line-height: 1;
    }

    .hero-kicker-heart {
        color: color-mix(in srgb, var(--primary) 72%, #d5a270);
    }

    .hero-title {
        position: relative;
        margin: 0;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .hero-name-mark {
        position: relative;
        z-index: 0;
        display: inline-block;
    }

    /* The name keeps its solid --primary colour, then upgrades to a slow
       travelling highlight where background-clip: text is available. */
    @supports (background-clip: text) or (-webkit-background-clip: text) {
        .hero-name-mark {
            background-image: linear-gradient(100deg,
                var(--primary) 0%,
                var(--primary) 34%,
                color-mix(in srgb, var(--primary) 74%, white) 47%,
                var(--primary) 62%,
                var(--primary) 100%);
            background-position: 100% 0;
            background-size: 260% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: hero-name-shine 7.2s ease-in-out 1.1s infinite;
        }
    }

    @keyframes hero-name-shine {
        0%, 40% { background-position: 100% 0; }
        74%, 100% { background-position: 0% 0; }
    }

    .hero-name-mark::before {
        position: absolute;
        z-index: -1;
        right: -0.12em;
        bottom: 0.06em;
        left: -0.08em;
        height: 0.34em;
        border-radius: 55% 40% 48% 38%;
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 24%, transparent), color-mix(in srgb, var(--primary) 62%, transparent));
        content: "";
        transform: rotate(-2deg) scaleX(1);
        transform-origin: 6% 65%;
        animation: name-mark-sweep 900ms cubic-bezier(0.16, 1, 0.3, 1) 620ms backwards;
    }

    @keyframes name-mark-sweep {
        from {
            opacity: 0;
            transform: rotate(-2deg) scaleX(0.05);
        }
        30% {
            opacity: 1;
        }
        to {
            opacity: 1;
            transform: rotate(-2deg) scaleX(1);
        }
    }

    .hero-title-charm {
        position: relative;
        display: inline-grid;
        width: 0.92em;
        height: 0.92em;
        margin-left: 0.18em;
        place-items: center;
        border: 1px solid color-mix(in srgb, var(--primary) 28%, white 35%);
        border-radius: 52% 48% 55% 45%;
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 11%, white 38%);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6), 0 0.18em 0.45em color-mix(in srgb, var(--primary) 15%, transparent);
        vertical-align: 0.08em;
        transform: rotate(7deg);
        transform-origin: center;
    }

    .hero-title-charm :global(svg) {
        width: 62%;
        height: 62%;
    }

    /* A soft ring pulses out of the charm badge every few seconds. */
    .hero-title-charm::before {
        position: absolute;
        inset: -0.06em;
        border: 1.5px solid color-mix(in srgb, var(--primary) 58%, transparent);
        border-radius: inherit;
        content: "";
        pointer-events: none;
        animation: charm-ping 3.4s cubic-bezier(0.22, 0.61, 0.36, 1) 1.4s infinite;
    }

    @keyframes charm-ping {
        0% {
            opacity: 0.9;
            scale: 0.86;
        }
        70%, 100% {
            opacity: 0;
            scale: 1.55;
        }
    }

    .hero-title-charm::after {
        position: absolute;
        top: -0.28em;
        right: -0.2em;
        color: color-mix(in srgb, var(--primary) 78%, white);
        content: "✦";
        font-size: 0.32em;
        text-shadow: 0 0.08em 0.22em color-mix(in srgb, var(--primary) 24%, transparent);
    }

    :global(.dark) .hero-title-charm {
        border-color: color-mix(in srgb, var(--primary) 34%, rgb(255 255 255 / 0.12));
        background: color-mix(in srgb, var(--primary) 16%, rgb(54 43 46 / 0.82));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 0.18em 0.45em color-mix(in srgb, var(--primary) 18%, transparent);
    }

    .hero-bio {
        margin-top: 0.72rem;
    }

    .hero-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.55rem;
        margin-top: 1rem;
    }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.32rem;
        padding: 0.42rem 0.7rem;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, white 42%);
        border-radius: 999px;
        background: color-mix(in srgb, #fff5f4 72%, transparent);
        color: color-mix(in srgb, var(--text-body) 70%, #9b746c);
        font-size: 0.76rem;
        font-weight: 700;
        box-shadow: 0 0.5rem 1.2rem rgb(127 91 82 / 0.06);
        backdrop-filter: blur(12px);
        transition: border-color 260ms ease, box-shadow 260ms ease;
    }

    .hero-tag:hover {
        border-color: color-mix(in srgb, var(--primary) 38%, white 26%);
        box-shadow: 0 0.8rem 1.7rem color-mix(in srgb, var(--primary) 20%, transparent);
    }

    .hero-tag:nth-child(2) {
        background: color-mix(in srgb, #f4f8ff 74%, transparent);
        transform: translateY(0.18rem) rotate(1deg);
    }

    .hero-tag:nth-child(3) {
        background: color-mix(in srgb, #fff7e9 78%, transparent);
        transform: rotate(-1deg);
    }

    .hero-tag > span {
        display: inline-block;
        color: var(--primary);
        transition: rotate 260ms ease, scale 260ms ease;
    }

    .hero-tag:hover > span {
        rotate: -9deg;
        scale: 1.18;
    }

    .hero-socials {
        margin-top: 1.35rem;
    }

    .avatar-scene {
        position: relative;
    }

    .avatar-float {
        position: relative;
        display: flex;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        animation: avatar-bob 7.6s ease-in-out infinite;
    }

    /* The avatar breathes: it never sits perfectly still. */
    @keyframes avatar-bob {
        0%, 100% {
            translate: 0 0.32rem;
            rotate: -0.5deg;
        }
        50% {
            translate: 0 -0.42rem;
            rotate: 0.5deg;
        }
    }

    .avatar-scene::before {
        position: absolute;
        top: 54%;
        left: -6.4rem;
        width: 5.4rem;
        height: 2px;
        background-image: repeating-linear-gradient(90deg,
            color-mix(in srgb, var(--primary) 34%, transparent) 0 0.42rem,
            transparent 0.42rem 0.8rem);
        content: "";
        transform: rotate(-5deg);
        animation: avatar-line-march 1.6s linear infinite;
    }

    /* The dotted thread keeps running towards the avatar. */
    @keyframes avatar-line-march {
        to { background-position: 0.8rem 0; }
    }

    .avatar-scene::after {
        position: absolute;
        top: calc(54% - 0.45rem);
        left: -1.35rem;
        color: color-mix(in srgb, var(--primary) 72%, #dab5ab);
        content: "♡";
        font-size: 0.92rem;
        transform: rotate(10deg);
        animation: avatar-heart-beat 2.6s ease-in-out infinite;
    }

    @keyframes avatar-heart-beat {
        0%, 100% { scale: 1; }
        16% { scale: 1.2; }
        32% { scale: 0.95; }
        48% { scale: 1.09; }
        64% { scale: 1; }
    }

    .avatar-photo {
        position: relative;
        width: 100%;
        height: 100%;
        padding: 0.7rem;
        border: 1px solid color-mix(in srgb, var(--primary) 15%, white 62%);
        border-radius: 48% 52% 47% 53% / 52% 46% 54% 48%;
        background: linear-gradient(145deg, rgb(255 255 255 / 0.82), rgb(255 244 242 / 0.66));
        box-shadow: 0 1.8rem 3.4rem rgb(100 74 67 / 0.19), inset 0 0 0 0.32rem rgb(255 255 255 / 0.34);
        cursor: pointer;
        transition: transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 450ms ease;
        transform: rotate(1.4deg);
    }

    .avatar-photo:hover,
    .avatar-photo:focus-visible {
        box-shadow: 0 2rem 4rem rgb(120 75 74 / 0.24), 0 0 0 0.45rem color-mix(in srgb, var(--primary) 9%, transparent);
        outline: none;
        transform: rotate(-0.8deg) translateY(-0.35rem) scale(1.025);
    }

    .avatar-photo:active {
        transform: rotate(0deg) scale(0.98);
    }

    .avatar-image-shell {
        display: block;
        width: 100%;
        height: 100%;
        overflow: hidden;
        border-radius: inherit;
        background: color-mix(in srgb, var(--primary) 7%, white);
    }

    .avatar-tape {
        position: absolute;
        z-index: 3;
        top: -0.55rem;
        left: 50%;
        width: 5.7rem;
        height: 1.55rem;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, rgb(255 255 255 / 0.34));
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 42%, transparent), color-mix(in srgb, var(--primary) 40%, white 48%), color-mix(in srgb, var(--primary) 42%, transparent));
        box-shadow: 0 0.3rem 0.9rem color-mix(in srgb, var(--primary) 14%, transparent);
        clip-path: polygon(3% 8%, 97% 0, 94% 92%, 5% 100%);
        transform: translateX(-50%) rotate(-3deg);
        backdrop-filter: blur(4px);
        animation: avatar-tape-sway 5.8s ease-in-out infinite;
    }

    @keyframes avatar-tape-sway {
        0%, 100% { rotate: -2deg; }
        50% { rotate: 3.4deg; }
    }

    .avatar-bubble {
        position: absolute;
        z-index: 4;
        right: -0.7rem;
        bottom: 2rem;
        padding: 0.48rem 0.72rem;
        border: 1px solid color-mix(in srgb, var(--primary) 20%, white);
        border-radius: 1rem 1rem 0.25rem 1rem;
        background: rgb(255 250 247 / 0.82);
        color: color-mix(in srgb, var(--primary) 76%, #8d675f);
        font-size: 0.72rem;
        font-weight: 800;
        box-shadow: 0 0.8rem 1.8rem rgb(137 92 87 / 0.12);
        opacity: 0;
        pointer-events: none;
        transition: opacity 220ms ease, transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
        transform: translateY(0.55rem) rotate(2deg) scale(0.82);
        backdrop-filter: blur(14px);
    }

    .avatar-photo:hover ~ .avatar-bubble,
    .avatar-photo:focus-visible ~ .avatar-bubble,
    .avatar-bubble.is-visible {
        opacity: 1;
        transform: translateY(0) rotate(2deg) scale(1);
    }

    .avatar-caption {
        position: absolute;
        z-index: 3;
        bottom: -0.9rem;
        left: 1.8rem;
        padding: 0.25rem 0.62rem;
        border-radius: 999px;
        background: color-mix(in srgb, #fff9f5 82%, transparent);
        color: color-mix(in srgb, var(--primary) 62%, #a48378);
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        box-shadow: 0 0.55rem 1.3rem rgb(130 88 82 / 0.08);
        transform: rotate(-4deg);
    }

    .avatar-spark {
        position: absolute;
        z-index: 4;
