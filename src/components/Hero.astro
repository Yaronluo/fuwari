            ];

            try {
                const data = pureLoveQuotes[Math.floor(Math.random() * pureLoveQuotes.length)];
                const authorVisible = authorEl && authorEl.textContent;
                const targets = authorVisible ? [textEl, authorEl] : [textEl];
                const canAnimate = typeof textEl.animate === 'function' && !this.motionReduced();

                if (!canAnimate) {
                    textEl.textContent = data.text;
                    if (authorEl) authorEl.textContent = `—— 《${data.from}》`;
                    return;
                }

                if (this.dataset.swapping === 'true') return;
                this.dataset.swapping = 'true';

                // The very first line only fades in: there is nothing to
                // replace yet.
                const isPlaceholder = textEl.textContent.includes('正在寻找灵魂深处的共鸣');
                const leaving = isPlaceholder ? [] : targets.map((el) => el.animate([
                    { opacity: 1, transform: 'translateY(0) scale(1)', filter: 'blur(0)' },
                    { opacity: 0, transform: 'translateY(-0.34rem) scale(0.985)', filter: 'blur(0.22rem)' }
                ], { duration: 190, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }));
                await Promise.all(leaving.map((animation) => animation.finished.catch(() => {})));

                textEl.textContent = data.text;
                if (authorEl) authorEl.textContent = `—— 《${data.from}》`;

                const entering = targets.map((el, index) => el.animate([
                    { opacity: 0, transform: 'translateY(0.42rem) scale(0.985)', filter: 'blur(0.22rem)' },
                    { opacity: index === 0 ? 1 : 0.7, transform: 'translateY(0) scale(1)', filter: 'blur(0)' }
                ], { duration: 460, delay: index * 60, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }));
                await Promise.all(entering.map((animation) => animation.finished.catch(() => {})));

                // Hand the final state back to CSS so hover styles keep working.
                [...leaving, ...entering].forEach((animation) => {
                    const target = animation.effect && animation.effect.target;
                    if (target) target.style.opacity = '';
                    animation.cancel();
                });
                textEl.style.filter = '';
                if (authorEl) authorEl.style.filter = '';
            } catch (err) {
                textEl.textContent = "获取台词失败";
            } finally {
                this.dataset.swapping = 'false';
            }
        }

        motionReduced() {
            return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }
    }
    if (!customElements.get('pure-love-quote')) {
        customElements.define('pure-love-quote', PureLoveQuote);
    }

    function setupHeroScroll() {
        const scrollBtn = document.getElementById('scroll-down-btn');
        if (scrollBtn && scrollBtn.dataset.scrollBound !== 'true') {
            scrollBtn.dataset.scrollBound = 'true';
            scrollBtn.addEventListener('click', () => {
                const mainGrid = document.getElementById('main-grid');
                if (mainGrid) {
                    const y = mainGrid.getBoundingClientRect().top + window.scrollY - 80;
                    window.scrollTo({ top: y, behavior: 'smooth' });
                }
            });
        }
    }

    function motionReduced() {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    /** Sends the seven reel glyphs of the avatar flying outwards. */
    function spawnAvatarBurst(scene) {
        const burst = scene?.querySelector('.avatar-burst');
        if (!burst || motionReduced()) return;

        const items = burst.querySelectorAll('.avatar-burst-item');
        const size = scene.getBoundingClientRect().width || 280;
        items.forEach((item, index) => {
            const angle = (Math.PI * 2 * index) / items.length - Math.PI / 2 + (Math.random() - 0.5) * 0.5;
            const distance = size * (0.48 + Math.random() * 0.2);
            item.style.setProperty('--bx', `${(Math.cos(angle) * distance).toFixed(1)}px`);
            item.style.setProperty('--by', `${(Math.sin(angle) * distance).toFixed(1)}px`);
            item.style.setProperty('--br', `${Math.round((Math.random() - 0.5) * 140)}deg`);
            item.style.setProperty('--bd', `${1000 + Math.round(Math.random() * 420)}ms`);
        });

        burst.classList.remove('is-active');
        void burst.offsetWidth; // restart the animation from the top
        burst.classList.add('is-active');

        window.clearTimeout(burst._burstTimer);
        burst._burstTimer = window.setTimeout(() => burst.classList.remove('is-active'), 1700);
    }

    function setupHeroAvatar() {
        const avatarButton = document.getElementById('hero-avatar-button');
        const scene = avatarButton?.closest('.avatar-scene');
        const bubble = scene?.querySelector('.avatar-bubble');
        if (!avatarButton || !bubble || avatarButton.dataset.avatarBound === 'true') return;

        const messages = ['うんたん♪', '吉太～', '今天也要开心 ୨୧', '放学后见吧 ♫'];
        const initialMessageIndex = messages.indexOf(bubble.textContent?.trim() ?? '');
        let messageIndex = initialMessageIndex >= 0 ? initialMessageIndex + 1 : 0;
        let hideTimer;

        avatarButton.dataset.avatarBound = 'true';
        avatarButton.addEventListener('click', () => {
            bubble.textContent = messages[messageIndex % messages.length];
            messageIndex += 1;
            bubble.classList.remove('is-visible');
            requestAnimationFrame(() => bubble.classList.add('is-visible'));
            window.clearTimeout(hideTimer);
            hideTimer = window.setTimeout(() => bubble.classList.remove('is-visible'), 1800);
            spawnAvatarBurst(scene);
        });
    }

    /** The hero gently follows the cursor: the avatar leads, text and doodles
        lag behind in the opposite direction. */
    function setupHeroParallax() {
        const section = document.getElementById('hero-section');
        if (!section || section.dataset.parallaxBound === 'true') return;
        if (!window.matchMedia('(pointer: fine)').matches || motionReduced()) return;

        const scene = section.querySelector('.avatar-scene');
        const copy = section.querySelector('.hero-copy');
        const doodles = section.querySelector('.hero-doodles');
        if (!scene || !copy || !doodles) return;

        const DEPTH = { scene: 15, copy: 6, doodles: 24 };
        let pointerX = 0;
        let pointerY = 0;
        let currentX = 0;
        let currentY = 0;
        let frame = 0;

        section.dataset.parallaxBound = 'true';

        const render = () => {
            currentX += (pointerX - currentX) * 0.12;
            currentY += (pointerY - currentY) * 0.12;

            scene.style.translate = `${(currentX * DEPTH.scene).toFixed(2)}px ${(currentY * DEPTH.scene * 0.6).toFixed(2)}px`;
            copy.style.translate = `${(-currentX * DEPTH.copy).toFixed(2)}px ${(-currentY * DEPTH.copy * 0.6).toFixed(2)}px`;
            doodles.style.translate = `${(-currentX * DEPTH.doodles).toFixed(2)}px ${(-currentY * DEPTH.doodles * 0.6).toFixed(2)}px`;

            if (Math.abs(pointerX - currentX) > 0.002 || Math.abs(pointerY - currentY) > 0.002) {
                frame = requestAnimationFrame(render);
            } else {
                frame = 0;
            }
        };

        const onPointerMove = (event) => {
            if (!section.isConnected) {
                window.removeEventListener('pointermove', onPointerMove);
                if (frame) window.cancelAnimationFrame(frame);
                return;
            }

            const rect = section.getBoundingClientRect();
            if (rect.bottom < -120 || rect.top > window.innerHeight + 120) return;

            pointerX = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width) * 2 - 1));
            pointerY = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height) * 2 - 1));
            if (!frame) frame = requestAnimationFrame(render);
        };

        window.addEventListener('pointermove', onPointerMove, { passive: true });
    }

    function setupHero() {
        setupHeroScroll();
        setupHeroAvatar();
        setupHeroParallax();
    }

    setupHero();

    if (!window.__fuwariHeroScrollHookRegistered) {
        window.__fuwariHeroScrollHookRegistered = true;

        if (window.swup) {
            window.swup.hooks.on('page:view', setupHero);
        } else {
            document.addEventListener('swup:enable', () => {
                window.swup.hooks.on('page:view', setupHero);
                setupHero();
            }, { once: true });
        }
    }
    })();
</script>
