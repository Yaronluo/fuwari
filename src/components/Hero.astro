---
import { profileConfig } from "../config";
import ImageWrapper from "./misc/ImageWrapper.astro";
import { Icon } from "astro-icon/components";
---

<div id="hero-section" class="relative w-full h-[calc(100vh-6.5rem)] min-h-[500px] flex flex-col items-center justify-center">
    <div class="hero-doodles" aria-hidden="true">
        <span class="hero-doodle hero-doodle--note">♫</span>
        <span class="hero-doodle hero-doodle--spark">✦</span>
        <span class="hero-doodle hero-doodle--ribbon">୨୧</span>
        <span class="hero-doodle hero-doodle--heart">♡</span>
    </div>

    <!-- Main Content Area -->
    <div class="hero-main-content w-full max-w-[var(--page-width)] mx-auto px-6 md:px-12 flex flex-col md:flex-row items-center justify-between gap-12 md:gap-8 z-10">
        
        <!-- Left: Text & Social (Ordered 2nd on mobile, 1st on desktop) -->
        <div class="hero-copy order-2 md:order-1 flex flex-col items-center md:items-start text-center md:text-left flex-1 w-full md:w-auto mt-6 md:mt-0">
            <div class="hero-copy-intro">
                <div class="hero-kicker" aria-hidden="true">
                    <span class="hero-kicker-note">♫</span>
                    <span>放学后的生活手账</span>
                    <span class="hero-kicker-heart">୨୧</span>
                </div>

                <h1 class="hero-title text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black/80 dark:text-white/90 leading-tight md:whitespace-nowrap">
                    Hi everyone, I'm <span class="whitespace-nowrap"><span class="hero-name-mark text-[var(--primary)]">{profileConfig.name}</span><span class="hero-title-charm animate-wave" aria-hidden="true"><Icon name="material-symbols:favorite-rounded" /></span></span>
                </h1>
                <h2 class="hero-bio text-xl md:text-2xl text-black/70 dark:text-white/70 font-medium leading-relaxed">
                    {profileConfig.bio}
                </h2>

                <div class="hero-tags" aria-label="生活关键词">
                    <span class="hero-tag"><span aria-hidden="true">♡</span>认真生活</span>
                    <span class="hero-tag"><span aria-hidden="true">♫</span>快乐追番</span>
                    <span class="hero-tag"><span aria-hidden="true">✦</span>慢慢成长</span>
                </div>
            </div>
            
            <!-- Social Icons -->
            <div class="hero-socials flex flex-wrap justify-center md:justify-start gap-4">
                {profileConfig.links.map((link, index) => {
                    const nameLower = link.name.toLowerCase();
                    let brandClass = "default-link";
                    if (nameLower.includes("github")) brandClass = "github-link";
                    else if (nameLower.includes("qq")) brandClass = "qq-link";
                    else if (nameLower.includes("bilibili")) brandClass = "bilibili-link";
                    else if (nameLower === "x" || nameLower.includes("twitter")) brandClass = "x-link";
                    else if (nameLower.includes("instagram")) brandClass = "instagram-link";
                    
                    return (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.name}
                           class={`social-hero-link w-10 h-10 rounded-full backdrop-blur-md border border-white/40 dark:border-white/10 flex items-center justify-center hover:scale-110 hover:-translate-y-1 transition-all duration-300 shadow-lg hover:shadow-xl ${brandClass}`}
                           style={`animation-delay: ${index * 80 + 300}ms;`}>
                            <Icon name={link.icon} class="text-xl" />
                        </a>
                    );
                })}
            </div>
        </div>

        <!-- Right: Avatar (Ordered 1st on mobile, 2nd on desktop) -->
        <div class="avatar-scene order-1 md:order-2 flex-shrink-0 flex items-center justify-center w-56 h-56 md:w-72 md:h-72 lg:w-[22rem] lg:h-[22rem]">
            <span class="avatar-tape" aria-hidden="true"></span>
            <span class="avatar-spark avatar-spark--one" aria-hidden="true">✦</span>
            <span class="avatar-spark avatar-spark--two" aria-hidden="true">♡</span>
            <button id="hero-avatar-button" class="avatar-photo" type="button" aria-label="点一下平泽唯头像">
                <span class="avatar-image-shell">
                    <ImageWrapper
                        src={profileConfig.avatar || ""}
                        alt="Avatar"
                        class="w-full h-full object-cover"
                        loading="eager"
                        decoding="sync"
                        fetchpriority="high"
                    />
                </span>
            </button>
            <span class="avatar-bubble" aria-live="polite">うんたん♪</span>
            <span class="avatar-caption" aria-hidden="true">今日份开心</span>
        </div>
        
    </div>

    <!-- Bottom: Pure Love Quote & Scroll Down -->
    <div class="hero-bottom absolute bottom-8 left-0 w-full flex flex-col items-center justify-center space-y-3 z-10 onload-animation" style="animation-delay: 300ms;">
        <pure-love-quote class="hero-quote block text-black/60 dark:text-white/60 text-sm md:text-base font-serif font-medium tracking-wide cursor-pointer text-center" title="点击刷新台词">
            <span class="hero-quote-heart" aria-hidden="true">♡</span>
            <span class="hero-quote-content">「<span class="quote-text">正在寻找灵魂深处的共鸣...</span>」</span>
            <span class="quote-author text-xs font-normal ml-2 opacity-70 hidden md:inline-block"></span>
        </pure-love-quote>
        
        <button id="scroll-down-btn" class="text-[var(--primary)] hover:text-[var(--primary)]/80 transition-colors animate-bounce p-2 mt-2" aria-label="Scroll down">
            <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-4xl" />
        </button>
    </div>
</div>

<style>
    #hero-section {
        isolation: isolate;
        overflow: hidden;
    }

    .hero-main-content {
        position: relative;
    }

    .hero-copy {
        position: relative;
        max-width: 48rem;
    }

    .hero-copy-intro {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: center;
    }

    @media (min-width: 768px) {
        .hero-copy-intro {
            align-items: flex-start;
        }
    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.7rem;
        padding: 0.4rem 0.75rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 34%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--card-bg) 60%, transparent);
        color: color-mix(in srgb, var(--primary) 86%, #885f56);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        box-shadow: 0 0.6rem 1.5rem rgb(169 104 113 / 0.08);
        backdrop-filter: blur(12px);
        transform: rotate(-1deg);
    }

    .hero-kicker-note,
    .hero-kicker-heart {
        font-size: 0.85rem;
        line-height: 1;
    }

    .hero-kicker-heart {
        color: color-mix(in srgb, var(--primary) 72%, #d5a270);
    }

    .hero-title {
        position: relative;
        margin: 0;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .hero-name-mark {
        position: relative;
        z-index: 0;
        display: inline-block;
    }

    .hero-name-mark::before {
        position: absolute;
        z-index: -1;
        right: -0.12em;
        bottom: 0.06em;
        left: -0.08em;
        height: 0.34em;
        border-radius: 55% 40% 48% 38%;
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 24%, transparent), color-mix(in srgb, var(--primary) 62%, transparent));
        content: "";
        transform: rotate(-2deg);
    }

    .hero-title-charm {
        position: relative;
        display: inline-grid;
        width: 0.92em;
        height: 0.92em;
        margin-left: 0.18em;
        place-items: center;
        border: 1px solid color-mix(in srgb, var(--primary) 28%, white 35%);
        border-radius: 52% 48% 55% 45%;
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 11%, white 38%);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6), 0 0.18em 0.45em color-mix(in srgb, var(--primary) 15%, transparent);
        vertical-align: 0.08em;
        transform: rotate(7deg);
        transform-origin: center;
    }

    .hero-title-charm :global(svg) {
        width: 62%;
        height: 62%;
    }

    .hero-title-charm::after {
        position: absolute;
        top: -0.28em;
        right: -0.2em;
        color: color-mix(in srgb, var(--primary) 78%, white);
        content: "✦";
        font-size: 0.32em;
        text-shadow: 0 0.08em 0.22em color-mix(in srgb, var(--primary) 24%, transparent);
    }

    :global(.dark) .hero-title-charm {
        border-color: color-mix(in srgb, var(--primary) 34%, rgb(255 255 255 / 0.12));
        background: color-mix(in srgb, var(--primary) 16%, rgb(54 43 46 / 0.82));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 0.18em 0.45em color-mix(in srgb, var(--primary) 18%, transparent);
    }

    .hero-bio {
        margin-top: 0.72rem;
    }

    .hero-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.55rem;
        margin-top: 1rem;
    }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.32rem;
        padding: 0.42rem 0.7rem;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, white 42%);
        border-radius: 999px;
        background: color-mix(in srgb, #fff5f4 72%, transparent);
        color: color-mix(in srgb, var(--text-body) 70%, #9b746c);
        font-size: 0.76rem;
        font-weight: 700;
        box-shadow: 0 0.5rem 1.2rem rgb(127 91 82 / 0.06);
        backdrop-filter: blur(12px);
    }

    .hero-tag:nth-child(2) {
        background: color-mix(in srgb, #f4f8ff 74%, transparent);
        transform: translateY(0.18rem) rotate(1deg);
    }

    .hero-tag:nth-child(3) {
        background: color-mix(in srgb, #fff7e9 78%, transparent);
        transform: rotate(-1deg);
    }

    .hero-tag > span {
        color: var(--primary);
    }

    .hero-socials {
        margin-top: 1.35rem;
    }

    .avatar-scene {
        position: relative;
    }

    .avatar-scene::before {
        position: absolute;
        top: 54%;
        left: -6.4rem;
        width: 5.4rem;
        border-top: 2px dashed color-mix(in srgb, var(--primary) 28%, transparent);
        content: "";
        transform: rotate(-5deg);
    }

    .avatar-scene::after {
        position: absolute;
        top: calc(54% - 0.45rem);
        left: -1.35rem;
        color: color-mix(in srgb, var(--primary) 72%, #dab5ab);
        content: "♡";
        font-size: 0.92rem;
        transform: rotate(10deg);
    }

    .avatar-photo {
        position: relative;
        width: 100%;
        height: 100%;
        padding: 0.7rem;
        border: 1px solid color-mix(in srgb, var(--primary) 15%, white 62%);
        border-radius: 48% 52% 47% 53% / 52% 46% 54% 48%;
        background: linear-gradient(145deg, rgb(255 255 255 / 0.82), rgb(255 244 242 / 0.66));
        box-shadow: 0 1.8rem 3.4rem rgb(100 74 67 / 0.19), inset 0 0 0 0.32rem rgb(255 255 255 / 0.34);
        cursor: pointer;
        transition: transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 450ms ease;
        transform: rotate(1.4deg);
    }

    .avatar-photo:hover,
    .avatar-photo:focus-visible {
        box-shadow: 0 2rem 4rem rgb(120 75 74 / 0.24), 0 0 0 0.45rem color-mix(in srgb, var(--primary) 9%, transparent);
        outline: none;
        transform: rotate(-0.8deg) translateY(-0.35rem) scale(1.025);
    }

    .avatar-photo:active {
        transform: rotate(0deg) scale(0.98);
    }

    .avatar-image-shell {
        display: block;
        width: 100%;
        height: 100%;
        overflow: hidden;
        border-radius: inherit;
        background: color-mix(in srgb, var(--primary) 7%, white);
    }

    .avatar-tape {
        position: absolute;
        z-index: 3;
        top: -0.55rem;
        left: 50%;
        width: 5.7rem;
        height: 1.55rem;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, rgb(255 255 255 / 0.34));
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 42%, transparent), color-mix(in srgb, var(--primary) 40%, white 48%), color-mix(in srgb, var(--primary) 42%, transparent));
        box-shadow: 0 0.3rem 0.9rem color-mix(in srgb, var(--primary) 14%, transparent);
        clip-path: polygon(3% 8%, 97% 0, 94% 92%, 5% 100%);
        transform: translateX(-50%) rotate(-3deg);
        backdrop-filter: blur(4px);
    }

    .avatar-bubble {
        position: absolute;
        z-index: 4;
        right: -0.7rem;
        bottom: 2rem;
        padding: 0.48rem 0.72rem;
        border: 1px solid color-mix(in srgb, var(--primary) 20%, white);
        border-radius: 1rem 1rem 0.25rem 1rem;
        background: rgb(255 250 247 / 0.82);
        color: color-mix(in srgb, var(--primary) 76%, #8d675f);
        font-size: 0.72rem;
        font-weight: 800;
        box-shadow: 0 0.8rem 1.8rem rgb(137 92 87 / 0.12);
        opacity: 0;
        pointer-events: none;
        transition: opacity 220ms ease, transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
        transform: translateY(0.55rem) rotate(2deg) scale(0.82);
        backdrop-filter: blur(14px);
    }

    .avatar-photo:hover ~ .avatar-bubble,
    .avatar-photo:focus-visible ~ .avatar-bubble,
    .avatar-bubble.is-visible {
        opacity: 1;
        transform: translateY(0) rotate(2deg) scale(1);
    }

    .avatar-caption {
        position: absolute;
        z-index: 3;
        bottom: -0.9rem;
        left: 1.8rem;
        padding: 0.25rem 0.62rem;
        border-radius: 999px;
        background: color-mix(in srgb, #fff9f5 82%, transparent);
        color: color-mix(in srgb, var(--primary) 62%, #a48378);
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        box-shadow: 0 0.55rem 1.3rem rgb(130 88 82 / 0.08);
        transform: rotate(-4deg);
    }

    .avatar-spark {
        position: absolute;
        z-index: 4;
        color: color-mix(in srgb, var(--primary) 70%, #e8b5b0);
        pointer-events: none;
        filter: drop-shadow(0 0.3rem 0.5rem rgb(174 102 116 / 0.15));
    }

    .avatar-spark--one {
        top: 1.2rem;
        right: -0.6rem;
        font-size: 1.4rem;
    }

    .avatar-spark--two {
        right: 0.8rem;
        bottom: 0.25rem;
        font-size: 1.15rem;
        transform: rotate(12deg);
    }

    .hero-doodles {
        position: absolute;
        z-index: 0;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .hero-doodle {
        position: absolute;
        color: color-mix(in srgb, var(--primary) 42%, transparent);
        font-weight: 700;
        opacity: 0.32;
        filter: blur(0.1px);
    }

    .hero-doodle--note { top: 19%; left: 7%; font-size: 2rem; transform: rotate(-13deg); }
    .hero-doodle--spark { top: 16%; right: 29%; font-size: 1.2rem; transform: rotate(12deg); }
    .hero-doodle--ribbon { right: 7%; bottom: 22%; font-size: 1.55rem; transform: rotate(8deg); }
    .hero-doodle--heart { bottom: 25%; left: 11%; font-size: 2.1rem; transform: rotate(-11deg); }

    .hero-quote {
        position: relative;
        max-width: min(88vw, 54rem);
        padding: 0.62rem 1.05rem 0.62rem 2rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 20%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--card-bg) 58%, transparent);
        box-shadow: 0 0.8rem 2rem rgb(115 80 72 / 0.07);
        backdrop-filter: blur(15px);
        transition: opacity 180ms ease, transform 220ms ease;
    }

    .hero-quote:hover {
        opacity: 0.88;
        transform: translateY(-0.12rem);
    }

    .hero-quote-heart {
        position: absolute;
        top: 50%;
        left: 0.78rem;
        color: var(--primary);
        font-family: sans-serif;
        transform: translateY(-50%) rotate(-8deg);
    }

    /* Keep the delayed footer entrance, but let the hero own the only
       page-level opacity fade so the two animations do not flicker. */
    #hero-section .hero-bottom.onload-animation {
        animation: 350ms cubic-bezier(0.16, 1, 0.3, 1) hero-bottom-rise;
        animation-delay: 300ms;
        animation-fill-mode: backwards;
    }

    @keyframes hero-bottom-rise {
        from { transform: translateY(0.65rem) scale(0.98); }
        to { transform: translateY(0) scale(1); }
    }

    @media (max-width: 767px) {
        #hero-section {
            min-height: 640px;
        }

        .hero-main-content {
            width: 100%;
            margin-inline: auto;
            padding-inline: 1.25rem;
            gap: 1.5rem;
            translate: 0 -2.6rem;
        }

        .hero-copy {
            max-width: 25rem;
            margin-top: 0;
        }

        .hero-kicker {
            margin-bottom: 0.55rem;
            padding: 0.34rem 0.65rem;
            font-size: 0.64rem;
        }

        .hero-title {
            width: max-content;
            max-width: none;
            font-size: clamp(1.3rem, 7.2vw, 1.72rem);
            line-height: 1.12;
            letter-spacing: -0.045em;
            white-space: nowrap;
        }

        .hero-bio {
            margin-top: 0.55rem;
            font-size: 1rem;
        }

        .hero-tags {
            gap: 0.42rem;
            margin-top: 0.75rem;
        }

        .hero-tag {
            padding: 0.35rem 0.58rem;
            font-size: 0.68rem;
        }

        .hero-socials {
            gap: 0.72rem;
            margin-top: 0.9rem;
        }

        .avatar-scene {
            width: 11.5rem;
            height: 11.5rem;
        }

        .avatar-scene::before,
        .avatar-scene::after {
            display: none;
        }

        .avatar-photo {
            padding: 0.5rem;
        }

        .avatar-tape {
            top: -0.45rem;
            width: 4.6rem;
            height: 1.25rem;
        }

        .avatar-bubble {
            right: -0.2rem;
            bottom: 0.8rem;
            padding: 0.38rem 0.58rem;
            font-size: 0.64rem;
        }

        .avatar-caption {
            bottom: -0.65rem;
            left: 1rem;
            font-size: 0.52rem;
        }

        .avatar-spark--one {
            top: 0.7rem;
            right: -0.25rem;
            font-size: 1rem;
        }

        .avatar-spark--two {
            right: 0.4rem;
            bottom: -0.15rem;
            font-size: 0.9rem;
        }

        .hero-bottom {
            bottom: 1rem;
            padding-inline: 1rem;
        }

        .hero-quote {
            width: auto;
            max-width: 100%;
            padding: 0.5rem 0.8rem 0.5rem 1.75rem;
            font-size: 0.72rem;
            line-height: 1.5;
        }

        .hero-quote-heart {
            left: 0.65rem;
        }

        .hero-doodle--note { top: 18%; left: 4%; font-size: 1.25rem; }
        .hero-doodle--spark { top: 15%; right: 7%; }
        .hero-doodle--ribbon { right: 4%; bottom: 27%; font-size: 1.05rem; }
        .hero-doodle--heart { bottom: 29%; left: 5%; font-size: 1.3rem; }
    }

    @media (min-width: 768px) {
        .hero-tags {
            justify-content: flex-start;
        }
    }

    :global(.dark) .hero-kicker,
    :global(.dark) .hero-tag,
    :global(.dark) .hero-quote,
    :global(.dark) .avatar-bubble,
    :global(.dark) .avatar-caption {
        border-color: rgb(255 255 255 / 0.1);
        background: rgb(35 29 30 / 0.52);
        color: rgb(255 240 240 / 0.76);
    }

    :global(.dark) .avatar-photo {
        border-color: rgb(255 255 255 / 0.12);
        background: linear-gradient(145deg, rgb(52 43 45 / 0.72), rgb(28 24 25 / 0.6));
        box-shadow: 0 1.8rem 3.4rem rgb(0 0 0 / 0.34), inset 0 0 0 0.32rem rgb(255 255 255 / 0.05);
    }

    @keyframes wave {
        0%, 100% { transform: rotate(-3deg) scale(1); }
        50% { transform: rotate(4deg) scale(1.08); }
    }
    .animate-wave {
        animation: wave 2.8s ease-in-out infinite;
    }

    .social-hero-link {
        opacity: 0;
        animation: 450ms cubic-bezier(0.34, 1.56, 0.64, 1) pop-up-item;
        animation-fill-mode: both;
    }

    .social-hero-link:nth-child(odd) {
        rotate: -2deg;
    }

    .social-hero-link:nth-child(even) {
        translate: 0 0.18rem;
        rotate: 2deg;
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-wave,
        .social-hero-link {
            animation: none;
        }

        .social-hero-link {
            opacity: 1;
        }

        .avatar-photo,
        .avatar-bubble,
        .hero-quote {
            transition: none;
        }
    }

    /* Icon Tilt Animation */
    .social-hero-link svg {
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .social-hero-link:hover svg {
        transform: rotate(12deg) scale(1.15);
    }

    /* Brand Colors for Frosted Glass */
    .social-hero-link.github-link {
        background-color: rgba(36, 41, 46, 0.15);
        color: #24292e;
    }
    :global(.dark) .social-hero-link.github-link {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff;
    }
    .social-hero-link.qq-link {
        background-color: rgba(18, 183, 245, 0.15);
        color: #12b7f5;
    }
    .social-hero-link.bilibili-link {
        background-color: rgba(251, 114, 153, 0.15);
        color: #fb7299;
    }
    .social-hero-link.x-link {
        background-color: rgba(0, 0, 0, 0.10);
        color: #111111;
    }
    :global(.dark) .social-hero-link.x-link {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff;
    }
    .social-hero-link.instagram-link {
        background-color: rgba(225, 48, 108, 0.12);
        color: #e1306c;
    }
    .social-hero-link.default-link {
        background-color: rgba(150, 150, 150, 0.15);
        color: var(--primary);
    }

    .social-hero-link:hover {
        color: #ffffff;
    }
    
    /* Hover Glow & Fill (Color Diffusion) */
    .social-hero-link.github-link:hover {
        background-color: #24292e;
        box-shadow: 0 0 24px 4px rgba(36, 41, 46, 0.4);
    }
    :global(.dark) .social-hero-link.github-link:hover {
        background-color: #ffffff;
        color: #24292e;
