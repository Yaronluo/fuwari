<div id="mouse-note-trail" aria-hidden="true"></div>

<style is:global>
    #mouse-note-trail {
        position: fixed;
        inset: 0;
        z-index: 9997;
        overflow: hidden;
        pointer-events: none;
        contain: strict;
    }

    #mouse-note-trail .mouse-note {
        position: absolute;
        left: 0;
        top: 0;
        color: color-mix(in srgb, var(--primary) 82%, var(--tea));
        font-family: Georgia, "Times New Roman", serif;
        font-size: var(--note-size, 1rem);
        font-weight: 700;
        line-height: 1;
        text-shadow:
            0 0.1rem 0.35rem color-mix(in srgb, var(--primary) 36%, transparent),
            0 0 0.04rem rgb(255 255 255 / 0.7);
        will-change: transform, opacity;
        animation: mouse-note-float var(--note-duration, 820ms) cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes mouse-note-float {
        0% {
            opacity: 0.78;
            transform: translate(-50%, -50%) scale(0.62) rotate(var(--note-rotate-start, -8deg));
        }
        22% {
            opacity: 0.92;
        }
        100% {
            opacity: 0;
            transform:
                translate(
                    calc(-50% + var(--note-drift-x, 0px)),
                    calc(-50% + var(--note-drift-y, -3rem))
                )
                scale(1.08)
                rotate(var(--note-rotate-end, 12deg));
        }
    }

    @media (prefers-reduced-motion: reduce), (pointer: coarse) {
        #mouse-note-trail {
            display: none;
        }
    }
</style>

<script is:inline>
    (() => {
    const trailWindow = window;

    if (
        !trailWindow.__fuwariMouseNoteTrailInitialized
        && window.matchMedia('(pointer: fine)').matches
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
        trailWindow.__fuwariMouseNoteTrailInitialized = true;

        const trail = document.getElementById('mouse-note-trail');
        const notes = ['♪', '♫', '♬'];
        const activeNotes = [];
        let lastX = Number.NaN;
        let lastY = Number.NaN;
        let lastCreatedAt = 0;

        const removeNote = (note) => {
            const index = activeNotes.indexOf(note);
            if (index >= 0) activeNotes.splice(index, 1);
            note.remove();
        };

        document.addEventListener('pointermove', (event) => {
            if (!trail || event.pointerType !== 'mouse') return;

            const now = performance.now();
            const distance = Number.isNaN(lastX)
                ? Number.POSITIVE_INFINITY
                : Math.hypot(event.clientX - lastX, event.clientY - lastY);

            if (distance < 28 || now - lastCreatedAt < 45) return;

            lastX = event.clientX;
            lastY = event.clientY;
            lastCreatedAt = now;

            const note = document.createElement('span');
            note.className = 'mouse-note';
            note.textContent = notes[Math.floor(Math.random() * notes.length)];
            note.style.left = `${event.clientX}px`;
            note.style.top = `${event.clientY}px`;
            note.style.setProperty('--note-size', `${0.82 + Math.random() * 0.42}rem`);
            note.style.setProperty('--note-duration', `${720 + Math.round(Math.random() * 220)}ms`);
            note.style.setProperty('--note-drift-x', `${Math.round((Math.random() - 0.5) * 38)}px`);
            note.style.setProperty('--note-drift-y', `${-38 - Math.round(Math.random() * 24)}px`);
            note.style.setProperty('--note-rotate-start', `${-18 + Math.round(Math.random() * 22)}deg`);
            note.style.setProperty('--note-rotate-end', `${4 + Math.round(Math.random() * 24)}deg`);

            activeNotes.push(note);
            trail.appendChild(note);
            note.addEventListener('animationend', () => removeNote(note), { once: true });

            if (activeNotes.length > 14) removeNote(activeNotes[0]);
        }, { passive: true });
    }
    })();
</script>
