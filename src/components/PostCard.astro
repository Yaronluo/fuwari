---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
    pinned?: boolean;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
    pinned,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";
const titleCharacters = Array.from(title);
const titleTailLength = Math.min(2, titleCharacters.length);
const titlePrefix = titleCharacters.slice(0, -titleTailLength).join("");
const titleSuffix = titleCharacters.slice(-titleTailLength).join("");

const coverWidth = "28%";

/* The date stamp prints the same UTC calendar day as the article metadata. */
const MONTH_LABELS = [
	"JAN", "FEB", "MAR", "APR", "MAY", "JUN",
	"JUL", "AUG", "SEP", "OCT", "NOV", "DEC",
];
const WEEKDAY_LABELS = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
const stampMonth = MONTH_LABELS[published.getUTCMonth()];
const stampDay = String(published.getUTCDate()).padStart(2, "0");
const stampYear = String(published.getUTCFullYear());
const stampWeekday = WEEKDAY_LABELS[published.getUTCDay()];
const stampDateTime = published.toISOString().substring(0, 10);

const visibleTags = (tags || []).filter(Boolean).slice(0, 4);

const { remarkPluginFrontmatter } = await entry.render();
---
<article class:list={["post-card card-base w-full rounded-[var(--radius-large)] overflow-hidden relative transition-all duration-300", {"has-cover": hasCover, "is-pinned": pinned}, className]} style={style}>
    <a href={url} class="post-card-hit absolute inset-0 z-[1]" aria-label={title}></a>

    <!-- decorative stationery -->
    <span class="post-card-tint" aria-hidden="true"></span>
    <span class="post-card-sticker sticker-ribbon" aria-hidden="true">🎀</span>
    <span class="post-card-sticker sticker-flower" aria-hidden="true">🌸</span>
    <span class="post-card-sticker sticker-sparkles" aria-hidden="true">⋆｡˚</span>
    <span class="post-card-sticker sticker-note" aria-hidden="true">(˶ᵔ ᵕ ᵔ˶)</span>

    <div class:list={["post-card-body relative z-10 flex px-5 md:px-8 pt-6 md:pt-8 pb-5 md:pb-7 gap-3.5 md:gap-5", {"w-full": !hasCover, "w-full md:w-[calc(100%_-_var(--coverWidth)_-_12px)]": hasCover}]}>

        <!-- date stamp -->
        <time datetime={stampDateTime} class="post-card-stamp">
            <span class="stamp-month">{stampMonth}</span>
            <span class="stamp-day">{stampDay}</span>
            <span class="stamp-meta"><span class="stamp-weekday">{stampWeekday}</span><i aria-hidden="true">·</i><span class="stamp-year">{stampYear}</span></span>
        </time>
        <span class="post-card-rail" aria-hidden="true"></span>

        <div class="post-card-main flex flex-col min-w-0 flex-1">
            {pinned && (
                <span class="post-card-pin">
                    <Icon name="mdi:pin" class="w-3 h-3" />
                    置顶
                </span>
            )}

            <h2 class="post-card-heading">
                <a href={url}
                   class="post-card-title transition group w-full block font-bold mb-3 text-[1.22rem] md:text-[1.62rem] leading-snug text-90
                hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
                active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
                relative
                ">
                    {titlePrefix}<span class="post-card-title-tail">{titleSuffix}<Icon class="post-card-mobile-arrow md:hidden text-[1.1rem] text-[var(--primary)]" name="material-symbols:chevron-right-rounded"></Icon><Icon class="post-card-desktop-arrow text-[var(--primary)]" name="material-symbols:chevron-right-rounded"></Icon></span>
                </a>
            </h2>

            <!-- metadata (the date and the tags live in the stamp and footer) -->
            <PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} hideDate={true} hideTags={true} class="mb-3.5 relative z-10"></PostMetadata>

            <!-- description -->
            <div class:list={["post-card-desc transition text-75 pr-1", {"line-clamp-2 md:line-clamp-1": !description}]}>
                { description || remarkPluginFrontmatter.excerpt }
            </div>

            <!-- footer: tags + reading time -->
            <div class="post-card-foot">
                <div class="post-card-tags">
                    {visibleTags.map((tag) => (
                        <a href={getTagUrl(tag)} class="post-card-tag" aria-label={`View all posts with the ${tag.trim()} tag`}>
                            <span aria-hidden="true">#</span>{tag.trim()}
                        </a>
                    ))}
                    {visibleTags.length === 0 && (
                        <span class="post-card-tag post-card-tag--empty" aria-hidden="true">{i18n(I18nKey.noTags)}</span>
                    )}
                </div>

                <div class="post-card-reading text-sm text-black/30 dark:text-white/30 flex gap-3 transition">
                    <div>
                        {remarkPluginFrontmatter.words} {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                    </div>
                    <div aria-hidden="true">|</div>
                    <div>
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {hasCover && <a href={url} aria-label={title}
                    class:list={["group relative z-10",
                        "max-h-[20vh] md:max-h-none mx-4 mt-4 -mb-2 md:mb-0 md:mx-0 md:mt-0",
                        "md:w-[var(--coverWidth)] relative md:absolute md:top-3 md:bottom-3 md:right-3 rounded-xl overflow-hidden active:scale-95"
                    ]} >
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div>
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center ">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full h-full">
        </ImageWrapper>
    </a>}

</article>

<style define:vars={{coverWidth}}>
    .post-card {
        isolation: isolate;
        border-color: color-mix(in srgb, var(--primary) 12%, var(--glass-border));
        background:
            linear-gradient(138deg, rgb(255 255 255 / 0.36), transparent 42%),
            color-mix(in srgb, var(--glass-card) 96%, var(--primary) 2%);
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.72),
            0 0.8rem 2rem rgb(116 77 67 / 0.065) !important;
    }
    /* washi tape on the top edge */
    .post-card::before {
        content: "";
        position: absolute;
        z-index: 3;
        top: 0;
        left: 1.45rem;
        width: 2.8rem;
        height: 0.34rem;
        border-radius: 0 0 0.18rem 0.18rem;
        display: block;
        background:
            repeating-linear-gradient(118deg, rgb(255 255 255 / 0.2) 0 0.3rem, transparent 0.3rem 0.58rem),
            linear-gradient(90deg, color-mix(in srgb, var(--primary) 56%, transparent), color-mix(in srgb, var(--primary) 22%, transparent));
        box-shadow: 0 0.25rem 0.65rem color-mix(in srgb, var(--primary) 15%, transparent);
        transform: rotate(-1.5deg);
    }
    .post-card::after {
        content: "♡";
        position: absolute;
        z-index: 3;
        right: 0.75rem;
        bottom: 0.55rem;
        color: color-mix(in srgb, var(--primary) 25%, transparent);
        font-size: 0.68rem;
        font-weight: 700;
        pointer-events: none;
    }
    .post-card:hover {
        border-color: color-mix(in srgb, var(--primary) 18%, var(--glass-border));
    }
    /* the entry gets a warm paper tint instead of a light sweep */
    .post-card-tint {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0;
        background:
            radial-gradient(120% 130% at 0% 0%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 62%),
            linear-gradient(180deg, color-mix(in srgb, var(--primary) 4%, transparent), transparent 70%);
        transition: opacity 420ms ease;
    }

    /* ---------------- date stamp ---------------- */
    .post-card-stamp {
        flex: none;
        align-self: flex-start;
        width: 4.15rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.05rem;
        padding: 0.6rem 0.3rem 0.5rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 30%, transparent);
        border-radius: 0.9rem 0.85rem 0.95rem 0.82rem;
        background:
            linear-gradient(158deg, color-mix(in srgb, var(--primary) 10%, transparent), transparent 74%),
            color-mix(in srgb, var(--glass-card) 62%, transparent);
        transform: rotate(-1.6deg);
        transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1), border-color 320ms ease, background 320ms ease;
    }
    .stamp-month {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-indent: 0.16em;
        color: color-mix(in srgb, var(--primary) 82%, var(--text-muted));
    }
    .stamp-day {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        color: var(--text-strong);
    }
    .stamp-meta {
        display: flex;
        align-items: center;
        gap: 0.12rem;
        font-size: 0.55rem;
        letter-spacing: 0.02em;
        color: var(--text-muted);
    }
    .stamp-meta i {
        font-style: normal;
        opacity: 0.6;
    }
    /* the dashed notebook margin between the stamp and the entry */
    .post-card-rail {
        position: relative;
        flex: none;
        align-self: stretch;
        width: 0;
        border-left: 1px dashed color-mix(in srgb, var(--primary) 20%, transparent);
    }
    /* an ink line runs down the margin when the entry is hovered */
    .post-card-rail::after {
        content: "";
        position: absolute;
        left: -1px;
        top: 0;
        bottom: 0;
        width: 1px;
        border-radius: 999px;
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--primary) 72%, transparent),
            color-mix(in srgb, var(--primary) 10%, transparent)
        );
        transform: scaleY(0);
        transform-origin: center top;
        transition: transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ---------------- entry ---------------- */
    .post-card-main {
        position: relative;
    }
    .post-card-heading {
        margin: 0;
        font-size: inherit;
        font-weight: inherit;
    }
    .post-card-pin {
        display: inline-flex;
        align-items: center;
        gap: 0.24rem;
        width: max-content;
        margin-bottom: 0.5rem;
        padding: 0.1rem 0.52rem 0.12rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 42%, transparent);
        border-radius: 0.4rem;
        background: color-mix(in srgb, var(--primary) 15%, transparent);
        color: color-mix(in srgb, var(--primary) 88%, var(--text-strong));
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-indent: 0.1em;
        transform: rotate(-1.4deg);
    }
    .post-card-title {
        letter-spacing: -0.018em;
        text-wrap: balance;
        overflow-wrap: anywhere;
        padding-right: 3.25rem;
        /* a highlighter stroke that hugs every line of the title */
        text-decoration-line: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 0.15em;
        text-underline-offset: 0.16em;
        transition: text-decoration-color 460ms ease, text-decoration-thickness 460ms ease;
    }
    .post-card-title::before {
        content: "✦";
        display: inline-block;
        margin-right: 0.3rem;
        color: color-mix(in srgb, var(--primary) 72%, white);
        font-size: 0.52rem;
        vertical-align: 0.26em;
        transform: rotate(-8deg);
    }
    .post-card-title-tail {
        white-space: nowrap;
    }
    .post-card-mobile-arrow {
        display: inline-block;
        width: 1em;
        height: 1em;
        margin-left: 0.12em;
        vertical-align: -0.1em;
    }
    .post-card-desktop-arrow {
        display: none;
    }
    .post-card-desc {
        margin-bottom: 0.9rem;
    }

    /* ---------------- footer ---------------- */
    .post-card-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        margin-top: auto;
        padding-top: 0.7rem;
        border-top: 1px dashed color-mix(in srgb, var(--primary) 15%, transparent);
    }
    .post-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        min-width: 0;
    }
    .post-card-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.1rem;
        padding: 0.1rem 0.5rem 0.14rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 22%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 6%, transparent);
        color: color-mix(in srgb, var(--primary) 58%, var(--text-body));
        font-size: 0.68rem;
        font-weight: 600;
        line-height: 1.5;
        transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), background 220ms ease, border-color 220ms ease, color 220ms ease;
    }
    .post-card-tag span {
        opacity: 0.55;
        font-weight: 700;
    }
    .post-card-tag--empty {
        border-style: dotted;
        color: var(--text-muted);
        background: none;
    }
    .post-card-reading {
        margin-left: auto;
        white-space: nowrap;
    }
    .post-card-reading > div:first-child::before {
        content: "⌁";
        display: inline;
        margin-right: 0.25rem;
        color: color-mix(in srgb, var(--primary) 58%, transparent);
    }

    /* ---------------- stickers ---------------- */
    .post-card-sticker {
        position: absolute;
        z-index: 20;
        display: grid;
        place-items: center;
        width: max-content;
        color: color-mix(in srgb, var(--primary) 76%, white);
        pointer-events: none;
        user-select: none;
    }
    .sticker-ribbon {
        top: 0.75rem;
        right: 1.05rem;
        width: 2rem;
        height: 1.65rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 28%, transparent);
        border-radius: 0.72rem 0.95rem 0.68rem 0.92rem;
        background: color-mix(in srgb, var(--glass-card) 82%, var(--primary) 12%);
        box-shadow: 0 0.3rem 0.8rem color-mix(in srgb, var(--primary) 10%, transparent);
        font-size: 0.78rem;
        font-weight: 800;
        transform: rotate(7deg);
    }
    .sticker-flower {
        display: none;
        top: 0.7rem;
        right: 1.1rem;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: color-mix(in srgb, var(--glass-card) 78%, var(--primary) 10%);
        box-shadow: 0 0.3rem 0.8rem color-mix(in srgb, var(--primary) 10%, transparent);
        font-size: 1rem;
        transform: rotate(-8deg);
    }
    .is-pinned .sticker-ribbon {
        right: 3.15rem;
    }
    .sticker-sparkles {
        left: 0.52rem;
        top: 48%;
        font-size: 0.68rem;
        letter-spacing: -0.08em;
        opacity: 0.54;
        transform: rotate(-13deg);
    }
    .sticker-note {
        right: auto;
        left: calc(100% - 7rem);
        top: calc(100% - 1.05rem);
        width: 4.7rem;
        padding: 0.12rem 0.42rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--glass-card) 72%, transparent);
        color: color-mix(in srgb, var(--primary) 38%, var(--text-color) 35%);
        font-size: 0.56rem;
        line-height: 1.2;
        letter-spacing: 0.01em;
        opacity: 0.72;
        transform: rotate(-3deg);
    }
    :global(.post-list > :nth-child(3n + 2)) .sticker-ribbon {
        border-radius: 0.95rem 0.65rem 0.92rem 0.7rem;
        transform: rotate(-6deg);
    }
    :global(.post-list > :nth-child(3n + 2)) .sticker-sparkles {
        top: 35%;
        transform: rotate(10deg);
    }
    :global(.post-list > :nth-child(3n + 2)) .sticker-note {
        transform: rotate(2.5deg);
    }
    :global(.post-list > :nth-child(3n)) .sticker-ribbon {
        display: none;
    }
    :global(.post-list > :nth-child(3n)) .sticker-flower {
        display: grid;
    }
    :global(.post-list > :nth-child(3n)) .sticker-sparkles {
        left: 0.62rem;
        top: 58%;
    }
    /* each entry gets its own stationery rhythm */
    :global(.post-list > :nth-child(2n)) .post-card-stamp {
        transform: rotate(1.3deg);
    }
    :global(.post-list > :nth-child(3n)) .post-card-stamp {
        border-radius: 0.8rem 0.95rem 0.78rem 0.92rem;
        transform: rotate(-0.6deg);
    }
    :global(.post-list > :nth-child(2n)) .post-card-rail {
        border-left-style: dotted;
    }

    /* pinned entry reads as the cover page of the notebook */
    .is-pinned {
        border-color: color-mix(in srgb, var(--primary) 26%, var(--glass-border));
        background:
            linear-gradient(138deg, rgb(255 255 255 / 0.42), transparent 44%),
            color-mix(in srgb, var(--glass-card) 90%, var(--primary) 6%);
    }
    .is-pinned::before {
        width: 4.6rem;
        background:
            repeating-linear-gradient(118deg, rgb(255 255 255 / 0.24) 0 0.3rem, transparent 0.3rem 0.58rem),
            linear-gradient(90deg, color-mix(in srgb, var(--primary) 72%, transparent), color-mix(in srgb, var(--primary) 30%, transparent));
    }
    .is-pinned .post-card-stamp {
        border-style: solid;
        border-color: color-mix(in srgb, var(--primary) 30%, transparent);
        background:
            linear-gradient(158deg, color-mix(in srgb, var(--primary) 88%, white), color-mix(in srgb, var(--primary) 68%, white));
        box-shadow: 0 0.4rem 1rem color-mix(in srgb, var(--primary) 22%, transparent);
    }
    .is-pinned .stamp-month,
    .is-pinned .stamp-meta {
        color: rgb(255 255 255 / 0.86);
    }
    .is-pinned .stamp-day {
        color: #fff;
    }

    /* ---------------- dark mode ---------------- */
    :global(.dark) .post-card {
        border-color: color-mix(in srgb, var(--primary) 17%, var(--glass-border));
        background:
            linear-gradient(138deg, rgb(255 255 255 / 0.035), transparent 45%),
            color-mix(in srgb, var(--glass-card) 96%, var(--primary) 3%);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07), 0 0.8rem 2rem rgb(0 0 0 / 0.16) !important;
    }
    :global(.dark) .post-card-tint {
        background:
            radial-gradient(120% 130% at 0% 0%, color-mix(in srgb, var(--primary) 20%, transparent), transparent 62%),
            linear-gradient(180deg, color-mix(in srgb, var(--primary) 7%, transparent), transparent 70%);
    }
    :global(.dark) .post-card-stamp {
        background:
            linear-gradient(158deg, color-mix(in srgb, var(--primary) 14%, transparent), transparent 74%),
            color-mix(in srgb, var(--glass-card) 82%, transparent);
        border-color: color-mix(in srgb, var(--primary) 34%, transparent);
    }
    :global(.dark) .post-card-tag {
        border-color: color-mix(in srgb, var(--primary) 26%, transparent);
        background: color-mix(in srgb, var(--primary) 9%, transparent);
        color: color-mix(in srgb, var(--primary) 52%, var(--text-body));
    }
    :global(.dark) .post-card-foot {
        border-top-color: color-mix(in srgb, var(--primary) 18%, transparent);
    }
    :global(.dark) .post-card-rail {
        border-left-color: color-mix(in srgb, var(--primary) 22%, transparent);
    }
    :global(.dark) .is-pinned {
        border-color: color-mix(in srgb, var(--primary) 30%, var(--glass-border));
        background:
            linear-gradient(138deg, rgb(255 255 255 / 0.05), transparent 46%),
            color-mix(in srgb, var(--glass-card) 92%, var(--primary) 8%);
    }
    :global(.dark) .sticker-ribbon {
        border-color: color-mix(in srgb, var(--primary) 32%, transparent);
        background: color-mix(in srgb, var(--glass-card) 88%, var(--primary) 9%);
        box-shadow: 0 0.35rem 0.9rem rgb(0 0 0 / 0.16);
    }
    :global(.dark) .sticker-flower {
        background: color-mix(in srgb, var(--glass-card) 88%, var(--primary) 8%);
        box-shadow: 0 0.35rem 0.9rem rgb(0 0 0 / 0.16);
    }
    :global(.dark) .sticker-note {
        background: color-mix(in srgb, var(--glass-card) 85%, transparent);
        color: color-mix(in srgb, var(--primary) 45%, white 35%);
    }

    /* ---------------- desktop ---------------- */
    @media (min-width: 48rem) {
        .post-card-mobile-arrow { display: none; }
        .post-card-desktop-arrow {
            display: inline-block;
            width: 1.05em;
            height: 1.05em;
            margin-left: 0.1em;
            vertical-align: -0.12em;
            opacity: 0;
            transform: translateX(-0.28em);
            transition: opacity 180ms ease, transform 180ms ease;
        }
        .post-card-title:hover .post-card-desktop-arrow {
            opacity: 1;
            transform: translateX(0);
        }
        .post-card::before { left: 2.2rem; width: 3.8rem; height: 0.42rem; }
        .post-card::after { right: 1rem; bottom: 0.7rem; font-size: 0.85rem; }
        .post-card-title::before { margin-right: 0.5rem; font-size: 0.72rem; }
        .post-card-reading > div:first-child::before { margin-right: 0.35rem; }
        .sticker-ribbon { top: 0.95rem; right: 1.3rem; width: 2.35rem; height: 1.9rem; font-size: 0.9rem; }
        .sticker-flower { top: 0.85rem; right: 1.35rem; width: 2.25rem; height: 2.25rem; font-size: 1.08rem; }
        .is-pinned .sticker-ribbon { right: 3.7rem; }
        .sticker-sparkles { left: 0.8rem; font-size: 0.82rem; }
        .sticker-note { left: calc(100% - 8.3rem); top: calc(100% - 1.3rem); width: 5.3rem; font-size: 0.64rem; }
        .post-card-stamp { width: 4.9rem; padding: 0.75rem 0.3rem 0.62rem; }
