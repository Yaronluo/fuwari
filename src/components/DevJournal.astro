	<footer class="dev-footer-note">
		<span>每一次 build 成功，都值得当成一个小小的节日 ✧</span>
		<span>还在学习，也还在继续创造。♡</span>
	</footer>
</section>

<script>
	type Contribution = { date: string; count: number; level: number };
	type ContributionResponse = { total: Record<string, number>; contributions: Contribution[] };

	const MOTION_QUERY = "(prefers-reduced-motion: reduce)";
	const prefersReducedMotion = () => window.matchMedia(MOTION_QUERY).matches;

	function countUp(element: HTMLElement, target: number, format?: (value: number) => string) {
		const render = format ?? ((value: number) => new Intl.NumberFormat("zh-CN").format(value));
		if (prefersReducedMotion()) {
			element.textContent = render(target);
			return;
		}

		const duration = 900;
		const started = performance.now();
		element.textContent = render(0);

		const tick = (now: number) => {
			const progress = Math.min(1, (now - started) / duration);
			const eased = 1 - (1 - progress) ** 3;
			element.textContent = render(Math.round(target * eased));
			if (progress < 1) requestAnimationFrame(tick);
			else element.textContent = render(target);
		};
		requestAnimationFrame(tick);
	}

	function initDevJournalMotion() {
		const journal = document.querySelector<HTMLElement>(".dev-journal");
		if (!journal || journal.dataset.motionReady === "true") return;
		journal.dataset.motionReady = "true";

		const reduced = prefersReducedMotion();
		const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
		const revealTargets = Array.from(journal.querySelectorAll<HTMLElement>("[data-reveal]"));
		const countScopes = Array.from(journal.querySelectorAll<HTMLElement>("[data-count-scope]"));

		const runCounters = (scope: HTMLElement) => {
			if (scope.dataset.counted === "true") return;
			scope.dataset.counted = "true";
			scope.querySelectorAll<HTMLElement>("[data-count-to]").forEach((node) => {
				countUp(node, Number(node.dataset.countTo || 0));
			});
		};

		// Entrance reveal -------------------------------------------------
		try {
			if (reduced || !("IntersectionObserver" in window)) {
				revealTargets.forEach((element) => element.classList.add("is-in"));
				countScopes.forEach(runCounters);
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const element = entry.target as HTMLElement;
							element.classList.add("is-in");
							if (element.dataset.countScope !== undefined) runCounters(element);
							observer.unobserve(element);
						});
					},
					{ rootMargin: "0px 0px -6% 0px", threshold: 0.12 },
				);
				revealTargets.forEach((element) => observer.observe(element));
				countScopes.forEach((element) => observer.observe(element));
			}
		} catch (error) {
			console.error(error);
			revealTargets.forEach((element) => element.classList.add("is-in"));
			countScopes.forEach(runCounters);
		}

		// Pointer spotlight + parallax ------------------------------------
		if (!reduced && finePointer) {
			journal.querySelectorAll<HTMLElement>(".tech-card, .project-card").forEach((card) => {
				card.addEventListener("pointermove", (event) => {
					const rect = card.getBoundingClientRect();
					if (!rect.width || !rect.height) return;
					card.style.setProperty("--mx", `${(((event.clientX - rect.left) / rect.width) * 100).toFixed(2)}%`);
					card.style.setProperty("--my", `${(((event.clientY - rect.top) / rect.height) * 100).toFixed(2)}%`);
					card.classList.add("is-pointing");
				});
				card.addEventListener("pointerleave", () => {
					card.classList.remove("is-pointing");
					card.style.removeProperty("--mx");
					card.style.removeProperty("--my");
				});
			});

			const layers = Array.from(journal.querySelectorAll<HTMLElement>("[data-parallax]"));
			if (layers.length) {
				let frame = 0;
				const update = () => {
					frame = 0;
					const rect = journal.getBoundingClientRect();
					const progress = (rect.top + rect.height / 2 - window.innerHeight / 2) / Math.max(1, window.innerHeight);
					layers.forEach((layer) => {
						const depth = Number(layer.dataset.parallax || 1);
						layer.style.transform = `translate3d(0, ${(-progress * depth * 26).toFixed(2)}px, 0)`;
					});
				};
				const request = () => {
					if (!frame) frame = requestAnimationFrame(update);
				};
				window.addEventListener("scroll", request, { passive: true });
				window.addEventListener("resize", request, { passive: true });
				update();
			}
		}

		// Console typing ---------------------------------------------------
		const consoleText = document.getElementById("dev-console-text");
		const consoleLine = 'const dream = "做出真正属于自己的作品";';
		if (consoleText) {
			if (reduced) {
				consoleText.textContent = consoleLine;
			} else {
				let index = 0;
				const type = () => {
					if (!consoleText.isConnected) return;
					consoleText.textContent = consoleLine.slice(0, index);
					index += 1;
					if (index <= consoleLine.length) window.setTimeout(type, 52);
				};
				window.setTimeout(type, 520);
			}
		}

		// Tech list scroll affordance --------------------------------------
		journal.querySelectorAll<HTMLElement>(".tech-list-wrap").forEach((wrap) => {
			const list = wrap.querySelector<HTMLElement>(".tech-list");
			if (!list) return;
			const sync = () => {
				const atEnd = list.scrollTop + list.clientHeight >= list.scrollHeight - 2;
				wrap.classList.toggle("is-at-end", atEnd || list.scrollHeight <= list.clientHeight + 2);
			};
			list.addEventListener("scroll", sync, { passive: true });
			window.addEventListener("resize", sync, { passive: true });
			sync();
		});
	}

	async function initDevJournal() {
		initDevJournalMotion();

		const journal = document.querySelector<HTMLElement>(".dev-journal");
		const grid = document.getElementById("contribution-grid");
		const months = document.getElementById("contribution-months");
		const total = document.getElementById("contribution-total");
		const status = document.getElementById("contribution-status");
		const detail = document.getElementById("contribution-detail");
		const detailLevel = document.getElementById("contribution-detail-level");
		const detailDate = document.getElementById("contribution-detail-date");
		const detailCount = document.getElementById("contribution-detail-count");
		const activeDays = document.getElementById("contribution-active");
		const streakNode = document.getElementById("contribution-streak");
		const busiestNode = document.getElementById("contribution-busiest");
		if (
			!journal || !grid || !months || !total || !status || !detail || !detailLevel ||
			!detailDate || !detailCount || !activeDays || !streakNode || !busiestNode ||
			journal.dataset.contributionsReady === "true"
		) return;

		journal.dataset.contributionsReady = "true";

		// The cascade wave only plays when the calendar actually becomes visible.
		if (prefersReducedMotion()) {
			grid.classList.add("is-cascading");
		} else if ("IntersectionObserver" in window) {
			const cascadeObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						grid.classList.add("is-cascading");
						cascadeObserver.disconnect();
					});
				},
				{ threshold: 0.15 },
			);
			cascadeObserver.observe(grid);
		} else {
			grid.classList.add("is-cascading");
		}

		try {
			const response = await fetch("https://github-contributions-api.jogruber.de/v4/Yaronluo?y=last");
			if (!response.ok) throw new Error(`GitHub contributions: ${response.status}`);
			const data = await response.json() as ContributionResponse;
			const contributions = data.contributions || [];
			const firstDay = contributions[0] ? new Date(`${contributions[0].date}T00:00:00`).getDay() : 0;
			const fragment = document.createDocumentFragment();
			const monthFragment = document.createDocumentFragment();
			const monthLabels: Array<{ label: string; column: number }> = [];
			let previousMonth = -1;

			contributions.forEach((day, index) => {
				const cell = document.createElement("button");
				const offset = index + firstDay;
				const date = new Date(`${day.date}T00:00:00`);
				const month = date.getMonth();
				const column = Math.floor(offset / 7) + 1;
				const row = (offset % 7) + 1;
				cell.type = "button";
				cell.className = "contribution-cell";
				cell.dataset.level = String(Math.max(0, Math.min(4, day.level || 0)));
				cell.dataset.date = day.date;
				cell.dataset.count = String(day.count || 0);
				cell.style.gridColumn = String(column);
				cell.style.gridRow = String(row);
				cell.style.setProperty("--dj-col", String(column));
				cell.style.setProperty("--dj-row", String(row));
				cell.title = `${day.date} · ${day.count} 次贡献`;
				cell.setAttribute("aria-label", cell.title);
				cell.setAttribute("aria-pressed", "false");
				fragment.appendChild(cell);

				if (month !== previousMonth) {
					monthLabels.push({
						label: `${month + 1}月`,
						column,
					});
					previousMonth = month;
				}
			});

			if (monthLabels.length > 1 && monthLabels[1].column - monthLabels[0].column < 3) {
				monthLabels.shift();
			}
			monthLabels.forEach(({ label, column }) => {
				const monthLabel = document.createElement("span");
				monthLabel.textContent = label;
				monthLabel.style.gridColumn = `${column} / span 4`;
				monthFragment.appendChild(monthLabel);
			});

			grid.replaceChildren(fragment);
			months.replaceChildren(monthFragment);
			grid.addEventListener("click", (event) => {
				const target = event.target instanceof Element
					? event.target.closest<HTMLButtonElement>(".contribution-cell")
					: null;
				if (!target || !grid.contains(target)) return;

				grid.querySelectorAll<HTMLButtonElement>(".contribution-cell.is-selected").forEach((cell) => {
					cell.classList.remove("is-selected");
					cell.setAttribute("aria-pressed", "false");
				});
				target.classList.add("is-selected");
				target.setAttribute("aria-pressed", "true");

				const date = new Date(`${target.dataset.date}T00:00:00`);
				detailDate.textContent = new Intl.DateTimeFormat("zh-CN", {
					year: "numeric",
					month: "long",
					day: "numeric",
					weekday: "short",
				}).format(date);
				const count = Number(target.dataset.count || 0);
				detailCount.textContent = count > 0 ? `${count} 次贡献` : "没有贡献";
				detailLevel.dataset.level = target.dataset.level || "0";
				detail.hidden = false;
			});

			// Year in review -------------------------------------------------
			let active = 0;
			let running = 0;
			let longest = 0;
			let busiest = contributions[0] ?? null;

			contributions.forEach((day) => {
				const count = Number(day.count || 0);
				if (count > 0) {
					active += 1;
					running += 1;
					longest = Math.max(longest, running);
				} else {
					running = 0;
				}
				if (busiest && count > Number(busiest.count || 0)) busiest = day;
			});

			const totalCount = Object.values(data.total || {}).reduce((sum, value) => sum + Number(value || 0), 0);
			countUp(total, totalCount);
			countUp(activeDays, active, (value) => `${value} 天`);
			countUp(streakNode, longest, (value) => `${value} 天`);
			if (busiest) {
				const date = new Date(`${busiest.date}T00:00:00`);
				busiestNode.textContent = `${date.getMonth() + 1}/${date.getDate()}`;
				busiestNode.title = `${busiest.date} · ${busiest.count} 次贡献`;
			} else {
				busiestNode.textContent = "—";
			}

			status.textContent = "贡献日历已更新";
			status.classList.add("is-ready");
		} catch (error) {
			console.error(error);
			journal.dataset.contributionsReady = "error";
			total.textContent = "—";
			[activeDays, streakNode, busiestNode].forEach((node) => {
				node.textContent = "—";
			});
			status.textContent = "贡献日历暂时在偷懒，稍后再来看看吧 (｡•́︿•̀｡)";
			status.classList.add("is-error");
		}
	}

	const devWindow = window as Window & { __devJournalHookRegistered?: boolean };
	initDevJournal();
	const setupDevJournalHooks = () => {
		if (devWindow.__devJournalHookRegistered) return;
		devWindow.__devJournalHookRegistered = true;
		window.swup.hooks.on("page:view", initDevJournal);
	};
	if (window.swup) setupDevJournalHooks();
	else document.addEventListener("swup:enable", setupDevJournalHooks, { once: true });
</script>

