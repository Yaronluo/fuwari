---
import { Icon } from "astro-icon/components";
import ImageWrapper from "../misc/ImageWrapper.astro";
import "../../styles/anime-article.css";

interface AnimeData {
	theme: "weathering-with-you" | "k-on";
	titleJa: string;
	titleEn?: string;
	year: string;
	director: string;
	music: string;
	firstWatch?: string;
	rewatch?: string;
	rating?: string;
	spoiler?: boolean;
	cover: string;
	quote?: string;
}

interface Props {
	anime: AnimeData;
	title: string;
	description: string;
	published: Date;
	words: number;
	minutes: number;
	basePath: string;
}

const { anime, title, description, published, words, minutes, basePath } =
	Astro.props;
const isKOn = anime.theme === "k-on";
const publishedLabel = published.toLocaleDateString("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});

const facts = [
	{
		icon: "material-symbols:person-outline-rounded",
		label: "导演",
		value: anime.director,
	},
	{
		icon: "material-symbols:music-note-rounded",
		label: "音乐",
		value: anime.music,
	},
	{
		icon: "material-symbols:favorite-outline-rounded",
		label: "感受",
		value: anime.rating,
	},
].filter((item) => item.value);

const timeline = [
	{ label: "上映", date: anime.year },
	{ label: "初看", date: anime.firstWatch },
	{ label: "重温", date: anime.rewatch },
].filter((item) => item.date);

const sealSource = anime.rating ?? (isKOn ? "軽音" : "晴れ");
const sealChars = Array.from(sealSource).slice(0, 4);

const archiveKicker = isKOn ? "AFTER SCHOOL RECORD 01" : "WEATHER ARCHIVE 01";
const archiveStatus = isKOn ? "HTT ON AIR" : "WEATHER LINKED";

/* 「金句」——写给《作品》 的主副标题拆行 */
const [titleLead, titleTail] = title.split(/——+/) as [string, string?];
const choiceLabel = isKOn ? "LAST SONG" : "MY CHOICE";
const archiveCode = isKOn ? "HTT-2009-0402" : "WX-2019-0719";

const sparks = [
	{ x: 14, y: 62, d: 0, s: 0.7 },
	{ x: 26, y: 34, d: 1.6, s: 1 },
	{ x: 38, y: 74, d: 3.1, s: 0.6 },
	{ x: 52, y: 22, d: 2.2, s: 0.9 },
	{ x: 63, y: 58, d: 4.4, s: 0.7 },
	{ x: 74, y: 30, d: 1.1, s: 1.1 },
	{ x: 86, y: 68, d: 3.6, s: 0.8 },
	{ x: 92, y: 18, d: 5.2, s: 0.65 },
];
---

<section class="anime-hero" aria-label={`${anime.titleJa}观后感封面`}>
	<div class="anime-hero__media" aria-hidden="true">
		<div class="anime-hero__backdrop">
			<ImageWrapper
				class="anime-hero__backdrop-image"
				src={anime.cover}
				basePath={basePath}
				position="center"
				alt=""
			/>
		</div>
		<ImageWrapper
			class="anime-hero__image"
			src={anime.cover}
			basePath={basePath}
			position={isKOn ? "50% 26%" : "62% 34%"}
			alt={`${anime.titleJa}封面`}
		/>
		<div class="anime-hero__rays"></div>
		<div class="anime-hero__weather"></div>
		<div class="anime-hero__grain"></div>
		<div class="anime-hero__shade"></div>
		<div class="anime-hero__frame"></div>
		<div class="anime-hero__sparks">
			{sparks.map((spark) => (
				<i style={`--x:${spark.x}%;--y:${spark.y}%;--d:${spark.d}s;--s:${spark.s}`}></i>
			))}
		</div>
	</div>

	<div class="anime-hero__rail" aria-hidden="true">
		<span class="anime-hero__rail-ja">{anime.titleJa}</span>
		<span class="anime-hero__rail-line"></span>
		<span class="anime-hero__rail-en">{anime.titleEn ?? "ANIME"}</span>
	</div>

	<div class="anime-hero__content">
		<div class="anime-hero__badges">
			<span class="anime-hero__badge anime-hero__badge--primary">
				<i class="anime-hero__badge-dot" aria-hidden="true"></i>
				ANIME ESSAY · 番剧观后感
			</span>
			{anime.spoiler && <span class="anime-hero__badge">含结局剧透</span>}
		</div>

		<div class="anime-hero__eyebrow">
			<span class="anime-hero__eyebrow-rule" aria-hidden="true"></span>
			<span>{anime.titleJa}</span>
			{anime.titleEn && <span class="anime-hero__eyebrow-sep" aria-hidden="true">/</span>}
			{anime.titleEn && <span>{anime.titleEn}</span>}
		</div>

		<h1 class="anime-hero__title" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">
			{titleTail ? (
				<>
					<span class="anime-hero__title-lead">{titleLead}</span>
					<span class="anime-hero__title-tail">——{titleTail}</span>
				</>
			) : (
				title
			)}
		</h1>
		<p class="anime-hero__description">{description}</p>

		<div class="anime-hero__reading-meta" aria-label="文章信息">
			<span><Icon name="material-symbols:calendar-month-outline-rounded" />{publishedLabel}</span>
			<span><Icon name="material-symbols:notes-rounded" />{words} 字</span>
			<span><Icon name="material-symbols:schedule-outline-rounded" />{minutes} 分钟</span>
		</div>
	</div>

	<figure class="anime-hero__plate">
		<ImageWrapper
			class="anime-hero__plate-photo"
			src={anime.cover}
			basePath={basePath}
			position={isKOn ? "50% 42%" : "66% 40%"}
			alt=""
		/>
		<figcaption class="anime-hero__plate-caption">
			<span>{anime.titleJa}</span>
			<em>{anime.year}</em>
		</figcaption>
		<div class="anime-hero__seal" aria-label={`观后感标记：${sealSource}`}>
			<span class="anime-hero__seal-text">
				{sealChars.map((char) => <i>{char}</i>)}
			</span>
			<span class="anime-hero__seal-sub" aria-hidden="true">{isKOn ? "REPLAY" : "REWATCH"}</span>
		</div>
	</figure>
</section>

<section class="anime-dossier" aria-label={`${anime.titleJa}作品档案`}>
	<header class="anime-dossier__head">
		<div class="anime-dossier__titleblock">
			<span class="anime-dossier__kicker"><span aria-hidden="true">✦</span>{archiveKicker}</span>
			<h2>作品档案</h2>
		</div>
		<div class="anime-dossier__headmeta">
			<span class="anime-dossier__barcode" aria-hidden="true"></span>
			<span class="anime-dossier__code" aria-hidden="true">{archiveCode}</span>
			<span class="anime-dossier__status"><i aria-hidden="true"></i>{archiveStatus}</span>
		</div>
	</header>

	<div class="anime-dossier__body">
		<ol class="anime-timeline" aria-label="观看时间线">
			{timeline.map((step, index) => (
				<li class:list={["anime-timeline__item", { "is-current": index === timeline.length - 1 }]}>
					<span class="anime-timeline__dot" aria-hidden="true"></span>
					<span class="anime-timeline__label">{step.label}</span>
					<span class="anime-timeline__date">{step.date}</span>
				</li>
			))}
		</ol>

		<dl class="anime-dossier__facts">
			{facts.map((fact) => (
				<div class="anime-fact">
					<dt>
						<span class="anime-fact__icon" aria-hidden="true"><Icon name={fact.icon} /></span>
						{fact.label}
					</dt>
					<dd>{fact.value}</dd>
				</div>
			))}
		</dl>
	</div>

	{anime.quote && (
		<blockquote class="anime-dossier__quote">
			<span class="anime-dossier__quote-mark" aria-hidden="true">“</span>
			<div class="anime-dossier__quote-body">
				<span class="anime-dossier__quote-label">{choiceLabel}</span>
				<p>{anime.quote}</p>
			</div>
			<span class="anime-dossier__quote-seal" aria-hidden="true">{anime.titleJa}</span>
		</blockquote>
	)}
</section>

<script>
type AnimeWindow = Window & { __animeArticleExperienceBound?: boolean };

const animeWindow = window as AnimeWindow;

const weatherSectionPresets = [
	{ match: "前言", icon: "☂", mood: "rain" },
	{ match: "爱能做到", icon: "✦", mood: "drizzle" },
	{ match: "比起晴天", icon: "☀", mood: "sun" },
	{ match: "她为所有人", icon: "☁", mood: "cloud" },
	{ match: "两次枪声", icon: "ϟ", mood: "storm" },
	{ match: "没有阳菜", icon: "☔", mood: "clear" },
	{ match: "爱没有拯救", icon: "✧", mood: "sky" },
	{ match: "阳菜不欠", icon: "☀", mood: "dawn" },
	{ match: "最後", icon: "☼", mood: "dawn" },
];

const kOnSectionPresets = [
	{ match: "前言", icon: "♩", mood: "intro" },
	{ match: "平泽唯", icon: "♪", mood: "yui" },
	{ match: "看似什么", icon: "☕", mood: "tea" },
	{ match: "请不要毕业", icon: "🌸", mood: "graduation" },
	{ match: "ふわふわ時間", icon: "♫", mood: "fuwafuwa" },
	{ match: "放学后 Tea Time", icon: "♬", mood: "band" },
	{ match: "活动室", icon: "♭", mood: "memory" },
	{ match: "最後", icon: "♥", mood: "memory" },
];

const prepareAnimeArticle = (): HTMLElement | null => {
	const card = document.querySelector<HTMLElement>(".anime-theme");
	if (!card) return null;
	const sectionPresets = card.classList.contains("anime-theme--k-on")
		? kOnSectionPresets
		: weatherSectionPresets;

	const headings = card.querySelectorAll<HTMLElement>(".markdown-content h1");
	for (const heading of headings) {
		const preset = sectionPresets.find((item) => heading.textContent?.includes(item.match));
		heading.dataset.animeIcon = preset?.icon ?? "✦";
		heading.dataset.animeMood = preset?.mood ?? "drizzle";
	}
	return card;
};

let revealObserver: IntersectionObserver | null = null;
let revealTimer = 0;

const setupAnimeReveal = (card: HTMLElement) => {
	revealObserver?.disconnect();
	window.clearTimeout(revealTimer);

	const targets = [
		...card.querySelectorAll<HTMLElement>(
			".anime-dossier, .anime-fin, .markdown-content h1, .markdown-content h2, .markdown-content p:has(> strong:only-child), .markdown-content p:has(> img:only-child), .markdown-content > section > ul, .markdown-content > section > blockquote",
		),
	];

	if (!("IntersectionObserver" in window)) {
		targets.forEach((element) => element.classList.add("anime-reveal", "is-inview"));
		return;
	}

	const viewport = window.innerHeight;
	targets.forEach((element, index) => {
		element.style.setProperty("--reveal-delay", `${(index % 5) * 55}ms`);
		// 首屏内容直接展示，避免加载时的闪动
		if (element.getBoundingClientRect().top < viewport * 0.94) {
			element.classList.add("anime-reveal", "is-inview");
			return;
		}
		element.classList.add("anime-reveal");
	});

	revealObserver = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add("is-inview");
				revealObserver?.unobserve(entry.target);
			}
		},
		{ rootMargin: "0px 0px -6% 0px", threshold: 0.04 },
	);

	targets
		.filter((element) => !element.classList.contains("is-inview"))
		.forEach((element) => revealObserver?.observe(element));

	// 兜底：无论如何都在 5 秒内让内容可见
	revealTimer = window.setTimeout(() => {
		targets.forEach((element) => element.classList.add("is-inview"));
	}, 5000);
};

let animeFrame = 0;
const updateAnimeMood = () => {
	if (animeFrame) return;
	animeFrame = window.requestAnimationFrame(() => {
		animeFrame = 0;
		const card = document.querySelector<HTMLElement>(".anime-theme");
		if (!card) return;

		const headings = [...card.querySelectorAll<HTMLElement>(".markdown-content h1")];
		let active = headings[0];
		const threshold = window.innerHeight * 0.4;
		for (const heading of headings) {
			if (heading.getBoundingClientRect().top <= threshold) active = heading;
		}
		card.dataset.animeMood = active?.dataset.animeMood ?? (card.classList.contains("anime-theme--k-on") ? "intro" : "rain");

		const hero = card.querySelector<HTMLElement>(".anime-hero");
		if (hero) {
			const rect = hero.getBoundingClientRect();
			if (rect.bottom > -80 && rect.top < window.innerHeight) {
				const shift = Math.max(-40, Math.min(80, -rect.top * 0.16));
				hero.style.setProperty("--anime-parallax", `${shift.toFixed(1)}px`);
			}
		}
	});
};

const setupAnimeArticle = () => {
	const card = prepareAnimeArticle();
	updateAnimeMood();
	if (card) setupAnimeReveal(card);
};

if (!animeWindow.__animeArticleExperienceBound) {
	animeWindow.__animeArticleExperienceBound = true;
	window.addEventListener("scroll", updateAnimeMood, { passive: true });
	window.addEventListener("resize", updateAnimeMood, { passive: true });

	if (window.swup) {
		window.swup.hooks.on("page:view", setupAnimeArticle);
	} else {
		document.addEventListener("swup:enable", () => {
			window.swup.hooks.on("page:view", setupAnimeArticle);
		}, { once: true });
	}
}

setupAnimeArticle();
</script>
