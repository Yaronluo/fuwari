---
// src/components/ArticleDescription.astro
export interface Props {
    description: string; // 文章描述内容
}

const { description } = Astro.props;

// 如果没有描述，则不渲染任何东西
if (!description || description.trim() === '') {
    return null;
}
---

<div class="article-description onload-animation">
    <!--
      🎯 性能与重排（Reflow）优化：
      服务端直接渲染完整的未打字文本（透明），确立完整布局高度，
      防止客户端打字时由于行数不断增加触发大篇幅文章的 Reflow（重排）导致页面闪烁与跳动。
    -->
    <div class="description-content" data-description={description}>
        <span class="typed-text"></span><span class="typing-cursor">|</span><span class="untyped-text" style="opacity: 0; pointer-events: none; user-select: none;">{description}</span>
    </div>
</div>

<script>
    function initTyping() {
        const descElements = document.querySelectorAll('.article-description .description-content');

        descElements.forEach((descElement: Element) => {
            // 如果已经初始化过，则跳过
            if (descElement.hasAttribute('data-typed')) {
                return;
            }

            // 标记为已初始化，防止重复执行
            descElement.setAttribute('data-typed', 'true');

            const text = descElement.getAttribute('data-description') || '';
            if (!text) return;

            const typedSpan = descElement.querySelector('.typed-text') as HTMLElement;
            const untypedSpan = descElement.querySelector('.untyped-text') as HTMLElement;
            const cursorSpan = descElement.querySelector('.typing-cursor') as HTMLElement;

            if (!typedSpan || !untypedSpan || !cursorSpan) return;

            let index = 0;
            const typeSpeed = 25;

			function typeWriter() {
				if (!descElement.isConnected) return;
				if (index <= text.length) {
                    typedSpan.textContent = text.slice(0, index);
                    untypedSpan.textContent = text.slice(index);
                    index++;
                    setTimeout(typeWriter, typeSpeed);
				} else {
					cursorSpan.style.display = 'none';
				}
            }

            function startTyping() {
                // 确保打字开始前，清空已打字部分，未打字部分保持完整以占位
                typedSpan.textContent = '';
                untypedSpan.textContent = text;
                typeWriter();
            }

            // 🎯 优化：等待载入/缩放动画结束后再开始打字，防止动画和打字同时进行导致视觉混乱
            const parent = descElement.closest('.article-description');
            
            // 安全机制：如果由于某种原因没有触发 animationend，设置 800ms 的兜底定时器
			const fallbackTimer = setTimeout(() => {
				parent?.removeEventListener('animationend', onAnimationEnd);
				if (descElement.isConnected) startTyping();
			}, 800);

			function onAnimationEnd(event: Event) {
				if (event.target !== parent) return;
				clearTimeout(fallbackTimer);
				startTyping();
            }

            const hasEnterAnimation = parent
                && parent.classList.contains('onload-animation')
                && getComputedStyle(parent).animationName !== 'none';

            if (hasEnterAnimation) {
                parent.addEventListener('animationend', onAnimationEnd, { once: true });
            } else {
                clearTimeout(fallbackTimer);
                startTyping();
            }
        });
    }

    // 首次加载时执行
    initTyping();

    // 🎯 关键修复：注册 Swup 钩子，确保页面切换后重新初始化打字机效果
	function setupSwupHooks() {
		if (window.swup?.hooks && !window.__fuwariArticleTypingHookRegistered) {
			window.__fuwariArticleTypingHookRegistered = true;
			window.swup.hooks.on('page:view', () => {
                // Swup 页面切换完成后重新初始化打字机
                initTyping();
            });
        }
    }

    if (window.swup) {
        setupSwupHooks();
	} else {
		document.addEventListener('swup:enable', setupSwupHooks, { once: true });
	}
</script>

<style>
    /* 使用 Fuwari 的全局变量来保持风格一致 */
    .article-description {
        --desc-text: var(--text-90);
        --desc-border: var(--line-divider);
        --desc-primary: var(--primary);
    }

    .article-description {
        margin: 1.5rem 0 2rem 0;
        padding: 0 0.5rem 1rem 0.5rem;
        background: transparent;
        border-bottom: 2px dashed var(--line-divider);
        position: relative;
    }
    :global(.dark) .article-description {
        background: transparent;
    }

    .description-content {
        color: var(--tw-prose-body);
        font-size: 1.05rem;
        line-height: 1.7;
        font-style: normal;
        font-weight: 400;
        min-height: 1.7em;
        opacity: 0.8;
    }
    :global(.dark) .description-content {
        color: color-mix(in srgb, var(--primary) 16%, rgb(247 239 235 / 0.84));
    }
    :global(html:not(.dark)) .description-content {
        color: rgba(0, 0, 0, 0.75);
    }

    /* 打字机光标效果 */
    .typing-cursor {
        color: var(--desc-primary);
        animation: blink-cursor 1s infinite;
        font-weight: bold;
        font-style: normal;
        margin: 0 1px;
        display: inline-block;
    }

    /* 光标闪烁动画 */
    @keyframes blink-cursor {
        0%, 50% {
            opacity: 1;
        }
        51%, 100% {
            opacity: 0;
        }
    }
</style>
