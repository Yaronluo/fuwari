			<ul class="tv-extremes">
				{extremes.map((extreme) => (
					<li>
						<span class="tv-extreme-tag">{extreme.tag}</span>
						<strong>{extreme.marker.name}</strong>
						<span class="tv-extreme-meta">{extreme.coordinate} · 离家 {extreme.marker.fromHome} km</span>
					</li>
				))}
			</ul>
		</div>

		<div class="tv-route-card">
			<div class="tv-route-head">
				<span>行程顺序</span>
				<small>每段为两点之间的直线距离</small>
			</div>
			<ol class="tv-route-stops">
				{markers.map((marker, index) => (
					<>
						{index > 0 ? (
							<li class="tv-route-seg" aria-hidden="true">
								<span>{marker.segmentFromPrevious}</span>
							</li>
						) : null}
						<li class="tv-route-stop">
							<i class:list={{ "is-home": marker.kind === "home" }}></i>
							<b>{marker.name}</b>
						</li>
					</>
				))}
			</ol>
		</div>
	</section>

	<!-- 03 · 想去的地方 -------------------------------------------------- -->
	<section class="tv-section tv-wish" id="tv-wishlist" aria-labelledby="tv-wish-title" data-reveal style="--d: 60ms">
		<header class="tv-section-head">
			<p class="tv-kicker"><span>03</span> WISHLIST · 想去</p>
