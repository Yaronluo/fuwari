---
import { Icon } from "astro-icon/components";
import type { FeatureCollection, Geometry, Position } from "geojson";
import provincesJson from "cn-atlas/provinces.json";
import { travelPlaces, travelWishlist } from "../data/travel-places";

/* ------------------------------------------------------------------ 投影 */

const MAP_WIDTH = 900;
const MAP_HEIGHT = 640;

type Bounds = { minLon: number; maxLon: number; minLat: number; maxLat: number };
type LonLat = [longitude: number, latitude: number];

const mercatorY = (latitude: number) =>
	Math.log(Math.tan(Math.PI / 4 + (latitude * Math.PI) / 360));

function createProjection(width: number, height: number, padding: number, bounds: Bounds) {
	const minY = mercatorY(bounds.minLat);
	const maxY = mercatorY(bounds.maxLat);
	const lonSpan = ((bounds.maxLon - bounds.minLon) * Math.PI) / 180;
	const mercSpan = maxY - minY;
	const scale = Math.min(
		(width - padding * 2) / lonSpan,
		(height - padding * 2) / mercSpan,
	);
	const contentWidth = lonSpan * scale;
	const contentHeight = mercSpan * scale;
	const offsetX = (width - contentWidth) / 2;
	const offsetY = (height - contentHeight) / 2;

	return {
		scale,
		contentWidth,
		contentHeight,
		offsetX,
		offsetY,
		project([longitude, latitude]: LonLat): [number, number] {
			return [
				offsetX + (((longitude - bounds.minLon) * Math.PI) / 180) * scale,
				offsetY + (maxY - mercatorY(latitude)) * scale,
			];
		},
	};
}

const mapProjection = createProjection(MAP_WIDTH, MAP_HEIGHT, 26, {
	minLon: 73.5,
	maxLon: 135.1,
	minLat: 17.5,
	maxLat: 53.6,
});

function ringToPath(ring: Position[], project: (p: LonLat) => [number, number]) {
	return `${ring
		.map((position, index) => {
			const [x, y] = project(position as LonLat);
			return `${index === 0 ? "M" : "L"}${x.toFixed(2)},${y.toFixed(2)}`;
		})
		.join("")}Z`;
}

function geometryToPath(
	geometry: Geometry,
	project: (p: LonLat) => [number, number],
) {
	if (geometry.type === "Polygon") {
		return geometry.coordinates.map((ring) => ringToPath(ring, project)).join("");
	}
	if (geometry.type === "MultiPolygon") {
		return geometry.coordinates
			.flatMap((polygon) => polygon.map((ring) => ringToPath(ring, project)))
			.join("");
	}
	return "";
}

/** 把任意 GeoJSON 几何体摊平成坐标点集合，用来量外接框。 */
function collectPositions(geometry: Geometry): Position[] {
	if (!("coordinates" in geometry)) return [];
	const positions: Position[] = [];
	const stack: unknown[] = [geometry.coordinates as unknown];
	while (stack.length > 0) {
		const value = stack.pop();
		if (!Array.isArray(value)) continue;
		if (typeof value[0] === "number") positions.push(value as Position);
		else stack.push(...value);
	}
	return positions;
}

/* -------------------------------------------------------------- 省份数据 */

const provinces = provincesJson as FeatureCollection<Geometry>;
const visitedProvinces = new Set(travelPlaces.map((place) => place.province));
const placesPerProvince = new Map<string, number>();
for (const place of travelPlaces) {
	placesPerProvince.set(place.province, (placesPerProvince.get(place.province) ?? 0) + 1);
}

const provinceName = (feature: (typeof provinces.features)[number]) => {
	const properties = feature.properties as { 地名?: string; name?: string } | null;
	return properties?.地名 || properties?.name || "未命名地点";
};

const provincePaths = provinces.features.map((feature) => {
	const name = provinceName(feature);
	const count = placesPerProvince.get(name) ?? 0;
	return {
		name,
		d: geometryToPath(feature.geometry, mapProjection.project),
		visited: visitedProvinces.has(name),
		label: count
			? `${name.replace(/(省|市)$/, "")} · 已点亮 ${count} 站`
			: `${name.replace(/(省|市|壮族自治区|回族自治区|维吾尔自治区|自治区|特别行政区)$/, "")} · 待点亮`,
	};
});

/** 省份名字写在手挑的位置上，避开东南角的脚印堆积。 */
const provinceLabels = [
	{ name: "湖南", x: 528, y: 487, visited: true },
	{ name: "江西", x: 611, y: 466, visited: true },
	{ name: "福建", x: 638, y: 494, visited: true },
	{ name: "广东", x: 594, y: 565, visited: true },
	{ name: "湖北", x: 551, y: 402, visited: false },
	{ name: "浙江", x: 654, y: 447, visited: false },
	{ name: "台湾", x: 664, y: 530, visited: false },
	{ name: "广西", x: 504, y: 528, visited: false },
];

/* ---------------------------------------------------------------- 经纬网 */

const graticule: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let longitude = 80; longitude <= 130; longitude += 10) {
	const [x] = mapProjection.project([longitude, 30]);
	const [, y1] = mapProjection.project([longitude, 53.6]);
	const [, y2] = mapProjection.project([longitude, 17.5]);
	graticule.push({ x1: x, y1, x2: x, y2 });
}
for (let latitude = 20; latitude <= 50; latitude += 10) {
	const [x1, y] = mapProjection.project([73.5, latitude]);
	const [x2] = mapProjection.project([135.1, latitude]);
	graticule.push({ x1, y1: y, x2, y2: y });
}

/* ------------------------------------------------------------------ 行程 */

const EARTH_RADIUS = 6371;
const toRadians = (degrees: number) => (degrees * Math.PI) / 180;

function distanceKm(a: LonLat, b: LonLat) {
	const deltaLat = toRadians(b[1] - a[1]);
	const deltaLon = toRadians(b[0] - a[0]);
	const h =
		Math.sin(deltaLat / 2) ** 2 +
		Math.cos(toRadians(a[1])) * Math.cos(toRadians(b[1])) * Math.sin(deltaLon / 2) ** 2;
	return 2 * EARTH_RADIUS * Math.asin(Math.sqrt(h));
}

const home = travelPlaces.find((place) => place.kind === "home") ?? travelPlaces[0];

const markers = travelPlaces.map((place, index) => {
	const [x, y] = mapProjection.project(place.coordinates);
	const previous = travelPlaces[index - 1];
	const segmentFromPrevious = previous ? Math.round(distanceKm(previous.coordinates, place.coordinates)) : 0;
	const fromHome = Math.round(distanceKm(home.coordinates, place.coordinates));
	const offsetX = place.zoomLabelOffset?.[0] ?? 6;
	const offsetY = place.zoomLabelOffset?.[1] ?? 0;
	const angle = (Math.atan2(x - MAP_WIDTH / 2, MAP_HEIGHT / 2 - y) * 180) / Math.PI;
	const label = `${place.name} · ${place.province} · ${place.note ?? ""}${
		place.kind === "home" ? "" : ` · 离家 ${fromHome} km`
	}`;
	return {
		...place,
		index,
		x,
		y,
		label,
		angle,
		segmentFromPrevious,
		fromHome,
		offsetX,
		offsetY,
		anchor: place.zoomLabelAnchor ?? "start",
	};
});

const segments = markers.slice(1).map((marker) => ({
	from: travelPlaces[marker.index - 1].name,
	to: marker.name,
	km: marker.segmentFromPrevious,
}));
const totalKm = segments.reduce((sum, segment) => sum + segment.km, 0);

const cluster = {
	x: markers.reduce((sum, marker) => sum + marker.x, 0) / markers.length,
	y: markers.reduce((sum, marker) => sum + marker.y, 0) / markers.length,
};

const routePath = `M${markers
	.map((marker) => `${marker.x.toFixed(1)},${marker.y.toFixed(1)}`)
	.join("L")}`;

const extremes = [
	{ tag: "最北", marker: [...markers].sort((a, b) => b.coordinates[1] - a.coordinates[1])[0], value: (m: (typeof markers)[number]) => `${m.coordinates[1].toFixed(2)}°N` },
	{ tag: "最南", marker: [...markers].sort((a, b) => a.coordinates[1] - b.coordinates[1])[0], value: (m: (typeof markers)[number]) => `${m.coordinates[1].toFixed(2)}°N` },
	{ tag: "最东", marker: [...markers].sort((a, b) => b.coordinates[0] - a.coordinates[0])[0], value: (m: (typeof markers)[number]) => `${m.coordinates[0].toFixed(2)}°E` },
	{ tag: "最西", marker: [...markers].sort((a, b) => a.coordinates[0] - b.coordinates[0])[0], value: (m: (typeof markers)[number]) => `${m.coordinates[0].toFixed(2)}°E` },
].map((item) => ({ ...item, coordinate: item.value(item.marker) }));

const driveHours = (totalKm / 80).toFixed(1);
const remainingProvinces = provincePaths.length - visitedProvinces.size;

const longestSegment = segments.reduce((longest, segment) => (segment.km > longest.km ? segment : longest));
const averageSegment = Math.round(totalKm / Math.max(1, segments.length));
const farthestMarker = markers.reduce((far, marker) => (marker.fromHome > far.fromHome ? marker : far));

/* -------------------------------------------------------- 南海诸岛小图 */

const hainanFeature = provinces.features.find((feature) => provinceName(feature) === "海南省");
let insetBounds: Bounds = { minLon: 106, maxLon: 122, minLat: 2.5, maxLat: 23 };
if (hainanFeature) {
	let minLon = Number.POSITIVE_INFINITY;
	let maxLon = Number.NEGATIVE_INFINITY;
	let minLat = Number.POSITIVE_INFINITY;
	let maxLat = Number.NEGATIVE_INFINITY;
	const positions = collectPositions(hainanFeature.geometry);
	for (const position of positions) {
		const [longitude, latitude] = position as LonLat;
		minLon = Math.min(minLon, longitude);
		maxLon = Math.max(maxLon, longitude);
		minLat = Math.min(minLat, latitude);
		maxLat = Math.max(maxLat, latitude);
	}
	insetBounds = { minLon: minLon - 0.6, maxLon: maxLon + 0.6, minLat: minLat - 0.4, maxLat: maxLat + 0.4 };
}
const insetProjection = createProjection(92, 116, 4, insetBounds);
const hainanPath = hainanFeature
	? geometryToPath(hainanFeature.geometry, insetProjection.project)
	: "";

const visitedLabel = `${visitedProvinces.size} / ${provincePaths.length}`;
const wishlistDomestic = travelWishlist.filter((item) => item.region === "国内");
const wishlistOverseas = travelWishlist.filter((item) => item.region === "国外");
---

<script is:inline>
	/* 第一帧之前就把「准备入场」的状态挂在 <html> 上，避免内容先闪一下。 */
	(() => {
		const root = document.documentElement;
		root.classList.add("tv-boot", "tv-motion");
		const navigation = performance.getEntriesByType?.("navigation")?.[0];
		if (navigation && navigation.type === "reload") root.classList.add("tv-no-enter");
		window.setTimeout(() => {
			const page = document.querySelector(".tv-page");
			if (!page || page.dataset.tvArmed !== "true") root.classList.remove("tv-boot");
		}, 3200);
	})();
</script>

<section class="tv-page" aria-labelledby="travel-title" data-tv-root>
	<!-- 00 · 抬头 ------------------------------------------------------- -->
	<header class="tv-hero">
		<div class="tv-hero-copy">
			<p class="tv-eyebrow tv-enter" style="--d: 0ms">
				<Icon name="material-symbols:map-outline-rounded" />
				<span>TRAVEL FOOTPRINTS</span>
				<span class="tv-eyebrow-cn">旅行足迹册</span>
				<span class="tv-eyebrow-face" aria-hidden="true">₍ᐢ. ̫.ᐢ₎</span>
			</p>

			<h1 class="tv-title tv-enter" id="travel-title" style="--d: 70ms">
				把<span class="tv-title-mark">走过的路<svg
						class="tv-underline"
						viewBox="0 0 200 12"
						preserveAspectRatio="none"
						aria-hidden="true"
					><path d="M2 8.4C34 3.6 70 3.2 101 5.4c31 2.2 63 3.4 96 1.1" pathLength="1"></path></svg
					></span>，慢慢标在地图上
			</h1>

			<p class="tv-lead tv-enter" style="--d: 140ms">
				去过的城市、看过的风景，还有想一直记住的小瞬间。<br />
				地图还空着很多格，先从这里开始数。
			</p>

			<div class="tv-meta tv-enter" style="--d: 200ms">
				<span><b>{visitedProvinces.size}</b> 个省份</span>
				<i aria-hidden="true"></i>
				<span><b>{travelPlaces.length}</b> 个地点</span>
				<i aria-hidden="true"></i>
				<span><b>1</b> 个家乡</span>
			</div>

			<div class="tv-actions tv-enter" style="--d: 260ms">
				<button class="tv-btn tv-btn--primary" type="button" data-random>
					<Icon name="material-symbols:shuffle-rounded" />
					<span>随机重温一站</span>
				</button>
				<a class="tv-btn tv-btn--ghost" href="#tv-wishlist">
					<Icon name="material-symbols:favorite-outline-rounded" />
					<span>看看想去的地方</span>
				</a>
			</div>
		</div>

		<aside class="tv-pass tv-enter" style="--d: 240ms" aria-label="旅行登机牌">
			<div class="tv-pass-inner" data-tilt>
				<div class="tv-pass-head">
					<span class="tv-pass-brand">
						<Icon name="material-symbols:flight-rounded" />
						YARON AIRWAYS
					</span>
					<span class="tv-pass-kind">BOARDING PASS</span>
				</div>

				<div class="tv-pass-route">
					<div class="tv-pass-port">
						<span>FROM · 起点</span>
						<strong>平江县</strong>
						<em>湖南 · 家</em>
					</div>
					<span class="tv-pass-arrow" aria-hidden="true">
						<svg viewBox="0 0 60 16" preserveAspectRatio="none">
							<path d="M1 8h52" stroke-dasharray="3 4"></path>
							<path d="M49 3l7 5-7 5"></path>
						</svg>
					</span>
					<div class="tv-pass-port tv-pass-port--to">
						<span>TO · 下一站</span>
						<strong>还没定</strong>
						<em>留一张空白</em>
					</div>
				</div>

				<div class="tv-pass-perf" aria-hidden="true"></div>

				<dl class="tv-pass-fields">
					<div><dt>PASSENGER</dt><dd>Yaron</dd></div>
					<div><dt>STOPS</dt><dd>{String(travelPlaces.length).padStart(2, "0")}</dd></div>
					<div><dt>PROVINCES</dt><dd>{String(visitedProvinces.size).padStart(2, "0")}</dd></div>
					<div><dt>DISTANCE</dt><dd>{totalKm.toLocaleString("en-US")} km</dd></div>
				</dl>

				<div class="tv-pass-tail">
					<span class="tv-barcode" aria-hidden="true"></span>
					<span class="tv-pass-stamp" aria-hidden="true">
						<b>{travelPlaces.length}</b>
						<small>STOPS</small>
					</span>
				</div>
				<p class="tv-pass-foot">NO. 0008 · 旅行足迹 · 一页一页攒起来</p>
			</div>
		</aside>
	</header>

	<!-- 01 · 地图 + 手账 ------------------------------------------------ -->
	<section class="tv-section tv-atlas" aria-labelledby="tv-atlas-title" data-reveal style="--d: 40ms">
		<header class="tv-section-head">
			<p class="tv-kicker"><span>01</span> ATLAS · 地图册</p>
			<h2 id="tv-atlas-title">把脚印摊开来看</h2>
			<p class="tv-section-sub">
				四个省份已经点亮，八个脚印挤在东南这一角——放大一点才看得清。
			</p>
		</header>

		<div class="tv-atlas-grid">
			<article class="tv-map-card" data-map-card
				data-caption-default="把鼠标放到地图上，看看是哪一站"
				data-caption-cluster="八个脚印都藏在东南这一角 · 点开放大"
				data-hint-full="点击东南角 · 放大查看"
				data-hint-zoom="点右边的手账，也能跳过来">
				<div class="tv-map-head">
					<div class="tv-map-title">
						<p>CHINA · 中国</p>
						<h3>中国旅行地图</h3>
					</div>
					<ul class="tv-legend" aria-label="地图图例">
						<li><i class="tv-legend-dot is-visited"></i>去过</li>
						<li><i class="tv-legend-dot is-home"></i>家乡</li>
						<li><i class="tv-legend-dot"></i>待点亮</li>
					</ul>
				</div>

				<div class="tv-map-stage">
					<svg
						class="tv-map"
						viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
						preserveAspectRatio="xMidYMid meet"
						role="group"
						aria-labelledby="tv-map-title tv-map-desc"
						data-map
					>
						<title id="tv-map-title">中国旅行地图</title>
						<desc id="tv-map-desc">
							中国地图，湖南、江西、福建、广东四个省份已经点亮，八个旅行地点集中在东南部。
						</desc>

						<defs>
							<radialGradient id="tv-cluster-glow" cx="50%" cy="50%" r="50%">
								<stop offset="0%" stop-color="var(--sakura)" stop-opacity="0.34"></stop>
								<stop offset="70%" stop-color="var(--sakura)" stop-opacity="0.1"></stop>
								<stop offset="100%" stop-color="var(--sakura)" stop-opacity="0"></stop>
							</radialGradient>
							<filter id="tv-soften" x="-40%" y="-40%" width="180%" height="180%">
								<feGaussianBlur stdDeviation="3.2"></feGaussianBlur>
							</filter>
						</defs>

						<g class="tv-graticule" aria-hidden="true">
							{graticule.map((line) => (
								<line x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} />
							))}
						</g>

						<g class="tv-provinces" aria-hidden="true" data-provinces>
							{provincePaths.map((province) => (
								<path
									class:list={["tv-province", { "is-visited": province.visited }]}
									d={province.d}
									data-label={province.label}
									data-visited={province.visited ? "true" : "false"}
								/>
							))}
						</g>

						<g class="tv-province-labels" aria-hidden="true">
							{provinceLabels.map((label) => (
								<text
									class:list={["tv-province-label", { "is-visited": label.visited }]}
									x={label.x}
									y={label.y}
								>
									{label.name}
								</text>
							))}
						</g>

						<g class="tv-route" aria-hidden="true" data-route>
							<path class="tv-route-case" d={routePath}></path>
							<path class="tv-route-line" d={routePath}></path>
							<circle
								class="tv-route-comet"
								r="1.15"
								style={`offset-path: path('${routePath}');`}
							></circle>
						</g>

						<g class="tv-pins tv-pins--full" aria-hidden="true">
							<ellipse
								class="tv-cluster-glow"
								cx={cluster.x}
								cy={cluster.y}
								rx="30"
								ry="44"
								fill="url(#tv-cluster-glow)"
							></ellipse>
							<ellipse
								class="tv-cluster-ring"
								cx={cluster.x}
								cy={cluster.y}
								rx="27"
								ry="40"
							></ellipse>
							{markers.map((marker) => (
								<circle
									class:list={["tv-dot", { "is-home": marker.kind === "home" }]}
									cx={marker.x}
									cy={marker.y}
									r={marker.kind === "home" ? 2.7 : 2.1}
								></circle>
							))}
						</g>

						<circle
							class="tv-cluster-hit"
							cx={cluster.x}
							cy={cluster.y}
							r="26"
							role="button"
							tabindex="0"
							aria-label="放大东南角的八个地点"
							data-cluster
						></circle>

						<g class="tv-pins tv-pins--zoom">
							{markers.map((marker) => (
								<g
									class:list={["tv-pin", { "is-home": marker.kind === "home" }]}
									transform={`translate(${marker.x.toFixed(1)} ${marker.y.toFixed(1)})`}
									data-index={marker.index}
									data-label={marker.label}
									data-angle={marker.angle.toFixed(1)}
									role="button"
									tabindex="0"
									aria-label={`${marker.name} · ${marker.province} · ${
										marker.kind === "home" ? "家乡" : `离家 ${marker.fromHome} 公里`
									}`}
								>
									<circle class="tv-pin-hit" r="7.4"></circle>
									{marker.kind === "home" ? (
										<circle class="tv-pin-pulse" r="1.5"></circle>
									) : null}
									<circle class="tv-pin-halo" r="3"></circle>
									<circle class="tv-pin-dot" r="1.3"></circle>
									<line
										class="tv-pin-leader"
										x1="0"
										y1="0"
										x2={marker.offsetX}
										y2={marker.offsetY}
									></line>
									<text
										class="tv-pin-name"
										x={marker.offsetX + (marker.anchor === "end" ? -0.9 : 0.9)}
										y={marker.offsetY}
										text-anchor={marker.anchor}
										dominant-baseline="central"
									>
										{marker.name}
									</text>
								</g>
							))}
						</g>
					</svg>

					<button class="tv-zoom" type="button" data-zoom aria-pressed="false">
						<Icon name="material-symbols:zoom-in-map-rounded" />
						<span data-zoom-text>放大东南八站</span>
					</button>

					<div class="tv-compass" aria-hidden="true" data-compass>
						<span class="tv-compass-sway">
							<span class="tv-compass-needle"></span>
						</span>
						<span class="tv-compass-n">N</span>
					</div>

					<figure class="tv-inset">
						<svg viewBox="0 0 92 116" aria-hidden="true">
							<path d={hainanPath}></path>
						</svg>
						<figcaption>南海诸岛</figcaption>
					</figure>
				</div>

				<div class="tv-caption">
					<span class="tv-caption-mark" aria-hidden="true"></span>
					<p data-caption>把鼠标放到地图上，看看是哪一站"</p>
					<span class="tv-caption-hint" data-hint>点击东南角 · 放大查看</span>
				</div>
				<p class="tv-sr" aria-live="polite" data-live></p>

				<div class="tv-map-foot">
					<span class="tv-map-foot-label">省份点亮</span>
					<ol class="tv-ticks" aria-hidden="true">
