	}

	.tv-pin-hit {
		fill: transparent;
	}

	.tv-pin-halo {
		fill: color-mix(in srgb, var(--sakura) 20%, transparent);
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		transition: opacity 0.3s ease;
	}

	.tv-pin.is-hot .tv-pin-halo {
		opacity: 1;
	}

	.tv-pin.is-active .tv-pin-halo {
		opacity: 1;
		fill: color-mix(in srgb, var(--sakura) 30%, transparent);
	}

	.tv-pin-dot {
		fill: var(--sakura);
		stroke: color-mix(in srgb, var(--cream-base) 94%, transparent);
		stroke-width: 0.72;
		transform-box: fill-box;
		transform-origin: center;
		transition: fill 0.3s ease, stroke 0.3s ease, transform 0.3s ease;
	}

	.tv-pin.is-home .tv-pin-dot {
		fill: var(--tea);
		stroke: color-mix(in srgb, var(--cream-base) 94%, transparent);
	}

	.tv-pin.is-hot .tv-pin-dot,
	.tv-pin.is-active .tv-pin-dot {
		fill: color-mix(in srgb, var(--sakura) 76%, var(--tea));
		transform: scale(1.32);
	}

	.tv-pin-pulse {
		fill: none;
		stroke: color-mix(in srgb, var(--tea) 65%, transparent);
		stroke-width: 0.45;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		pointer-events: none;
	}

	.tv-pin-leader {
		stroke: color-mix(in srgb, var(--sakura) 52%, transparent);
		stroke-width: 0.28;
		stroke-dasharray: 0.7 0.8;
		opacity: 0.8;
		pointer-events: none;
	}

	.tv-pin-name {
		font-size: 3.05px;
		font-weight: 600;
		letter-spacing: 0.02em;
		fill: var(--tv-ink);
		paint-order: stroke;
		stroke: color-mix(in srgb, var(--cream-base) 92%, transparent);
		stroke-width: 1.4;
		stroke-linejoin: round;
		pointer-events: none;
	}

	/* 控件 */

	.tv-zoom {
		position: absolute;
		top: 0.55rem;
		right: 0.55rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 1.95rem;
		padding: 0 0.7rem;
		border: 1px solid color-mix(in srgb, var(--sakura) 26%, var(--tv-line));
		border-radius: 999px;
		background: color-mix(in srgb, var(--cream-base) 86%, transparent);
		backdrop-filter: blur(8px);
		color: var(--tv-body);
		font-family: inherit;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		cursor: pointer;
		box-shadow: 0 8px 20px -16px color-mix(in srgb, var(--tea) 90%, transparent);
		transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease,
			transform 0.25s ease;
	}

	.tv-zoom :global(svg) {
		width: 1.05em;
		height: 1.05em;
		color: var(--sakura);
	}

	.tv-zoom:hover {
		color: var(--tv-ink);
		border-color: color-mix(in srgb, var(--sakura) 54%, transparent);
		transform: translateY(-1px);
	}

	.tv-zoom[aria-pressed="true"] {
		border-color: color-mix(in srgb, var(--sakura) 46%, transparent);
		background: color-mix(in srgb, var(--sakura) 16%, var(--cream-base));
		color: var(--tv-ink);
	}

	.tv-zoom:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--sakura) 62%, transparent);
		outline-offset: 2px;
	}

	.tv-compass {
		position: absolute;
		bottom: 0.6rem;
		left: 0.7rem;
		width: 2.45rem;
		height: 2.45rem;
		border: 1px dashed color-mix(in srgb, var(--tea) 44%, transparent);
		border-radius: 50%;
		background: color-mix(in srgb, var(--cream-base) 78%, transparent);
		backdrop-filter: blur(4px);
		pointer-events: none;
	}

	.tv-compass::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 3px;
		height: 3px;
		margin: -1.5px 0 0 -1.5px;
		border-radius: 50%;
		background: var(--tv-quiet);
	}

	.tv-compass-sway {
		position: absolute;
		inset: 0.12rem;
		border-radius: 50%;
		transform-origin: 50% 50%;
		animation: tv-sway 7s ease-in-out infinite;
	}

	.tv-compass.is-pointing .tv-compass-sway {
		animation: none;
	}

	.tv-compass-needle {
		position: absolute;
		top: 15%;
		left: 50%;
		width: 0.34rem;
		height: 70%;
		margin-left: -0.17rem;
		clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
		background: linear-gradient(
			to bottom,
			var(--sakura) 0 50%,
			color-mix(in srgb, var(--tea) 58%, transparent) 50% 100%
		);
		transform: rotate(var(--tv-needle, 0deg));
		transform-origin: 50% 50%;
		transition: transform 0.55s cubic-bezier(0.3, 1.25, 0.5, 1);
	}

	.tv-compass-n {
		position: absolute;
		top: 0.08rem;
		left: 50%;
		font-family: var(--tv-mono);
		font-size: 0.38rem;
		letter-spacing: 0.1em;
		color: color-mix(in srgb, var(--sakura) 70%, transparent);
		transform: translateX(-50%);
	}

	.tv-inset {
		position: absolute;
		right: 0.5rem;
		bottom: 0.5rem;
		width: 4.6rem;
		margin: 0;
		padding: 0.26rem 0.26rem 0.1rem;
		border: 1px solid var(--tv-line);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--cream-base) 82%, transparent);
		backdrop-filter: blur(6px);
	}

	.tv-inset svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.tv-inset path {
		fill: color-mix(in srgb, var(--sakura) 24%, var(--cream-base));
		stroke: color-mix(in srgb, var(--tea) 45%, transparent);
		stroke-width: 0.5;
		vector-effect: non-scaling-stroke;
	}

	.tv-inset figcaption {
		margin-top: 0.08rem;
		font-size: 0.42rem;
		letter-spacing: 0.12em;
		text-align: center;
		color: var(--tv-quiet);
	}

	.tv-caption {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 1rem;
		padding: 0.55rem 0 0.5rem;
		border-top: 1px dashed var(--tv-line-soft);
	}

	.tv-caption-mark {
		flex: 0 0 auto;
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 50%;
		background: var(--sakura);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--sakura) 16%, transparent);
	}

	.tv-caption p {
		flex: 1 1 auto;
		min-width: 0;
		margin: 0;
		font-size: 0.77rem;
		line-height: 1.5;
		color: var(--tv-body);
	}

	.tv-caption-hint {
		flex: 0 0 auto;
		font-family: var(--tv-mono);
		font-size: 0.57rem;
		letter-spacing: 0.04em;
		color: var(--tv-quiet);
	}

	.tv-map-foot {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 1rem;
		padding: 0.55rem 0 0.8rem;
		border-top: 1px dashed var(--tv-line-soft);
		font-size: 0.63rem;
		color: var(--tv-quiet);
	}

	.tv-map-foot-label {
		flex: 0 0 auto;
	}

	.tv-ticks {
		display: flex;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tv-ticks li {
		width: 4px;
		height: 0.6rem;
		border-radius: 1px;
		background: color-mix(in srgb, var(--tea) 14%, transparent);
	}

	.tv-ticks li.is-on {
		background: color-mix(in srgb, var(--sakura) 78%, transparent);
	}

	.tv-map-foot b {
		font-family: var(--tv-mono);
		font-size: 0.65rem;
		color: var(--tv-ink);
	}

	.tv-map-foot small {
		margin-left: auto;
		font-size: 0.55rem;
		text-align: right;
	}

	/* 旅行手账 ---------------------------------------------------------- */

	.tv-journal {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 0.95rem 0.85rem 0.8rem;
		border: 1px solid var(--tv-line);
		border-radius: 1.3rem;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--cream-base) 46%, var(--cream-soft)),
			var(--cream-soft)
		);
		box-shadow: 0 22px 48px -42px color-mix(in srgb, var(--tea) 90%, transparent);
	}

	.tv-journal-head .tv-kicker {
		font-size: 0.53rem;
		letter-spacing: 0.18em;
	}

	.tv-journal-head h3 {
		margin: 0.3rem 0 0.2rem;
		font-size: 1.06rem;
		font-weight: 700;
		color: var(--tv-ink);
		letter-spacing: 0.02em;
	}

	.tv-journal-sub {
		margin: 0;
		font-size: 0.69rem;
		line-height: 1.65;
		color: var(--tv-quiet);
	}

	.tv-journal-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.3rem;
		margin: 0.65rem 0 0;
		padding: 0.5rem 0;
		list-style: none;
		border-top: 1px dashed var(--tv-line-soft);
		border-bottom: 1px dashed var(--tv-line-soft);
	}

	.tv-journal-stats li {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.15rem;
	}

	.tv-journal-stats b {
		font-family: var(--tv-mono);
		font-size: 1rem;
		font-weight: 700;
		color: var(--tv-ink);
	}

	.tv-journal-stats span {
		font-size: 0.6rem;
		color: var(--tv-quiet);
	}

	.tv-stops {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.tv-stop {
		display: grid;
		grid-template-columns: 1.1rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.42rem;
		width: 100%;
		padding: 0.36rem 0.4rem;
		border: 1px solid transparent;
		border-radius: 0.6rem;
		background: transparent;
		color: inherit;
		font-family: inherit;
		text-align: left;
		cursor: pointer;
		transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
	}

	.tv-stop:hover,
	.tv-stop.is-hot {
		border-color: color-mix(in srgb, var(--sakura) 22%, transparent);
		background: color-mix(in srgb, var(--sakura) 7%, transparent);
		transform: translateX(2px);
	}

	.tv-stop.is-active {
		border-color: color-mix(in srgb, var(--sakura) 36%, transparent);
		background: color-mix(in srgb, var(--sakura) 12%, transparent);
	}

	.tv-stop:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--sakura) 55%, transparent);
		outline-offset: 1px;
	}

	.tv-stop-index {
		font-family: var(--tv-mono);
		font-size: 0.55rem;
		letter-spacing: 0.04em;
		color: color-mix(in srgb, var(--tea) 62%, transparent);
	}

	.tv-stop.is-home .tv-stop-index {
		color: color-mix(in srgb, var(--sakura) 85%, transparent);
	}

	.tv-stop-main {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		min-width: 0;
	}

	.tv-stop-name {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--tv-ink);
	}

	.tv-stop-name i {
		padding: 0.16rem 0.28rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--tea) 13%, transparent);
		font-style: normal;
		font-size: 0.48rem;
		line-height: 1;
		color: color-mix(in srgb, var(--tea) 85%, var(--tv-body));
	}

	.tv-stop-note {
		overflow: hidden;
		font-size: 0.61rem;
		line-height: 1.4;
		color: var(--tv-quiet);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.tv-stop-distance {
		display: flex;
		align-items: baseline;
		gap: 0.1rem;
		font-family: var(--tv-mono);
		font-size: 0.54rem;
		color: var(--tv-quiet);
	}

	.tv-stop-distance b {
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--tv-body);
	}

	.tv-journal-foot {
		margin: auto 0 0;
		padding-top: 0.55rem;
		border-top: 1px dashed var(--tv-line-soft);
		font-size: 0.55rem;
		line-height: 1.5;
		text-align: center;
		color: var(--tv-quiet);
	}

	/* 02 · 数字 -------------------------------------------------------- */

	.tv-facts-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 0.8rem;
	}

	.tv-mileage {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem 1.6rem;
		align-items: end;
		overflow: hidden;
		padding: 1.05rem 1.15rem;
		border: 1px solid var(--tv-line);
		border-radius: 1.25rem;
		background:
			radial-gradient(120% 100% at 0% 0%, color-mix(in srgb, var(--sakura) 15%, transparent), transparent 62%),
			var(--cream-soft);
	}

	.tv-mileage-main {
		align-self: center;
	}

	.tv-mileage-facts {
		display: grid;
		gap: 0.1rem;
		margin: 0;
		padding: 0 0 0 1.1rem;
		border-left: 1px dashed var(--tv-line-soft);
		list-style: none;
	}

	.tv-mileage-facts li {
		display: grid;
		grid-template-columns: auto auto;
		align-items: baseline;
		gap: 0.1rem 0.5rem;
		padding: 0.34rem 0;
	}

	.tv-mileage-facts li + li {
		border-top: 1px dotted color-mix(in srgb, var(--tv-line-soft) 70%, transparent);
	}

	.tv-mileage-facts span {
		font-family: var(--tv-mono);
		font-size: 0.5rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--tv-quiet);
	}

	.tv-mileage-facts b {
		justify-self: end;
		font-family: var(--tv-mono);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1;
		color: var(--tv-ink);
		font-variant-numeric: tabular-nums;
	}

	.tv-mileage-facts b em {
		margin-left: 0.16rem;
		font-style: normal;
		font-size: 0.55rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		color: var(--tv-quiet);
	}

	.tv-mileage-facts small {
		grid-column: 1 / -1;
		font-size: 0.6rem;
		line-height: 1.4;
		color: var(--tv-quiet);
	}

	.tv-mileage .tv-kicker {
		font-size: 0.51rem;
		letter-spacing: 0.24em;
	}

	.tv-mileage-num {
		display: flex;
		align-items: baseline;
		gap: 0.28rem;
		margin: 0.55rem 0 0.1rem;
		font-family: var(--tv-mono);
		font-size: clamp(2rem, 4.2vw, 3rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--tv-ink);
		font-variant-numeric: tabular-nums;
	}

	.tv-mileage-num em {
		font-style: normal;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: color-mix(in srgb, var(--sakura) 80%, var(--tea));
	}

	.tv-mileage-sub {
		margin: 0.4rem 0 0;
		font-size: 0.77rem;
		color: var(--tv-body);
	}

	.tv-mileage-note {
		margin: 0.3rem 0 0;
		font-size: 0.67rem;
		line-height: 1.7;
		color: var(--tv-quiet);
	}

	.tv-extremes {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.55rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tv-extremes li {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.16rem;
		padding: 0.7rem 0.8rem;
		border: 1px solid var(--tv-line);
		border-radius: 0.9rem;
		background: var(--cream-soft);
		transition: border-color 0.3s ease, transform 0.3s ease;
	}

	.tv-extremes li:hover {
		border-color: color-mix(in srgb, var(--sakura) 34%, transparent);
		transform: translateY(-2px);
	}

	.tv-extreme-tag {
		font-family: var(--tv-mono);
		font-size: 0.51rem;
		letter-spacing: 0.18em;
		color: color-mix(in srgb, var(--sakura) 80%, var(--tea));
	}

	.tv-extremes strong {
		font-size: 1rem;
		font-weight: 700;
		color: var(--tv-ink);
	}

	.tv-extreme-meta {
		font-family: var(--tv-mono);
		font-size: 0.54rem;
		letter-spacing: 0.02em;
		color: var(--tv-quiet);
	}

	.tv-route-card {
		margin-top: 0.8rem;
		padding: 0.8rem 1rem 0.7rem;
		border: 1px solid var(--tv-line);
		border-radius: 1.15rem;
		background: var(--cream-soft);
	}

	.tv-route-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
		margin-bottom: 0.75rem;
	}

	.tv-route-head span {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: var(--tv-body);
	}

	.tv-route-head small {
		font-size: 0.55rem;
		color: var(--tv-quiet);
	}

	.tv-route-stops {
		display: flex;
		align-items: flex-start;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tv-route-stop {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		width: 2.9rem;
	}

	.tv-route-stop i {
		width: 0.46rem;
		height: 0.46rem;
		border: 1.4px solid color-mix(in srgb, var(--sakura) 74%, transparent);
		border-radius: 50%;
		background: var(--cream-soft);
	}

	.tv-route-stop i.is-home {
		border-color: var(--tea);
		background: var(--tea);
	}

	.tv-route-stop b {
		font-size: 0.59rem;
		font-weight: 600;
		color: var(--tv-body);
		white-space: nowrap;
	}

	.tv-route-seg {
		position: relative;
		flex: 1 1 0;
		min-width: 0.8rem;
		height: 2rem;
	}

	.tv-route-seg::before {
		content: "";
		position: absolute;
		top: 0.2rem;
		right: 0;
		left: 0;
		border-top: 1px dashed color-mix(in srgb, var(--sakura) 42%, transparent);
		transform: scaleX(0);
		transform-origin: left center;
	}

	.tv-route-seg span {
		position: absolute;
		top: 0.42rem;
		left: 50%;
		font-family: var(--tv-mono);
		font-size: 0.49rem;
		color: var(--tv-quiet);
		transform: translateX(-50%);
	}

	.tv-facts.is-in .tv-route-seg::before {
		transform: scaleX(1);
		transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1) 0.15s;
	}

	/* 03 · 明信片 ------------------------------------------------------ */

	.tv-postcards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.tv-postcard {
		--tone: var(--sakura);
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--tv-line);
		border-radius: 0.95rem;
		background: var(--cream-soft);
		box-shadow: 0 16px 32px -30px color-mix(in srgb, var(--tea) 90%, transparent);
		transform: rotate(var(--tilt, 0deg));
		transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.35), box-shadow 0.4s ease,
			border-color 0.3s ease;
	}

	.tv-postcard:hover {
		border-color: color-mix(in srgb, var(--tone) 42%, transparent);
		box-shadow: 0 22px 40px -28px color-mix(in srgb, var(--tea) 95%, transparent);
		transform: rotate(0deg) translateY(-4px);
	}

	.tv-tone-sakura {
		--tone: var(--sakura);
	}

	.tv-tone-sky {
		--tone: var(--azusa-blue);
	}

	.tv-tone-tea {
		--tone: var(--tea);
	}

	.tv-tone-violet {
		--tone: var(--mio-purple);
