								aria-label={`在地图上查看 ${marker.name} · ${marker.province}`}
							>
								<span class="tv-stop-index">{String(marker.index + 1).padStart(2, "0")}</span>
								<span class="tv-stop-main">
									<span class="tv-stop-name">
										{marker.name}
										{marker.kind === "home" ? <i>家乡</i> : null}
									</span>
									<span class="tv-stop-note">{marker.province} · {marker.note}</span>
								</span>
								<span class="tv-stop-distance">
									{marker.kind === "home" ? (
										<b>家</b>
									) : (
										<>
											<b>{marker.fromHome}</b>
