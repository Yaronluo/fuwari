	<!-- 04 · 收尾 ------------------------------------------------------- -->
	<footer class="tv-outro" data-reveal style="--d: 40ms">
		<div class="tv-outro-lead">
			<p class="tv-kicker">NEXT STOP · 下一站</p>
			<h2>地图还空着 {remainingProvinces} 个省份</h2>
			<p>下次出发，记得把新的脚印带回来。</p>
		</div>

		<div class="tv-outro-track" aria-hidden="true">
			<span class="tv-outro-line"></span>
			<span class="tv-outro-plane">✈</span>
			<span class="tv-outro-chips">
				{travelWishlist.map((wish) => <i>{wish.name}</i>)}
			</span>
		</div>

		<div class="tv-outro-foot">
			<p class="tv-sign">✎ Yaron · 手账 Vol.08</p>
			<p class="tv-credit">地图数据 cn-atlas · 省级边界仅作示意 · 距离为直线估算</p>
		</div>
	</footer>
</section>

<script>
	type Box = { x: number; y: number; w: number; h: number };

	const TV_FULL: Box = { x: 0, y: 0, w: 900, h: 640 };
	const TV_ZOOM: Box = { x: 487.2, y: 419.6, w: 212.6, h: 151.18 };
	const TV_EASE = (t: number) =>
		t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2;
	const tvReduced = () =>
		window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const tvFormat = (value: number) => value.toLocaleString("en-US");
	const tvBox = (box: Box) =>
		`${box.x.toFixed(2)} ${box.y.toFixed(2)} ${box.w.toFixed(2)} ${box.h.toFixed(2)}`;

	let tvCleanup: (() => void) | null = null;

	const setupTravel = () => {
		const root = document.querySelector<HTMLElement>("[data-tv-root]");
		if (!root) return;
		tvCleanup?.();
		tvCleanup = null;
		if (root.dataset.tvReady === "true") return;
		root.dataset.tvReady = "true";

		const card = root.querySelector<HTMLElement>("[data-map-card]");
		const svg = root.querySelector<SVGSVGElement>("[data-map]");
		const caption = root.querySelector<HTMLElement>("[data-caption]");
		const hint = root.querySelector<HTMLElement>("[data-hint]");
		const live = root.querySelector<HTMLElement>("[data-live]");
		const zoomButton = root.querySelector<HTMLButtonElement>("[data-zoom]");
		const zoomText = root.querySelector<HTMLElement>("[data-zoom-text]");
		const randomButton = root.querySelector<HTMLButtonElement>("[data-random]");
		const compass = root.querySelector<HTMLElement>("[data-compass]");
		const cluster = root.querySelector<SVGElement>("[data-cluster]");
		const provinces = root.querySelector<SVGGElement>("[data-provinces]");
		const pins = Array.from(root.querySelectorAll<SVGGElement>(".tv-pin[data-index]"));
		const rows = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-stop]"));
		if (!card || !svg || !caption) return;

		const captionDefault = card.dataset.captionDefault ?? "";
		const captionCluster = card.dataset.captionCluster ?? "";
		const hintFull = card.dataset.hintFull ?? "";
		const hintZoom = card.dataset.hintZoom ?? "";

		let zoomed = false;
		let active = -1;
		let hovering: number | null = null;
		let provinceHover: { label: string; node: SVGPathElement } | null = null;
		let frame = 0;

		/* ---------------------------------------------------------- 地图缩放 */

		const currentBox = (): Box => {
			const viewBox = svg.viewBox.baseVal;
			return { x: viewBox.x, y: viewBox.y, w: viewBox.width, h: viewBox.height };
		};

		const stopTween = () => {
			if (frame) window.cancelAnimationFrame(frame);
			frame = 0;
		};

		const tweenTo = (target: Box, done?: () => void) => {
			stopTween();
			const from = currentBox();
			const start = performance.now();
			const duration = 640;
			const step = (now: number) => {
				const progress = Math.min(1, (now - start) / duration);
				const eased = TV_EASE(progress);
				svg.setAttribute(
					"viewBox",
					tvBox({
						x: from.x + (target.x - from.x) * eased,
						y: from.y + (target.y - from.y) * eased,
						w: from.w + (target.w - from.w) * eased,
						h: from.h + (target.h - from.h) * eased,
					}),
				);
				if (progress < 1) {
					frame = window.requestAnimationFrame(step);
				} else {
					frame = 0;
					done?.();
				}
			};
			frame = window.requestAnimationFrame(step);
		};

		const setZoom = (
			next: boolean,
			options: { animate?: boolean; done?: () => void } = {},
		) => {
			if (zoomed === next) {
				options.done?.();
				return;
			}
			zoomed = next;
			card.classList.toggle("is-zoomed", next);
			card.dataset.zoomed = next ? "true" : "false";
			zoomButton?.setAttribute("aria-pressed", next ? "true" : "false");
			if (zoomText) zoomText.textContent = next ? "看全图" : "放大东南八站";
			if (hint) hint.textContent = next ? hintZoom : hintFull;
			if (!next) {
				active = -1;
				hovering = null;
			}
			const target = next ? TV_ZOOM : TV_FULL;
			if (options.animate === false || tvReduced()) {
				applyBox(target);
				options.done?.();
				return;
			}
			tweenTo(target, options.done);
		};

		const applyBox = (box: Box) => {
			stopTween();
			svg.setAttribute("viewBox", tvBox(box));
		};

		/* ------------------------------------------------------------ 高亮 */

		const render = () => {
			const index = hovering ?? (active >= 0 ? active : null);
			for (const pin of pins) {
				const pinIndex = Number(pin.dataset.index);
				pin.classList.toggle("is-hot", pinIndex === index);
				pin.classList.toggle("is-active", pinIndex === active);
			}
			for (const row of rows) {
				const rowIndex = Number(row.dataset.index);
				row.classList.toggle("is-hot", rowIndex === index);
				row.classList.toggle("is-active", rowIndex === active);
			}

			if (index !== null) {
				const row = rows[index];
				caption.textContent = row.dataset.label ?? captionDefault;
				compass?.classList.add("is-pointing");
				compass?.style.setProperty("--tv-needle", `${row.dataset.angle ?? 0}deg`);
				return;
			}
			if (provinceHover) {
				caption.textContent = provinceHover.label;
				compass?.classList.remove("is-pointing");
				return;
			}
			caption.textContent = zoomed ? captionCluster : captionDefault;
			compass?.classList.remove("is-pointing");
		};

		const flash = (index: number) => {
			const pin = pins.find((item) => Number(item.dataset.index) === index);
			if (!pin || tvReduced()) return;
			pin.classList.remove("is-flash");
			void pin.getBoundingClientRect();
			pin.classList.add("is-flash");
		};

		const activate = (index: number, options: { scroll?: boolean } = {}) => {
			active = index;
			hovering = null;
			if (!zoomed) setZoom(true);
			render();
			flash(index);
			if (live) live.textContent = rows[index]?.dataset.label ?? "";
			if (options.scroll && card) {
				const rect = card.getBoundingClientRect();
				if (rect.top < 0 || rect.bottom > window.innerHeight * 1.02) {
					card.scrollIntoView({
						behavior: tvReduced() ? "auto" : "smooth",
						block: "center",
					});
				}
			}
		};

		/* ------------------------------------------------------------ 事件 */

		const onZoomClick = () => setZoom(!zoomed);
		zoomButton?.addEventListener("click", onZoomClick);

		const onCluster = () => setZoom(true);
		cluster?.addEventListener("click", onCluster);
		cluster?.addEventListener("keydown", (event) => {
			const key = (event as KeyboardEvent).key;
			if (key !== "Enter" && key !== " ") return;
			event.preventDefault();
			setZoom(true);
		});

		const onRandom = () => {
			if (!rows.length) return;
			let next = Math.floor(Math.random() * rows.length);
			if (rows.length > 1 && next === active) next = (next + 1) % rows.length;
			activate(next, { scroll: true });
		};
		randomButton?.addEventListener("click", onRandom);

		const pinHandlers: Array<[SVGGElement, (event: Event) => void]> = [];
		for (const pin of pins) {
			const index = Number(pin.dataset.index);
			const enter = () => {
				hovering = index;
				render();
			};
			const leave = () => {
				hovering = null;
				render();
			};
			const click = () => activate(index);
			const keydown = (event: Event) => {
				const key = (event as KeyboardEvent).key;
				if (key !== "Enter" && key !== " ") return;
				event.preventDefault();
				activate(index);
			};
			pin.addEventListener("pointerenter", enter);
			pin.addEventListener("pointerleave", leave);
			pin.addEventListener("focus", enter);
			pin.addEventListener("blur", leave);
			pin.addEventListener("click", click);
			pin.addEventListener("keydown", keydown);
			pinHandlers.push([pin, enter]);
		}

		for (const row of rows) {
			const index = Number(row.dataset.index);
			const enter = () => {
				hovering = index;
				render();
			};
			const leave = () => {
				hovering = null;
				render();
			};
			const click = () => activate(index);
			row.addEventListener("pointerenter", enter);
			row.addEventListener("pointerleave", leave);
			row.addEventListener("focus", enter);
			row.addEventListener("blur", leave);
			row.addEventListener("click", click);
		}

		let hoveredProvince: SVGPathElement | null = null;
		const onProvinceOver = (event: Event) => {
			const target = event.target as Element | null;
			const path = target?.closest?.<SVGPathElement>(".tv-province");
			if (!path || path === hoveredProvince) return;
			hoveredProvince?.classList.remove("is-hover");
			hoveredProvince = path;
			path.classList.add("is-hover");
			provinceHover = { label: path.dataset.label ?? "", node: path };
			render();
		};
		const onProvinceOut = (event: Event) => {
			const target = event.target as Element | null;
			const path = target?.closest?.<SVGPathElement>(".tv-province");
			if (!path || path !== hoveredProvince) return;
			path.classList.remove("is-hover");
			hoveredProvince = null;
			provinceHover = null;
			render();
		};
		provinces?.addEventListener("pointerover", onProvinceOver);
		provinces?.addEventListener("pointerout", onProvinceOut);

		/* ------------------------------------------------------------ 入场 */

		const revealTargets = Array.from(
			root.querySelectorAll<HTMLElement>("[data-reveal]"),
		);

		let observer: IntersectionObserver | null = null;
		if ("IntersectionObserver" in window && !tvReduced()) {
			root.classList.add("tv-armed");
			document.documentElement.classList.remove("tv-boot");
			root.dataset.tvArmed = "true";
			observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add("is-in");
						observer?.unobserve(entry.target);
					}
				},
				{ rootMargin: "0px 0px -6% 0px", threshold: 0.06 },
			);
			window.requestAnimationFrame(() => {
				for (const target of revealTargets) {
					const rect = target.getBoundingClientRect();
					if (rect.top < window.innerHeight * 0.94 && rect.bottom > 0) {
						target.classList.add("is-in");
					}
				}
			});
			for (const target of revealTargets) observer.observe(target);
		} else {
			document.documentElement.classList.remove("tv-boot");
			root.dataset.tvArmed = "true";
			for (const target of revealTargets) target.classList.add("is-in");
		}

		/* ------------------------------------------------------------ 计数 */

		const counters = Array.from(root.querySelectorAll<HTMLElement>("[data-count]"));
		const runCounter = (element: HTMLElement) => {
			const target = Number(element.dataset.count ?? 0);
			if (!Number.isFinite(target)) return;
			if (tvReduced()) {
				element.textContent = tvFormat(target);
				return;
			}
			const start = performance.now();
			const duration = 1100;
			const step = (now: number) => {
				const progress = Math.min(1, (now - start) / duration);
				const eased = 1 - (1 - progress) ** 3;
				element.textContent = tvFormat(Math.round(target * eased));
				if (progress < 1) window.requestAnimationFrame(step);
			};
			window.requestAnimationFrame(step);
		};

		let counterObserver: IntersectionObserver | null = null;
		if (counters.length) {
			if ("IntersectionObserver" in window) {
				counterObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							runCounter(entry.target as HTMLElement);
							counterObserver?.unobserve(entry.target);
						}
					},
					{ threshold: 0.4 },
				);
				for (const counter of counters) counterObserver.observe(counter);
			} else {
				for (const counter of counters) runCounter(counter);
			}
		}

		/* ------------------------------------------------------------ 倾斜 */

		const tiltTarget = root.querySelector<HTMLElement>("[data-tilt]");
		const canTilt =
			tiltTarget &&
			window.matchMedia("(pointer: fine)").matches &&
			!tvReduced();
		const onTiltMove = (event: PointerEvent) => {
			if (!tiltTarget) return;
			const rect = tiltTarget.getBoundingClientRect();
			if (!rect.width || !rect.height) return;
			const px = (event.clientX - rect.left) / rect.width - 0.5;
			const py = (event.clientY - rect.top) / rect.height - 0.5;
			tiltTarget.style.setProperty("--tilt-y", `${(px * 9).toFixed(2)}deg`);
			tiltTarget.style.setProperty("--tilt-x", `${(-py * 7).toFixed(2)}deg`);
		};
		const onTiltLeave = () => {
			tiltTarget?.style.removeProperty("--tilt-x");
			tiltTarget?.style.removeProperty("--tilt-y");
		};
		if (canTilt && tiltTarget) {
			tiltTarget.addEventListener("pointermove", onTiltMove);
			tiltTarget.addEventListener("pointerleave", onTiltLeave);
