										</>
									)}
								</span>
							</button>
						</li>
					))}
				</ol>

				<p class="tv-journal-foot">
					右侧为离家的直线距离 · 数据来自手写记录
				</p>
			</aside>
		</div>
	</section>

	<!-- 02 · 数字 ------------------------------------------------------- -->
	<section class="tv-section tv-facts" aria-labelledby="tv-facts-title" data-reveal style="--d: 60ms">
		<header class="tv-section-head">
			<p class="tv-kicker"><span>02</span> BY THE NUMBERS · 数字</p>
