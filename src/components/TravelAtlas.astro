						{wish.scene === "wave" ? (
							<svg class="tv-postcard-scene" viewBox="0 0 160 52" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
								<circle class="tv-scene-sun" cx="124" cy="14" r="6.4"></circle>
								<path
									class="tv-scene-far"
									d="M0 36C18 29 34 29 52 36C70 43 86 43 104 36C122 29 138 29 160 36L160 52L0 52Z"
								></path>
								<path
									class="tv-scene-near"
									d="M0 45C20 38 36 38 56 45C76 52 92 52 112 45C130 39 144 39 160 42L160 52L0 52Z"
								></path>
							</svg>
						) : (
							<svg class="tv-postcard-scene" viewBox="0 0 160 52" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
								<circle class="tv-scene-sun" cx="124" cy="14" r="6.4"></circle>
								<path
									class="tv-scene-far"
									d="M0 35L16 24L30 30L46 17L62 30L78 22L96 33L112 25L130 32L146 26L160 31L160 52L0 52Z"
								></path>
								<path
									class="tv-scene-near"
									d="M0 43L18 35L34 42L50 34L68 44L84 37L102 45L118 38L136 44L160 40L160 52L0 52Z"
								></path>
							</svg>
						)}
						<span class="tv-postcard-region">{wish.region}</span>
						<span class="tv-postcard-seal" aria-hidden="true">航</span>
					</div>
					<div class="tv-postcard-body">
						<h3>
							<i class="tv-postcard-icon" aria-hidden="true">{wish.glyph}</i>
							{wish.name}
						</h3>
						<p>{wish.note}</p>
						<span class="tv-postcard-stamp" aria-hidden="true">待寄出</span>
					</div>
				</article>
			))}

			<article class="tv-postcard tv-postcard--blank">
				<div class="tv-postcard-photo">
					<span class="tv-postcard-plus" aria-hidden="true">＋</span>
				</div>
				<div class="tv-postcard-body">
					<h3>下一站</h3>
					<p>位置留白，等下一次出发再填上。</p>
