---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig, profileConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";
import ImageWrapper from "./misc/ImageWrapper.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="relative z-50">
    <div id="navbar-container" class:list={[
        className,
        "w-full max-w-[var(--page-width)] h-14 mx-auto flex items-center justify-between pointer-events-none px-0"
        ]}>
        
        <!-- Left: Logo -->
        <div class="navbar-pill pointer-events-auto h-14 flex items-center relative isolate rounded-full px-4">
            <div class="nav-bg-blur absolute inset-0 rounded-full bg-white/35 dark:bg-black/45 backdrop-blur-2xl border border-white/40 dark:border-white/10 z-[-1] transition-opacity duration-400"></div>
            <a href={url('/')} class="btn-plain scale-animation rounded-lg h-10 font-bold active:scale-95">
                <div class="flex flex-row text-[var(--primary)] items-center text-md">
                    <ImageWrapper src={profileConfig.avatar || ""} alt="Avatar" class="w-8 h-8 rounded-full mr-2" />
                    {siteConfig.title}
                </div>
            </a>
        </div>
        
        <!-- Middle: Links -->
        <div class="navbar-pill pointer-events-auto h-14 hidden md:flex relative items-center rounded-full px-2" id="nav-menu-container">
            <div class="nav-bg-blur absolute inset-0 rounded-full bg-white/35 dark:bg-black/45 backdrop-blur-2xl border border-white/40 dark:border-white/10 z-0 transition-opacity duration-400"></div>
            <div id="nav-indicator" class="absolute bottom-1 h-[3px] rounded-full bg-gradient-to-r from-transparent via-[var(--primary)] to-transparent transition-all duration-300 opacity-0 pointer-events-none"></div>
            {links.map((l) => l.children?.length ? (
                <div class="nav-dropdown relative z-10 h-10">
                    <div class="nav-dropdown-trigger nav-link-item relative group h-10 cursor-pointer font-bold px-4 flex items-center justify-center transition-all">
                        <span class="flex items-center text-black/75 dark:text-white/75 group-hover:text-[var(--primary)] transition-colors">
                            {l.icon && <Icon name={l.icon} class="text-[1.125rem] mr-1.5 transition-colors group-hover:text-[var(--primary)]" />}
                            {l.name}
                            <Icon name="material-symbols:keyboard-arrow-down-rounded" class="nav-dropdown-chevron text-[1.15rem] ml-0.5 transition-transform duration-200" />
                        </span>
                    </div>
                    <div class="nav-dropdown-panel absolute right-0 top-[calc(100%+0.3rem)] w-44 rounded-xl p-1 opacity-0 invisible translate-y-[-0.3rem] pointer-events-none transition-all duration-200" role="menu">
                        <div class="nav-dropdown-decoration" aria-hidden="true">✦</div>
                        {l.children.map((child) => (
                            <a
                                href={child.external ? child.url : url(child.url)}
                                target={child.external ? "_blank" : null}
                                class="nav-dropdown-link group flex min-h-10 items-center gap-1.5 rounded-lg px-2 py-1.5 transition-all"
                                role="menuitem"
                            >
                                <span class="nav-dropdown-icon flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-[var(--primary)]">
                                    {child.icon && <Icon name={child.icon} class="text-[0.8rem]" />}
                                </span>
                                <span class="min-w-0 flex-1">
                                    <span class="block text-[0.78rem] font-bold leading-none text-black/70 dark:text-white/75 group-hover:text-[var(--primary)] transition-colors">{child.name}</span>
                                    {child.description && <span class="mt-0.5 block text-xs text-black/45 dark:text-white/45">{child.description}</span>}
                                </span>
                                <Icon name="material-symbols:chevron-right-rounded" class="text-[0.95rem] text-[var(--primary)] transition-transform group-hover:translate-x-0.5" />
                            </a>
                        ))}
                    </div>
                </div>
            ) : (
                <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                   class="nav-link-item relative z-10 group h-10 font-bold px-4 flex items-center justify-center active:scale-95 transition-all"
                >
                    <div class="flex items-center text-black/75 dark:text-white/75 group-hover:text-[var(--primary)] transition-colors">
                        {l.icon && <Icon name={l.icon} class="text-[1.125rem] mr-1.5 transition-colors group-hover:text-[var(--primary)]" />}
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2] group-hover:text-[var(--primary)]"></Icon>}
                    </div>
                </a>
            ))}
        </div>
        
        <!-- Right: Actions -->
        <div class="navbar-pill pointer-events-auto h-14 flex items-center relative isolate rounded-full px-2">
            <div class="nav-bg-blur absolute inset-0 rounded-full bg-white/35 dark:bg-black/45 backdrop-blur-2xl border border-white/40 dark:border-white/10 z-[-1] transition-opacity duration-400"></div>
            <button aria-label="Search Panel" class="btn-plain scale-animation rounded-lg w-10 h-10 active:scale-90" id="search-switch">
                <Icon name="material-symbols:search" class="text-[1.25rem]"></Icon>
            </button>
            <Search client:load></Search>
            <button aria-label="配色主题" title="配色主题" class="btn-plain scale-animation rounded-lg h-10 w-10 active:scale-90" id="display-settings-switch">
                <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
            </button>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-10 h-10 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
    </div>
    <NavMenuPanel links={links}></NavMenuPanel>
    <DisplaySettings client:only="svelte"></DisplaySettings>
</div>

<style is:global>
    #navbar-container {
        position: relative;
        background-color: transparent;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        border: 1px solid transparent;
        border-radius: 9999px;
        box-shadow: none;
        transition:
            padding 260ms ease,
            border-color 260ms ease;
    }
    #navbar-container::before {
        content: "";
        position: absolute;
        inset: -1px;
        z-index: 0;
        border: 1px solid color-mix(in srgb, white 44%, var(--glass-border));
        border-radius: inherit;
        background: color-mix(in srgb, var(--cream-base) 58%, transparent);
        backdrop-filter: blur(32px) saturate(145%);
        -webkit-backdrop-filter: blur(32px) saturate(145%);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.28),
            0 10px 32px rgba(118, 80, 68, 0.1);
        opacity: 0;
        pointer-events: none;
        transition: opacity 260ms ease;
    }
    #navbar-container > .navbar-pill {
        z-index: 1;
    }
    #navbar-container.is-scrolled {
        padding-left: 1rem;
        padding-right: 1rem;
        pointer-events: auto;
    }
    #navbar-container.is-scrolled::before {
        opacity: 1;
    }
    :is(.dark) #navbar-container::before {
        background: color-mix(in srgb, var(--cream-base) 70%, transparent);
        border-color: color-mix(in srgb, white 12%, var(--glass-border));
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.08),
            0 10px 34px rgba(0, 0, 0, 0.28);
    }
    .navbar-pill {
        box-shadow: 0 4px 12px color-mix(in srgb, var(--tea) 12%, transparent);
        transition: box-shadow 260ms ease;
    }
    .nav-bg-blur {
        background-color: color-mix(in srgb, var(--cream-base) 52%, transparent) !important;
        border-color: color-mix(in srgb, white 48%, var(--glass-border)) !important;
        backdrop-filter: blur(30px) saturate(150%) !important;
        -webkit-backdrop-filter: blur(30px) saturate(150%) !important;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
        transition: opacity 260ms ease;
    }
    :is(.dark) .nav-bg-blur {
        background-color: color-mix(in srgb, var(--cream-base) 66%, transparent) !important;
        border-color: color-mix(in srgb, white 12%, var(--glass-border)) !important;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }
    #navbar-container.is-scrolled .navbar-pill {
        box-shadow: none;
    }
    #navbar-container.is-scrolled .nav-bg-blur {
        opacity: 0;
    }
    .nav-dropdown-panel {
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.24), color-mix(in srgb, var(--cream-base) 30%, transparent));
        border: 1px solid color-mix(in srgb, white 68%, var(--glass-border));
        backdrop-filter: blur(30px) saturate(175%);
        -webkit-backdrop-filter: blur(30px) saturate(175%);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.78),
            inset 0 -1px 0 color-mix(in srgb, var(--primary) 8%, transparent),
            0 16px 38px rgba(118, 80, 68, 0.14);
    }
    .nav-dropdown::after {
        content: "";
        position: absolute;
        top: 100%;
        right: -0.5rem;
        width: 11.5rem;
        height: 0.7rem;
    }
    .nav-dropdown:hover .nav-dropdown-panel,
    .nav-dropdown:focus-within .nav-dropdown-panel {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }
    .nav-dropdown:hover .nav-dropdown-chevron,
    .nav-dropdown:focus-within .nav-dropdown-chevron {
        transform: rotate(180deg);
    }
    .nav-dropdown-link:hover {
        background: color-mix(in srgb, var(--primary) 9%, white 45%);
        transform: translateY(-1px);
    }
    .nav-dropdown-icon {
        background: color-mix(in srgb, var(--primary) 11%, transparent);
        border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
    }
    .nav-dropdown-decoration {
        position: absolute;
        right: 0.8rem;
        top: -0.7rem;
        color: color-mix(in srgb, var(--primary) 65%, white);
        font-size: 0.8rem;
        text-shadow: -0.65rem 0.45rem 0 color-mix(in srgb, var(--primary) 30%, transparent);
        pointer-events: none;
    }
    :is(.dark) .nav-dropdown-panel {
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.06), color-mix(in srgb, var(--cream-base) 38%, transparent));
        border-color: color-mix(in srgb, white 18%, var(--glass-border));
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.14),
            inset 0 -1px 0 color-mix(in srgb, var(--primary) 10%, transparent),
            0 18px 42px rgba(0, 0, 0, 0.3);
    }
    :is(.dark) .nav-dropdown-link:hover {
        background: color-mix(in srgb, var(--primary) 12%, transparent);
    }
</style>

<script>

function loadButtonScript() {

    let searchBtn = document.getElementById("search-switch");
    if (searchBtn) {
        searchBtn.onclick = function () {
            let searchPanel = document.getElementById("search-panel");
            if (searchPanel) {
                searchPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    const navContainer = document.getElementById('nav-menu-container');
    const indicator = document.getElementById('nav-indicator');
    const navLinks = document.querySelectorAll('.nav-link-item');

    if (navContainer && indicator && navLinks.length > 0) {
        navLinks.forEach(link => {
            link.addEventListener('mouseenter', () => {
                const rect = link.getBoundingClientRect();
                const containerRect = navContainer.getBoundingClientRect();
                const left = rect.left - containerRect.left;
                
                indicator.style.width = `${rect.width * 0.75}px`;
                indicator.style.transform = `translateX(${left + rect.width * 0.125}px)`;
                indicator.style.opacity = '1';
            });
        });

        navContainer.addEventListener('mouseleave', () => {
            indicator.style.opacity = '0';
        });
    }

}

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
(() => {
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

		window.pagefind = pagefind;

		document.dispatchEvent(new CustomEvent('pagefindready'));
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
		};
		document.dispatchEvent(new CustomEvent('pagefindloaderror'));
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
})();
</script>}
