---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;

const total = page.total ?? page.data.length;
const isFirstPage = page.currentPage === 1;
const heading = isFirstPage ? "最新手账" : "手账存档";
const kicker = isFirstPage ? "AFTER SCHOOL NOTES" : `PAGE ${page.currentPage}`;
---
<div class="post-list-head onload-animation" style="animation-delay: calc(var(--content-delay) + 40ms);">
    <div class="post-list-head-main">
        <span class="post-list-kicker">{kicker}</span>
        <h2 class="post-list-title">{heading}</h2>
    </div>
    <span class="post-list-rule" aria-hidden="true"><i>✦</i></span>
    <div class="post-list-head-meta">
        <span class="post-list-count">共 <strong>{total}</strong> 篇</span>
        <span class="post-list-page">第 {page.currentPage} / {page.lastPage} 页</span>
    </div>
</div>

<div class="post-list transition flex flex-col gap-3.5 md:gap-4 mb-4">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                pinned={entry.data.pinned}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>

<style>
    .post-list-head {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 0.95rem;
        padding: 0 0.35rem;
    }
    .post-list-head-main {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        flex: none;
    }
    .post-list-kicker {
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--primary) 62%, transparent);
    }
    .post-list-title {
        position: relative;
        margin: 0;
        font-size: 1.12rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        color: var(--text-strong);
        line-height: 1.3;
    }
    .post-list-title::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0.35rem;
        bottom: -0.2rem;
        height: 0.4rem;
        border-radius: 999px;
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 30%, transparent), transparent);
        opacity: 0.75;
    }
    .post-list-rule {
        position: relative;
        flex: 1 1 auto;
        min-width: 1.5rem;
        height: 1px;
        border-top: 1px dashed color-mix(in srgb, var(--primary) 26%, transparent);
    }
    .post-list-rule i {
        position: absolute;
        top: 50%;
        right: 0;
        transform: translate(0, -50%) rotate(12deg);
        font-style: normal;
        font-size: 0.62rem;
        color: color-mix(in srgb, var(--primary) 52%, transparent);
    }
    .post-list-head-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.05rem;
        flex: none;
        font-size: 0.68rem;
        letter-spacing: 0.02em;
        color: var(--text-muted);
        line-height: 1.45;
    }
    .post-list-count strong {
        font-size: 0.86rem;
        font-weight: 800;
        color: color-mix(in srgb, var(--primary) 78%, var(--text-strong));
        font-variant-numeric: tabular-nums;
    }
    @media (max-width: 47.999rem) {
        .post-list-head { gap: 0.6rem; padding: 0 0.15rem; }
        .post-list-title { font-size: 1rem; }
        .post-list-page { display: none; }
    }
</style>
