---
import { Icon } from "astro-icon/components";
import type { SiteContentStats } from "../utils/content-utils";

interface Props {
	contentStats: SiteContentStats;
}

const { contentStats } = Astro.props;
const formatNumber = new Intl.NumberFormat("zh-CN");
const SITE_START_DATE = "2025-12-01";
const UMAMI_API_BASE = "https://cloud.umami.is/analytics/us";
const UMAMI_SHARE_ID = "1Dc4PAeDKgLAox0M";
---

<section id="stats-garden" class="stats-garden" aria-labelledby="stats-title" data-stats-state="idle">
	<div class="stats-decoration stats-decoration-heart" aria-hidden="true">♡</div>
	<div class="stats-decoration stats-decoration-star" aria-hidden="true">✦</div>
	<div class="stats-decoration stats-decoration-note" aria-hidden="true">♪</div>

	<header class="stats-header">
		<div>
			<div class="stats-eyebrow">
				<Icon name="material-symbols:auto-awesome-rounded" />
				<span>SITE DIARY</span>
				<span aria-hidden="true">(｡•ᴗ•｡)ﾉ♡</span>
			</div>
			<h1 id="stats-title">今天也有人路过这里</h1>
			<p>每一次访问，都是小站悄悄收藏的一枚脚印。</p>
		</div>
		<div id="stats-sync-status" class="stats-sync-status" aria-live="polite">
			<span class="stats-live-dot"></span>
			<span>正在数脚印...</span>
		</div>
	</header>

	<div class="stats-cards" aria-label="网站访问概览">
		<article class="stats-card stats-card-pink">
			<div class="stats-card-icon"><Icon name="material-symbols:group-outline-rounded" /></div>
			<div class="stats-card-copy">
				<span>来过的旅人</span>
				<strong id="stats-visitors">···</strong>
				<small>位朋友发现了这里</small>
			</div>
			<span class="stats-card-face" aria-hidden="true">(˶ᵔ ᵕ ᵔ˶)</span>
		</article>

		<article class="stats-card stats-card-peach">
			<div class="stats-card-icon"><Icon name="material-symbols:visibility-outline-rounded" /></div>
			<div class="stats-card-copy">
				<span>留下的足迹</span>
				<strong id="stats-pageviews">···</strong>
				<small>次页面被轻轻翻开</small>
			</div>
			<span class="stats-card-face" aria-hidden="true">₍ᐢ. .ᐢ₎</span>
		</article>

		<article class="stats-card stats-card-purple">
			<div class="stats-card-icon"><Icon name="material-symbols:favorite-outline-rounded" /></div>
			<div class="stats-card-copy">
				<span>相遇的次数</span>
				<strong id="stats-visits">···</strong>
				<small>次与小站再次碰面</small>
			</div>
			<span class="stats-card-face" aria-hidden="true">♡⸜(˶˃ ᵕ ˂˶)⸝</span>
		</article>

		<article class="stats-card stats-card-blue">
			<div class="stats-card-icon"><Icon name="material-symbols:schedule-rounded" /></div>
			<div class="stats-card-copy">
				<span>平均停留</span>
				<strong id="stats-duration">···</strong>
				<small>慢慢看看，不着急走</small>
			</div>
			<span class="stats-card-face" aria-hidden="true">(づ˶•༝•˶)づ</span>
		</article>
	</div>

	<div class="stats-story-grid">
		<section class="stats-chart-panel" aria-labelledby="stats-chart-title">
			<div class="stats-section-heading">
				<div>
					<span class="stats-section-kicker">VISIT FOOTPRINTS</span>
					<h2 id="stats-chart-title">访问足迹</h2>
				</div>
				<div class="stats-chart-legend"><span></span> 每月浏览量</div>
			</div>
			<div id="stats-chart" class="stats-chart" aria-label="每月浏览量柱状图">
				<div class="stats-chart-loading">正在把脚印画成小山丘... ✎﹏</div>
			</div>
			<div class="stats-chart-footer">
				<span id="stats-chart-summary">等待数据寄来一封信 ✉</span>
				<span id="stats-updated-at"></span>
			</div>
		</section>

		<aside class="stats-note-panel">
			<div class="stats-note-tape" aria-hidden="true"></div>
			<span class="stats-section-kicker">ABOUT THIS LITTLE SITE</span>
			<h2>小站手账</h2>
			<p class="stats-running-copy">已经认真营业 <strong id="stats-running-days">···</strong> 天啦！</p>
			<div class="stats-content-list">
				<div><span>文章</span><strong>{formatNumber.format(contentStats.postCount)}</strong><small>篇</small></div>
				<div><span>文字</span><strong>{formatNumber.format(contentStats.wordCount)}</strong><small>字</small></div>
				<div><span>分类</span><strong>{formatNumber.format(contentStats.categoryCount)}</strong><small>个</small></div>
				<div><span>标签</span><strong>{formatNumber.format(contentStats.tagCount)}</strong><small>枚</small></div>
			</div>
			<div class="stats-note-bottom">
				<span id="stats-bounce-note">正在整理今日手账...</span>
				<span aria-hidden="true">꒰ঌ(っ˘꒳˘ｃ)໒꒱</span>
			</div>
		</aside>
	</div>

	<div class="stats-insights-grid">
		<section class="stats-insight-panel" aria-labelledby="stats-environment-title">
			<div class="stats-section-heading stats-insight-heading">
				<div>
					<span class="stats-section-kicker">VISIT ENVIRONMENT</span>
					<h2 id="stats-environment-title">访问环境</h2>
				</div>
				<span class="stats-insight-face" aria-hidden="true">⌨︎(｡•̀ᴗ-)✧</span>
			</div>
			<div class="stats-metric-tabs" data-metric-tabs="environment" aria-label="访问环境分类">
				<button type="button" data-metric-type="browser" class="is-active">浏览器</button>
				<button type="button" data-metric-type="os">系统</button>
				<button type="button" data-metric-type="device">设备</button>
			</div>
			<div id="stats-environment-list" class="stats-metric-list"><div class="stats-metric-loading">正在整理访问环境…</div></div>
		</section>

		<section class="stats-insight-panel" aria-labelledby="stats-location-title">
			<div class="stats-section-heading stats-insight-heading">
				<div>
					<span class="stats-section-kicker">VISITOR MAP</span>
					<h2 id="stats-location-title">地区足迹</h2>
				</div>
				<span class="stats-insight-face" aria-hidden="true">⌖ ૮ ˶ᵔ ᵕ ᵔ˶ ა</span>
			</div>
			<div class="stats-metric-tabs" data-metric-tabs="location" aria-label="访问地区分类">
				<button type="button" data-metric-type="country" class="is-active">国家</button>
				<button type="button" data-metric-type="region">州 / 省</button>
				<button type="button" data-metric-type="city">城市</button>
			</div>
			<div id="stats-location-list" class="stats-metric-list"><div class="stats-metric-loading">正在把足迹放上地图…</div></div>
		</section>
	</div>

	<footer class="stats-footer-note">
		<span aria-hidden="true">🌸</span>
		<span>数字会增长，愿每一次相遇都仍然柔软。</span>
		<span>Data by Umami</span>
	</footer>
</section>

<script is:inline define:vars={{ SITE_START_DATE, UMAMI_API_BASE, UMAMI_SHARE_ID }}>
	(() => {
		const numberFormat = new Intl.NumberFormat('zh-CN');

		function setText(id, value) {
			const element = document.getElementById(id);
			if (element) element.textContent = value;
		}

		function formatDuration(totalSeconds) {
			const seconds = Math.max(0, Math.round(totalSeconds));
			const minutes = Math.floor(seconds / 60);
			const remainingSeconds = seconds % 60;
			if (minutes >= 60) {
				const hours = Math.floor(minutes / 60);
				return `${hours}时${minutes % 60}分`;
			}
			return `${minutes}分${remainingSeconds}秒`;
		}

		function renderChart(points) {
			const chart = document.getElementById('stats-chart');
			if (!chart) return;
			chart.replaceChildren();

			const values = points.map((point) => Number(point.y) || 0);
			const maxValue = Math.max(...values, 1);
			const fragment = document.createDocumentFragment();

			points.forEach((point) => {
				const value = Number(point.y) || 0;
				const item = document.createElement('div');
				item.className = 'stats-chart-item';
				item.title = `${new Date(point.x).toLocaleDateString('zh-CN', { month: 'long', timeZone: 'Asia/Hong_Kong' })}：${numberFormat.format(value)} 次浏览`;

				const valueLabel = document.createElement('span');
				valueLabel.className = 'stats-chart-value';
				valueLabel.textContent = numberFormat.format(value);

				const track = document.createElement('span');
				track.className = 'stats-chart-track';
				const bar = document.createElement('span');
				bar.className = 'stats-chart-bar';
				bar.style.height = `${Math.max(8, (value / maxValue) * 100)}%`;
				track.appendChild(bar);

				const month = document.createElement('span');
				month.className = 'stats-chart-month';
				month.textContent = new Date(point.x).toLocaleDateString('zh-CN', { month: 'numeric', timeZone: 'Asia/Hong_Kong' }).replace('/', '月');

				item.append(valueLabel, track, month);
				fragment.appendChild(item);
			});

			chart.appendChild(fragment);
		}

		const metricNames = {
			browser: { chrome: 'Chrome', 'edge-chromium': 'Edge', crios: 'Chrome（iOS）', firefox: 'Firefox', ios: 'iOS 浏览器', 'edge-ios': 'Edge（iOS）', opera: 'Opera' },
			os: { 'windows 10': 'Windows 10 / 11', 'android os': 'Android', 'mac os': 'macOS' },
			device: { laptop: '笔记本电脑', desktop: '台式电脑', mobile: '手机', tablet: '平板设备' },
		};
		const regionNames = typeof Intl.DisplayNames === 'function' ? new Intl.DisplayNames(['zh-CN'], { type: 'region' }) : null;
		const subdivisionNames = {
			CN: { BJ: '北京市', SH: '上海市', TJ: '天津市', CQ: '重庆市', GD: '广东省', HN: '湖南省', HB: '湖北省', ZJ: '浙江省', JS: '江苏省', FJ: '福建省', SC: '四川省', SD: '山东省', HA: '河南省', HE: '河北省', AH: '安徽省', JX: '江西省', GX: '广西壮族自治区', HI: '海南省', YN: '云南省', XZ: '西藏自治区', SN: '陕西省' },
			US: { CA: '加利福尼亚州', TX: '得克萨斯州', UT: '犹他州', NY: '纽约州', WA: '华盛顿州', OR: '俄勒冈州', FL: '佛罗里达州', IL: '伊利诺伊州', VA: '弗吉尼亚州', IA: '爱荷华州' },
			JP: { '01': '北海道', '13': '东京都', '14': '神奈川县', '23': '爱知县', '26': '京都府', '27': '大阪府', '28': '兵库县', '40': '福冈县', '47': '冲绳县' },
		};
		const flagFor = (code) => /^[A-Z]{2}$/.test(code || '') ? String.fromCodePoint(...code.split('').map((char) => 127397 + char.charCodeAt(0))) : '•';
		const countryLabel = (code) => {
			try { return regionNames?.of(code) || code; } catch { return code; }
		};

		function metricLabel(item, type) {
			const value = String(item.x || '未知');
			if (type === 'country') {
				return countryLabel(value);
			}
			if (type === 'region') {
				const [countryCode, ...subdivisionParts] = value.toUpperCase().split('-');
				const subdivisionCode = subdivisionParts.join('-');
				if (!subdivisionCode) return countryLabel(countryCode);
				const subdivision = subdivisionNames[countryCode]?.[subdivisionCode] || subdivisionCode;
				return `${countryLabel(countryCode)} · ${subdivision}`;
			}
			return metricNames[type]?.[value.toLowerCase()] || value;
		}

		function renderMetricList(listId, points, type, totalVisitors) {
			const list = document.getElementById(listId);
			if (!list) return;
			list.replaceChildren();
			if (!Array.isArray(points) || points.length === 0) {
				list.innerHTML = '<div class="stats-metric-loading">这里还没有留下足迹 (｡•́︿•̀｡)</div>';
				return;
			}
			const fragment = document.createDocumentFragment();
			points.forEach((item) => {
				const value = Number(item.y) || 0;
				const percent = totalVisitors > 0 ? Math.max(1, Math.round((value / totalVisitors) * 100)) : 0;
				const row = document.createElement('div');
				row.className = 'stats-metric-row';
				const symbol = document.createElement('span');
				symbol.className = `stats-metric-symbol${type === 'country' ? ' is-flag' : ''}`;
				symbol.textContent = type === 'country' ? flagFor(String(item.x || '').toUpperCase()) : '✦';
				const copy = document.createElement('span');
				copy.className = 'stats-metric-copy';
				const name = document.createElement('span');
				name.textContent = metricLabel(item, type);
				const track = document.createElement('span');
				track.className = 'stats-metric-track';
				const bar = document.createElement('span');
				bar.style.width = `${Math.min(100, percent)}%`;
				track.appendChild(bar);
				copy.append(name, track);
				const count = document.createElement('span');
				count.className = 'stats-metric-count';
				count.innerHTML = `<strong>${numberFormat.format(value)}</strong><small>${percent}%</small>`;
				row.append(symbol, copy, count);
				fragment.appendChild(row);
			});
			list.appendChild(fragment);
		}

		function setupMetricTabs(group, listId, datasets, totalVisitors) {
			const tabs = document.querySelector(`[data-metric-tabs="${group}"]`);
			if (!tabs) return;
			const render = (type) => {
				tabs.querySelectorAll('button').forEach((button) => {
					const active = button.dataset.metricType === type;
					button.classList.toggle('is-active', active);
					button.setAttribute('aria-pressed', String(active));
				});
				renderMetricList(listId, datasets[type] || [], type, totalVisitors);
			};
			tabs.addEventListener('click', (event) => {
				const button = event.target.closest('button[data-metric-type]');
				if (button) render(button.dataset.metricType);
			});
			render(group === 'environment' ? 'browser' : 'country');
		}

		async function initStatsGarden() {
			const root = document.getElementById('stats-garden');
			if (!root || root.dataset.statsState === 'loading' || root.dataset.statsState === 'loaded') return;
			root.dataset.statsState = 'loading';

			const startAt = new Date(SITE_START_DATE).getTime();
			const endAt = Date.now();
			const runningDays = Math.max(0, Math.floor((endAt - startAt) / 86400000));
			setText('stats-running-days', numberFormat.format(runningDays));

			try {
				const shareResponse = await fetch(`${UMAMI_API_BASE}/api/share/${UMAMI_SHARE_ID}`, {
					headers: { Accept: 'application/json' },
				});
				if (!shareResponse.ok) throw new Error(`Share request failed: ${shareResponse.status}`);
				const share = await shareResponse.json();
				if (!share.websiteId || !share.token) throw new Error('Share data is incomplete');

				const query = new URLSearchParams({ startAt: String(startAt), endAt: String(endAt) });
				const chartQuery = new URLSearchParams({
					startAt: String(startAt),
					endAt: String(endAt),
					unit: 'month',
					timezone: 'Asia/Hong_Kong',
				});
				const headers = {
					Accept: 'application/json',
					'x-umami-share-token': share.token,
					'x-umami-share-context': '1',
				};
				const metricUrl = (type) => {
					const metricQuery = new URLSearchParams({ startAt: String(startAt), endAt: String(endAt), type, limit: '12' });
					return `${UMAMI_API_BASE}/api/websites/${share.websiteId}/metrics?${metricQuery}`;
				};

				const metricTypes = ['browser', 'os', 'device', 'country', 'region', 'city'];
				const [statsResponse, chartResponse, ...metricResponses] = await Promise.all([
					fetch(`${UMAMI_API_BASE}/api/websites/${share.websiteId}/stats?${query}`, { headers }),
					fetch(`${UMAMI_API_BASE}/api/websites/${share.websiteId}/pageviews?${chartQuery}`, { headers }),
					...metricTypes.map((type) => fetch(metricUrl(type), { headers })),
				]);
				if (!statsResponse.ok || !chartResponse.ok || metricResponses.some((response) => !response.ok)) throw new Error('Statistics request failed');

				const [stats, chartData, ...metricData] = await Promise.all([statsResponse.json(), chartResponse.json(), ...metricResponses.map((response) => response.json())]);
				const metrics = Object.fromEntries(metricTypes.map((type, index) => [type, metricData[index]]));
				const visits = Number(stats.visits) || 0;
				const bounces = Number(stats.bounces) || 0;
				const averageDuration = visits > 0 ? (Number(stats.totaltime) || 0) / visits : 0;
				const bounceRate = visits > 0 ? Math.round((bounces / visits) * 100) : 0;

				setText('stats-visitors', numberFormat.format(Number(stats.visitors) || 0));
				setText('stats-pageviews', numberFormat.format(Number(stats.pageviews) || 0));
				setText('stats-visits', numberFormat.format(visits));
				setText('stats-duration', formatDuration(averageDuration));
				setText('stats-bounce-note', `有 ${100 - bounceRate}% 的相遇愿意继续逛逛`);
				setText('stats-chart-summary', `一共收集了 ${numberFormat.format(Number(stats.pageviews) || 0)} 枚浏览脚印`);
				setText('stats-updated-at', `更新于 ${new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}`);
				renderChart(Array.isArray(chartData.pageviews) ? chartData.pageviews : []);
				const totalVisitors = Number(stats.visitors) || 0;
				setupMetricTabs('environment', 'stats-environment-list', metrics, totalVisitors);
				setupMetricTabs('location', 'stats-location-list', metrics, totalVisitors);

				const status = document.getElementById('stats-sync-status');
				if (status) status.lastElementChild.textContent = '脚印已数好';
				root.dataset.statsState = 'loaded';
			} catch (error) {
				console.error('[StatsGarden] Failed to load statistics.', error);
				const status = document.getElementById('stats-sync-status');
				if (status) status.lastElementChild.textContent = '数据暂时睡着了';
				const chart = document.getElementById('stats-chart');
				if (chart) chart.innerHTML = '<div class="stats-chart-loading">今天的数据在打盹，晚点再来看看吧 (｡•́︿•̀｡)</div>';
				root.dataset.statsState = 'error';
			}
		}

		initStatsGarden();
		if (window.swup && !window.__statsGardenHookRegistered) {
			window.__statsGardenHookRegistered = true;
			window.swup.hooks.on('page:view', initStatsGarden);
		}
	})();
</script>

<style>
	.stats-garden {
		position: relative;
		isolation: isolate;
		width: min(100%, 72rem);
		margin: 0 auto;
		padding: clamp(1.2rem, 3vw, 2.25rem);
		border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--glass-border));
		border-radius: 2.2rem;
		background:
			radial-gradient(circle at 94% 5%, color-mix(in srgb, var(--primary) 15%, transparent) 0 5rem, transparent 11rem),
			radial-gradient(circle at 3% 94%, color-mix(in srgb, var(--azusa-blue) 9%, transparent) 0 4rem, transparent 10rem),
			linear-gradient(135deg, color-mix(in srgb, var(--cream-base) 93%, white), color-mix(in srgb, var(--cream-base) 80%, var(--primary) 5%));
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.62),
			0 1.5rem 4rem color-mix(in srgb, var(--tea) 12%, transparent);
		overflow: hidden;
	}
	.stats-garden::before {
		content: "";
		position: absolute;
		inset: 0.65rem;
		z-index: -1;
		border: 1px dashed color-mix(in srgb, var(--primary) 16%, transparent);
		border-radius: 1.75rem;
		pointer-events: none;
	}
	.stats-decoration {
		position: absolute;
		z-index: -1;
		color: color-mix(in srgb, var(--primary) 24%, transparent);
		font-weight: 900;
		pointer-events: none;
	}
	.stats-decoration-heart { right: 4%; top: 8.5rem; font-size: 2.8rem; transform: rotate(12deg); }
	.stats-decoration-star { left: 1.3rem; top: 46%; font-size: 1.25rem; }
	.stats-decoration-note { right: 1.6rem; bottom: 4rem; font-size: 1.5rem; transform: rotate(-12deg); }
	.stats-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1.75rem;
		padding: 0.45rem 0.5rem 0;
	}
	.stats-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.45rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.13em;
	}
	.stats-eyebrow :global(svg) { width: 1rem; height: 1rem; }
	.stats-header h1 {
		margin: 0;
		color: color-mix(in srgb, var(--tea) 86%, black);
		font-size: clamp(1.85rem, 4vw, 3rem);
		font-weight: 900;
		letter-spacing: -0.035em;
		line-height: 1.12;
	}
	.stats-header p {
		margin: 0.65rem 0 0;
		color: color-mix(in srgb, var(--tea) 60%, transparent);
		font-size: 0.92rem;
	}
	.stats-sync-status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		flex: none;
		margin-top: 0.5rem;
		padding: 0.55rem 0.85rem;
		border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.48);
		color: color-mix(in srgb, var(--tea) 70%, transparent);
		font-size: 0.75rem;
		font-weight: 700;
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.7);
	}
	.stats-live-dot {
		width: 0.48rem;
		height: 0.48rem;
		border-radius: 50%;
		background: #72c995;
		box-shadow: 0 0 0 0.25rem rgb(114 201 149 / 0.13);
		animation: stats-breathe 1.8s ease-in-out infinite;
	}
	.stats-cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.85rem;
	}
	.stats-card {
