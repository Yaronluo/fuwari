---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { dot, href, label }: Props = Astro.props;
---
<a href={href} aria-label={label} class="transition-all duration-300 h-8 text-sm px-4 rounded-full border border-black/10 dark:border-white/10 hover:border-[var(--primary)] hover:bg-[var(--btn-regular-bg)] hover:text-[var(--primary)] dark:hover:text-[var(--primary)] text-neutral-600 dark:text-neutral-400 flex items-center justify-center">
    {dot && <div class="h-1 w-1 bg-current transition rounded-md mr-2"></div>}
    <slot></slot>
</a>
