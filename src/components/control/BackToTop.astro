---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper">
    <button id="back-to-top-btn" type="button" class="back-to-top-btn hide" onclick="backToTop()" aria-label="返回顶部" title="返回顶部">
        <Icon name="material-symbols:arrow-upward-rounded" class="back-to-top-icon"></Icon>
        <span class="back-to-top-label" aria-hidden="true">TOP</span>
    </button>
</div>

<style>
    .back-to-top-wrapper {
        position: fixed;
        right: max(1rem, calc((100vw - var(--page-width)) / 2 - 4.5rem));
        bottom: calc(1.5rem + env(safe-area-inset-bottom));
        z-index: 60;
        pointer-events: none;
    }

    .back-to-top-btn {
        position: relative;
        display: flex;
        width: 3.25rem;
        height: 3.25rem;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.05rem;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, white 62%, var(--glass-border));
        border-radius: 1.15rem;
        color: var(--primary);
        background:
            linear-gradient(145deg, rgb(255 255 255 / 0.58), color-mix(in srgb, var(--cream-base) 72%, transparent));
        backdrop-filter: blur(24px) saturate(145%);
        -webkit-backdrop-filter: blur(24px) saturate(145%);
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.78),
            0 0.65rem 1.6rem rgb(119 80 69 / 0.13);
        opacity: 1;
        cursor: pointer;
        pointer-events: auto;
        transform: translateY(0) scale(1);
        transition: opacity 220ms ease, transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }

    .back-to-top-btn::after {
        content: "✦";
        position: absolute;
        top: 0.32rem;
        right: 0.42rem;
        color: color-mix(in srgb, var(--primary) 58%, transparent);
        font-size: 0.48rem;
        line-height: 1;
    }

    .back-to-top-icon {
        width: 1.25rem;
        height: 1.25rem;
    }

    .back-to-top-label {
        font-size: 0.48rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.12em;
        opacity: 0.66;
        transform: translateX(0.04em);
    }

    .back-to-top-btn:hover {
        border-color: color-mix(in srgb, var(--primary) 28%, white);
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.86),
            0 0.8rem 1.8rem rgb(119 80 69 / 0.17);
        transform: translateY(-0.18rem) scale(1.04);
    }

    .back-to-top-btn:active {
        transform: translateY(0) scale(0.93);
    }

    .back-to-top-btn:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--primary) 65%, white);
        outline-offset: 3px;
    }

    .back-to-top-btn.hide {
        opacity: 0;
        pointer-events: none;
        transform: translateY(0.75rem) scale(0.88);
    }

    :global(.dark) .back-to-top-btn {
        border-color: rgb(255 255 255 / 0.12);
        background: linear-gradient(145deg, rgb(255 255 255 / 0.08), color-mix(in srgb, var(--cream-base) 75%, transparent));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 0.75rem 1.7rem rgb(0 0 0 / 0.28);
    }

    @media (max-width: 767px) {
        .back-to-top-wrapper {
            right: 1rem;
            bottom: calc(1.25rem + env(safe-area-inset-bottom));
        }

        .back-to-top-btn {
            width: 3rem;
            height: 3rem;
            border-radius: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .back-to-top-btn {
            transition: opacity 120ms ease;
        }
    }
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
