    }
    .atlas-you i {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: var(--primary);
        animation: atlas-you-pulse 2.6s ease-in-out infinite;
    }

    .atlas-route {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        transform: translate3d(calc(var(--px, 0) * 0.4px), calc(var(--py, 0) * 0.4px), 0);
    }
    .atlas-line,
    .atlas-flow,
    .atlas-runner {
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .atlas-line {
        stroke: color-mix(in srgb, var(--primary) 42%, transparent);
        stroke-width: 1.6;
        stroke-dasharray: 3 2.4;
        animation: atlas-flow 22s linear infinite;
    }
    .atlas-flow {
        stroke: color-mix(in srgb, var(--azusa-blue) 60%, transparent);
        stroke-width: 1.2;
        stroke-dasharray: 0.4 9.6;
        animation: atlas-flow 9s linear infinite reverse;
    }
    .atlas-runner {
        stroke: var(--primary);
        stroke-width: 3.4;
        stroke-dasharray: 0.55 100;
        animation: atlas-run 7.5s linear infinite;
    }

    .atlas-pins {
        position: absolute;
        inset: 0;
        z-index: 2;
        transform: translate3d(calc(var(--px, 0) * 1px), calc(var(--py, 0) * 1px), 0);
        transition: transform 0.5s ease-out;
    }
    .atlas-pin {
        position: absolute;
        left: calc(var(--x) * 1%);
        top: calc(var(--y) * 1%);
        display: flex;
        align-items: center;
        gap: 0.3rem;
        transform: translate(-50%, -50%);
        transition: transform 0.26s cubic-bezier(0.22, 0.68, 0, 1);
    }
    .atlas-pin:hover {
        transform: translate(-50%, -50%) scale(1.06);
    }
    .pin-dot {
        position: relative;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        width: 0.74rem;
        height: 0.74rem;
        border-radius: 999px;
        background: var(--tone);
        box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--tone) 16%, transparent);
    }
    .pin-dot i {
        width: 0.26rem;
        height: 0.26rem;
        border-radius: 999px;
        background: color-mix(in srgb, white 82%, var(--tone));
    }
    .pin-dot::after {
        content: '';
        position: absolute;
        inset: -0.28rem;
        border: 1px solid var(--tone);
        border-radius: 999px;
        opacity: 0;
        animation: pin-pulse 3.6s ease-out calc(var(--i) * 0.55s) infinite;
    }
    .pin-label {
        display: inline-flex;
        align-items: center;
        gap: 0.26rem;
        padding: 0.14rem 0.44rem;
        border: 1px solid color-mix(in srgb, var(--tone) 26%, var(--glass-border));
        border-radius: 999px;
        background: color-mix(in srgb, var(--glass-card) 88%, transparent);
        backdrop-filter: blur(6px);
        color: var(--text-body);
        font-size: 0.66rem;
        white-space: nowrap;
        transition: border-color 0.24s ease, color 0.24s ease;
    }
    .pin-label b {
        font-weight: 700;
    }
    .pin-label small {
        color: color-mix(in srgb, var(--tone) 85%, var(--text-muted));
        font-size: 0.6rem;
        font-weight: 700;
    }
    .atlas-pin:hover .pin-label {
        border-color: color-mix(in srgb, var(--tone) 55%, transparent);
        color: color-mix(in srgb, var(--tone) 88%, var(--text-strong));
    }
    /* 还没被写到的坐标 */
    .atlas-unknown {
        position: absolute;
        left: calc(var(--x) * 1%);
        top: calc(var(--y) * 1%);
        display: grid;
        place-items: center;
        width: 1.05rem;
        height: 1.05rem;
        border: 1px dashed color-mix(in srgb, var(--text-muted) 45%, transparent);
        border-radius: 999px;
        color: color-mix(in srgb, var(--text-muted) 70%, transparent);
        font-size: 0.6rem;
        font-weight: 700;
        transform: translate(-50%, -50%);
        animation: atlas-unknown 5.5s ease-in-out infinite;
    }
    .atlas-unknown:nth-of-type(2) {
        animation-delay: 1.6s;
    }

    .atlas-compass {
        position: absolute;
        right: 0.75rem;
        top: 0.75rem;
        z-index: 3;
        width: 3.6rem;
        height: 3.6rem;
        opacity: 1;
    }
    .atlas-compass svg {
        width: 100%;
        height: 100%;
        animation: compass-spin 40s linear infinite;
    }
    .compass-ring {
        fill: none;
        stroke: color-mix(in srgb, var(--primary) 34%, transparent);
        stroke-width: 1;
        stroke-dasharray: 2 3;
    }
    .compass-ring.is-inner {
        stroke-dasharray: 1 4;
        opacity: 0.7;
    }
    .compass-tick {
        stroke: color-mix(in srgb, var(--primary) 45%, transparent);
        stroke-width: 1.4;
        stroke-linecap: round;
    }
    .compass-needle {
        fill: color-mix(in srgb, var(--primary) 62%, transparent);
    }
    .compass-core {
        fill: var(--primary);
    }

    /* ------------------------------------------------------------ 图例条 */
    .hero-legend {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        margin-top: 1.3rem;
        padding-top: 0.85rem;
        border-top: 1px dashed color-mix(in srgb, var(--primary) 20%, transparent);
        color: var(--text-muted);
        font-size: 0.66rem;
    }
    .hero-legend > span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .hero-legend em {
        margin-left: auto;
        color: color-mix(in srgb, var(--primary) 70%, var(--text-muted));
        font-size: 0.64rem;
        font-style: normal;
    }
    .legend-route {
        width: 1.4rem;
        border-top: 2px dashed color-mix(in srgb, var(--primary) 55%, transparent);
    }
    .legend-area {
        width: 0.72rem;
        height: 0.72rem;
        border: 1px solid color-mix(in srgb, var(--azusa-blue) 55%, transparent);
        border-radius: 0.24rem;
        background: color-mix(in srgb, var(--azusa-blue) 22%, transparent);
    }
    .legend-glyph {
        color: color-mix(in srgb, var(--primary) 78%, var(--text-muted));
        font-style: normal;
        font-weight: 800;
    }

    /* ============================================================ 通用分节 */
    .map-section {
        margin-top: 1rem;
        padding: 1.4rem 1.45rem;
        border-radius: 1.5rem;
    }
    .section-heading {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1.15rem;
    }
    .section-icon {
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 0.9rem;
        font-size: 1.35rem;
    }
    .icon-primary {
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 12%, transparent);
    }
    .icon-blue {
        color: var(--azusa-blue);
        background: color-mix(in srgb, var(--azusa-blue) 14%, transparent);
    }
    .icon-purple {
        color: var(--mio-purple);
        background: color-mix(in srgb, var(--mio-purple) 14%, transparent);
    }
    .icon-tea {
        color: var(--tea);
        background: color-mix(in srgb, var(--tea) 14%, transparent);
    }
    .section-title p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.18em;
    }
    .section-title h2 {
        margin: 0.12rem 0 0;
        color: var(--text-strong);
        font-size: 1.16rem;
    }
    .section-note {
        margin-left: auto;
        color: var(--text-muted);
        font-size: 0.68rem;
    }
    .panel-foot {
        margin: auto 0 0;
        padding-top: 0.7rem;
        border-top: 1px dashed color-mix(in srgb, var(--primary) 16%, transparent);
        color: var(--text-muted);
        font-size: 0.64rem;
    }
    /* 两栏卡片内部用纵向 flex，页脚就会贴在卡片底部，左右高度看起来才齐 */
    .territory-section,
    .tag-section {
        display: flex;
        flex-direction: column;
    }

    /* ========================================================== 从这里出发 */
    .start-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
        gap: 0.8rem;
    }
    .start-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.42rem;
        padding: 1rem 1.05rem;
        border: 1px solid color-mix(in srgb, var(--tone) 20%, var(--glass-border));
        border-radius: 1.15rem;
        background:
            linear-gradient(158deg, color-mix(in srgb, var(--tone) 9%, transparent), transparent 62%),
            color-mix(in srgb, var(--glass-card) 84%, transparent);
        overflow: hidden;
        transition: transform 0.28s cubic-bezier(0.22, 0.68, 0, 1), border-color 0.28s ease, box-shadow 0.28s ease;
    }
    .start-card > * {
        position: relative;
        z-index: 1;
    }
    .start-card::before {
        content: '';
        position: absolute;
        right: -1.7rem;
        bottom: -1.9rem;
        width: 5.4rem;
        height: 5.4rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--tone) 13%, transparent);
        transition: transform 0.45s cubic-bezier(0.22, 0.68, 0, 1);
    }
    .start-card:hover {
        transform: translateY(-0.28rem);
        border-color: color-mix(in srgb, var(--tone) 45%, transparent);
        box-shadow: 0 1rem 2rem color-mix(in srgb, var(--tone) 16%, transparent);
    }
    .start-card:hover::before {
        transform: scale(1.3);
    }
    .start-badge {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 0.26rem;
        padding: 0.22rem 0.5rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--tone) 14%, transparent);
        color: color-mix(in srgb, var(--tone) 86%, var(--text-strong));
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }
    .start-badge > :global(svg) {
        font-size: 0.86rem;
    }
    .start-title {
        margin: 0;
        color: var(--text-strong);
        font-size: 0.92rem;
        font-weight: 750;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .start-desc {
        margin: 0;
        min-height: 2.4em;
        color: var(--text-muted);
        font-size: 0.72rem;
        line-height: 1.6;
    }
    .start-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.24rem 0.6rem;
        margin-top: auto;
        padding-top: 0.2rem;
        color: var(--text-muted);
        font-size: 0.63rem;
    }
    .start-meta > span {
        display: inline-flex;
        align-items: center;
        gap: 0.22rem;
    }
    .start-meta > span > :global(svg) {
        font-size: 0.82rem;
        color: color-mix(in srgb, var(--tone) 70%, var(--text-muted));
    }
    .start-go {
        display: inline-flex;
        align-items: center;
        gap: 0.24rem;
        color: color-mix(in srgb, var(--tone) 85%, var(--text-body));
        font-size: 0.68rem;
        font-weight: 700;
        opacity: 0;
        transform: translateX(-0.2rem);
        transition: opacity 0.26s ease, transform 0.26s ease;
    }
    .start-card:hover .start-go {
        opacity: 1;
        transform: none;
    }

    .start-card--shuffle {
        border-style: dashed;
        background:
            repeating-linear-gradient(135deg, color-mix(in srgb, var(--tone) 5%, transparent) 0 0.55rem, transparent 0.55rem 1.25rem),
            color-mix(in srgb, var(--glass-card) 84%, transparent);
    }
    .start-card--shuffle::before {
        display: none;
    }
    .shuffle-link {
        color: inherit;
    }
    .shuffle-btn {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 0.3rem;
        margin-top: 0.55rem;
        padding: 0.34rem 0.66rem;
        border: 1px solid color-mix(in srgb, var(--tone) 32%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--tone) 11%, transparent);
        color: color-mix(in srgb, var(--tone) 88%, var(--text-strong));
        font-size: 0.66rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.22s ease, background-color 0.22s ease;
    }
    .shuffle-btn:hover {
        transform: translateY(-0.12rem);
        background: color-mix(in srgb, var(--tone) 20%, transparent);
    }
    .start-card--shuffle.is-shuffling [data-map-shuffle-title],
    .start-card--shuffle.is-shuffling [data-map-shuffle-desc],
    .start-card--shuffle.is-shuffling .start-meta {
        animation: shuffle-pop 0.62s cubic-bezier(0.22, 0.68, 0, 1);
    }
    .start-card--shuffle.is-shuffling .start-desc {
        animation-delay: 40ms;
    }
    .start-card--shuffle.is-shuffling .start-meta {
        animation-delay: 80ms;
    }

    /* ============================================================ 系列路线 */
    .route-list {
        display: grid;
        gap: 0.9rem;
    }
    .route-card {
        position: relative;
        padding: 1.05rem 1.15rem 1.15rem;
        border: 1px solid color-mix(in srgb, var(--tone) 18%, var(--glass-border));
        border-radius: 1.25rem;
        background:
            linear-gradient(152deg, color-mix(in srgb, var(--tone) 7%, transparent), transparent 56%),
            color-mix(in srgb, var(--glass-card) 78%, transparent);
    }
    .route-head {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 0.95rem;
    }
    .route-index {
        display: grid;
        place-items: center;
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 0.65rem;
        background: color-mix(in srgb, var(--tone) 13%, transparent);
        color: color-mix(in srgb, var(--tone) 86%, var(--text-strong));
        font-size: 0.72rem;
        font-weight: 800;
    }
    .route-titles p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.56rem;
        font-weight: 700;
        letter-spacing: 0.18em;
    }
    .route-titles h3 {
        margin: 0.1rem 0 0;
        font-size: 1.02rem;
    }
    .route-titles h3 a {
        color: var(--text-strong);
        transition: color 0.22s ease;
    }
    .route-titles h3 a:hover {
        color: var(--tone);
    }
    .route-meta {
        margin-left: auto;
        color: var(--text-muted);
        font-size: 0.68rem;
    }
    .route-more {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        padding: 0.28rem 0.58rem;
        border: 1px dashed color-mix(in srgb, var(--tone) 32%, transparent);
        border-radius: 999px;
        color: color-mix(in srgb, var(--tone) 85%, var(--text-body));
        font-size: 0.64rem;
        transition: background-color 0.22s ease, transform 0.22s ease;
    }
    .route-more:hover {
        transform: translateX(0.12rem);
        background: color-mix(in srgb, var(--tone) 10%, transparent);
    }

    .route-lines {
        display: grid;
        gap: 0.7rem;
    }
    .route-line {
        padding: 0.65rem 0.8rem 0.8rem;
        border: 1px solid color-mix(in srgb, var(--tone) 10%, transparent);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--tone) 4%, transparent);
    }
    .line-head {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
    }
    .line-bullet {
        display: grid;
        place-items: center;
        width: 1.05rem;
        height: 1.05rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--tone) 18%, transparent);
    }
    .line-bullet i {
        width: 0.42rem;
        height: 0.42rem;
        border-radius: 999px;
        background: var(--tone);
    }
    .line-name {
        color: var(--text-body);
        font-size: 0.86rem;
        font-weight: 750;
        transition: color 0.22s ease;
    }
    .line-name:hover {
        color: var(--tone);
    }
    .line-count {
        padding: 0.14rem 0.45rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--tone) 11%, transparent);
        color: color-mix(in srgb, var(--tone) 82%, var(--text-muted));
        font-size: 0.6rem;
        font-weight: 700;
    }
    .line-hint {
        display: inline-flex;
        align-items: center;
        gap: 0.18rem;
        margin-left: auto;
        color: var(--text-muted);
        font-size: 0.62rem;
    }
    .line-hint > :global(svg) {
        color: color-mix(in srgb, var(--tone) 70%, var(--text-muted));
    }

    .line-track {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.6rem;
        margin: 0;
        padding: 1.35rem 0 0;
        list-style: none;
    }
    /* 轨道画在每一站自己身上：线路跟着最后一站停下，不会拖出一条空荡荡的长线 */
    .line-track::before {
        display: none;
    }
    .line-stop {
        position: relative;
        display: flex;
        flex-direction: column;
        flex: 0 1 17rem;
        min-width: 12rem;
    }
    .line-stop::before {
        content: '';
        position: absolute;
        left: 1.05rem;
        right: -0.6rem;
        top: -0.8rem;
        border-top: 2px dashed color-mix(in srgb, var(--tone) 42%, transparent);
        transform-origin: left center;
    }
    .line-stop:last-child::before {
        right: calc(100% - 3.4rem);
    }
    /* 顺着线路往前跑的小光点 */
    .line-stop::after {
        content: '';
        position: absolute;
        top: -0.8rem;
        left: 1.05rem;
        width: 0.34rem;
        height: 0.34rem;
        margin-top: -0.17rem;
        border-radius: 999px;
        background: var(--tone);
        opacity: 0;
        animation: station-travel 4.8s ease-in-out infinite;
        animation-delay: calc(var(--si, 0) * 0.9s + var(--pi, 0) * 1.3s);
        pointer-events: none;
    }
    .line-stop:last-child::after {
        animation-name: station-travel-end;
    }
    .article-map.map-anim .line-stop::before {
        transform: scaleX(0);
        transition: transform 0.75s cubic-bezier(0.22, 0.68, 0, 1) calc(var(--i, 0) * 90ms + var(--si, 0) * 80ms + var(--pi, 0) * 150ms + 160ms);
    }
    .article-map.map-anim .route-card.is-visible .line-stop::before {
        transform: scaleX(1);
    }
    .article-map.map-anim .line-stop {
        opacity: 0;
        transform: translateY(0.55rem);
        transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 0.68, 0, 1);
        transition-delay: calc(var(--i, 0) * 90ms + var(--si, 0) * 80ms + var(--pi, 0) * 110ms + 200ms);
    }
    .article-map.map-anim .route-card.is-visible .line-stop {
        opacity: 1;
        transform: none;
    }
    .stop-pin {
        position: absolute;
        left: 1.05rem;
        top: -0.8rem;
        z-index: 1;
        width: 0.62rem;
        height: 0.62rem;
        border: 2px solid color-mix(in srgb, var(--tone) 55%, transparent);
        border-radius: 999px;
        background: var(--glass-card);
        transform: translate(-50%, -50%);
        transition: background-color 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
    }
    .stop-pin::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 100%;
        width: 1px;
        height: 0.5rem;
        background: color-mix(in srgb, var(--tone) 34%, transparent);
    }
    .line-stop:hover .stop-pin {
        background: var(--tone);
        border-color: var(--tone);
        box-shadow: 0 0 0 0.24rem color-mix(in srgb, var(--tone) 18%, transparent);
    }
    .stop-card {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 0.26rem;
        padding: 0.58rem 0.7rem;
        border: 1px solid color-mix(in srgb, var(--tone) 14%, var(--glass-border));
        border-radius: 0.85rem;
        background: color-mix(in srgb, var(--glass-card) 78%, transparent);
        transition: transform 0.26s cubic-bezier(0.22, 0.68, 0, 1), border-color 0.26s ease, background-color 0.26s ease;
    }
    .stop-card:hover {
        transform: translateY(-0.22rem);
        border-color: color-mix(in srgb, var(--tone) 45%, transparent);
        background: color-mix(in srgb, var(--tone) 8%, var(--glass-card));
    }
    .stop-date {
        color: color-mix(in srgb, var(--tone) 82%, var(--text-muted));
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.06em;
    }
    .stop-title {
        color: var(--text-body);
        font-size: 0.78rem;
        font-weight: 650;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .stop-foot {
        color: var(--text-muted);
        font-size: 0.6rem;
    }

    /* ====================================================== 领地 + 星标 */
    .map-columns {
        display: grid;
        grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
        gap: 1rem;
    }
    .territory-list {
        display: grid;
        gap: 0.3rem;
    }
    .territory {
        display: grid;
        grid-template-columns: 5.6rem minmax(0, 1fr) 1.75rem 2.5rem;
        align-items: center;
        gap: 0.6rem;
        padding: 0.48rem 0.6rem;
        border-radius: 0.85rem;
        transition: background-color 0.24s ease, transform 0.24s ease;
    }
    .territory:hover {
        transform: translateX(0.2rem);
        background: color-mix(in srgb, var(--tone) 6%, transparent);
    }
    .territory-name {
        overflow: hidden;
        color: var(--text-body);
        font-size: 0.85rem;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .territory:hover .territory-name {
        color: var(--tone);
    }
    .territory-bar {
        position: relative;
        height: 0.42rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--tone) 12%, transparent);
        overflow: hidden;
    }
    .territory-bar i {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: calc(var(--w) * 1%);
        border-radius: 999px;
        background: linear-gradient(90deg, color-mix(in srgb, var(--tone) 60%, transparent), var(--tone));
    }
    .article-map.map-anim .territory-bar i {
        width: 0;
        transition: width 1s cubic-bezier(0.22, 0.68, 0, 1) calc(var(--i, 0) * 90ms + 200ms);
    }
    .article-map.map-anim .map-section.is-visible .territory-bar i {
        width: calc(var(--w) * 1%);
    }
    .territory-count {
        display: grid;
        place-items: center;
        min-width: 1.6rem;
        height: 1.4rem;
        padding-inline: 0.3rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--tone) 12%, transparent);
        color: color-mix(in srgb, var(--tone) 85%, var(--text-strong));
        font-size: 0.66rem;
        font-weight: 800;
    }
    .territory-percent {
        color: var(--text-muted);
        font-size: 0.64rem;
        text-align: right;
