    .map-doodles {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }
    .map-doodles span {
        position: absolute;
        left: calc(var(--x) * 1%);
        top: calc(var(--y) * 1%);
        color: var(--tone);
        font-size: calc(var(--s) * 1rem);
        font-weight: 800;
        opacity: 0.22;
        transform: translate(-50%, -50%) rotate(var(--r));
        animation: map-doodle-float var(--dur) ease-in-out var(--delay) infinite;
    }

    .map-hero,
    .map-section,
    .map-outro {
        position: relative;
        border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--glass-border));
        background: var(--glass-card);
        backdrop-filter: blur(28px);
        box-shadow: 0 0.85rem 2.4rem rgb(118 80 68 / 0.05);
    }
    /* 地图纸上的虚线内框 */
    .map-hero::after,
    .map-section::after,
    .map-outro::after {
        content: '';
        position: absolute;
        inset: 0.42rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 13%, transparent);
        border-radius: inherit;
        pointer-events: none;
    }

    /* ============================================================ 出场动画 */
    .article-map.map-anim [data-map-reveal] {
        opacity: 0;
        transform: translateY(1.1rem);
        transition: opacity 0.7s ease, transform 0.75s cubic-bezier(0.22, 0.68, 0, 1);
        transition-delay: calc(var(--i, 0) * 70ms);
    }
    .article-map.map-anim [data-map-reveal].is-visible {
        opacity: 1;
        transform: none;
    }

    /* ================================================================ HERO */
    .map-hero {
        overflow: hidden;
        padding: 1.7rem 1.8rem 1.15rem;
        border-radius: 1.7rem;
        background:
            radial-gradient(circle at 88% -6%, color-mix(in srgb, var(--primary) 18%, transparent), transparent 34%),
