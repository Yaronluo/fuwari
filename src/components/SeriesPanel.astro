---
import { UNCATEGORIZED } from '@constants/constants'
import { getCategoryList, getSortedPosts, getTagList } from '../utils/content-utils'
import { getPostUrlBySlug, getCategoryUrl, getTagUrl } from '../utils/url-utils'
import { Icon } from 'astro-icon/components'

interface Props {
    keyword?: string
    tags?: string[]
    categories?: string[]
}

let posts = await getSortedPosts()
const categories = await getCategoryList()
const tags = await getTagList()

interface Series {
    count: number
    name: string
    posts: typeof posts
}

const groups: { category: string; series: Series[] }[] = (() => {
    const groupedSeries = posts.reduce(
        (grouped: { [category: string]: {[seriesName: string]: Series} }, post) => {
            const category = post.data.category || UNCATEGORIZED
            const series = post.data.series || UNCATEGORIZED
			if (category === UNCATEGORIZED || series === UNCATEGORIZED) {
                return grouped
            }
            if (!grouped[category]) {
                grouped[category] = {}
            }
            if (!grouped[category][series]) {
                grouped[category][series] = {
                    count: 0,
                    name: series,
                    posts: [],
                }
            }
            grouped[category][series].count++
            grouped[category][series].posts.push(post)
            return grouped
        },
        {},
    )

    // convert the object to an array
    const groupedSeriesArray = Object.keys(groupedSeries).map(key => ({
        category: key,
        series: Object.values(groupedSeries[key]),
    }))

    return groupedSeriesArray
})()

const seriesCount = groups.reduce((count, group) => count + group.series.length, 0)
---

<div class="article-map max-w-5xl mx-auto">
    <header class="map-hero onload-animation">
        <div class="map-stickers" aria-hidden="true"><span>✦</span><span>♡</span><span>₊˚⊹</span></div>
        <p><Icon name="material-symbols:map-outline-rounded" /> ARTICLE MAP</p>
        <h1>文章地图 <span>(｡•ᴗ•｡)♡</span></h1>
        <div class="map-subtitle">沿着系列、分类和标签，找到想看的内容。</div>
        <div class="map-counts">
            <span><strong>{seriesCount}</strong> 个系列</span>
            <i></i>
            <span><strong>{categories.length}</strong> 个分类</span>
            <i></i>
            <span><strong>{tags.length}</strong> 个标签</span>
        </div>
    </header>

    <section class="map-section series-section onload-animation" style="animation-delay: 80ms">
        <div class="section-heading">
            <div class="section-icon series-icon"><Icon name="material-symbols:book-2-outline-rounded" /></div>
            <div><p>按专题慢慢读</p><h2>系列专题</h2></div>
            <span>连续的故事，要从第一篇开始看呀</span>
        </div>
        <div class="series-groups">
            {groups.map(group => (
                <div class="series-group">
                    <a class="series-category" href={getCategoryUrl(group.category)}>{group.category}</a>
                    <div class="series-links">
                        {group.series.map(series => (
                            <a class="series-item" href={getPostUrlBySlug(series.posts[series.posts.length - 1].slug)} aria-label={series.name}>
                                <span class="series-dot"></span>
                                <span class="series-name">{series.name}</span>
                                <small>{series.count} 篇</small>
                                <Icon name="material-symbols:arrow-forward-rounded" />
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>

    <div class="map-columns">
        <section class="map-section category-section onload-animation" style="animation-delay: 140ms">
            <div class="section-heading compact">
                <div class="section-icon category-icon"><Icon name="material-symbols:folder-open-outline-rounded" /></div>
                <div><p>按内容类型找</p><h2>分类目录</h2></div>
            </div>
            <div class="category-list">
                {categories.map(category => (
                    <a href={category.url}>
                        <span>{category.name}</span>
                        <strong>{category.count}</strong>
                    </a>
                ))}
            </div>
        </section>

        <section class="map-section tag-section onload-animation" style="animation-delay: 200ms">
            <div class="section-heading compact">
                <div class="section-icon tag-icon"><Icon name="material-symbols:tag-rounded" /></div>
                <div><p>跟着关键词逛</p><h2>标签线索</h2></div>
            </div>
            <div class="tag-cloud">
                {tags.map(tag => (
                    <a href={getTagUrl(tag.name)}><span>#</span>{tag.name}<small>{tag.count}</small></a>
                ))}
            </div>
        </section>
    </div>
</div>

<style>
    .article-map { padding: 1rem 1.25rem 3rem; }
    .map-hero, .map-section { position: relative; border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--glass-border)); background: var(--glass-card); backdrop-filter: blur(28px); }
    .map-hero { overflow: hidden; padding: 1.65rem 1.8rem; border-radius: 1.7rem; background: radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--primary) 17%, transparent), transparent 30%), linear-gradient(135deg, color-mix(in srgb, var(--primary) 8%, transparent), transparent 48%), var(--glass-card); box-shadow: 0 1.2rem 3rem rgb(118 80 68 / 0.07); }
    .map-stickers { position: absolute; right: 1.4rem; top: 1.05rem; display: flex; gap: 0.45rem; color: color-mix(in srgb, var(--primary) 70%, white); font-weight: 800; transform: rotate(3deg); opacity: 0.8; }
    .map-stickers span:nth-child(1) { animation: map-twinkle 2.4s ease-in-out infinite; }
    .map-hero > p { display: flex; align-items: center; gap: 0.35rem; margin: 0 0 0.25rem; color: var(--primary); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.14em; }
    .map-hero h1 { margin: 0; color: var(--text-strong); font-size: clamp(1.65rem, 4vw, 2.15rem); line-height: 1.25; }
    .map-hero h1 span { display: inline-block; margin-left: 0.25rem; color: var(--primary); font-size: 0.55em; white-space: nowrap; transform: rotate(-2deg); }
    .map-subtitle { margin-top: 0.35rem; color: var(--text-muted); font-size: 0.82rem; }
    .map-counts { display: flex; align-items: center; flex-wrap: wrap; gap: 0.45rem 0.75rem; margin-top: 1.05rem; color: var(--text-muted); font-size: 0.74rem; }
    .map-counts strong { color: var(--primary); font-size: 1rem; }
    .map-counts i { width: 0.22rem; height: 0.22rem; border-radius: 999px; background: color-mix(in srgb, var(--primary) 52%, var(--text-muted)); }

    .map-section { margin-top: 1rem; padding: 1.35rem; border-radius: 1.45rem; box-shadow: 0 0.8rem 2.3rem rgb(118 80 68 / 0.045); }
    .section-heading { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
    .section-heading > span { margin-left: auto; color: var(--text-muted); font-size: 0.7rem; }
    .section-heading p { margin: 0; color: var(--text-muted); font-size: 0.65rem; }
    .section-heading h2 { margin: 0.08rem 0 0; color: var(--text-strong); font-size: 1.12rem; }
    .section-icon { display: grid; place-items: center; flex: 0 0 auto; width: 2.55rem; height: 2.55rem; border-radius: 0.9rem; font-size: 1.3rem; }
    .series-icon { color: var(--primary); background: color-mix(in srgb, var(--primary) 11%, transparent); }
    .category-icon { color: #cf9463; background: rgb(231 174 126 / 0.13); }
    .tag-icon { color: #8c7abe; background: rgb(140 122 190 / 0.12); }

    .series-groups { display: grid; gap: 1.1rem; }
    .series-group { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0.9rem; align-items: start; }
    .series-category { display: flex; align-items: center; min-height: 2.8rem; color: var(--text-body); font-size: 0.9rem; font-weight: 800; }
    .series-category:hover { color: var(--primary); }
    .series-links { display: grid; gap: 0.45rem; }
    .series-item { display: grid; grid-template-columns: 0.7rem minmax(0, 1fr) auto 1.3rem; align-items: center; gap: 0.55rem; min-height: 2.8rem; padding: 0.45rem 0.65rem; border: 1px solid transparent; border-radius: 0.95rem; color: inherit; transition: transform 0.22s ease, background-color 0.22s ease, border-color 0.22s ease; }
    .series-item:hover { transform: translateX(0.25rem); border-color: color-mix(in srgb, var(--primary) 16%, transparent); background: color-mix(in srgb, var(--primary) 6%, transparent); }
    .series-dot { width: 0.5rem; height: 0.5rem; border: 2px solid var(--glass-card); border-radius: 999px; background: var(--primary); box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--primary) 12%, transparent); }
    .series-name { overflow: hidden; color: var(--text-body); font-size: 0.88rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
    .series-item small { color: var(--text-muted); font-size: 0.68rem; }
    .series-item > :global(svg) { color: var(--primary); opacity: 0; transform: translateX(-0.3rem); transition: opacity 0.22s ease, transform 0.22s ease; }
    .series-item:hover > :global(svg) { opacity: 1; transform: none; }

    .map-columns { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 1rem; }
    .section-heading.compact { margin-bottom: 0.85rem; }
    .category-list { display: grid; gap: 0.38rem; }
    .category-list a { display: flex; align-items: center; justify-content: space-between; min-height: 2.65rem; padding: 0.45rem 0.7rem; border-radius: 0.9rem; color: var(--text-body); font-size: 0.86rem; font-weight: 650; transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease; }
    .category-list a:hover { transform: translateX(0.22rem); color: var(--primary); background: color-mix(in srgb, var(--primary) 7%, transparent); }
    .category-list strong { display: grid; place-items: center; min-width: 1.7rem; height: 1.45rem; padding-inline: 0.35rem; border-radius: 999px; color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); font-size: 0.68rem; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.55rem; }
    .tag-cloud a { display: inline-flex; align-items: center; gap: 0.28rem; min-height: 2.25rem; padding: 0.4rem 0.72rem; border: 1px solid color-mix(in srgb, var(--primary) 14%, var(--glass-border)); border-radius: 999px; color: var(--text-body); background: color-mix(in srgb, var(--glass-card) 72%, transparent); font-size: 0.78rem; transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease; }
    .tag-cloud a:hover { transform: translateY(-0.12rem) rotate(-1deg); border-color: color-mix(in srgb, var(--primary) 40%, transparent); color: var(--primary); }
    .tag-cloud a > span { color: var(--primary); font-weight: 800; }
    .tag-cloud small { display: grid; place-items: center; min-width: 1.15rem; height: 1.15rem; border-radius: 999px; color: var(--text-muted); background: color-mix(in srgb, var(--primary) 8%, transparent); font-size: 0.6rem; }

    @keyframes map-twinkle { 0%, 100% { opacity: 0.45; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1.15) rotate(12deg); } }
    @media (max-width: 640px) {
        .article-map { padding: 0.5rem 0 2rem; }
        .map-hero { padding: 1.25rem; border-radius: 1.4rem; }
        .map-hero h1 span { display: block; width: max-content; margin: 0.35rem 0 0; }
        .map-subtitle { font-size: 0.75rem; }
        .map-section { padding: 1rem; border-radius: 1.25rem; }
        .section-heading > span { display: none; }
        .series-group { grid-template-columns: 1fr; gap: 0.25rem; }
        .series-category { min-height: 2rem; }
        .map-columns { grid-template-columns: 1fr; gap: 0; }
        .series-item > :global(svg) { opacity: 0.55; transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .map-stickers span:nth-child(1) { animation: none; }
        .series-item, .category-list a, .tag-cloud a { transition: none; }
    }
</style>
