---
import { UNCATEGORIZED } from "@constants/constants";
import { Icon } from "astro-icon/components";
import getReadingTime from "reading-time";
import {
	getCategoryList,
	getSiteContentStats,
	getSortedPosts,
	getTagList,
} from "../utils/content-utils";
import {
	getCategoryUrl,
	getPostUrlBySlug,
	getTagUrl,
	url,
} from "../utils/url-utils";

interface Props {
	keyword?: string;
	tags?: string[];
	categories?: string[];
}

const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
const siteStats = await getSiteContentStats();

/* 星标里最亮的那颗：出现次数最多的标签 */
const starTag = tags.length
	? tags.reduce((best, tag) => (tag.count > best.count ? tag : best))
	: null;
const starTagPosts = starTag
	? posts.filter((post) => (post.data.tags || []).includes(starTag.name))
	: [];

type Post = (typeof posts)[number];

/* ---------------------------------------------------------------- helpers */
const pad = (value: number) => String(value).padStart(2, "0");
const dateOf = (post: Post) => new Date(post.data.published);
const shortDate = (post: Post) =>
	`${pad(dateOf(post).getMonth() + 1)}.${pad(dateOf(post).getDate())}`;
const fullDate = (post: Post) =>
	`${dateOf(post).getFullYear()}-${shortDate(post)}`;
const weekdayFmt = new Intl.DateTimeFormat("zh-CN", { weekday: "short" });
const minutesOf = (post: Post) =>
	Math.max(1, Math.round(getReadingTime(post.body || "").minutes));
const numberFmt = new Intl.NumberFormat("en-US");

const byDate = [...posts].sort(
	(a, b) => dateOf(b).getTime() - dateOf(a).getTime(),
);
const newest = byDate[0];
const oldest = byDate[byDate.length - 1];
const pinned = posts.find((post) => post.data.pinned);

const totalMinutes = posts.reduce((sum, post) => sum + minutesOf(post), 0);
const totalWords = siteStats.wordCount;

/** 每条「领地 / 线路」都有自己的颜色，颜色跟着分类名走，排序变化也不会串色。 */
const TONES = [
	"var(--primary)",
	"var(--azusa-blue)",
	"var(--mio-purple)",
	"var(--tea)",
];
const toneOf = (name: string) => {
	const index = categories.findIndex((category) => category.name === name);
	return index >= 0 ? TONES[index % TONES.length] : TONES[0];
};

/* ------------------------------------------------------------ series map */
interface Series {
	count: number;
	name: string;
	posts: Post[];
}

const groups = (() => {
	const grouped: { [category: string]: { [seriesName: string]: Series } } = {};

	for (const post of posts) {
		const category = post.data.category || UNCATEGORIZED;
		const series = post.data.series || UNCATEGORIZED;
		if (category === UNCATEGORIZED || series === UNCATEGORIZED) continue;
		if (!grouped[category]) grouped[category] = {};
		if (!grouped[category][series])
			grouped[category][series] = { count: 0, name: series, posts: [] };
		grouped[category][series].count++;
		grouped[category][series].posts.push(post);
	}

	return Object.keys(grouped).map((category) => {
		// 线路上的站点按时间正序：从第一篇一路读到最新一篇。
		const seriesList = Object.values(grouped[category]).map((series) => ({
			...series,
			posts: [...series.posts].sort(
				(a, b) => dateOf(a).getTime() - dateOf(b).getTime(),
			),
		}));
		return {
			category,
			series: seriesList,
			postCount: seriesList.reduce((sum, series) => sum + series.count, 0),
		};
	});
})();

const seriesCount = groups.reduce((sum, group) => sum + group.series.length, 0);

/* ------------------------------------------------------------- hero data */
const heroStats = [
	{
		icon: "material-symbols:description-outline-rounded",
		value: posts.length,
		suffix: "篇文章",
	},
	{ icon: "material-symbols:route", value: seriesCount, suffix: "条线路" },
	{
		icon: "material-symbols:folder-open-outline-rounded",
		value: categories.length,
		suffix: "片领地",
	},
	{
		icon: "material-symbols:tag-rounded",
		value: tags.length,
		suffix: "枚星标",
	},
	{
		icon: "material-symbols:stylus-note-outline-rounded",
		value: totalWords,
		suffix: "字",
	},
	{
		icon: "material-symbols:timer-outline-rounded",
		value: totalMinutes,
		suffix: "分钟",
	},
];

const jumpLinks = [
	{
		href: "#map-start",
		icon: "material-symbols:near-me-outline-rounded",
		label: "从这里出发",
		hint: "3 个入口",
	},
	{
		href: "#map-routes",
		icon: "material-symbols:route",
		label: "系列路线",
		hint: `${seriesCount} 条`,
	},
	{
		href: "#map-territory",
		icon: "material-symbols:folder-open-outline-rounded",
		label: "分类 · 标签",
		hint: `${categories.length} + ${tags.length}`,
	},
	{
		href: "#map-timeline",
		icon: "material-symbols:timeline",
		label: "时间航线",
		hint: `${posts.length} 站`,
	},
];

/** 星图上的坐标点：前几个分类按文章数量落在地图上，虚线把它们连成一条游览路线。 */
const PIN_SPOTS = [
	{ x: 22, y: 27 },
	{ x: 45, y: 16 },
	{ x: 64, y: 31 },
	{ x: 30, y: 62 },
	{ x: 55, y: 55 },
	{ x: 70, y: 76 },
];
const atlasPins = [...categories]
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
	.slice(0, PIN_SPOTS.length)
	.map((category, index) => ({
		...category,
		...PIN_SPOTS[index],
		tone: toneOf(category.name),
	}));

const atlasPath =
	atlasPins.length > 1
		? atlasPins
				.map((pin, index) => `${index === 0 ? "M" : "L"} ${pin.x} ${pin.y}`)
				.join(" ")
		: "M 14 78 L 32 30 L 58 20 L 86 44";

/* --------------------------------------------------------- start entries */
interface StartCard {
	key: string;
	label: string;
	icon: string;
	note: string;
	tone: string;
	post: Post;
}

const startCards: StartCard[] = [];
const usedSlugs = new Set<string>();
const addStartCard = (card: StartCard) => {
	if (usedSlugs.has(card.post.slug)) return;
	usedSlugs.add(card.post.slug);
	startCards.push(card);
};

if (pinned) {
	addStartCard({
		key: "pinned",
		label: "先看这里",
		icon: "material-symbols:push-pin",
		note: "第一次来？从这篇开始就好～",
		tone: "var(--primary)",
		post: pinned,
	});
}
if (newest) {
	addStartCard({
		key: "newest",
		label: "最新更新",
		icon: "material-symbols:bolt-outline-rounded",
		note: "刚出炉的一篇，还热乎着。",
		tone: "var(--azusa-blue)",
		post: newest,
	});
}
if (oldest) {
	addStartCard({
		key: "oldest",
		label: "从零开始",
		icon: "material-symbols:flag-outline-rounded",
		note: "这里藏着这个博客最早的足迹。",
		tone: "var(--mio-purple)",
		post: oldest,
	});
}
if (startCards.length < 3) {
	const longest = [...posts].sort(
		(a, b) => (b.body?.length || 0) - (a.body?.length || 0),
	)[0];
	if (longest) {
		addStartCard({
			key: "longest",
			label: "最长的一篇",
			icon: "material-symbols:auto-stories-outline-rounded",
			note: "泡杯茶，慢慢读完它。",
			tone: "var(--tea)",
			post: longest,
		});
	}
}

/* ------------------------------------------------------- shuffle machine */
const shufflePool = posts.map((post) => ({
	slug: post.slug,
	title: post.data.title,
	url: getPostUrlBySlug(post.slug),
	note:
		(post.data.description || "").replace(/\s+/g, " ").slice(0, 56) ||
		`收录在「${post.data.category || UNCATEGORIZED}」里的一篇。`,
	date: shortDate(post),
	minutes: minutesOf(post),
}));
// 初始那篇不要和上面几张推荐卡重复，否则会出现两张一模一样的卡片。
// 一篇文章都没有（或推荐卡已经把所有文章用光）时不渲染这张卡，避免读到 undefined。
const shuffleSeedIndex = shufflePool.findIndex((item) => !usedSlugs.has(item.slug));
const shuffleSeed = shuffleSeedIndex >= 0 ? shufflePool[shuffleSeedIndex] : null;

/* -------------------------------------------------------------- timeline */
const timeline = (() => {
	const years: { year: string; posts: Post[] }[] = [];
	for (const post of byDate) {
		const year = String(dateOf(post).getFullYear());
		let bucket = years[years.length - 1];
		if (!bucket || bucket.year !== year) {
			bucket = { year, posts: [] };
			years.push(bucket);
		}
		bucket.posts.push(post);
	}
	return years;
})();

const territoryList = [...categories].sort(
	(a, b) => b.count - a.count || a.name.localeCompare(b.name),
);

/* 背景里飘着的小装饰，只出现在页面两侧的留白处 */
const doodles = [
	{
		char: "✦",
		x: 3,
		y: 8,
		size: 1.15,
		rotate: -8,
		duration: 13,
		delay: 0,
		tone: "var(--primary)",
	},
	{
		char: "✧",
		x: 96.5,
		y: 5,
		size: 0.95,
		rotate: 12,
		duration: 15,
		delay: 1.2,
		tone: "var(--azusa-blue)",
	},
	{
		char: "♡",
		x: 2.4,
		y: 23,
		size: 0.9,
		rotate: 6,
		duration: 12,
		delay: 0.6,
		tone: "var(--primary)",
	},
	{
		char: "˚₊",
		x: 97,
		y: 30,
		size: 0.85,
		rotate: -6,
		duration: 16,
		delay: 1.8,
		tone: "var(--mio-purple)",
	},
	{
		char: "✿",
		x: 2.8,
		y: 46,
		size: 1,
		rotate: 10,
		duration: 14,
		delay: 0.9,
		tone: "var(--tea)",
	},
	{
		char: "☁",
		x: 96.8,
		y: 55,
		size: 1.1,
		rotate: -10,
		duration: 18,
		delay: 0.3,
		tone: "var(--azusa-blue)",
	},
	{
		char: "୨୧",
		x: 2.6,
		y: 69,
		size: 0.8,
		rotate: 8,
		duration: 13,
		delay: 1.5,
		tone: "var(--primary)",
	},
	{
		char: "✦",
		x: 97,
		y: 78,
		size: 0.95,
		rotate: -12,
		duration: 15,
		delay: 0.4,
		tone: "var(--mio-purple)",
	},
	{
		char: "⌇",
		x: 3,
		y: 89,
		size: 0.95,
		rotate: 4,
		duration: 17,
		delay: 1.1,
		tone: "var(--tea)",
	},
	{
		char: "☆",
		x: 96.2,
		y: 95,
		size: 0.85,
		rotate: 14,
		duration: 12,
		delay: 2,
		tone: "var(--primary)",
	},
];
---

<div class="article-map max-w-5xl mx-auto">
    {/* 先给根节点打上动画开关：脚本没跑起来时页面就是静态可见的，不会白屏 */}
    <script is:inline>
        (function () {
            var node = document.currentScript
            var root = node && node.parentElement
            if (root && root.classList.contains('article-map')) root.classList.add('map-anim')
        })()
    </script>

    <div class="map-doodles" aria-hidden="true">
        {doodles.map(doodle => (
            <span
                style={`--x: ${doodle.x}; --y: ${doodle.y}; --s: ${doodle.size}; --r: ${doodle.rotate}deg; --dur: ${doodle.duration}s; --delay: ${doodle.delay}s; --tone: ${doodle.tone}`}
            >{doodle.char}</span>
        ))}
    </div>

    <header class="map-hero" id="map-top" data-map-reveal style="--i: 0">
        <div class="hero-grid">
            <div class="hero-copy">
                <p class="hero-eyebrow">
                    <Icon name="material-symbols:map-outline-rounded" />
                    ARTICLE MAP<em>· Yaron's Life</em>
                </p>
                <h1>文章地图 <span class="hero-kaomoji">(｡•ᴗ•｡)♡</span></h1>
                <p class="hero-lead">
                    沿着系列、分类和标签，找到想看的内容。<br />
                    像翻一张手绘地图那样，从一个坐标逛到另一个坐标～
                </p>

                <ul class="hero-stats">
                    {heroStats.map((stat, index) => (
                        <li style={`--i: ${index}`}>
                            <Icon name={stat.icon} />
                            <strong data-map-count={stat.value}>{numberFmt.format(stat.value)}</strong>
                            <span>{stat.suffix}</span>
                        </li>
                    ))}
                </ul>

                <nav class="hero-jump" aria-label="页面内跳转">
                    {jumpLinks.map(link => (
                        <a href={link.href} data-map-jump data-no-swup>
                            <Icon name={link.icon} />
                            <b>{link.label}</b>
                            <small>{link.hint}</small>
                        </a>
                    ))}
                </nav>
            </div>

            <div class="hero-atlas" data-map-atlas>
                <span class="atlas-caption">CONTENT ATLAS</span>
                <svg class="atlas-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    <path class="atlas-line" d={atlasPath} pathLength="100" vector-effect="non-scaling-stroke" />
                    <path class="atlas-flow" d={atlasPath} pathLength="100" vector-effect="non-scaling-stroke" />
                    <path class="atlas-runner" d={atlasPath} pathLength="100" vector-effect="non-scaling-stroke" />
                </svg>
                <div class="atlas-pins">
                    {atlasPins.map((pin, index) => (
                        <a
                            class="atlas-pin"
                            href={pin.url}
                            style={`--x: ${pin.x}; --y: ${pin.y}; --tone: ${pin.tone}; --i: ${index}`}
                            title={`${pin.name} · ${pin.count} 篇`}
                        >
                            <span class="pin-dot"><i></i></span>
                            <span class="pin-label"><b>{pin.name}</b><small>{pin.count}</small></span>
                        </a>
                    ))}
                    {/* 还没被写到的坐标，留给以后的新文章 */}
                    <span class="atlas-unknown" style="--x: 14; --y: 46" title="还没有被写到的坐标">?</span>
                    <span class="atlas-unknown" style="--x: 85; --y: 58" title="还没有被写到的坐标">?</span>
                </div>
                <div class="atlas-compass" aria-hidden="true">
                    <svg viewBox="0 0 64 64">
                        <circle class="compass-ring" cx="32" cy="32" r="26" />
                        <circle class="compass-ring is-inner" cx="32" cy="32" r="17" />
                        <path class="compass-tick" d="M32 3 v7 M32 54 v7 M3 32 h7 M54 32 h7" />
                        <path class="compass-needle" d="M32 12 L37 34 L32 42 L27 34 Z" />
                        <circle class="compass-core" cx="32" cy="32" r="2.4" />
                    </svg>
                </div>
                <span class="atlas-you"><i></i>你在这里</span>
                <span class="atlas-hint">点一下坐标就能出发</span>
            </div>
        </div>

        <div class="hero-legend">
            <span><i class="legend-route" aria-hidden="true"></i>系列 ＝ 一条路线</span>
            <span><i class="legend-area" aria-hidden="true"></i>分类 ＝ 一片领地</span>
            <span><i class="legend-glyph" aria-hidden="true">✦</i>标签 ＝ 散落的星标</span>
            <span><i class="legend-glyph" aria-hidden="true">↺</i>时间 ＝ 一条航线</span>
            <em>小提示：地图会跟着新文章一起长大 ✧</em>
        </div>
    </header>

    <section class="map-section start-section" id="map-start" data-map-reveal style="--i: 1">
        <div class="section-heading">
            <div class="section-icon icon-primary"><Icon name="material-symbols:near-me-outline-rounded" /></div>
            <div class="section-title">
                <p>START HERE</p>
                <h2>从这里出发</h2>
            </div>
            <span class="section-note">第一次来？先看这几篇就够啦</span>
        </div>

        <div class="start-grid">
            {startCards.map((card, index) => (
                <a class="start-card" href={getPostUrlBySlug(card.post.slug)} style={`--tone: ${card.tone}; --i: ${index}`}>
                    <span class="start-badge"><Icon name={card.icon} />{card.label}</span>
                    <h3 class="start-title">{card.post.data.title}</h3>
                    <p class="start-desc">{card.note}</p>
                    <span class="start-meta">
                        <span><Icon name="material-symbols:calendar-today-outline-rounded" />{fullDate(card.post)}</span>
                        <span><Icon name="material-symbols:timer-outline-rounded" />约 {minutesOf(card.post)} 分钟</span>
                        {card.post.data.category && (
                            <span><Icon name="material-symbols:folder-outline-rounded" />{card.post.data.category}</span>
                        )}
                    </span>
                    <span class="start-go">去读这篇 <Icon name="material-symbols:arrow-forward-rounded" /></span>
                </a>
            ))}

            {shuffleSeed && (
            <div
                class="start-card start-card--shuffle"
                data-map-shuffle
                data-map-shuffle-index={shuffleSeedIndex}
                aria-live="polite"
                style={`--tone: var(--tea); --i: ${startCards.length}`}
            >
                <span class="start-badge"><Icon name="material-symbols:casino" />随便翻翻</span>
                <a class="shuffle-link" href={shuffleSeed.url} data-map-shuffle-link>
                    <h3 class="start-title" data-map-shuffle-title>{shuffleSeed.title}</h3>
                </a>
                <p class="start-desc" data-map-shuffle-desc>{shuffleSeed.note}</p>
                <span class="start-meta">
                    <span><Icon name="material-symbols:calendar-today-outline-rounded" /><span data-map-shuffle-date>{shuffleSeed.date}</span></span>
                    <span><Icon name="material-symbols:timer-outline-rounded" />约 <span data-map-shuffle-time>{shuffleSeed.minutes} 分钟</span></span>
                </span>
                <button type="button" class="shuffle-btn" data-map-shuffle-btn>
                    <Icon name="material-symbols:shuffle-rounded" />换一篇
                </button>
            </div>
            )}
        </div>

        <script type="application/json" id="map-shuffle-pool" is:inline set:html={JSON.stringify(shufflePool).replace(/</g, '\\u003c')}></script>
    </section>

    <section class="map-section route-section" id="map-routes" data-map-reveal style="--i: 2">
        <div class="section-heading">
            <div class="section-icon icon-blue"><Icon name="material-symbols:route" /></div>
            <div class="section-title">
                <p>SERIES ROUTES</p>
                <h2>系列路线</h2>
            </div>
            <span class="section-note">一条线路，从第一篇走到最新一篇</span>
        </div>

        <div class="route-list">
            {groups.map((group, groupIndex) => (
                <article class="route-card" data-map-reveal style={`--tone: ${toneOf(group.category)}; --i: ${groupIndex}`}>
                    <header class="route-head">
                        <span class="route-index">{pad(groupIndex + 1)}</span>
                        <div class="route-titles">
                            <p>CATEGORY ROUTE</p>
                            <h3><a href={getCategoryUrl(group.category)}>{group.category}</a></h3>
                        </div>
                        <span class="route-meta">{group.series.length} 条线路 · {group.postCount} 篇文章</span>
                        <a class="route-more" href={getCategoryUrl(group.category)}>
                            进入领地<Icon name="material-symbols:arrow-forward-rounded" />
                        </a>
                    </header>

                    <div class="route-lines">
                        {group.series.map((series, seriesIndex) => (
                            <div class="route-line" style={`--si: ${seriesIndex}`}>
                                <div class="line-head">
                                    <span class="line-bullet"><i></i></span>
                                    <a class="line-name" href={getPostUrlBySlug(series.posts[0].slug)}>{series.name}</a>
                                    <span class="line-count">{series.count} 站</span>
                                    <span class="line-hint">从第一篇开始读<Icon name="material-symbols:subdirectory-arrow-right-rounded" /></span>
                                </div>
                                <ol class="line-track">
                                    {series.posts.map((post, postIndex) => (
                                        <li class="line-stop" style={`--pi: ${postIndex}`}>
                                            <span class="stop-pin" aria-hidden="true"></span>
                                            <a class="stop-card" href={getPostUrlBySlug(post.slug)}>
                                                <span class="stop-date">{shortDate(post)}</span>
                                                <span class="stop-title">{post.data.title}</span>
                                                <span class="stop-foot">
                                                    {series.posts.length === 1 ? '起点 · 也是终点' : postIndex === 0 ? '起点' : postIndex === series.posts.length - 1 ? '终点' : `第 ${postIndex + 1} 站`}
                                                    · 约 {minutesOf(post)} 分钟
                                                </span>
                                            </a>
                                        </li>
                                    ))}
                                </ol>
                            </div>
                        ))}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <div class="map-columns">
        <section class="map-section territory-section" id="map-territory" data-map-reveal style="--i: 3">
            <div class="section-heading">
                <div class="section-icon icon-purple"><Icon name="material-symbols:folder-open-outline-rounded" /></div>
                <div class="section-title">
                    <p>TERRITORIES</p>
                    <h2>分类领地</h2>
                </div>
            </div>
            <div class="territory-list">
                {territoryList.map((category, index) => {
                    const percent = posts.length ? Math.round((category.count / posts.length) * 100) : 0
                    return (
                        <a
                            class="territory"
                            href={category.url}
                            style={`--tone: ${toneOf(category.name)}; --i: ${index}; --w: ${percent}`}
                        >
                            <span class="territory-name">{category.name}</span>
                            <span class="territory-bar" aria-hidden="true"><i></i></span>
                            <span class="territory-count">{category.count}</span>
                            <span class="territory-percent">{percent}%</span>
                        </a>
                    )
                })}
            </div>
            <p class="panel-foot">共 {posts.length} 篇文章，落在 {categories.length} 片领地上</p>
        </section>

        <section class="map-section tag-section" id="map-tags" data-map-reveal style="--i: 4">
            <div class="section-heading">
                <div class="section-icon icon-tea"><Icon name="material-symbols:tag-rounded" /></div>
                <div class="section-title">
                    <p>TAG STARS</p>
                    <h2>标签星标</h2>
                </div>
            </div>
            <div class="tag-cloud">
                {tags.map((tag, index) => (
                    <a
                        class="tag-star"
                        href={getTagUrl(tag.name)}
                        style={`--i: ${index}; --size: ${Math.min(tag.count, 4)}`}
                        title={`${tag.name} · ${tag.count} 篇`}
                    >
                        <Icon name="material-symbols:star-outline-rounded" />
                        {tag.name}
                        <small>{tag.count}</small>
                    </a>
                ))}
            </div>
            {starTag && (
                <a
                    class="star-lead"
                    href={getTagUrl(starTag.name)}
                    title={`${starTag.name} · ${starTag.count} 篇`}
                >
                    <span class="star-lead-glyph" aria-hidden="true">✦</span>
                    <span class="star-lead-body">
                        <b>
                            最亮的星 · {starTag.name}
                            <small>{starTag.count}</small>
                        </b>
                        <span class="star-lead-line">
                            {starTagPosts[0]
                                ? `最近更新 ${shortDate(starTagPosts[0])} · ${starTagPosts[0].data.title}`
                                : "这颗星下面还空着"}
                        </span>
                    </span>
                    <span class="star-lead-go" aria-hidden="true">
                        <Icon name="material-symbols:arrow-forward-rounded" />
                    </span>
                </a>
            )}
            <p class="panel-foot">星标越大，说明这个词出现得越多 ✧</p>
        </section>
    </div>

    <section class="map-section timeline-section" id="map-timeline" data-map-reveal style="--i: 5">
        <div class="section-heading">
            <div class="section-icon icon-primary"><Icon name="material-symbols:timeline" /></div>
            <div class="section-title">
                <p>TIMELINE</p>
                <h2>时间航线</h2>
            </div>
            <span class="section-note">从最近一篇，一路往回走</span>
        </div>

        <div class="timeline" data-map-timeline>
            <span class="timeline-rail" aria-hidden="true"><i class="timeline-fill" data-map-rail></i></span>

            {timeline.map(yearGroup => (
                <div class="year-group">
                    <p class="year-chip">
                        <span class="year-dot" aria-hidden="true"></span>
                        <b>{yearGroup.year}</b>
                        <small>{yearGroup.posts.length} 篇</small>
                    </p>
                    <ol class="year-list">
                        {yearGroup.posts.map(post => (
                            <li class="timeline-stop" data-map-stop>
                                <span class="stop-dot" aria-hidden="true"></span>
                                <a class="stop-link" href={getPostUrlBySlug(post.slug)}>
                                    <span class="stop-date">
                                        <b>{shortDate(post)}</b>
                                        <small>{weekdayFmt.format(dateOf(post))}</small>
                                    </span>
                                    <span class="stop-main">
                                        <span class="stop-title">
                                            <b class="stop-name">{post.data.title}</b>
                                            {post.data.pinned && <em class="stop-badge">置顶</em>}
                                        </span>
                                        <span class="stop-meta">
                                            <span>{post.data.category || UNCATEGORIZED}</span>
                                            {post.data.series && <span>· {post.data.series}</span>}
                                            <span>· 约 {minutesOf(post)} 分钟</span>
                                            {(post.data.tags || []).slice(0, 3).map(tag => (
                                                <span class="stop-tag">#{tag}</span>
                                            ))}
                                        </span>
                                    </span>
                                    <span class="stop-go" aria-hidden="true"><Icon name="material-symbols:arrow-forward-rounded" /></span>
                                </a>
                            </li>
                        ))}
                    </ol>
                </div>
            ))}
        </div>
    </section>

    <footer class="map-outro" data-map-reveal style="--i: 6">
        <div class="outro-dash" aria-hidden="true"><span>✧</span><i></i><span>♡</span><i></i><span>✦</span></div>
        <p class="outro-text">
            地图会跟着新文章一起长大 —— 现在一共有 <strong>{posts.length}</strong> 个坐标、
            <strong>{seriesCount}</strong> 条线路，走完大约要 <strong>{totalMinutes}</strong> 分钟。
        </p>
        <div class="outro-links">
            <a href={url('/archive/')}><Icon name="material-symbols:menu-book-outline-rounded" />查看全部文章</a>
            <a href="#map-top" data-map-jump data-no-swup><Icon name="material-symbols:north-east-rounded" />回到地图顶部</a>
        </div>
    </footer>

    <script is:inline>
        (function () {
            var root = document.querySelector('.article-map')
            if (!root || root.dataset.mapReady === '1') return
            root.dataset.mapReady = '1'

            if (typeof window.__fuwariSeriesMapCleanup === 'function') {
                try { window.__fuwariSeriesMapCleanup() } catch (error) { /* 上一页的清理失败就算了 */ }
            }

            var cleanups = []
            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
            var numberFmt = new Intl.NumberFormat('en-US')

            /* 1. 滚动到就出现 */
            var revealTargets = Array.prototype.slice.call(root.querySelectorAll('[data-map-reveal]'))
            if (reduceMotion) {
                revealTargets.forEach(function (el) { el.classList.add('is-visible') })
            } else if ('IntersectionObserver' in window) {
                var revealObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) return
                        entry.target.classList.add('is-visible')
                        revealObserver.unobserve(entry.target)
                    })
                }, { threshold: 0, rootMargin: '0px 0px -10% 0px' })
                revealTargets.forEach(function (el) { revealObserver.observe(el) })
                cleanups.push(function () { revealObserver.disconnect() })
            } else {
                revealTargets.forEach(function (el) { el.classList.add('is-visible') })
            }

            /* 2. 数字滚动 */
            var counters = Array.prototype.slice.call(root.querySelectorAll('[data-map-count]'))
            var runCounter = function (el) {
                var target = Number(el.getAttribute('data-map-count') || '0')
                if (!isFinite(target) || target <= 0) return
                if (reduceMotion) {
                    el.textContent = numberFmt.format(target)
                    return
                }
                var duration = 900
                var startTime = performance.now()
                var step = function (now) {
                    var progress = Math.min(1, (now - startTime) / duration)
                    var eased = 1 - Math.pow(1 - progress, 3)
                    el.textContent = numberFmt.format(Math.round(target * eased))
                    if (progress < 1) requestAnimationFrame(step)
                    else el.textContent = numberFmt.format(target)
                }
                requestAnimationFrame(step)
            }
            if (counters.length && 'IntersectionObserver' in window) {
                var countObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) return
                        runCounter(entry.target)
                        countObserver.unobserve(entry.target)
                    })
                }, { threshold: 0.35 })
                counters.forEach(function (el) { countObserver.observe(el) })
                cleanups.push(function () { countObserver.disconnect() })
            }

            /* 3. 星图跟随鼠标轻轻浮动 */
            var atlas = root.querySelector('[data-map-atlas]')
            if (atlas && !reduceMotion && window.matchMedia('(hover: hover)').matches) {
                var frame = 0
                var targetX = 0
                var targetY = 0
                var currentX = 0
                var currentY = 0
                var render = function () {
                    frame = 0
                    currentX += (targetX - currentX) * 0.16
                    currentY += (targetY - currentY) * 0.16
                    atlas.style.setProperty('--px', currentX.toFixed(2))
                    atlas.style.setProperty('--py', currentY.toFixed(2))
                    if (Math.abs(targetX - currentX) > 0.04 || Math.abs(targetY - currentY) > 0.04) {
                        frame = requestAnimationFrame(render)
                    }
                }
                var queue = function () { if (!frame) frame = requestAnimationFrame(render) }
                var onMove = function (event) {
                    var rect = atlas.getBoundingClientRect()
                    if (!rect.width || !rect.height) return
                    var relX = (event.clientX - rect.left) / rect.width - 0.5
                    var relY = (event.clientY - rect.top) / rect.height - 0.5
                    targetX = Math.max(-0.5, Math.min(0.5, relX)) * 18
                    targetY = Math.max(-0.5, Math.min(0.5, relY)) * 14
                    queue()
                }
                var onLeave = function () { targetX = 0; targetY = 0; queue() }
                atlas.addEventListener('pointermove', onMove)
                atlas.addEventListener('pointerleave', onLeave)
                cleanups.push(function () {
                    atlas.removeEventListener('pointermove', onMove)
                    atlas.removeEventListener('pointerleave', onLeave)
                    if (frame) cancelAnimationFrame(frame)
                })
            }

            /* 4. 时间航线：进度条 + 走过的站点会亮起来 */
            var timeline = root.querySelector('[data-map-timeline]')
            if (timeline) {
                var fill = timeline.querySelector('[data-map-rail]')
                var stops = Array.prototype.slice.call(timeline.querySelectorAll('[data-map-stop]'))
                var railFrame = 0
                var updateRail = function () {
                    railFrame = 0
                    if (!fill) return
                    var rect = timeline.getBoundingClientRect()
                    if (!rect.height) return
                    var anchor = window.innerHeight * 0.55
                    var progress = Math.max(0, Math.min(1, (anchor - rect.top) / rect.height))
                    fill.style.setProperty('--progress', progress.toFixed(4))
                }
                var onScroll = function () { if (!railFrame) railFrame = requestAnimationFrame(updateRail) }
                updateRail()
                window.addEventListener('scroll', onScroll, { passive: true })
                window.addEventListener('resize', onScroll)
                cleanups.push(function () {
                    window.removeEventListener('scroll', onScroll)
                    window.removeEventListener('resize', onScroll)
                    if (railFrame) cancelAnimationFrame(railFrame)
                })

                if (reduceMotion || !('IntersectionObserver' in window)) {
                    stops.forEach(function (stop) { stop.classList.add('is-passed') })
                } else {
                    var stopObserver = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) entry.target.classList.add('is-passed')
                        })
                    }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 })
                    stops.forEach(function (stop) { stopObserver.observe(stop) })
                    cleanups.push(function () { stopObserver.disconnect() })
                }
            }

            /* 5. 随机漫步 */
            var shuffleCard = root.querySelector('[data-map-shuffle]')
            var poolScript = document.getElementById('map-shuffle-pool')
            if (shuffleCard && poolScript) {
                var pool = []
                try { pool = JSON.parse(poolScript.textContent || '[]') } catch (error) { pool = [] }
                if (pool.length > 1) {
                    var shuffleLink = shuffleCard.querySelector('[data-map-shuffle-link]')
                    var shuffleTitle = shuffleCard.querySelector('[data-map-shuffle-title]')
                    var shuffleDesc = shuffleCard.querySelector('[data-map-shuffle-desc]')
                    var shuffleDate = shuffleCard.querySelector('[data-map-shuffle-date]')
                    var shuffleTime = shuffleCard.querySelector('[data-map-shuffle-time]')
                    var shuffleButton = shuffleCard.querySelector('[data-map-shuffle-btn]')
                    var current = Math.min(pool.length - 1, Math.max(0, Number(shuffleCard.getAttribute('data-map-shuffle-index')) || 0))
                    var onShuffle = function () {
                        var next = current
                        while (next === current) next = Math.floor(Math.random() * pool.length)
                        current = next
                        var item = pool[next]
                        shuffleCard.classList.remove('is-shuffling')
                        void shuffleCard.offsetWidth
                        shuffleCard.classList.add('is-shuffling')
                        window.setTimeout(function () { shuffleCard.classList.remove('is-shuffling') }, 720)
                        if (shuffleLink) shuffleLink.href = item.url
                        if (shuffleTitle) shuffleTitle.textContent = item.title
                        if (shuffleDesc) shuffleDesc.textContent = item.note
                        if (shuffleDate) shuffleDate.textContent = item.date
                        if (shuffleTime) shuffleTime.textContent = item.minutes + ' 分钟'
                    }
                    if (shuffleButton) {
                        shuffleButton.addEventListener('click', onShuffle)
                        cleanups.push(function () { shuffleButton.removeEventListener('click', onShuffle) })
                    }
                }
            }

            /* 6. 页面内平滑跳转 */
            var jumps = Array.prototype.slice.call(root.querySelectorAll('[data-map-jump]'))
            var onJump = function (event) {
                var href = event.currentTarget.getAttribute('href') || ''
                if (href.charAt(0) !== '#') return
                var target = document.querySelector(href)
                if (!target) return
                event.preventDefault()
                target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' })
                if (window.history && window.history.replaceState) window.history.replaceState(null, '', href)
            }
            jumps.forEach(function (anchor) { anchor.addEventListener('click', onJump) })
            cleanups.push(function () {
                jumps.forEach(function (anchor) { anchor.removeEventListener('click', onJump) })
            })

            var unregisterLeave = null
            window.__fuwariSeriesMapCleanup = function () {
                cleanups.forEach(function (fn) {
                    try { fn() } catch (error) { /* 忽略 */ }
                })
                cleanups = []
                if (unregisterLeave) {
                    unregisterLeave()
                    unregisterLeave = null
                }
            }

            // 离开这一页时立刻释放 window 监听与 observer：只靠「下次进地图页再清」
            // 的话，跳到别的页面之后旧监听会一直活着。
            if (window.swup && window.swup.hooks) {
                unregisterLeave = window.swup.hooks.on('visit:start', function () {
                    window.__fuwariSeriesMapCleanup()
                })
            } else {
                document.addEventListener('swup:enable', function () {
                    if (window.swup && window.swup.hooks && !unregisterLeave) {
                        unregisterLeave = window.swup.hooks.on('visit:start', function () {
                            window.__fuwariSeriesMapCleanup()
                        })
                    }
                }, { once: true })
            }
        })()
    </script>
</div>

<style>
