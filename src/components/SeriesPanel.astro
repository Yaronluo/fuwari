        color: color-mix(in srgb, var(--primary) 75%, var(--text-muted));
        font-weight: 800;
    }
    .atlas-hint {
        right: 0.9rem;
        bottom: 0.7rem;
        letter-spacing: 0.04em;
    }
    .atlas-you {
        left: 0.9rem;
        bottom: 0.7rem;
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        padding: 0.16rem 0.45rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 10%, transparent);
        color: color-mix(in srgb, var(--primary) 82%, var(--text-body));
