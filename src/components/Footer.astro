---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const FOOTER_QUOTES = [
    { text: "今天也要认真生活，顺便偷偷期待一点好运。", from: "今日份温柔" },
    { text: "慢慢来吧，花会开，喜欢的故事也会有结局。", from: "生活小记" },
    { text: "愿每一次晚风，都把好心情轻轻送到你身边。", from: "今日份温柔" },
    { text: "把普通的日子收好，它们以后都会闪闪发光。", from: "时光收藏夹" },
    { text: "生活偶尔下雨，也别忘了给心里留一小块晴天。", from: "生活小记" },
    { text: "今天的你也很可爱，请继续喜欢这个世界吧。", from: "今日份温柔" },
    { text: "不用急着长大，按自己的节奏慢慢向前就好。", from: "生活小记" },
    { text: "有喜欢的事、有想见的人，今天就值得期待。", from: "今日份温柔" },
    { text: "愿你路过的每一场风景，都有温柔回应。", from: "生活小记" },
    { text: "把烦恼交给晚风，把快乐留给明天的自己。", from: "今日份温柔" },
    { text: "日子平淡一点也没关系，我们可以自己加糖。", from: "生活小记" },
    { text: "好好吃饭，好好睡觉，好好等待下一次心动。", from: "今日份温柔" },
    { text: "每一个认真生活的瞬间，都值得被悄悄收藏。", from: "时光收藏夹" },
    { text: "愿你在自己的故事里，永远是闪闪发光的主角。", from: "今日份温柔" },
    { text: "如果今天有点累，就先停下来抱抱自己吧。", from: "生活小记" },
    { text: "喜欢的风景要慢慢看，喜欢的人也要慢慢了解。", from: "今日份温柔" },
    { text: "普通的一天，也可以因为一件小事变得特别。", from: "生活小记" },
    { text: "愿所有不期而遇，最后都成为恰到好处的温柔。", from: "今日份温柔" },
    { text: "认真记录生活的人，本身就在创造浪漫。", from: "时光收藏夹" },
    { text: "今天也请带着一点点期待，慢慢走向明天。", from: "今日份温柔" },
];
---

<!-- 手账风分隔线 -->
<div class="footer-divider" aria-hidden="true">
    <span></span><b>♫</b><i>♡</i><b>✦</b><span></span>
</div>

<!-- 页脚内容 -->
<div class="footer-panel relative overflow-hidden transition mb-12">
    <!-- 樱花飘落画布 -->
    <sakura-canvas class="absolute top-0 left-0 w-full h-full pointer-events-none z-0 opacity-45">
        <canvas class="w-full h-full"></canvas>
    </sakura-canvas>

    <span class="footer-tape" aria-hidden="true"></span>
    <span class="footer-doodle footer-doodle-left" aria-hidden="true">୨୧</span>
    <span class="footer-doodle footer-doodle-right" aria-hidden="true">♡</span>

    <div class="footer-heading relative z-10">
        <span aria-hidden="true">✦</span>
        <span>AFTER SCHOOL NOTE</span>
        <b>(˶ᵔ ᵕ ᵔ˶)</b>
    </div>

    <!-- 每日一言（本地精选，点击切换） -->
    <hitokoto-quote class="footer-quote relative z-10" title="点击刷新一言" role="button" tabindex="0" aria-label="点击换一句温柔的话">
        <span class="footer-quote-icon" aria-hidden="true">♡</span>
        <span class="footer-quote-copy">
            <span>「<span class="hitokoto-text">正在寻找灵魂深处的共鸣...</span>」</span>
            <span class="hitokoto-author"></span>
        </span>
        <span class="footer-quote-refresh" aria-hidden="true">换一句 ↻</span>
    </hitokoto-quote>

    <!-- 主要信息 -->
    <div class="footer-info relative z-10">
        <div class="footer-signature">
            <span class="footer-signature-mark" aria-hidden="true">♪</span>
            <span>&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}</span>
            <span class="footer-signature-dot" aria-hidden="true"></span>
            <span>Made with <span class="footer-heart animate-pulse">♥</span> in China</span>
        </div>

        <!-- 链接区域 -->
        <nav class="footer-links" aria-label="页脚链接">
            <a target="_blank" href={url('rss.xml')}>
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
                RSS
            </a>
            <a target="_blank" href={url('sitemap-index.xml')}>
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M3 13h2v8H3zm4-8h2v16H7zm4-2h2v18h-2zm4 4h2v14h-2zm4-2h2v16h-2z"/></svg>
                Sitemap
            </a>
            <a target="_blank" href="https://github.com/Yaronluo">
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                GitHub
            </a>
        </nav>

        <!-- 备案信息（如果需要） -->
        <div class="footer-filing">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
                <!-- 这里填写你的备案号 -->
                <!-- 京ICP备xxxxxxxx号 -->
            </a>
        </div>

        <!-- 技术栈信息 -->
        <div class="footer-powered">
            <span aria-hidden="true">୨୧</span>
            <span>Powered by <a target="_blank" href="https://astro.build">Astro</a> × <a target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a></span>
            <span class="footer-powered-divider">·</span>
            <span>Hosted on <a target="_blank" href="https://www.cloudflare.com/zh-cn/">Cloudflare</a></span>
        </div>
    </div>
</div>

<style>
    .footer-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        margin: 2.5rem auto;
        color: color-mix(in srgb, var(--primary) 68%, var(--tea));
    }
    .footer-divider span {
        width: min(8rem, 20vw);
        border-top: 1px dashed color-mix(in srgb, var(--primary) 24%, transparent);
    }
    .footer-divider b { font-size: 0.75rem; font-weight: 700; }
    .footer-divider i { font-size: 1rem; font-style: normal; }

    .footer-panel {
        display: flex;
        min-height: 11rem;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.7rem 1.5rem 1rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 25%, transparent);
        border-radius: 1.75rem;
        background:
            radial-gradient(circle at 12% 18%, color-mix(in srgb, var(--primary) 9%, transparent), transparent 23%),
            radial-gradient(circle at 88% 82%, color-mix(in srgb, var(--tea) 8%, transparent), transparent 25%),
            linear-gradient(145deg, rgb(255 255 255 / 0.5), color-mix(in srgb, var(--cream-base) 86%, transparent));
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.72),
            0 1.15rem 3rem rgb(112 77 67 / 0.07);
    }
    .footer-panel::before {
        content: "";
        position: absolute;
        inset: 0.55rem;
        border: 1px solid color-mix(in srgb, var(--primary) 8%, transparent);
        border-radius: 1.35rem;
        pointer-events: none;
    }
    .footer-tape {
        position: absolute;
        z-index: 3;
        top: -0.35rem;
        left: 50%;
        width: 6.4rem;
        height: 1.35rem;
        background: linear-gradient(90deg, rgb(249 181 193 / 0.3), rgb(255 218 225 / 0.78), rgb(249 181 193 / 0.3));
        clip-path: polygon(4% 10%, 98% 0, 94% 92%, 2% 100%);
        transform: translateX(-50%) rotate(-2deg);
        box-shadow: 0 0.3rem 0.9rem rgb(163 99 112 / 0.08);
    }
    .footer-doodle {
        position: absolute;
        z-index: 1;
        color: color-mix(in srgb, var(--primary) 48%, transparent);
        font-family: Georgia, serif;
        pointer-events: none;
    }
    .footer-doodle-left { left: 4%; top: 22%; font-size: 1.35rem; transform: rotate(-12deg); }
    .footer-doodle-right { right: 5%; bottom: 16%; font-size: 1.65rem; transform: rotate(10deg); }
    .footer-heading {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.45rem;
        color: color-mix(in srgb, var(--primary) 78%, var(--tea));
        font-size: 0.67rem;
        font-weight: 800;
        letter-spacing: 0.14em;
    }
    .footer-heading b { color: color-mix(in srgb, var(--tea) 66%, transparent); font-weight: 600; letter-spacing: 0; }
    .footer-quote {
        display: flex;
        width: min(42rem, 100%);
        cursor: pointer;
        align-items: center;
        gap: 0.8rem;
        padding: 0.56rem 0.85rem;
        border: 1px solid color-mix(in srgb, var(--primary) 15%, white);
        border-radius: 1.15rem;
        background: rgb(255 255 255 / 0.46);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), 0 0.6rem 1.5rem rgb(115 77 67 / 0.06);
        color: rgb(70 61 59 / 0.76);
        transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }
    .footer-quote:hover,
    .footer-quote:focus-visible {
        border-color: color-mix(in srgb, var(--primary) 38%, white);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.86), 0 0.75rem 1.7rem color-mix(in srgb, var(--primary) 10%, transparent);
        outline: none;
        transform: translateY(-2px);
    }
    .footer-quote-icon {
        display: grid;
        width: 2rem;
        height: 2rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 0.7rem;
        background: color-mix(in srgb, var(--primary) 12%, white);
        color: var(--primary);
        font-size: 1rem;
    }
    .footer-quote-copy {
        display: flex;
        min-width: 0;
        flex: 1;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        gap: 0.2rem 0.65rem;
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-align: center;
    }
    .hitokoto-author { color: color-mix(in srgb, var(--primary) 65%, var(--tea)); font-size: 0.75rem; font-family: inherit; }
    .footer-quote-refresh { flex: 0 0 auto; color: rgb(112 92 88 / 0.48); font-size: 0.67rem; font-weight: 650; }
    .footer-info { display: flex; flex-direction: column; align-items: center; color: rgb(91 80 77 / 0.58); font-size: 0.78rem; text-align: center; }
    .footer-signature { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.45rem; margin-top: 0.45rem; }
    .footer-signature-mark { color: var(--primary); font-size: 1rem; }
    .footer-signature-dot { width: 0.22rem; height: 0.22rem; border-radius: 50%; background: color-mix(in srgb, var(--primary) 45%, transparent); }
    .footer-heart { color: var(--primary); }
    .footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem; margin-top: 0.45rem; }
    .footer-links a {
        display: inline-flex;
        min-height: 2rem;
        align-items: center;
        padding: 0.35rem 0.72rem;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, white 44%, transparent);
        color: color-mix(in srgb, var(--primary) 72%, var(--tea));
        font-weight: 700;
        transition: transform 170ms ease, background-color 170ms ease, border-color 170ms ease;
    }
    .footer-links a:hover {
        border-color: color-mix(in srgb, var(--primary) 32%, transparent);
        background: color-mix(in srgb, var(--primary) 9%, white);
        transform: translateY(-2px) rotate(-1deg);
    }
    .footer-filing { min-height: 0.1rem; margin-top: 0.2rem; font-size: 0.68rem; }
    .footer-powered { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.3rem; margin-top: 0.25rem; color: rgb(104 91 88 / 0.46); font-size: 0.68rem; }
    .footer-powered > span:first-child { color: color-mix(in srgb, var(--primary) 56%, transparent); }
    .footer-powered a { color: color-mix(in srgb, var(--primary) 76%, var(--tea)); font-weight: 700; transition: color 160ms ease; }
    .footer-powered a:hover { color: var(--primary); }
    .footer-powered-divider { color: color-mix(in srgb, var(--primary) 35%, transparent); }

    :global(.dark) .footer-panel {
        background:
            radial-gradient(circle at 12% 18%, color-mix(in srgb, var(--primary) 10%, transparent), transparent 23%),
            linear-gradient(145deg, rgb(39 32 34 / 0.72), rgb(27 24 25 / 0.58));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 1.15rem 3rem rgb(0 0 0 / 0.18);
    }
    :global(.dark) .footer-quote { border-color: rgb(255 255 255 / 0.08); background: rgb(255 255 255 / 0.045); color: rgb(255 242 241 / 0.68); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05); }
    :global(.dark) .footer-quote-icon,
    :global(.dark) .footer-links a { background: rgb(255 255 255 / 0.055); border-color: rgb(255 255 255 / 0.075); }
    :global(.dark) .footer-info { color: rgb(255 242 241 / 0.5); }
    :global(.dark) .footer-powered { color: rgb(255 242 241 / 0.36); }

    @media (max-width: 640px) {
        .footer-panel { min-height: 13.5rem; padding: 1.85rem 1rem 1rem; border-radius: 1.4rem; }
        .footer-quote { align-items: flex-start; padding: 0.58rem 0.72rem; }
        .footer-quote-copy {
            flex-wrap: nowrap;
            justify-content: flex-start;
            gap: 0.3rem;
            overflow: hidden;
            font-size: clamp(0.62rem, 2.6vw, 0.78rem);
            white-space: nowrap;
            text-align: left;
        }
        .hitokoto-author { flex: 0 0 auto; font-size: 0.64rem; }
        .footer-quote-refresh { display: none; }
        .footer-signature { max-width: 18rem; }
        .footer-signature-dot { display: none; }
        .footer-signature > span:nth-child(4) { width: 100%; }
        .footer-powered {
            max-width: 100%;
            flex-wrap: nowrap;
            gap: 0.2rem;
            font-size: clamp(0.56rem, 2.25vw, 0.64rem);
            white-space: nowrap;
        }
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
</style>

<script is:inline define:vars={{ FOOTER_QUOTES }}>
(() => {
class HitokotoQuote extends HTMLElement {
    constructor() {
        super();
        this.quoteIndex = -1;
        const refreshQuote = () => {
            const textEl = this.querySelector('.hitokoto-text');
            if (textEl) textEl.textContent = "换一句温柔的话...";
            this.showQuote(true);
        };
        this.addEventListener('click', refreshQuote);
        this.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            refreshQuote();
        });
    }

    connectedCallback() {
        // 使用 setTimeout 确保 DOM 子元素已经完全挂载
        setTimeout(() => this.showQuote(false), 0);
    }

    showQuote(advance) {
        const textEl = this.querySelector('.hitokoto-text');
        const authorEl = this.querySelector('.hitokoto-author');
        if (!textEl) return;

        if (this.quoteIndex < 0) {
            const today = new Date();
            const localDayNumber = Math.floor(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()) / 86400000);
            this.quoteIndex = localDayNumber % FOOTER_QUOTES.length;
        } else if (advance) {
            this.quoteIndex = (this.quoteIndex + 1) % FOOTER_QUOTES.length;
        }
        const quote = FOOTER_QUOTES[this.quoteIndex];

        textEl.style.opacity = '0';
        if (authorEl) authorEl.style.opacity = '0';

        setTimeout(() => {
            textEl.textContent = quote.text;
            if (authorEl) authorEl.textContent = `—— ${quote.from}`;

            textEl.style.transition = 'opacity 0.5s';
            textEl.style.opacity = '1';
            if (authorEl) {
                authorEl.style.transition = 'opacity 0.5s';
                authorEl.style.opacity = '0.7';
            }
        }, 300);
    }
}
if (!customElements.get('hitokoto-quote')) {
    customElements.define('hitokoto-quote', HitokotoQuote);
}

class Sakura {
    constructor(w, h) {
        this.reset(w, h, true);
    }
    reset(w, h, isInit) {
        this.x = Math.random() * w;
        this.y = isInit ? Math.random() * h : -20;
        this.size = Math.random() * 6 + 4; 
        this.speedY = Math.random() * 0.5 + 0.2; 
        this.speedX = Math.random() * 0.5 - 0.25; 
        this.angle = Math.random() * Math.PI * 2;
        this.spin = Math.random() * 0.02 - 0.01;
        this.opacity = Math.random() * 0.5 + 0.2;
    }
    update(w, h) {
        this.y += this.speedY;
        this.x += this.speedX + Math.sin(this.y * 0.01) * 0.5; 
        this.angle += this.spin;
        if (this.y > h + 20 || this.x < -20 || this.x > w + 20) {
            this.reset(w, h, false);
        }
    }
    draw(ctx, color) {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.angle);
        ctx.globalAlpha = this.opacity;
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.bezierCurveTo(this.size / 2, -this.size / 2, this.size, -this.size / 3, 0, this.size);
        ctx.bezierCurveTo(-this.size, -this.size / 3, -this.size / 2, -this.size / 2, 0, 0);
        ctx.fill();
        ctx.restore();
    }
}

class SakuraCanvasElement extends HTMLElement {
    connectedCallback() {
        setTimeout(() => this.init(), 0);
    }
    
    init() {
        this.canvas = this.querySelector('canvas');
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        this.sakuras = [];
        this.numSakuras = 25; 
        this.updateColor = () => {
            this.sakuraColor = getComputedStyle(document.documentElement)
                .getPropertyValue('--primary').trim() || '#d97991';
        };
        this.updateColor();
        this.themeObserver = new MutationObserver(this.updateColor);
        this.themeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class', 'data-palette'],
        });
        
        this.resize = () => {
            this.canvas.width = this.offsetWidth;
            this.canvas.height = this.offsetHeight;
        };
        
        this.resize();
        window.addEventListener('resize', this.resize);
        
        for (let i = 0; i < this.numSakuras; i++) {
            this.sakuras.push(new Sakura(this.canvas.width, this.canvas.height));
        }
        
        this.animId = requestAnimationFrame(() => this.animate());
    }
    
    disconnectedCallback() {
        if (this.resize) window.removeEventListener('resize', this.resize);
        if (this.animId) cancelAnimationFrame(this.animId);
        if (this.themeObserver) this.themeObserver.disconnect();
    }
    
    animate() {
        if (!this.canvas) return;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        this.sakuras.forEach(s => {
            s.update(this.canvas.width, this.canvas.height);
            s.draw(this.ctx, this.sakuraColor);
        });
        this.animId = requestAnimationFrame(() => this.animate());
    }
}
if (!customElements.get('sakura-canvas')) {
    customElements.define('sakura-canvas', SakuraCanvasElement);
}
})();
</script>
