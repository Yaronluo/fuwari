---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const FOOTER_QUOTES = [
    { text: "今天也要认真生活，顺便偷偷期待一点好运。", from: "今日份温柔" },
    { text: "慢慢来吧，花会开，喜欢的故事也会有结局。", from: "生活小记" },
    { text: "愿每一次晚风，都把好心情轻轻送到你身边。", from: "今日份温柔" },
    { text: "把普通的日子收好，它们以后都会闪闪发光。", from: "时光收藏夹" },
    { text: "生活偶尔下雨，也别忘了给心里留一小块晴天。", from: "生活小记" },
    { text: "今天的你也很可爱，请继续喜欢这个世界吧。", from: "今日份温柔" },
    { text: "不用急着长大，按自己的节奏慢慢向前就好。", from: "生活小记" },
    { text: "有喜欢的事、有想见的人，今天就值得期待。", from: "今日份温柔" },
    { text: "愿你路过的每一场风景，都有温柔回应。", from: "生活小记" },
    { text: "把烦恼交给晚风，把快乐留给明天的自己。", from: "今日份温柔" },
    { text: "日子平淡一点也没关系，我们可以自己加糖。", from: "生活小记" },
    { text: "好好吃饭，好好睡觉，好好等待下一次心动。", from: "今日份温柔" },
    { text: "每一个认真生活的瞬间，都值得被悄悄收藏。", from: "时光收藏夹" },
    { text: "愿你在自己的故事里，永远是闪闪发光的主角。", from: "今日份温柔" },
    { text: "如果今天有点累，就先停下来抱抱自己吧。", from: "生活小记" },
    { text: "喜欢的风景要慢慢看，喜欢的人也要慢慢了解。", from: "今日份温柔" },
    { text: "普通的一天，也可以因为一件小事变得特别。", from: "生活小记" },
    { text: "愿所有不期而遇，最后都成为恰到好处的温柔。", from: "今日份温柔" },
    { text: "认真记录生活的人，本身就在创造浪漫。", from: "时光收藏夹" },
    { text: "今天也请带着一点点期待，慢慢走向明天。", from: "今日份温柔" },
];
---

<!-- 分隔线 -->
<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>

<!-- 页脚内容 -->
<div class="footer-panel relative overflow-hidden transition border border-dashed dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6 py-8">
    <!-- 樱花飘落画布 -->
    <sakura-canvas class="absolute top-0 left-0 w-full h-full pointer-events-none z-0 opacity-60">
        <canvas class="w-full h-full"></canvas>
    </sakura-canvas>

    <!-- 每日一言（本地精选，点击切换） -->
    <hitokoto-quote class="relative z-10 block mb-4 text-black/70 dark:text-white/70 font-serif font-medium tracking-wide cursor-pointer hover:opacity-80 transition-opacity" title="点击刷新一言">
        「<span class="hitokoto-text">正在寻找灵魂深处的共鸣...</span>」
        <span class="hitokoto-author text-sm font-medium ml-2 opacity-70 hidden md:inline-block"></span>
    </hitokoto-quote>

    <!-- 主要信息 -->
    <div class="relative z-10 transition text-black/50 dark:text-white/50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}.
        Made with <span class="text-red-500 animate-pulse">❤️</span> in China.<br>

        <!-- 链接区域 -->
        <div class="flex flex-wrap justify-center items-center gap-3 mt-3">
            <a class="transition link text-[var(--primary)] font-medium hover:underline" target="_blank" href={url('rss.xml')}>
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
                RSS
            </a>
            <span class="text-[var(--text-40)]">|</span>
            <a class="transition link text-[var(--primary)] font-medium hover:underline" target="_blank" href={url('sitemap-index.xml')}>
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M3 13h2v8H3zm4-8h2v16H7zm4-2h2v18h-2zm4 4h2v14h-2zm4-2h2v16h-2z"/></svg>
                Sitemap
            </a>
            <span class="text-[var(--text-40)]">|</span>
            <a class="transition link text-[var(--primary)] font-medium hover:underline" target="_blank" href="https://github.com/Yaronluo">
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                Github
            </a>
        </div>

        <!-- 备案信息（如果需要） -->
        <div class="mt-3 text-xs text-black/40 dark:text-white/40">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-black/70 dark:hover:text-white/70 transition">
                <!-- 这里填写你的备案号 -->
                <!-- 京ICP备xxxxxxxx号 -->
            </a>
        </div>

        <!-- 技术栈信息 -->
        <div class="mt-4 text-xs text-black/50 dark:text-white/50">
            Powered by
            <a class="transition link text-[var(--primary)] font-medium hover:underline" target="_blank" href="https://astro.build">Astro</a> &
            <a class="transition link text-[var(--primary)] font-medium hover:underline" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
            & Hosted on
            <a class="transition link text-[var(--primary)] font-medium hover:underline" target="_blank" href="https://www.cloudflare.com/zh-cn/">Cloudflare</a>
        </div>
    </div>
</div>

<style>
    .footer-panel {
        border-color: color-mix(in srgb, var(--primary) 18%, transparent);
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
</style>

<script is:inline define:vars={{ FOOTER_QUOTES }}>
(() => {
class HitokotoQuote extends HTMLElement {
    constructor() {
        super();
        this.quoteIndex = -1;
        // 点击刷新一言
        this.addEventListener('click', () => {
            const textEl = this.querySelector('.hitokoto-text');
            if (textEl) textEl.textContent = "换一句温柔的话...";
            this.showQuote(true);
        });
    }

    connectedCallback() {
        // 使用 setTimeout 确保 DOM 子元素已经完全挂载
        setTimeout(() => this.showQuote(false), 0);
    }

    showQuote(advance) {
        const textEl = this.querySelector('.hitokoto-text');
        const authorEl = this.querySelector('.hitokoto-author');
        if (!textEl) return;

        if (this.quoteIndex < 0) {
            const today = new Date();
            const localDayNumber = Math.floor(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()) / 86400000);
            this.quoteIndex = localDayNumber % FOOTER_QUOTES.length;
        } else if (advance) {
            this.quoteIndex = (this.quoteIndex + 1) % FOOTER_QUOTES.length;
        }
        const quote = FOOTER_QUOTES[this.quoteIndex];

        textEl.style.opacity = '0';
        if (authorEl) authorEl.style.opacity = '0';

        setTimeout(() => {
            textEl.textContent = quote.text;
            if (authorEl) authorEl.textContent = `—— ${quote.from}`;

            textEl.style.transition = 'opacity 0.5s';
            textEl.style.opacity = '1';
            if (authorEl) {
                authorEl.style.transition = 'opacity 0.5s';
                authorEl.style.opacity = '0.7';
            }
        }, 300);
    }
}
if (!customElements.get('hitokoto-quote')) {
    customElements.define('hitokoto-quote', HitokotoQuote);
}

class Sakura {
    constructor(w, h) {
        this.reset(w, h, true);
    }
    reset(w, h, isInit) {
        this.x = Math.random() * w;
        this.y = isInit ? Math.random() * h : -20;
        this.size = Math.random() * 6 + 4; 
        this.speedY = Math.random() * 0.5 + 0.2; 
        this.speedX = Math.random() * 0.5 - 0.25; 
        this.angle = Math.random() * Math.PI * 2;
        this.spin = Math.random() * 0.02 - 0.01;
        this.opacity = Math.random() * 0.5 + 0.2;
    }
    update(w, h) {
        this.y += this.speedY;
        this.x += this.speedX + Math.sin(this.y * 0.01) * 0.5; 
        this.angle += this.spin;
        if (this.y > h + 20 || this.x < -20 || this.x > w + 20) {
            this.reset(w, h, false);
        }
    }
    draw(ctx, color) {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.angle);
        ctx.globalAlpha = this.opacity;
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.bezierCurveTo(this.size / 2, -this.size / 2, this.size, -this.size / 3, 0, this.size);
        ctx.bezierCurveTo(-this.size, -this.size / 3, -this.size / 2, -this.size / 2, 0, 0);
        ctx.fill();
        ctx.restore();
    }
}

class SakuraCanvasElement extends HTMLElement {
    connectedCallback() {
        setTimeout(() => this.init(), 0);
    }
    
    init() {
        this.canvas = this.querySelector('canvas');
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        this.sakuras = [];
        this.numSakuras = 25; 
        this.updateColor = () => {
            this.sakuraColor = getComputedStyle(document.documentElement)
                .getPropertyValue('--primary').trim() || '#d97991';
        };
        this.updateColor();
        this.themeObserver = new MutationObserver(this.updateColor);
        this.themeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class', 'data-palette'],
        });
        
        this.resize = () => {
            this.canvas.width = this.offsetWidth;
            this.canvas.height = this.offsetHeight;
        };
        
        this.resize();
        window.addEventListener('resize', this.resize);
        
        for (let i = 0; i < this.numSakuras; i++) {
            this.sakuras.push(new Sakura(this.canvas.width, this.canvas.height));
        }
        
        this.animId = requestAnimationFrame(() => this.animate());
    }
    
    disconnectedCallback() {
        if (this.resize) window.removeEventListener('resize', this.resize);
        if (this.animId) cancelAnimationFrame(this.animId);
        if (this.themeObserver) this.themeObserver.disconnect();
    }
    
    animate() {
        if (!this.canvas) return;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        this.sakuras.forEach(s => {
            s.update(this.canvas.width, this.canvas.height);
            s.draw(this.ctx, this.sakuraColor);
        });
        this.animId = requestAnimationFrame(() => this.animate());
    }
}
if (!customElements.get('sakura-canvas')) {
    customElements.define('sakura-canvas', SakuraCanvasElement);
}
})();
</script>
