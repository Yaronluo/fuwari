		border-radius: 1.35rem;
		background: color-mix(in srgb, var(--studio-accent) 10%, var(--glass-panel));
		box-shadow: inset 0 0 0 0.3rem color-mix(in srgb, var(--glass-card) 72%, transparent);
	}

	.reel-stamp img {
		position: relative;
		width: 62%;
		max-height: 62%;
		object-fit: contain;
	}

	.stamp-mono {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: color-mix(in srgb, var(--studio-accent) 74%, var(--text-strong));
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		opacity: 0;
	}

	/* 外链 logo 取不到时退回字母印章，避免出现破图 */
	.reel-stamp.logo-failed img {
		display: none;
	}

	.reel-stamp.logo-failed .stamp-mono {
		opacity: 1;
	}

	.reel-stamp-ring {
		position: absolute;
		inset: -0.45rem;
		border: 1px dashed color-mix(in srgb, var(--studio-accent) 34%, transparent);
		border-radius: 1.6rem;
	}

	.reel-stamp-charm {
		position: absolute;
		right: -0.6rem;
		bottom: -0.6rem;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--studio-accent);
		color: #fff;
		font-size: 0.82rem;
		box-shadow: 0 0.35rem 0.9rem color-mix(in srgb, var(--studio-accent) 45%, transparent);
	}

	.reel-stamp-charm b {
		font-weight: 700;
		line-height: 1;
	}

	.reel-identity {
		min-width: 0;
	}

	.reel-label {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 0.55rem;
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--studio-accent) 74%, var(--text-strong));
	}

	.reel-label span {
		padding: 0.22rem 0.5rem;
		border-radius: 0.45rem;
		background: color-mix(in srgb, var(--studio-accent) 15%, transparent);
	}

	.studio-reel h2 {
		margin: 0;
		font-size: 1.85rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		line-height: 1.25;
	}

	.reel-original {
		margin: 0.4rem 0 0;
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--text-strong) 52%, transparent);
	}

	.reel-traits {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.85rem;
	}

	.reel-traits small {
		padding: 0.24rem 0.6rem;
		border: 1px solid color-mix(in srgb, var(--studio-accent) 28%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--studio-accent) 8%, transparent);
		font-size: 0.68rem;
		color: color-mix(in srgb, var(--text-strong) 78%, transparent);
	}

	.reel-quote {
		position: relative;
		margin: 0;
		padding: 0.2rem 0 0.2rem 1.35rem;
		border-left: 2px solid color-mix(in srgb, var(--studio-accent) 42%, transparent);
		font-size: 1rem;
		line-height: 1.95;
		color: color-mix(in srgb, var(--text-strong) 88%, transparent);
	}

	.reel-quote::before {
		content: "“";
		position: absolute;
		top: -1.05rem;
		left: 0.55rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 3rem;
		line-height: 1;
		color: color-mix(in srgb, var(--studio-accent) 26%, transparent);
	}

	/* 便签 + 数据 */
	.reel-dossier {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: 1.3rem 2.2rem;
		margin-top: 1.6rem;
		padding-top: 1.45rem;
		border-top: 1px dashed color-mix(in srgb, var(--studio-accent) 32%, transparent);
	}

	.dossier-label {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.74rem;
		font-weight: 700;
		color: color-mix(in srgb, var(--studio-accent) 78%, var(--text-strong));
	}

	.dossier-label::before {
		content: "";
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: currentColor;
	}

	.dossier-note p {
		margin: 0.6rem 0 0;
		font-size: 0.86rem;
		line-height: 1.95;
		color: color-mix(in srgb, var(--text-strong) 76%, transparent);
	}

	.dossier-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.7rem;
		align-content: start;
	}

	.dossier-stat {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.7rem 0.8rem;
		border: 1px solid color-mix(in srgb, var(--studio-accent) 16%, transparent);
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--studio-accent) 7%, transparent);
	}

	.dossier-stat strong {
		font-size: 1.32rem;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		color: color-mix(in srgb, var(--studio-accent) 72%, var(--text-strong));
	}

	.dossier-stat span {
		font-size: 0.68rem;
		color: color-mix(in srgb, var(--text-strong) 58%, transparent);
	}

	.dossier-meter {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	.meter-ticks {
		display: flex;
		flex: 1 1 auto;
		gap: 0.22rem;
	}

	.meter-tick {
		flex: 1 1 auto;
		height: 0.42rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--text-strong) 12%, transparent);
	}

	.meter-tick.is-on {
		background: color-mix(in srgb, var(--studio-accent) 78%, transparent);
	}

	.meter-caption {
		flex: none;
		font-size: 0.66rem;
		color: color-mix(in srgb, var(--text-strong) 52%, transparent);
	}

	.meter-caption b {
		color: color-mix(in srgb, var(--studio-accent) 76%, var(--text-strong));
	}

	/* 作品联系表 */
	.reel-works {
		margin-top: 1.7rem;
	}

	.works-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.9rem;
	}

	.works-heading > span {
		font-size: 0.9rem;
		font-weight: 700;
	}

	.works-heading > span i {
		font-style: normal;
		color: var(--studio-accent);
	}

	.works-heading small {
		font-size: 0.6rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--text-strong) 42%, transparent);
	}

	.works-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.work-card {
		--reveal-y: 0rem;
		--lift: 0rem;
		--tilt-x: 0deg;
		--tilt-y: 0deg;
		position: relative;
		display: flex;
		flex: 0 0 calc((100% - 0.85rem) / 2);
		flex-direction: column;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--studio-accent) 18%, var(--glass-border));
		border-radius: 1rem;
		background: color-mix(in srgb, var(--glass-card) 96%, transparent);
		text-decoration: none;
		color: inherit;
		transform: perspective(900px) translateY(calc(var(--reveal-y) + var(--lift))) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
		transition: transform 0.5s cubic-bezier(0.22, 0.85, 0.24, 1), box-shadow 0.35s ease, border-color 0.35s ease, opacity 0.55s ease;
	}

	.work-card:hover,
	.work-card:focus-visible {
		--lift: -0.35rem;
		border-color: color-mix(in srgb, var(--studio-accent) 48%, transparent);
		box-shadow: 0 1.1rem 2.1rem color-mix(in srgb, var(--studio-accent) 24%, transparent);
	}

	.work-cover {
		position: relative;
		display: block;
		aspect-ratio: 3 / 4.15;
		overflow: hidden;
		background: color-mix(in srgb, var(--studio-accent) 8%, transparent);
	}

	.work-cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.65s cubic-bezier(0.22, 0.85, 0.24, 1);
	}

	.work-card:hover .work-cover img,
	.work-card:focus-visible .work-cover img {
		transform: scale(1.055);
	}

	.cover-fallback {
		display: grid;
		place-items: center;
		height: 100%;
		font-size: 0.72rem;
		color: color-mix(in srgb, var(--text-strong) 50%, transparent);
	}

	.work-badge {
		position: absolute;
		top: 0.45rem;
		left: 0.45rem;
		padding: 0.18rem 0.45rem;
		border-radius: 0.4rem;
		background: color-mix(in srgb, var(--studio-accent) 84%, #fff);
		color: #fff;
		font-size: 0.62rem;
		font-weight: 700;
		box-shadow: 0 0.2rem 0.5rem rgb(0 0 0 / 0.18);
	}

	.work-badge-article {
		left: auto;
		right: 0.45rem;
		background: rgb(26 18 24 / 0.72);
		font-weight: 600;
		backdrop-filter: blur(0.3rem);
	}

	.work-cue {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.55rem 0.7rem;
		background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--studio-accent) 76%, rgb(22 15 20 / 0.92)) 46%);
		color: #fff;
		font-size: 0.7rem;
		transform: translateY(103%);
		transition: transform 0.45s cubic-bezier(0.22, 0.85, 0.24, 1);
	}

	.work-card:hover .work-cue,
	.work-card:focus-visible .work-cue {
		transform: none;
	}

	.work-cue b {
		font-weight: 600;
	}

	.work-cue i {
		font-style: normal;
		transition: transform 0.35s ease;
	}

	.work-card:hover .work-cue i {
		transform: translate(0.15rem, -0.15rem);
	}

	.work-info {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.55rem;
		padding: 0.62rem 0.7rem 0.7rem;
	}

	.work-info h3 {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		min-height: 2.34em;
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.5;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.work-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		font-size: 0.66rem;
		color: color-mix(in srgb, var(--text-strong) 55%, transparent);
	}

	.work-rate {
		font-weight: 700;
		color: color-mix(in srgb, var(--studio-accent) 74%, var(--text-strong));
	}

	.work-rate-none {
		font-weight: 500;
		color: color-mix(in srgb, var(--text-strong) 45%, transparent);
	}

	.work-index {
		font-style: normal;
		letter-spacing: 0.12em;
		font-variant-numeric: tabular-nums;
	}

	/* 一卷放完的收尾卡：填满最后一行的空位 */
	.work-fin {
		display: flex;
		flex: 1 1 8rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 6rem;
		padding: 1.1rem;
		border: 1px dashed color-mix(in srgb, var(--studio-accent) 32%, transparent);
		border-radius: 1rem;
		background:
			radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--studio-accent) 9%, transparent), transparent 72%),
			repeating-linear-gradient(90deg, color-mix(in srgb, var(--studio-accent) 6%, transparent) 0 0.45rem, transparent 0.45rem 0.9rem);
		text-align: center;
	}

	.fin-dots {
		display: inline-flex;
		gap: 0.3rem;
	}

	.fin-dots i {
		width: 0.35rem;
		height: 0.35rem;
		border: 1px solid color-mix(in srgb, var(--studio-accent) 42%, transparent);
		border-radius: 50%;
	}

	.fin-word {
		font-size: 1.45rem;
		font-weight: 800;
		letter-spacing: 0.36em;
		text-indent: 0.36em;
		color: color-mix(in srgb, var(--studio-accent) 70%, var(--text-strong));
	}

	.fin-note {
		font-size: 0.66rem;
		letter-spacing: 0.05em;
		color: color-mix(in srgb, var(--text-strong) 50%, transparent);
	}

	/* ===== 页脚 ===== */
	.studios-foot {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 1.8rem;
		padding: 0 0.5rem;
		font-size: 0.74rem;
		color: color-mix(in srgb, var(--text-strong) 58%, transparent);
	}

	.studios-foot p {
		margin: 0;
		white-space: nowrap;
	}

	.studios-foot p b {
		color: var(--primary);
	}

	.studios-foot a {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--primary);
		font-weight: 700;
		text-decoration: none;
	}

	.foot-rule {
		flex: 1 1 auto;
		height: 1px;
		background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--text-strong) 22%, transparent) 0 0.4rem, transparent 0.4rem 0.8rem);
	}

	/* ===== 数据出错 ===== */
	.studios-empty {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.6rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 34%, var(--glass-border));
		border-radius: 1.3rem;
		background: color-mix(in srgb, var(--glass-card) 92%, transparent);
	}

	.studios-empty > span {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 16%, transparent);
		color: var(--primary);
		font-weight: 700;
	}

	.studios-empty strong {
		display: block;
		font-size: 0.9rem;
	}

	.studios-empty p {
		margin: 0.3rem 0 0;
		font-size: 0.78rem;
		color: color-mix(in srgb, var(--text-strong) 58%, transparent);
	}

	/* ===== 响应式 ===== */
	@media (min-width: 640px) {
		.work-card {
			flex-basis: calc((100% - 1.7rem) / 3);
		}
	}

	@media (min-width: 900px) {
		.work-card {
			flex-basis: calc((100% - 2.55rem) / 4);
		}
	}

	@media (min-width: 1150px) {
		.work-card {
			flex-basis: calc((100% - 3.4rem) / 5);
		}
	}

	@media (max-width: 1024px) {
		.studios-hero {
			padding: 2.6rem 2.4rem 4rem;
		}

		.hero-marquee {
			margin: 2rem -2.4rem -4rem;
		}

		.reel-head {
			grid-template-columns: 6.4rem minmax(0, 1fr);
		}

		.reel-quote {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 860px) {
		.studios-hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.6rem;
		}

		.hero-ticket {
			grid-column: 1;
			justify-content: space-between;
		}

		.reel-dossier {
			grid-template-columns: minmax(0, 1fr);
		}

		.reel-rail {
			display: none !important;
		}
	}

	@media (max-width: 640px) {
		.studios-page {
			padding: 0.75rem 0.6rem 2rem;
		}

		.studios-hero {
			padding: 2.2rem 1.5rem 3.6rem;
			border-radius: 1.5rem;
		}

		.hero-marquee {
			margin: 1.8rem -1.5rem -3.6rem;
		}

		.hero-reel {
			width: 4.2rem;
			height: 4.2rem;
		}

		.hero-ticket {
			flex-wrap: wrap;
			gap: 0.9rem 1.1rem;
		}

		.ticket-stub {
			display: none;
		}

		.studio-reel {
			padding: 1.7rem 1.15rem 1.7rem 1.9rem;
			border-radius: 1.3rem;
		}

		.reel-head {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.1rem;
		}

		.reel-spine {
			left: 0.6rem;
			width: 0.6rem;
			background-size: 0.6rem 0.95rem;
		}

		.works-heading small {
			display: none;
		}

		.studios-foot {
			flex-wrap: wrap;
			justify-content: center;
		}

		.foot-rule {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-dust i {
			display: none;
		}

		.studio-ambient {
			display: none;
		}
	}

	/* ===== 动效（只在允许动态、且脚本可用时启用） ===== */
	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		.hero-curtain {
			display: block;
		}

		.hero-curtain-left {
			animation: curtain-open-left 1.05s cubic-bezier(0.6, 0.02, 0.2, 1) 0.1s both;
		}

		.hero-curtain-right {
			animation: curtain-open-right 1.05s cubic-bezier(0.6, 0.02, 0.2, 1) 0.1s both;
		}

		.hero-beam {
			animation: beam-sway 13s ease-in-out infinite alternate;
		}

		.hero-dust i {
			animation: dust-rise calc(9s + var(--dust-order) * 1.5s) linear calc(var(--dust-order) * -1.7s) infinite;
		}

		.hero-reel {
			animation: reel-spin 42s linear infinite;
		}

		.hero-kicker {
			animation: hero-fade 0.8s ease-out 0.3s both;
		}

		.hero-title-cn i {
			animation: title-rise 1s cubic-bezier(0.22, 0.85, 0.24, 1) 0.45s both;
		}

		.hero-title-en {
			animation: hero-en 0.9s cubic-bezier(0.22, 0.85, 0.24, 1) 0.65s both;
		}

		.hero-lead {
			animation: hero-fade 0.9s ease-out 0.8s both;
		}

		.hero-ticket {
			animation: ticket-in 0.95s cubic-bezier(0.22, 0.85, 0.24, 1) 0.72s both;
		}

		.hero-marquee {
			animation: hero-fade 1s ease-out 1s both;
		}

		.hero-marquee-track {
			animation: marquee-run 46s linear infinite;
		}

		.hero-marquee:hover .hero-marquee-track {
			animation-play-state: paused;
		}

		.reel-spine {
			animation: film-run 5s linear infinite;
		}

		.watched-note {
			animation: hero-fade 0.8s ease-out 0.15s both;
		}

		/* 区块揭幕 */
		[data-reveal] {
			opacity: 0;
			transition: opacity 0.75s ease, transform 0.75s cubic-bezier(0.22, 0.85, 0.24, 1);
			transition-delay: calc(var(--reveal-order, 0) * 70ms);
		}

		/* 注意：初始隐藏状态只能用 opacity / transform。
		   Chrome 把 clip-path 也算进 IntersectionObserver 的可见矩形，
		   若在这里静态裁掉，元素永远判定为不可见 → 揭幕动画永远不会触发。 */
		.reel-head[data-reveal],
		.reel-dossier > [data-reveal],
		.works-heading[data-reveal] {
			transform: translateY(1.5rem);
			transition: opacity 0.75s ease, transform 0.9s cubic-bezier(0.22, 0.85, 0.24, 1);
			transition-delay: calc(var(--reveal-order, 0) * 90ms);
		}

		[data-reveal].is-in {
			opacity: 1;
			transform: none;
		}

		/* 幕帘式展开：裁剪发生在 is-in 之后，所以不参与 IO 判定 */
		.reel-head[data-reveal].is-in,
		.reel-dossier > [data-reveal].is-in,
		.works-heading[data-reveal].is-in {
			animation: reveal-wipe 0.95s cubic-bezier(0.22, 0.85, 0.24, 1) both;
			animation-delay: calc(var(--reveal-order, 0) * 90ms);
		}

		.work-card[data-reveal] {
			opacity: 0;
			--reveal-y: 1.5rem;
		}

		.work-card[data-reveal].is-in {
			opacity: 1;
			--reveal-y: 0rem;
		}

		/* 印章落下 + 涟漪 */
		.reel-head.is-in .reel-stamp {
			animation: stamp-drop 0.8s cubic-bezier(0.2, 0.9, 0.24, 1.05) 0.15s both;
		}

		.reel-head.is-in .reel-stamp-ring {
