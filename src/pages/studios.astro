---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getBangumiData } from "../data/bangumi";
import type { BangumiCollection, BangumiSubject } from "../utils/bangumi";

const ARTICLE_LINKS: Record<number, string> = {
	1424: "/posts/番剧观后感-轻音少女/",
	269235: "/posts/番剧观后感-天气之子/",
};

const STUDIO_CHARMS = [
	{ icon: "♪", text: "放学后" },
	{ icon: "△", text: "去露营" },
	{ icon: "☁", text: "看天空" },
	{ icon: "♡", text: "青春开演" },
	{ icon: "✦", text: "闪闪发光" },
	{ icon: "☺", text: "心动日常" },
	{ icon: "↺", text: "再来一次" },
] as const;

const STUDIO_DEFINITIONS = [
	{
		name: "京都动画",
		originalName: "KYOTO ANIMATION",
		logo: "https://upload.wikimedia.org/wikipedia/commons/7/7a/Kyoto_Animation_logo_2rows.svg",
		accent: "#e978a6",
		impression: "把日常里的目光、停顿与告别，画得比奇迹更加动人。",
		detail:
			"我喜欢京都动画，因为它总能发现日常里那些小小的可爱。《轻音少女》的放学后、《CLANNAD》的相遇与陪伴，看起来都是普通生活，却总能让我笑着笑着就悄悄红了眼眶。",
		traits: ["细腻演出", "日常温度", "人物情绪"],
		workIds: [876, 51, 1424, 3774, 12426, 90880, 29648, 55113],
	},
	{
		name: "C-Station",
		originalName: "シーステイション",
		logo: "https://upload.wikimedia.org/wikipedia/commons/8/8b/C-Station_Logo.png",
		accent: "#6fa56f",
		impression: "把脚步放慢一点，风景就会悄悄来到身边。",
		detail:
			"《摇曳露营△》最吸引我的，是它愿意慢慢记录旅途中的小事。准备行李、等待日落、分享晚餐，每一个平淡的瞬间，都让忙碌的心情跟着安静下来。",
		traits: ["户外治愈", "风景氛围", "悠闲日常"],
		workIds: [262897, 207195],
	},
	{
		name: "CoMix Wave Films",
		originalName: "コミックス・ウェーブ・フィルム",
		logo: "https://www.cwfilms.jp/common/favicon/apple-touch-icon.png",
		accent: "#5b9fd4",
		impression: "把天空、雨和很远的心事，都留在同一帧画面里。",
		detail:
			"新海诚的画面里总有一片很好的天空。《你的名字。》里黄昏那一瞬的错身、《天气之子》里为了一个人把世界淋湿的任性，都让我在电影院里很久没能平静下来。",
		traits: ["光影天空", "青春远行", "情绪暴雨"],
		workIds: [160209, 269235, 927, 362577],
	},
	{
		name: "A-1 Pictures",
		originalName: "A-1 Pictures",
		logo: "https://upload.wikimedia.org/wikipedia/commons/d/d9/A-1_Pictures_Logo.svg",
		accent: "#8477c3",
		impression: "把热闹的青春和安静的孤独，都拍得一样认真。",
		detail:
			"A-1 的画面总是很干净，人物站在一起说话的时候，空气里都像有细小的情绪在流动。《辉夜大小姐想让我告白》的斗智、《莉可丽丝》的夏日街景，都让我反复回看。",
		traits: ["青春群像", "轻快节奏", "情绪细节"],
		workIds: [317613, 425211, 248175, 100444, 23686, 10440, 293049, 46213],
	},
	{
		name: "三叶草工作室",
		originalName: "CLOVERWORKS",
		logo: "https://upload.wikimedia.org/wikipedia/commons/3/3b/CloverWorks_Logo.svg",
		accent: "#54a997",
		impression: "把成长里那些说不出口的部分，慢慢讲给观众听。",
		detail:
			"CloverWorks 很擅长拍“不太会说出口的心情”。《青春猪头少年》系列里那些笨拙的对话、《更衣人偶坠入爱河》的温度，都让角色显得又真实又可爱。",
		traits: ["细腻作画", "成长心事", "青春氛围"],
		workIds: [240038, 260680, 328609, 513345],
	},
	{
		name: "新锐动画",
		originalName: "SHIN-EI ANIMATION",
		logo: "https://upload.wikimedia.org/wikipedia/commons/9/9f/Shin-Ei_Animation_logo.png",
		accent: "#de9c55",
		impression: "几十年如一日地相信，日常本身就是最有趣的故事。",
		detail:
			"新锐动画的镜头里有一种很安心的亲切感。《蜡笔小新》的胡闹、《哆啦A梦》的冒险，是从小看到大的东西，长大以后再看，反而更能看懂那些温柔的部分。",
		traits: ["国民日常", "童年记忆", "温柔搞笑"],
		workIds: [219200, 271151, 347887, 347888],
	},
	{
		name: "白狐社",
		originalName: "WHITE FOX",
		logo: "https://whitefox.jp/favicon.svg",
		accent: "#8c94aa",
		impression: "让世界一次次崩塌，再把选择的重量与重新站起来的勇气交给角色。",
		detail:
			"《Re：从零开始的异世界生活》让我记住的并不是“重来”本身，而是每一次失败都会留下痕迹。白狐社把绝望、挣扎和重新作出选择的过程做得足够沉重，也足够有力量。",
		traits: ["异世界", "心理挣扎", "命运选择"],
		workIds: [296195, 278826, 316247, 425998, 510728, 261805, 225462, 547888],
	},
] as const;

const bangumiData = await getBangumiData();
const watchedCollections = bangumiData.collections.filter((item) => item.type === 2);
const syncDate = new Intl.DateTimeFormat("zh-CN", {
	timeZone: "Asia/Hong_Kong", dateStyle: "medium", timeStyle: "short",
}).format(new Date(bangumiData.fetchedAt));

const watchedById = new Map<number, BangumiCollection>();
for (const item of watchedCollections) {
	if (item.type === 2 && item.subject) watchedById.set(item.subject.id, item);
}

const studios = STUDIO_DEFINITIONS.map((studio) => {
	const works = studio.workIds
		.map((id) => watchedById.get(id))
		.filter((item): item is BangumiCollection & { subject: BangumiSubject } =>
			Boolean(item?.subject),
		);
	const ratings = works
		.map((item) => item.rate || 0)
		.filter((rate) => rate > 0);
	const averageRating = ratings.length
		? ratings.reduce((sum, rate) => sum + rate, 0) / ratings.length
		: 0;
	const highestRating = ratings.length ? Math.max(...ratings) : 0;
	return {
		...studio,
		works,
		averageRating,
		highestRating,
		// 平均分刻度：10 格里有几格是亮的
		averageTicks: Math.max(0, Math.min(10, Math.round(averageRating))),
	};
}).filter((studio) => studio.works.length > 0);

const displayedWorkCount = studios.reduce(
	(sum, studio) => sum + studio.works.length,
	0,
);

const allRatings = studios
	.flatMap((studio) => studio.works.map((item) => item.rate || 0))
	.filter((rate) => rate > 0);
const overallAverage = allRatings.length
	? allRatings.reduce((sum, rate) => sum + rate, 0) / allRatings.length
	: 0;

// 跑马灯：名单重复两遍，CSS 位移 -50% 即可无缝循环
const marqueeNames = studios.length
	? studios.map((studio) => studio.name)
	: STUDIO_DEFINITIONS.map((studio) => studio.name);
const marqueeItems = [...marqueeNames, ...marqueeNames];

const pad2 = (value: number) => String(value).padStart(2, "0");
const reelId = (index: number) => `reel-${pad2(index + 1)}`;

function getTitle(subject: BangumiSubject) {
	return subject.name_cn || subject.name || "未命名作品";
}

function getCover(subject: BangumiSubject) {
	const source = subject.images?.large || subject.images?.common;
	return source ? `https://images.weserv.nl/?url=${source}` : "";
}
---

<MainGridLayout title="动画会社" description="我喜欢的制作公司，以及它们创造的故事">
	<main class="studios-page">
	<script is:inline>
		// is:inline 是必须的：Astro 会把打包脚本提升到 <body> 末尾，落在 swup 的替换容器之外，
		// 从别的页面软跳转进来时永远不会执行（页面会一直停在 opacity:0）。
		// 写在 .studios-page 内部的 inline 脚本会随容器一起被替换，并被 swup 的 scripts 插件重新执行。
		(() => {
			const studiosWindow = window;
			const MOTION_QUERY = "(prefers-reduced-motion: reduce)";
			const prefersReducedMotion = () => window.matchMedia(MOTION_QUERY).matches;

			function countUp(element, target, decimals = 0) {
				const render = (value) => value.toFixed(decimals);
				if (prefersReducedMotion()) {
					element.textContent = render(target);
					return;
				}

				const duration = 950;
				const started = performance.now();
				element.textContent = render(0);

				const tick = (now) => {
					const progress = Math.min(1, (now - started) / duration);
					const eased = 1 - (1 - progress) ** 3;
					element.textContent = render(target * eased);
					if (progress < 1) requestAnimationFrame(tick);
					else element.textContent = render(target);
				};
				requestAnimationFrame(tick);
			}

			function initStudios() {
				const page = document.querySelector(".studios-page");
				if (!page || page.dataset.motionReady === "true") return;
				page.dataset.motionReady = "true";

				// 脚本每次软跳转都会重跑一遍：先收掉上一轮挂在 window 上的监听
				studiosWindow.__studiosAbort?.abort();
				const controller = new AbortController();
				studiosWindow.__studiosAbort = controller;
				const { signal } = controller;

				const reduced = prefersReducedMotion();
				const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
				const revealTargets = Array.from(page.querySelectorAll("[data-reveal]"));
				const countScopes = Array.from(page.querySelectorAll("[data-count-scope]"));

				// 外链公司 logo 拉不到时，改用字母印章 --------------------------
				page.querySelectorAll(".reel-stamp img").forEach((logo) => {
					const stamp = logo.closest(".reel-stamp");
					if (!stamp) return;
					const fallback = () => stamp.classList.add("logo-failed");
					if (logo.complete && logo.naturalWidth === 0) fallback();
					else logo.addEventListener("error", fallback, { once: true });
				});

				const runCounters = (scope) => {
					if (scope.dataset.counted === "true") return;
					scope.dataset.counted = "true";
					scope.querySelectorAll("[data-count-to]").forEach((node) => {
						countUp(node, Number(node.dataset.countTo || 0), Number(node.dataset.countDecimals || 0));
					});
				};

				// 入场：区块揭幕 + 数字滚动 --------------------------------------
				try {
					if (reduced || !("IntersectionObserver" in window)) {
						revealTargets.forEach((element) => element.classList.add("is-in"));
						countScopes.forEach(runCounters);
					} else {
						const observer = new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									if (!entry.isIntersecting) return;
									const element = entry.target;
									element.classList.add("is-in");
									if (element.dataset.countScope !== undefined) runCounters(element);
									observer.unobserve(element);
								});
							},
							{ rootMargin: "0px 0px -6% 0px", threshold: 0.12 },
						);
						revealTargets.forEach((element) => observer.observe(element));
						countScopes.forEach((element) => observer.observe(element));
					}
				} catch (error) {
					console.error(error);
					revealTargets.forEach((element) => element.classList.add("is-in"));
					countScopes.forEach(runCounters);
				}

				// 作品卡：随指针微微倾斜 ------------------------------------------
				if (!reduced && finePointer) {
					page.querySelectorAll("[data-tilt]").forEach((card) => {
						card.addEventListener(
							"pointermove",
							(event) => {
								const rect = card.getBoundingClientRect();
								if (!rect.width || !rect.height) return;
								const ratioX = (event.clientX - rect.left) / rect.width - 0.5;
								const ratioY = (event.clientY - rect.top) / rect.height - 0.5;
								card.style.setProperty("--tilt-y", `${(ratioX * 7).toFixed(2)}deg`);
								card.style.setProperty("--tilt-x", `${(-ratioY * 6).toFixed(2)}deg`);
							},
							{ signal },
						);
						const reset = () => {
							card.style.removeProperty("--tilt-x");
							card.style.removeProperty("--tilt-y");
						};
						card.addEventListener("pointerleave", reset, { signal });
						card.addEventListener("blur", reset, { signal });
					});
				}

				// 装饰层的视差 ----------------------------------------------------
				const parallaxLayers = Array.from(page.querySelectorAll("[data-parallax]"));
				if (!reduced && parallaxLayers.length) {
					let frame = 0;
					const update = () => {
						frame = 0;
						const rect = page.getBoundingClientRect();
						const progress = (rect.top + rect.height / 2 - window.innerHeight / 2) / Math.max(1, window.innerHeight);
						parallaxLayers.forEach((layer) => {
							const depth = Number(layer.dataset.parallax || 1);
							layer.style.transform = `translate3d(0, ${(-progress * depth * 24).toFixed(2)}px, 0)`;
						});
					};
					const request = () => {
						if (!frame) frame = requestAnimationFrame(update);
					};
					window.addEventListener("scroll", request, { passive: true, signal });
					window.addEventListener("resize", request, { signal });
					update();
				}

				// 右侧放映目录：滚动高亮 + 点击跳转 --------------------------------
				const rail = page.querySelector("[data-reel-rail]");
				const reels = Array.from(page.querySelectorAll("[data-reel]"));
				if (rail && reels.length) {
					const buttons = Array.from(rail.querySelectorAll("[data-reel-target]"));
					let frame = 0;

					const updateRail = () => {
						frame = 0;
						const probe = window.innerHeight * 0.42;
						let active = 0;
						reels.forEach((reel, index) => {
							if (reel.getBoundingClientRect().top <= probe) active = index;
						});
						buttons.forEach((button, index) => {
							button.setAttribute("aria-current", index === active ? "true" : "false");
							button.toggleAttribute("data-played", index < active);
						});

						const listTop = reels[0].getBoundingClientRect().top;
						const listBottom = reels[reels.length - 1].getBoundingClientRect().bottom;
						const inRange = listTop < window.innerHeight * 0.72 && listBottom > window.innerHeight * 0.28;
						rail.dataset.visible = inRange ? "true" : "false";
					};

					const requestRail = () => {
						if (!frame) frame = requestAnimationFrame(updateRail);
					};

					buttons.forEach((button) => {
						button.addEventListener(
							"click",
							() => {
								const target = document.getElementById(button.dataset.reelTarget || "");
								if (!target) return;
								target.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "start" });
							},
							{ signal },
						);
					});

					window.addEventListener("scroll", requestRail, { passive: true, signal });
					window.addEventListener("resize", requestRail, { signal });
					updateRail();
				}
			}

			// 软跳转离开本页时，把上一轮还挂在 window 上的监听清掉
			const refreshStudios = () => {
				if (document.querySelector(".studios-page")) initStudios();
				else studiosWindow.__studiosAbort?.abort();
			};

			// 这段脚本被放在 <main> 里（这样 swup 软跳转时它会随容器一起被替换并重新执行）。
			// 代价是首次加载时它跑在页面标记之前：那时后面的元素还没解析出来，所以等 DOM 就绪再初始化。
			// 软跳转进来时 DOM 已经换好了，readyState 是 complete，直接初始化。
			const bootStudios = () => {
				if (!document.querySelector(".studios-page")) return;
				initStudios();
			};
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", bootStudios, { once: true });
			} else {
				bootStudios();
			}

			const setupStudiosHooks = () => {
				if (studiosWindow.__studiosHookRegistered) return;
				studiosWindow.__studiosHookRegistered = true;
				window.swup.hooks.on("page:view", refreshStudios);
			};
			if (window.swup) setupStudiosHooks();
			else if (!studiosWindow.__studiosSwupEnableBound) {
				studiosWindow.__studiosSwupEnableBound = true;
				document.addEventListener("swup:enable", setupStudiosHooks, { once: true });
			}
		})();
	</script>
		<div class="studio-ambient" aria-hidden="true">
			<span class="ambient-orb ambient-orb-a"></span>
			<span class="ambient-orb ambient-orb-b"></span>
			<span class="ambient-ring" data-parallax="1.2"></span>
			<span class="ambient-float ambient-float-a">✦</span>
			<span class="ambient-float ambient-float-b">♡</span>
			<span class="ambient-float ambient-float-c">♪</span>
		</div>

		<section class="studios-hero" aria-labelledby="studios-title">
			<span class="hero-curtain hero-curtain-left" aria-hidden="true"></span>
			<span class="hero-curtain hero-curtain-right" aria-hidden="true"></span>
			<span class="hero-beam" aria-hidden="true"></span>
			<span class="hero-dust" aria-hidden="true">
				{Array.from({ length: 9 }).map((_, index) => <i style={`--dust-order: ${index};`}></i>)}
			</span>
			<span class="hero-reel" aria-hidden="true">
				<svg viewBox="0 0 100 100">
					<circle cx="50" cy="50" r="46"></circle>
					<circle cx="50" cy="50" r="7"></circle>
					<circle cx="50" cy="25" r="11.5"></circle>
					<circle cx="71.7" cy="37.5" r="11.5"></circle>
					<circle cx="71.7" cy="62.5" r="11.5"></circle>
					<circle cx="50" cy="75" r="11.5"></circle>
					<circle cx="28.3" cy="62.5" r="11.5"></circle>
					<circle cx="28.3" cy="37.5" r="11.5"></circle>
				</svg>
			</span>

			<div class="hero-copy">
				<p class="hero-kicker"><span>SCREENING PROGRAM</span> 我的动画收藏册</p>
				<h1 id="studios-title" class="hero-title">
					<span class="hero-title-cn"><i>动画会社</i></span>
					<span class="hero-title-en" aria-hidden="true">Animation Studios</span>
				</h1>
				<p class="hero-lead">有些会社的名字只在片头出现几秒，带来的故事却能喜欢好多年。于是我把它们和看过的动画一起，好好收藏在这里。</p>
			</div>

			<div class="hero-ticket" data-count-scope aria-label="页面收录统计">
				<div class="ticket-field">
					<strong data-count-to={studios.length}>{studios.length}</strong>
					<span>家制作会社</span>
				</div>
				<i class="ticket-split" aria-hidden="true"></i>
				<div class="ticket-field">
					<strong data-count-to={displayedWorkCount}>{displayedWorkCount}</strong>
					<span>部看过的作品</span>
				</div>
				<i class="ticket-split" aria-hidden="true"></i>
				<div class="ticket-field">
					<strong data-count-to={overallAverage} data-count-decimals="1">{overallAverage.toFixed(1)}</strong>
					<span>我的均分</span>
				</div>
				<span class="ticket-stub" aria-hidden="true">Admit One</span>
			</div>

			<div class="hero-marquee" aria-hidden="true">
				<div class="hero-marquee-track">
					{marqueeItems.map((name) => (
						<span>{name}<i>✦</i></span>
					))}
				</div>
			</div>
		</section>

		<div class="watched-note">
			<span aria-hidden="true">✓</span>
			<p><strong>只收录我看完的番剧</strong><small>作品只来自“番剧观测”的完结撒花列表，点击封面可查看条目或我的观后感。</small></p>
			<a href="/bangumi/">查看番剧观测 <b aria-hidden="true">→</b></a>
		</div>

		{bangumiData.stale && (
			<p class="studios-sync-notice" role="status">Bangumi 暂时连接不上，先展示上次同步的收藏。更新于 <time datetime={bangumiData.fetchedAt}>{syncDate}</time></p>
		)}
		{studios.length === 0 ? (
			<section class="studios-empty"><span aria-hidden="true">✦</span><div><strong>还没有可展示的作品</strong><p>看完相关作品后，下次同步就会出现在这里。</p></div></section>
		) : (
			<>
				{studios.length > 1 && (
					<aside class="reel-rail" data-reel-rail data-visible="false" aria-label="放映单目录">
						<span class="reel-rail-label" aria-hidden="true">Now Showing</span>
						<div class="reel-rail-track">
							{studios.map((studio, index) => (
								<button
									type="button"
									class="reel-rail-item"
									data-reel-target={reelId(index)}
									aria-current={index === 0 ? "true" : "false"}
								>
									<span class="reel-rail-name">{studio.name}</span>
									<b aria-hidden="true">{pad2(index + 1)}</b>
									<i aria-hidden="true"></i>
								</button>
							))}
						</div>
					</aside>
				)}

				<div class="studio-list">
					{studios.map((studio, studioIndex) => {
						const charm = STUDIO_CHARMS[studioIndex % STUDIO_CHARMS.length];
						const mono = (studio.name.match(/[A-Za-z0-9]+/g)?.join("") || studio.name).slice(0, 2).toUpperCase();
						return (
							<section
								class="studio-reel"
								id={reelId(studioIndex)}
								data-reel
								style={`--studio-accent: ${studio.accent};`}
								aria-label={`${studio.name} 放映单元`}
							>
								<span class="reel-spine" aria-hidden="true"></span>

								<header class="reel-head" data-reveal>
									<div class="reel-stamp">
										<span class="reel-stamp-ring" aria-hidden="true"></span>
										<span class="stamp-mono" aria-hidden="true">{mono}</span>
										<img src={studio.logo} alt={`${studio.name} 标志`} loading="eager" decoding="async" referrerpolicy="no-referrer" />
										<span class="reel-stamp-charm" aria-hidden="true" title={charm.text}><b>{charm.icon}</b></span>
									</div>

									<div class="reel-identity">
										<p class="reel-label"><span>Reel {pad2(studioIndex + 1)}</span> Animation Studio</p>
										<h2>{studio.name}</h2>
										<p class="reel-original">{studio.originalName}</p>
										<div class="reel-traits">
											{studio.traits.map((trait) => <small>{trait}</small>)}
										</div>
									</div>

									<blockquote class="reel-quote">{studio.impression}</blockquote>
								</header>

								<div class="reel-dossier">
									<div class="dossier-note" data-reveal>
										<span class="dossier-label">我为什么喜欢它</span>
										<p>{studio.detail}</p>
									</div>

									<div class="dossier-stats" data-count-scope data-reveal style="--reveal-order: 1;">
										<div class="dossier-stat">
											<strong data-count-to={studio.works.length}>{studio.works.length}</strong>
											<span>作品入选</span>
										</div>
										<div class="dossier-stat">
											<strong data-count-to={studio.averageRating} data-count-decimals="1">{studio.averageRating.toFixed(1)}</strong>
											<span>我的均分</span>
										</div>
										<div class="dossier-stat">
											<strong data-count-to={studio.highestRating}>{studio.highestRating}</strong>
											<span>最高评分</span>
										</div>
										<div class="dossier-meter" role="img" aria-label={`${studio.name} 平均分 ${studio.averageRating.toFixed(1)}，满分 10`}>
											<span class="meter-ticks" aria-hidden="true">
												{Array.from({ length: 10 }).map((_, tick) => (
													<i class:list={["meter-tick", { "is-on": tick < studio.averageTicks }]} style={`--tick: ${tick};`}></i>
												))}
											</span>
											<span class="meter-caption" aria-hidden="true"><b>{studio.averageRating.toFixed(1)}</b> / 10</span>
										</div>
									</div>
								</div>

								<div class="reel-works">
									<div class="works-heading" data-reveal>
										<span>我喜欢的作品 <i aria-hidden="true">♡</i></span>
										<small>My Picks · {pad2(studio.works.length)} Titles</small>
									</div>

									<div class="works-grid">
										{studio.works.map((item, workIndex) => {
											const subject = item.subject;
											const title = getTitle(subject);
											const articleLink = ARTICLE_LINKS[subject.id];
											const href = articleLink || `https://bgm.tv/subject/${subject.id}`;
											const cover = getCover(subject);
											return (
												<a
													class="work-card"
													href={href}
													target={articleLink ? undefined : "_blank"}
													rel={articleLink ? undefined : "noopener noreferrer"}
													data-reveal
													data-tilt
													style={`--reveal-order: ${workIndex % 5};`}
												>
													<span class="work-cover">
														{cover ? (
															<img src={cover} alt={title} loading="lazy" referrerpolicy="no-referrer" />
														) : <span class="cover-fallback">暂无封面</span>}
														{workIndex === 0 && <span class="work-badge">本命</span>}
														{articleLink && <span class="work-badge work-badge-article">观后感</span>}
														<span class="work-cue" aria-hidden="true">
															<b>{articleLink ? "读观后感" : "查看条目"}</b>
															<i>↗</i>
														</span>
													</span>
													<span class="work-info">
														<h3>{title}</h3>
														<span class="work-meta">
															{item.rate ? (
																<b class="work-rate">★ {item.rate}</b>
															) : (
																<b class="work-rate work-rate-none">已看过</b>
															)}
															<i class="work-index" aria-hidden="true">{pad2(workIndex + 1)}</i>
														</span>
													</span>
												</a>
											);
										})}

										<div class="work-fin" aria-hidden="true">
											<span class="fin-dots"><i></i><i></i><i></i></span>
											<b class="fin-word">FIN</b>
											<span class="fin-note">本场放映结束 · {studio.name}</span>
										</div>
									</div>
								</div>
							</section>
						);
					})}
				</div>

				<footer class="studios-foot">
					<span class="foot-rule" aria-hidden="true"></span>
					<p>放映结束，谢谢你陪我看到最后 <b aria-hidden="true">♡</b></p>
					<a href="/bangumi/">去看完整的番剧观测 <b aria-hidden="true">→</b></a>
					<span class="foot-rule" aria-hidden="true"></span>
				</footer>
			</>
		)}
	</main>
</MainGridLayout>


