---
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { profileConfig } from "../config";
import { Icon } from "astro-icon/components";

const qqLink = profileConfig.links.find((link) => link.name === "QQ")?.url || "#";
---

<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<div class="about-page">
		<section class="about-hero">
			<span class="about-tape" aria-hidden="true"></span>
			<span class="about-spark about-spark-one" aria-hidden="true">✦</span>
			<span class="about-spark about-spark-two" aria-hidden="true">♡</span>
			<div class="about-avatar-wrap">
				<div class="about-avatar">
					<ImageWrapper src={profileConfig.avatar || ""} alt="Yaron 的头像" class="h-full w-full object-cover" />
				</div>
				<span>今日也在认真生活中</span>
			</div>
			<div class="about-hero-copy">
				<p class="about-eyebrow">ABOUT YARON <b>₍ᐢ.ˬ.ᐢ₎</b></p>
				<h1>你好呀，我是 <em>Yaron</em></h1>
				<p class="about-lead">都看到这里啦，那就不许再装作不认识我咯！<br />这里有生活、热爱，还有一点点可爱 ₍ᐢ.ˬ.ᐢ₎♡</p>
				<div class="about-badges" aria-label="个人信息">
					<span>📍 来自湖南</span><span>🏫 湖南工商大学</span><span>💻 计算机科学与技术</span>
				</div>
			</div>
		</section>

		<section class="about-diary">
			<header class="about-section-title">
				<div><span>MY FAVORITES</span><h2>我的兴趣小手账</h2></div>
				<p>喜欢的事情，要认真记下来呀 (˶ᵔ ᵕ ᵔ˶)</p>
			</header>
			<div class="interest-list">
				<article class="interest-row football">
					<div class="interest-icon" aria-hidden="true"><Icon name="fa6-solid:futbol" /></div>
					<div><span>FOOTBALL</span><h3>足球 · 永不放弃</h3><p>最喜欢 C 罗永不放弃的精神，也永远为皇家马德里的纯白而心动。</p></div>
					<small>Hala Madrid!</small>
				</article>
				<article class="interest-row games">
					<div class="interest-icon" aria-hidden="true"><Icon name="fa6-solid:gamepad" /></div>
					<div><span>GAME TIME</span><h3>游戏 · 快乐开黑</h3><p>LOLM、三角洲行动、CS2，也喜欢星露谷物语、我的世界和恐怖游戏。</p></div>
					<small>✧(≖◡≖✿)</small>
				</article>
				<article class="interest-row anime">
					<div class="interest-icon" aria-hidden="true"><Icon name="fa6-solid:heart" /></div>
					<div><span>ANIME DAYS</span><h3>番剧 · 纯爱万岁</h3><p>最喜欢纯爱番——请让纯爱统治整个世界好叭！</p></div>
					<a href="/bangumi/">去看追番记录 <b>›</b></a>
				</article>
				<article class="interest-row music">
					<div class="interest-icon" aria-hidden="true"><Icon name="fa6-solid:music" /></div>
					<div><span>MY PLAYLIST</span><h3>音乐 · 单曲循环</h3><p>喜欢周杰伦、邓紫棋、许嵩、陶喆，还有许多会反复播放的旋律。</p></div>
					<small>♪(´▽｀)</small>
				</article>
			</div>
			<span class="diary-doodle" aria-hidden="true">⌁ 记录完毕！</span>
		</section>

		<div class="about-notes">
			<section class="about-note dream-note">
				<span class="note-pin" aria-hidden="true">♥</span><p>DREAM WISHLIST</p><h2>想把生活过得闪闪发光 ✦</h2>
				<div>最大的梦想是赚很多很多的钱 💸<br />还有……遇见一位可爱的女朋友 /(ㄒoㄒ)/~~</div>
			</section>
			<section class="about-note hello-note">
				<span class="note-pin" aria-hidden="true">✦</span><p>SAY HELLO</p><h2>欢迎来找我玩呀！</h2>
				<div>想聊天或交流问题，都可以加我的 QQ。<br />尊重彼此，我们就能愉快地成为朋友 (｡•̀ᴗ-)✧</div>
				<a href={qqLink} target="_blank" rel="noopener noreferrer">去加 QQ 好友 <span>→</span></a>
			</section>
		</div>

		<details class="english-drawer">
			<summary><span>🌷</span><div><b>English profile</b><small>英文自我介绍，点一下打开</small></div><i aria-hidden="true">⌄</i></summary>
			<div class="english-copy-wrap">
			<div class="english-copy-clip">
			<div class="english-copy">
				<h2>Hi, I'm Yaron!</h2>
				<p>Since you've opened this little drawer, I guess you want to know me a little better, right? Hehe (●ˇ∀ˇ●)</p>
				<p>Welcome to my little blog! I'm Yaron, from Hunan, and I'm currently a student at Hunan University of Technology and Business, majoring in Computer Science and Technology. ٩(๑^o^๑)۶</p>
				<p>My hobbies are football, gaming, watching anime, and listening to music.</p>
				<ul>
					<li><b>Football:</b> My favorite player is Cristiano Ronaldo. I admire his never-give-up spirit and the way he always keeps a heart set on victory. My favorite club is Real Madrid — “Hala Madrid! In a world full of colors, I choose pure white!”</li>
					<li><b>Games:</b> For competitive multiplayer games, I enjoy LOLM, Delta Force, and Counter-Strike 2. I also love Stardew Valley, Minecraft, and the occasional horror game ✧(≖◡≖✿)</li>
					<li><b>Anime:</b> I'm a big fan of pure romance — let pure love rule the whole world, okay?! You can also visit my <a href="/bangumi/">Anime Tracker</a> to see what I've been watching.</li>
					<li><b>Music:</b> I enjoy Jay Chou, G.E.M., Vae (Xu Song), David Tao, and many other artists. There are always a few songs quietly playing on repeat.</li>
				</ul>
				<p>My biggest dream is to <b>make lots and lots of money</b> 💸~ hehe. And... I also really hope to meet a cute girlfriend someday /(ㄒoㄒ)/~~</p>
				<p>I still have a fair amount of free time these days. If you'd like to chat or ask me something, feel free to <a href={qqLink} target="_blank" rel="noopener noreferrer">add me on QQ</a>. I enjoy meeting all kinds of interesting people—as long as we always respect one another! (｡•̀ᴗ-)✧</p>
			</div>
			</div>
			</div>
		</details>
	</div>
</MainGridLayout>

<script>
	const setupEnglishDrawer = () => {
		for (const drawer of document.querySelectorAll<HTMLDetailsElement>(".english-drawer")) {
			if (drawer.dataset.animationReady === "true") continue;
			drawer.dataset.animationReady = "true";
			const summary = drawer.querySelector<HTMLElement>("summary");
			const wrap = drawer.querySelector<HTMLElement>(".english-copy-wrap");
			if (!summary || !wrap) continue;

			summary.addEventListener("click", (event) => {
				if (!drawer.open || drawer.classList.contains("is-closing")) return;
				event.preventDefault();
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					drawer.open = false;
					return;
				}

				drawer.classList.add("is-closing");
				let finished = false;
				const finish = () => {
					if (finished) return;
					finished = true;
					drawer.open = false;
					drawer.classList.remove("is-closing");
				};
				const onTransitionEnd = (transitionEvent: TransitionEvent) => {
					if (transitionEvent.target !== wrap || transitionEvent.propertyName !== "grid-template-rows") return;
					wrap.removeEventListener("transitionend", onTransitionEnd);
					finish();
				};
				wrap.addEventListener("transitionend", onTransitionEnd);
				window.setTimeout(finish, 460);
			});
		}
	};

	setupEnglishDrawer();
	document.addEventListener("astro:page-load", setupEnglishDrawer);
</script>

<style>
	.about-page { display: grid; width: 100%; gap: 1rem; color: var(--text-color); }
	.about-hero, .about-diary, .about-note, .english-drawer { border: 1px solid color-mix(in srgb, var(--primary) 15%, var(--glass-border)); background: linear-gradient(145deg, rgb(255 255 255 / 0.48), transparent 48%), color-mix(in srgb, var(--glass-card) 95%, var(--primary) 2%); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.72), 0 1.2rem 3rem rgb(113 75 67 / 0.07); backdrop-filter: blur(18px) saturate(118%); }
	.about-hero { position: relative; display: grid; grid-template-columns: 14rem minmax(0, 1fr); align-items: center; gap: 2.2rem; min-height: 19rem; padding: 2.2rem 3rem; overflow: hidden; border-radius: 2rem; }
	.about-hero::before { position: absolute; top: -7rem; right: -4rem; width: 24rem; height: 24rem; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--primary) 16%, transparent), transparent 68%); content: ""; }
	.about-tape { position: absolute; top: 0; left: 4rem; width: 5rem; height: 0.55rem; border-radius: 0 0 0.35rem 0.35rem; background: repeating-linear-gradient(120deg, rgb(255 255 255 / 0.25) 0 0.45rem, transparent 0.45rem 0.8rem), color-mix(in srgb, var(--primary) 42%, transparent); transform: rotate(-1.5deg); }
	.about-spark { position: absolute; z-index: 2; color: color-mix(in srgb, var(--primary) 55%, transparent); pointer-events: none; }
	.about-spark-one { top: 1.5rem; right: 2rem; font-size: 1.35rem; transform: rotate(10deg); }
	.about-spark-two { right: 3.2rem; bottom: 1.3rem; font-size: 2rem; transform: rotate(-8deg); }
	.about-avatar-wrap { position: relative; z-index: 2; display: grid; justify-items: center; gap: 0.65rem; }
	.about-avatar { width: 11rem; height: 11rem; padding: 0.42rem; overflow: hidden; border: 1px solid color-mix(in srgb, var(--primary) 20%, white); border-radius: 50%; background: rgb(255 255 255 / 0.58); box-shadow: 0 1rem 2.4rem rgb(88 58 52 / 0.17), inset 0 0 0 0.22rem rgb(255 255 255 / 0.48); transform: rotate(-2deg); }
	.about-avatar-wrap > span { padding: 0.35rem 0.65rem; border-radius: 999px; background: color-mix(in srgb, var(--primary) 9%, rgb(255 255 255 / 0.55)); color: color-mix(in srgb, var(--text-color) 46%, transparent); font-size: 0.68rem; }
	.about-hero-copy { position: relative; z-index: 2; }
	.about-eyebrow { margin: 0 0 0.55rem; color: var(--primary); font-size: 0.72rem; font-weight: 900; letter-spacing: 0.13em; }
	.about-eyebrow b { margin-left: 0.4rem; letter-spacing: 0; }
	.about-hero h1 { margin: 0; color: color-mix(in srgb, var(--text-color) 88%, #69493f); font-size: clamp(2rem, 4.5vw, 3.8rem); font-weight: 900; letter-spacing: -0.05em; line-height: 1.12; }
	.about-hero h1 em { color: var(--primary); font-style: normal; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--primary) 18%, transparent); text-decoration-thickness: 0.45em; text-underline-offset: -0.28em; }
	.about-lead { margin: 0.9rem 0 1.15rem; color: color-mix(in srgb, var(--text-color) 56%, transparent); font-size: 0.95rem; line-height: 1.75; }
	.about-badges { display: flex; flex-wrap: wrap; gap: 0.48rem; }
	.about-badges span { padding: 0.48rem 0.72rem; border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--glass-card) 72%, transparent); color: color-mix(in srgb, var(--text-color) 58%, transparent); font-size: 0.7rem; }
	.about-diary { position: relative; padding: 1.45rem 1.55rem 2rem; overflow: hidden; border-radius: 1.7rem; }
	.about-diary::before { position: absolute; inset: 0; background: repeating-linear-gradient(180deg, transparent 0 4rem, color-mix(in srgb, var(--primary) 5%, transparent) 4rem 4.06rem); content: ""; pointer-events: none; }
	.about-section-title { position: relative; z-index: 2; display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.about-section-title span { color: var(--primary); font-size: 0.6rem; font-weight: 900; letter-spacing: 0.12em; }
	.about-section-title h2 { margin: 0.15rem 0 0; color: color-mix(in srgb, var(--text-color) 85%, #68493f); font-size: 1.45rem; font-weight: 900; }
	.about-section-title p { margin: 0; color: color-mix(in srgb, var(--text-color) 36%, transparent); font-size: 0.68rem; }
	.interest-list { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
	.interest-row { position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: center; gap: 0.8rem; min-height: 8.1rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--primary) 11%, transparent); border-radius: 1.15rem; background: color-mix(in srgb, var(--glass-card) 72%, rgb(255 255 255 / 0.18)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.58); transition: transform 180ms ease, box-shadow 180ms ease; }
	.interest-row:hover { transform: translateY(-0.2rem); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.66), 0 0.8rem 1.8rem rgb(104 67 58 / 0.08); }
	.interest-icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 1rem; background: color-mix(in srgb, var(--primary) 9%, rgb(255 255 255 / 0.6)); font-size: 1.3rem; transform: rotate(-3deg); }
	.interest-icon :global(svg) { width: 1.15rem; height: 1.15rem; color: var(--primary); }
	.interest-row span { color: var(--primary); font-size: 0.55rem; font-weight: 900; letter-spacing: 0.11em; }
	.interest-row h3 { margin: 0.15rem 0 0.3rem; color: color-mix(in srgb, var(--text-color) 82%, #68483f); font-size: 0.95rem; font-weight: 900; }
	.interest-row p { margin: 0; color: color-mix(in srgb, var(--text-color) 48%, transparent); font-size: 0.7rem; line-height: 1.65; }
	.interest-row small, .interest-row > a { position: absolute; right: 0.85rem; bottom: 0.7rem; color: color-mix(in srgb, var(--primary) 58%, transparent); font-size: 0.58rem; font-weight: 750; }
	.interest-row > a { padding: 0.3rem 0.5rem; border-radius: 999px; background: color-mix(in srgb, var(--primary) 8%, transparent); transition: 160ms ease; }
	.interest-row > a:hover { color: var(--primary); transform: translateX(0.12rem); }
	.interest-row > a b { font-size: 0.85rem; }
	.football { background-image: linear-gradient(135deg, rgb(255 236 225 / 0.22), transparent); }
	.games { background-image: linear-gradient(135deg, rgb(223 237 255 / 0.18), transparent); }
	.anime { background-image: linear-gradient(135deg, rgb(255 221 235 / 0.22), transparent); }
	.music { background-image: linear-gradient(135deg, rgb(232 225 255 / 0.2), transparent); }
	.diary-doodle { position: absolute; right: 1.2rem; bottom: 0.55rem; color: color-mix(in srgb, var(--primary) 36%, transparent); font-size: 0.58rem; transform: rotate(-2deg); }
	.about-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.about-note { position: relative; min-height: 11rem; padding: 1.35rem 1.5rem; overflow: hidden; border-radius: 1.55rem; }
	.about-note::after { position: absolute; right: -2rem; bottom: -3rem; width: 10rem; height: 10rem; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--primary) 12%, transparent), transparent 68%); content: ""; }
	.note-pin { position: absolute; top: 0; left: 2.3rem; display: grid; place-items: center; width: 2rem; height: 1.35rem; border-radius: 0 0 0.5rem 0.5rem; background: color-mix(in srgb, var(--primary) 22%, transparent); color: white; font-size: 0.6rem; }
	.about-note > p { margin: 0.35rem 0 0.25rem; color: var(--primary); font-size: 0.58rem; font-weight: 900; letter-spacing: 0.11em; }
	.about-note h2 { margin: 0; color: color-mix(in srgb, var(--text-color) 84%, #68483f); font-size: 1.18rem; font-weight: 900; }
	.about-note > div { position: relative; z-index: 2; margin-top: 0.75rem; color: color-mix(in srgb, var(--text-color) 50%, transparent); font-size: 0.75rem; line-height: 1.75; }
	.about-note > a { position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.75rem; padding: 0.48rem 0.75rem; border: 1px solid color-mix(in srgb, var(--primary) 17%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--primary) 9%, var(--glass-card)); color: var(--primary); font-size: 0.68rem; font-weight: 850; transition: 160ms ease; }
	.about-note > a:hover { box-shadow: 0 0.5rem 1rem color-mix(in srgb, var(--primary) 12%, transparent); transform: translateY(-1px); }
	.hello-note { transform: rotate(0.3deg); }
	.english-drawer { overflow: hidden; border-radius: 1.35rem; }
	.english-drawer summary { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; cursor: pointer; list-style: none; }
	.english-drawer summary::-webkit-details-marker { display: none; }
	.english-drawer summary > span { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 0.85rem; background: color-mix(in srgb, var(--primary) 9%, var(--glass-card)); }
	.english-drawer summary div { display: grid; gap: 0.1rem; }
	.english-drawer summary b { color: color-mix(in srgb, var(--text-color) 76%, #68483f); font-size: 0.85rem; }
	.english-drawer summary small { color: color-mix(in srgb, var(--text-color) 38%, transparent); font-size: 0.62rem; }
	.english-drawer summary i { margin-left: auto; color: var(--primary); font-size: 1rem; font-style: normal; transition: transform 180ms ease; }
	.english-drawer[open]:not(.is-closing) summary i { transform: rotate(180deg); }
	.english-copy-wrap,
	.english-drawer:not([open]) > .english-copy-wrap {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition: grid-template-rows 360ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease;
	}
	.english-drawer[open]:not(.is-closing) > .english-copy-wrap { grid-template-rows: 1fr; opacity: 1; }
	.english-copy { margin: 0 1.25rem 1.25rem; padding: 1.15rem 1.3rem; border: 1px dashed color-mix(in srgb, var(--primary) 16%, transparent); border-radius: 1rem; background: color-mix(in srgb, var(--glass-card) 62%, transparent); }
	.english-copy-clip { min-height: 0; overflow: hidden; }
	.english-copy h2 { margin: 0 0 0.55rem; color: var(--primary); font-size: 1.1rem; }
	.english-copy p, .english-copy li { color: color-mix(in srgb, var(--text-color) 53%, transparent); font-size: 0.75rem; line-height: 1.7; }
	.english-copy ul { margin: 0.7rem 0; padding-left: 1.2rem; }
	.english-copy a { color: var(--primary); font-weight: 800; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--primary) 30%, transparent); text-underline-offset: 0.16rem; }
	:global(.dark) .about-hero, :global(.dark) .about-diary, :global(.dark) .about-note, :global(.dark) .english-drawer { border-color: color-mix(in srgb, var(--primary) 18%, rgb(255 255 255 / 0.08)); background: linear-gradient(145deg, rgb(255 255 255 / 0.035), transparent 48%), rgb(25 21 22 / 0.82); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 1.2rem 3rem rgb(0 0 0 / 0.2); }
	:global(.dark) .about-hero h1, :global(.dark) .about-section-title h2, :global(.dark) .interest-row h3, :global(.dark) .about-note h2, :global(.dark) .english-drawer summary b { color: rgb(247 239 235 / 0.9); }
	:global(.dark) .interest-row, :global(.dark) .english-copy { border-color: rgb(255 255 255 / 0.07); background: rgb(20 17 18 / 0.58); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04); }
	:global(.dark) .about-lead, :global(.dark) .interest-row p, :global(.dark) .about-note > div, :global(.dark) .english-copy p, :global(.dark) .english-copy li { color: rgb(247 239 235 / 0.55); }
	:global(.dark) .about-lead,
	:global(.dark) .about-avatar-wrap > span,
	:global(.dark) .about-badges span,
	:global(.dark) .about-section-title > p,
	:global(.dark) .interest-row p,
	:global(.dark) .interest-row small,
	:global(.dark) .interest-row > a,
	:global(.dark) .about-note > div,
	:global(.dark) .english-drawer summary small,
	:global(.dark) .english-copy p,
	:global(.dark) .english-copy li { color: rgb(247 239 235 / 0.68); }
	:global(.dark) .about-badges span,
	:global(.dark) .about-avatar-wrap > span { border-color: rgb(255 255 255 / 0.08); background: rgb(255 255 255 / 0.06); }
	:global(.dark) .interest-icon { border: 1px solid color-mix(in srgb, var(--primary) 24%, rgb(255 255 255 / 0.06)); background: color-mix(in srgb, var(--primary) 13%, rgb(255 255 255 / 0.035)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 0.5rem 1rem rgb(0 0 0 / 0.16); }
	:global(.dark) .interest-icon :global(svg) { color: color-mix(in srgb, var(--primary) 88%, white); }
	@media (max-width: 760px) {
		.about-hero { grid-template-columns: 1fr; gap: 1rem; min-height: 0; padding: 1.6rem 1.15rem 1.35rem; text-align: center; border-radius: 1.55rem; }
		.about-avatar { width: 8.5rem; height: 8.5rem; }
		.about-hero h1 { font-size: 2rem; }
		.about-lead { margin: 0.65rem 0 0.85rem; font-size: 0.8rem; }
		.about-badges { justify-content: center; gap: 0.35rem; }
		.about-badges span { padding: 0.4rem 0.58rem; font-size: 0.62rem; }
		.about-diary { padding: 1.1rem 0.85rem 2.2rem; border-radius: 1.4rem; }
		.about-section-title { display: block; margin-bottom: 0.75rem; }
		.about-section-title h2 { font-size: 1.2rem; }
		.about-section-title > p { margin-top: 0.3rem; }
		.interest-list { grid-template-columns: 1fr; gap: 0.55rem; }
		.interest-row { grid-template-columns: 2.55rem minmax(0, 1fr); min-height: 7.2rem; padding: 0.82rem; }
		.interest-icon { width: 2.55rem; height: 2.55rem; border-radius: 0.82rem; font-size: 1.1rem; }
		.interest-row h3 { font-size: 0.88rem; }
		.interest-row p { padding-right: 0.2rem; font-size: 0.66rem; }
		.interest-row > small,
		.interest-row > a {
			position: static;
			grid-column: 2;
			justify-self: start;
			margin-top: 0.15rem;
