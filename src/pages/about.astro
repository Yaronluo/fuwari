---
import AboutMotion from "@components/AboutMotion.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const qqLink =
	profileConfig.links.find((link) => link.name === "QQ")?.url || "#";
const bilibiliLink =
	profileConfig.links.find((link) => link.name === "Bilibili")?.url || "#";
const githubLink =
	profileConfig.links.find((link) => link.name === "GitHub")?.url || "#";
const socials = profileConfig.links;

interface InterestAside {
	kind: "note" | "link";
	text: string;
	href?: string;
	icon?: string;
}

interface Interest {
	id: string;
	icon: string;
	tone: string;
	kicker: string;
	title: string;
	text: string;
	tags: string[];
	aside: InterestAside;
}

const interests: Interest[] = [
	{
		id: "football",
		icon: "fa6-solid:futbol",
		tone: "#dd8b5c",
		kicker: "FOOTBALL",
		title: "足球 · 永不放弃",
		text: "最喜欢 C 罗永不放弃的精神，也永远为皇家马德里的纯白而心动。",
		tags: ["C 罗", "皇家马德里", "Hala Madrid"],
		aside: { kind: "note", text: "世间五彩，我执纯白 ✦" },
	},
	{
		id: "games",
		icon: "fa6-solid:gamepad",
		tone: "#6f93c9",
		kicker: "GAME TIME",
		title: "游戏 · 快乐开黑",
		text: "LOLM、三角洲行动、CS2 都打，也喜欢星露谷物语、我的世界和恐怖游戏。",
		tags: ["LOLM", "三角洲行动", "CS2", "星露谷物语", "我的世界"],
		aside: { kind: "note", text: "✧(≖◡≖✿)" },
	},
	{
		id: "anime",
		icon: "fa6-solid:heart",
		tone: "#dd7ba1",
		kicker: "ANIME DAYS",
		title: "番剧 · 纯爱万岁",
		text: "最喜欢纯爱番——请让纯爱统治整个世界好叭！",
		tags: ["纯爱番", "恋爱喜剧", "剧场版"],
		aside: {
			kind: "link",
			text: "去看追番记录",
			href: "/bangumi/",
			icon: "fa6-solid:tv",
		},
	},
	{
		id: "music",
		icon: "fa6-solid:music",
		tone: "#8f7cc6",
		kicker: "MY PLAYLIST",
		title: "音乐 · 单曲循环",
		text: "喜欢周杰伦、邓紫棋、许嵩、陶喆，还有许多会反复播放的旋律。",
		tags: ["周杰伦", "邓紫棋", "许嵩", "陶喆"],
		aside: {
			kind: "link",
			text: "去 QQ 音乐看看",
			href: "https://c6.y.qq.com/base/fcgi-bin/u?__=YkxsLjK3HadO",
			icon: "fa6-solid:compact-disc",
		},
	},
];

// Glyphs that fly out of the polaroid when the avatar is clicked.
const burstGlyphs = ["⚽", "🎮", "♡", "♪", "✦", "🎬", "🎧"];
const avatarMessages = [
	"うんたん♪",
	"今天也要开心 ✿",
	"要不要一起踢球？⚽",
	"开黑吗，缺你一个！🎮",
	"纯爱统治世界！♡",
	"正在单曲循环 ♫",
];
---

<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<script is:inline>
		// Motion-capable browsers get the entrance choreography and the
		// scroll reveals; a hard reload keeps the page still instead of
		// replaying the entrance. `about-motion` is added here (before the
		// markup paints) so revealed blocks never flash in place first, and
		// `about-reveal-pending` keeps them hidden until the client script
		// arms the observer — the timer below drops it again if that script
		// never shows up, so nothing ever depends on JS to become visible.
		(() => {
			const root = document.documentElement;
			const navEntry = performance.getEntriesByType("navigation")[0];
			const initialPaint = document.readyState === "loading";
			root.classList.add("about-motion");
			if (initialPaint && navEntry && navEntry.type === "reload") {
				root.classList.add("about-no-enter");
			} else {
				root.classList.remove("about-no-enter");
			}
			if (
				window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
				!("IntersectionObserver" in window)
			) {
				return;
			}
			root.classList.add("about-reveal-pending");
			// Generous on purpose: the observer only takes over once the client
			// script has run, and a cold dev build can take a moment to serve it.
			window.setTimeout(() => {
				const page = document.querySelector(".about-page");
				if (!page || page.dataset.revealArmed !== "true") {
					root.classList.remove("about-reveal-pending");
				}
			}, 4000);
		})();
	</script>

	<div class="about-page">
		<!-- 01 · Masthead ------------------------------------------------ -->
		<header class="about-masthead" id="about-masthead">
			<div class="about-doodles" aria-hidden="true">
				<span class="about-doodle about-doodle--note" style="--x: 3%; --y: 12%; --dur: 10.5s; --delay: -1.2s; --size: 1.5rem;">♫</span>
				<span class="about-doodle about-doodle--spark" style="--x: 46%; --y: 6%; --dur: 8.4s; --delay: -3s; --size: 1.05rem;">✦</span>
				<span class="about-doodle about-doodle--heart" style="--x: 88%; --y: 16%; --dur: 9.6s; --delay: -0.6s; --size: 1.35rem;">♡</span>
				<span class="about-doodle about-doodle--star" style="--x: 94%; --y: 74%; --dur: 11.4s; --delay: -2.2s; --size: 1.15rem;">✧</span>
				<span class="about-doodle about-doodle--bloom" style="--x: 12%; --y: 82%; --dur: 12.6s; --delay: -4.4s; --size: 1.25rem;">❀</span>
				<span class="about-doodle about-doodle--tune" style="--x: 63%; --y: 88%; --dur: 9.2s; --delay: -1.8s; --size: 1rem;">♪</span>
				<span class="about-doodle about-doodle--ribbon" style="--x: 34%; --y: 92%; --dur: 13.2s; --delay: -5.1s; --size: 1.1rem;">✿</span>
				<span class="about-doodle about-doodle--chime" style="--x: 74%; --y: 32%; --dur: 10.8s; --delay: -3.6s; --size: 0.95rem;">♬</span>
			</div>

			<div class="about-polaroid" data-parallax="14" data-avatar-messages={JSON.stringify(avatarMessages)}>
				<div class="about-photo about-polaroid-in">
					<div class="about-photo-frame">
						<ImageWrapper
							src={profileConfig.avatar || ""}
							alt="Yaron 的头像"
							class="h-full w-full"
							loading="eager"
						/>
						<span class="about-photo-gloss" aria-hidden="true"></span>
					</div>
					<span class="about-photo-mark" aria-hidden="true">♡ Yaron</span>
					<button
						type="button"
						class="about-photo-hit"
						id="about-avatar-button"
						aria-label="点一下头像，会有一点小惊喜"
					></button>
					<span class="about-tape" aria-hidden="true"></span>
					<span class="about-photo-spark about-photo-spark--one" aria-hidden="true">✦</span>
					<span class="about-photo-spark about-photo-spark--two" aria-hidden="true">✧</span>
					<span class="about-burst" aria-hidden="true">
						{burstGlyphs.map((glyph) => <i class="about-burst-item">{glyph}</i>)}
					</span>
				</div>
				<span class="about-photo-caption">
					<span aria-hidden="true">✎</span> 今日也在认真生活中
				</span>
				<span class="about-bubble" aria-hidden="true">うんたん♪</span>
			</div>

			<div class="about-intro" data-parallax="5">
				<p class="about-eyebrow about-rise" style="--enter-delay: 60ms;">
					ABOUT YARON <b>₍ᐢ.ˬ.ᐢ₎</b> <i>档案 · 01</i>
				</p>
				<h1 class="about-name about-rise" style="--enter-delay: 150ms;">
					你好呀，我是 <em><span>Yaron</span></em>
				</h1>
				<p class="about-lead about-rise" style="--enter-delay: 250ms;">
					都看到这里啦，那就不许再装作不认识我咯！<br />
					这里有生活、热爱，还有一点点可爱 ₍ᐢ.ˬ.ᐢ₎♡
				</p>
				<ul class="about-meta about-rise" style="--enter-delay: 340ms;">
					<li><Icon name="fa6-solid:location-dot" /><span>来自湖南</span></li>
					<li><Icon name="fa6-solid:graduation-cap" /><span>湖南工商大学</span></li>
					<li><Icon name="fa6-solid:laptop-code" /><span>计算机科学与技术</span></li>
				</ul>
				<ul class="about-socials about-rise" style="--enter-delay: 430ms;">
					{socials.map((link) => (
						<li>
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={link.name}
							>
								<span class="about-socials-icon" aria-hidden="true">
									<Icon name={link.icon} />
								</span>
								<span class="about-socials-name">{link.name}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</header>

		<div class="about-rule" aria-hidden="true"><span>✦</span></div>

		<!-- 02 · Favourites ---------------------------------------------- -->
		<section class="about-favorites" aria-labelledby="about-favorites-title">
			<header class="about-heading" data-reveal>
				<span class="about-heading-index about-pop" aria-hidden="true" style="--enter-delay: 120ms;">01</span>
				<div class="about-heading-copy">
					<p>MY FAVORITES</p>
					<h2 id="about-favorites-title">我的兴趣小手账</h2>
				</div>
				<p class="about-heading-note">喜欢的事情，要认真记下来呀 (˶ᵔ ᵕ ᵔ˶)</p>
			</header>

			<ol class="about-threads">
				{interests.map((item, index) => (
					<li
						class="about-thread"
						data-reveal
						data-tilt
						style={`--tone: ${item.tone}; --reveal-delay: ${index * 90}ms;`}
					>
						<span class="about-thread-node" aria-hidden="true">
							<Icon name={item.icon} />
						</span>
						<div class="about-thread-body">
							<p class="about-thread-kicker">
								<b>{String(index + 1).padStart(2, "0")}</b>
								{item.kicker}
							</p>
							<h3>{item.title}</h3>
							<p class="about-thread-text">{item.text}</p>
							<ul class="about-chips">
								{item.tags.map((tag) => <li>{tag}</li>)}
							</ul>
						</div>
						<div class="about-thread-aside">
							{item.aside.kind === "link" ? (
								<a href={item.aside.href} rel="noopener noreferrer">
									<Icon name={item.aside.icon || "fa6-solid:arrow-up-right-from-square"} />
									<span>{item.aside.text}</span>
								</a>
							) : (
								<span class="about-thread-note">{item.aside.text}</span>
							)}
						</div>
					</li>
				))}
			</ol>

			<span class="about-signoff" data-reveal aria-hidden="true">❀ 记录完毕！</span>
		</section>

		<div class="about-rule" aria-hidden="true"><span>✦</span></div>

		<!-- 03 · Wishes & hello ------------------------------------------ -->
		<section class="about-outro" aria-label="梦想和联系方式">
			<div class="about-outro-col about-outro-col--dream" data-reveal>
				<p class="about-outro-kicker">
					<Icon name="fa6-solid:wand-magic-sparkles" />
					<span>DREAM WISHLIST</span>
				</p>
				<h2>想把生活过得闪闪发光 <b>✦</b></h2>
				<p class="about-outro-text">
					最大的梦想是<em>赚很多很多的钱</em> 💸，还有……
				</p>
				<ul class="about-wish">
					<li>
						<span class="about-wish-box" aria-hidden="true"></span>
						<span>把想买的东西都买下来 💸</span>
					</li>
					<li>
						<span class="about-wish-box" aria-hidden="true"></span>
						<span>遇见一位可爱的女朋友 /(ㄒoㄒ)/~~</span>
					</li>
				</ul>
			</div>

			<span class="about-outro-rule" aria-hidden="true"></span>

			<div class="about-outro-col about-outro-col--hello" data-reveal style="--reveal-delay: 130ms;">
				<p class="about-outro-kicker">
					<Icon name="fa6-solid:comment-dots" />
					<span>SAY HELLO</span>
				</p>
				<h2>欢迎来找我玩呀！</h2>
				<p class="about-outro-text">
					想聊天或交流问题，都可以加我的 QQ。<br />
					尊重彼此，我们就能愉快地成为朋友 (｡•̀ᴗ-)✧
				</p>
				<a class="about-cta" href={qqLink} target="_blank" rel="noopener noreferrer">
					<span class="about-cta-label">去加 QQ 好友</span>
					<i aria-hidden="true">→</i>
					<span class="about-cta-shine" aria-hidden="true"></span>
				</a>
				<p class="about-outro-else">
					也会在这里出没：
					<a href={bilibiliLink} target="_blank" rel="noopener noreferrer">
						<Icon name="fa6-brands:bilibili" /> Bilibili
					</a>
					·
					<a href={githubLink} target="_blank" rel="noopener noreferrer">
						<Icon name="fa6-brands:github" /> GitHub
					</a>
				</p>
			</div>
		</section>

		<!-- 04 · English profile ----------------------------------------- -->
		<details class="english-drawer" data-reveal>
			<summary>
				<span class="english-flower" aria-hidden="true">🌷</span>
				<span class="english-title">
					<b>English profile</b>
					<small>英文自我介绍，点一下打开</small>
				</span>
				<i class="english-chevron" aria-hidden="true">
					<Icon name="fa6-solid:chevron-down" />
				</i>
			</summary>
			<div class="english-copy-wrap">
				<div class="english-copy-clip">
					<div class="english-copy">
						<span class="english-watermark" aria-hidden="true">EN</span>
						<h2>Hi, I'm Yaron!</h2>
						<p>
							Since you've opened this little drawer, I guess you want to know me a
							little better, right? Hehe (●ˇ∀ˇ●)
						</p>
						<p>
							Welcome to my little blog! I'm Yaron, from Hunan, and I'm currently a
							student at Hunan University of Technology and Business, majoring in
							Computer Science and Technology. ٩(๑^o^๑)۶
						</p>
						<p>My hobbies are football, gaming, watching anime, and listening to music.</p>
						<ul>
							<li>
								<b>Football:</b> My favorite player is Cristiano Ronaldo. I admire his
								never-give-up spirit and the way he always keeps a heart set on victory.
								My favorite club is Real Madrid — “Hala Madrid! In a world full of
								colors, I choose pure white!”
							</li>
							<li>
								<b>Games:</b> For competitive multiplayer games, I enjoy LOLM, Delta
								Force, and Counter-Strike 2. I also love Stardew Valley, Minecraft, and
								the occasional horror game ✧(≖◡≖✿)
							</li>
							<li>
								<b>Anime:</b> I'm a big fan of pure romance — let pure love rule the
								whole world, okay?! You can also visit my{" "}
								<a href="/bangumi/">Anime Tracker</a> to see what I've been watching.
							</li>
							<li>
								<b>Music:</b> I enjoy Jay Chou, G.E.M., Vae (Xu Song), David Tao, and
								many other artists. There are always a few songs quietly playing on
								repeat.
							</li>
						</ul>
						<p>
							My biggest dream is to <b>make lots and lots of money</b> 💸~ hehe. And...
							I also really hope to meet a cute girlfriend someday /(ㄒoㄒ)/~~
						</p>
						<p>
							I still have a fair amount of free time these days. If you'd like to chat
							or ask me something, feel free to{" "}
							<a href={qqLink} target="_blank" rel="noopener noreferrer">
								add me on QQ
							</a>
							. I enjoy meeting all kinds of interesting people—as long as we always
							respect one another! (｡•̀ᴗ-)✧
						</p>
					</div>
				</div>
			</div>
		</details>
	</div>
	<AboutMotion />
</MainGridLayout>


<style>
	/* ------------------------------------------------------------------
	   Shell
	   ------------------------------------------------------------------ */
	.about-page {
		position: relative;
		display: grid;
		gap: clamp(1.8rem, 3.4vw, 3rem);
		width: 100%;
		color: var(--text-body);
	}

	/* Haired dashed rules that separate the chapters, with the dashes
	   slowly marching so the page keeps breathing while it is read. */
	.about-rule {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		color: color-mix(in srgb, var(--primary) 44%, transparent);
	}
	.about-rule::before,
	.about-rule::after {
		flex: 1;
		height: 1px;
		background-image: linear-gradient(
			90deg,
			currentcolor 0 0.44rem,
			transparent 0.44rem 1rem
		);
		background-size: 1rem 1px;
		content: "";
		animation: about-march-x 1.8s linear infinite;
	}
	.about-rule::before {
		mask-image: linear-gradient(90deg, transparent, #000 42%);
	}
	.about-rule::after {
		mask-image: linear-gradient(270deg, transparent, #000 42%);
	}
	.about-rule span {
		font-size: 0.8rem;
		animation: about-twinkle 3.6s ease-in-out infinite;
	}

	/* ------------------------------------------------------------------
	   Masthead
	   ------------------------------------------------------------------ */
	.about-masthead {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 13.5rem minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 3.6vw, 3.4rem);
		padding: clamp(1.4rem, 3vw, 2.4rem) clamp(0.6rem, 2vw, 1.8rem)
			clamp(1.6rem, 3vw, 2.6rem);
	}
	.about-masthead::before {
		position: absolute;
		inset: -6% -10% 0 -14%;
		z-index: -2;
		background: radial-gradient(
			58% 66% at 16% 34%,
			color-mix(in srgb, var(--primary) 15%, transparent),
			transparent 66%
		);
		content: "";
		animation: about-glow-breathe 11s ease-in-out infinite;
	}
	.about-masthead::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: radial-gradient(
			color-mix(in srgb, var(--primary) 26%, transparent) 1px,
			transparent 1px
		);
		background-size: 1.15rem 1.15rem;
		content: "";
		mask-image: radial-gradient(120% 96% at 74% 26%, #000, transparent 72%);
		opacity: 0.5;
	}
	/* Drifts up and dissolves while it leaves the viewport. Driven by the
	   client script instead of a view() timeline: `main` is a scroll
	   container here, which pins every view() progress at its end state. */
	@media (prefers-reduced-motion: no-preference) {
		:global(html.about-motion) .about-masthead {
			opacity: calc(1 - var(--masthead-exit, 0) * 0.62);
			translate: 0 calc(var(--masthead-exit, 0) * -1.6rem);
		}
	}

	.about-doodles {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}
	.about-doodle {
		position: absolute;
		left: var(--x);
		top: var(--y);
		color: color-mix(in srgb, var(--primary) 40%, transparent);
		font-size: var(--size, 1.15rem);
		animation: about-drift var(--dur, 9s) ease-in-out var(--delay, 0s) infinite;
	}
	.about-doodle--spark,
	.about-doodle--star {
		color: color-mix(in srgb, var(--mio-purple) 42%, var(--primary));
	}
	.about-doodle--heart {
		animation:
			about-drift var(--dur, 9s) ease-in-out var(--delay, 0s) infinite,
			about-heart-beat 2.9s ease-in-out infinite;
	}
	.about-doodle--note,
	.about-doodle--tune,
	.about-doodle--chime {
		color: color-mix(in srgb, var(--azusa-blue) 46%, var(--primary));
	}

	/* Polaroid ---------------------------------------------------------- */
	.about-polaroid {
		position: relative;
		z-index: 3;
		display: grid;
		justify-items: center;
		gap: 0.8rem;
	}
	.about-photo {
		position: relative;
		width: 12.4rem;
		padding: 0.5rem 0.5rem 1.9rem;
		border-radius: 1.05rem;
		background: linear-gradient(158deg, #fffdf9, #f7e9e0);
		box-shadow:
			0 1.5rem 2.8rem rgb(88 58 52 / 0.2),
			0 0.2rem 0.6rem rgb(88 58 52 / 0.08),
			inset 0 0 0 1px rgb(255 255 255 / 0.72);
		rotate: -2.6deg;
		transition:
			rotate 420ms cubic-bezier(0.2, 0.9, 0.28, 1.24),
			translate 420ms cubic-bezier(0.2, 0.9, 0.28, 1.24),
			box-shadow 320ms ease;
		animation: about-bob 7.8s ease-in-out infinite;
	}
	.about-photo:hover,
	.about-polaroid:focus-within .about-photo {
		translate: 0 -0.4rem;
		rotate: 0deg;
		box-shadow:
			0 2rem 3.4rem rgb(88 58 52 / 0.24),
			inset 0 0 0 1px rgb(255 255 255 / 0.8);
	}
	.about-photo-frame {
		position: relative;
		height: 11.4rem;
		overflow: hidden;
		border-radius: 0.62rem;
		background: color-mix(in srgb, var(--cream-soft) 60%, #fff);
	}
	.about-photo-gloss {
		position: absolute;
		inset: -30% -60%;
		background: linear-gradient(
			100deg,
			transparent 38%,
			rgb(255 255 255 / 0.55) 50%,
			transparent 62%
		);
		translate: -130% 0;
		animation: about-gloss 6.8s ease-in-out 1.4s infinite;
		pointer-events: none;
	}
	.about-photo-hit {
		position: absolute;
		inset: 0;
		border: 0;
		border-radius: 1.05rem;
		background: transparent;
		cursor: pointer;
	}
	.about-photo-hit:focus-visible {
		outline: 2px dashed color-mix(in srgb, var(--primary) 70%, transparent);
		outline-offset: 0.22rem;
	}
	.about-photo-mark {
		position: absolute;
		right: 0;
		bottom: 0.42rem;
		left: 0;
		color: color-mix(in srgb, var(--primary) 62%, var(--tea));
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		text-align: center;
	}
	.about-tape {
		position: absolute;
		top: -0.7rem;
		left: 50%;
		width: 4.4rem;
		height: 1.35rem;
		border-radius: 0.18rem;
		background: repeating-linear-gradient(
				118deg,
				rgb(255 255 255 / 0.34) 0 0.42rem,
				transparent 0.42rem 0.78rem
			),
			color-mix(in srgb, var(--primary) 34%, rgb(255 255 255 / 0.36));
		box-shadow: 0 0.3rem 0.7rem rgb(88 58 52 / 0.12);
		translate: -50% 0;
		rotate: -3deg;
		animation: about-tape-sway 5.6s ease-in-out infinite;
	}
	.about-photo-spark {
		position: absolute;
		color: color-mix(in srgb, var(--primary) 62%, transparent);
		font-size: 0.95rem;
		pointer-events: none;
	}
	.about-photo-spark--one {
		top: 0.35rem;
		right: -1.15rem;
		animation: about-twinkle 3.2s ease-in-out infinite;
	}
	.about-photo-spark--two {
		bottom: 1.9rem;
		left: -1.25rem;
		font-size: 0.8rem;
		animation: about-twinkle 4.1s ease-in-out 0.8s infinite;
	}
	.about-photo-caption {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.3rem 0.7rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 26%, transparent);
		border-radius: 999px;
		color: color-mix(in srgb, var(--text-muted) 96%, transparent);
		font-size: 0.66rem;
	}
	.about-bubble {
		position: absolute;
		top: 0.62rem;
		right: 0.66rem;
		max-width: calc(100% - 1.32rem);
		padding: 0.34rem 0.66rem;
		border-radius: 0.9rem 0.9rem 0.9rem 0.24rem;
		background: color-mix(in srgb, var(--glass-panel) 94%, transparent);
		box-shadow: 0 0.5rem 1.2rem rgb(88 58 52 / 0.16);
		color: color-mix(in srgb, var(--primary) 80%, var(--tea));
		font-size: 0.62rem;
		font-weight: 750;
		line-height: 1.35;
		opacity: 0;
		pointer-events: none;
		rotate: -1.6deg;
		translate: 0.4rem 0.3rem;
		transition:
			opacity 260ms ease,
			translate 320ms cubic-bezier(0.2, 0.9, 0.28, 1.3);
	}
	/* Little tail, pointing back down towards the avatar's face. */
	.about-bubble::after {
		position: absolute;
		bottom: -0.2rem;
		left: 0.66rem;
		width: 0.48rem;
		height: 0.48rem;
		border-radius: 0 0 0.12rem 0;
		background: inherit;
		content: "";
		rotate: 45deg;
	}
	.about-bubble.is-visible {
		opacity: 1;
		translate: 0 0;
	}
	.about-burst {
		position: absolute;
		top: 50%;
		left: 50%;
		pointer-events: none;
	}
	.about-burst-item {
		position: absolute;
		font-size: 0.95rem;
		font-style: normal;
		opacity: 0;
	}
	.about-burst.is-active .about-burst-item {
		animation: about-burst-fly var(--bd, 1000ms) cubic-bezier(0.22, 0.68, 0.34, 1)
			forwards;
	}

	/* Intro copy -------------------------------------------------------- */
	.about-intro {
		position: relative;
		z-index: 2;
		min-width: 0;
	}
	.about-eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.7rem;
		color: var(--primary);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.16em;
	}
	.about-eyebrow b {
		letter-spacing: 0;
	}
	.about-eyebrow i {
		padding: 0.2rem 0.52rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 34%, transparent);
		border-radius: 999px;
		color: color-mix(in srgb, var(--primary) 74%, var(--tea));
		font-size: 0.55rem;
		font-style: normal;
		font-weight: 850;
		letter-spacing: 0.08em;
	}
	.about-name {
		margin: 0;
		color: color-mix(in srgb, var(--text-strong) 94%, #69493f);
		font-size: clamp(2rem, 4.6vw, 3.7rem);
		font-weight: 900;
		letter-spacing: -0.05em;
		line-height: 1.12;
		text-wrap: balance;
	}
	.about-name em {
		position: relative;
		display: inline-block;
		font-style: normal;
	}
	.about-name em::after {
		position: absolute;
		right: -0.1em;
		bottom: 0.06em;
		left: -0.06em;
		z-index: -1;
		height: 0.4em;
		border-radius: 0.24rem;
		background: color-mix(in srgb, var(--primary) 17%, transparent);
		content: "";
		transform: scaleX(0);
		transform-origin: left center;
		animation: about-swatch 900ms cubic-bezier(0.16, 1, 0.3, 1) 700ms
			backwards;
	}
	.about-name em span {
		background: linear-gradient(
			100deg,
			var(--primary) 8%,
			color-mix(in srgb, var(--mio-purple) 78%, var(--primary)) 34%,
			var(--primary) 62%
		);
		background-clip: text;
		background-size: 240% 100%;
		color: transparent;
		-webkit-background-clip: text;
		animation: about-name-shine 7.6s ease-in-out 1.1s infinite;
	}
	.about-lead {
		margin: 0.95rem 0 0;
		color: color-mix(in srgb, var(--text-body) 92%, transparent);
		font-size: clamp(0.85rem, 1.1vw, 0.95rem);
		line-height: 1.8;
	}
	.about-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 1rem;
		margin: 1.2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.about-meta li {
		display: inline-flex;
		align-items: center;
		gap: 0.36rem;
		color: color-mix(in srgb, var(--text-body) 88%, transparent);
		font-size: 0.76rem;
	}
	.about-meta li + li::before {
		width: 0.26rem;
		height: 0.26rem;
		margin-right: 0.5rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 46%, transparent);
		content: "";
	}
	.about-meta :global(svg) {
		width: 0.85rem;
		height: 0.85rem;
		color: color-mix(in srgb, var(--primary) 84%, var(--tea));
	}
	.about-socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.15rem;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
	}
	.about-socials a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: color-mix(in srgb, var(--text-body) 86%, transparent);
		font-size: 0.72rem;
		font-weight: 700;
		text-decoration: none;
	}
	.about-socials-icon {
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--glass-card) 78%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 12%, transparent);
		transition:
			translate 260ms cubic-bezier(0.2, 0.9, 0.28, 1.3),
			rotate 260ms ease,
			background 260ms ease;
	}
	.about-socials-icon :global(svg) {
		width: 0.9rem;
		height: 0.9rem;
		color: color-mix(in srgb, var(--tea) 84%, transparent);
		transition: color 220ms ease;
	}
	.about-socials-name {
		position: relative;
	}
	.about-socials-name::after {
		position: absolute;
		right: 0;
		bottom: -0.18rem;
		left: 0;
		height: 1px;
		background: color-mix(in srgb, var(--primary) 62%, transparent);
		content: "";
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.about-socials a:hover .about-socials-icon {
		translate: 0 -0.18rem;
		rotate: -6deg;
		background: color-mix(in srgb, var(--primary) 14%, var(--glass-card));
	}
	.about-socials a:hover .about-socials-icon :global(svg) {
		color: var(--primary);
	}
	.about-socials a:hover .about-socials-name::after {
		transform: scaleX(1);
	}

	/* ------------------------------------------------------------------
	   Chapter headings
	   ------------------------------------------------------------------ */
	.about-heading {
		position: relative;
		display: flex;
		align-items: flex-end;
		gap: 0.85rem;
		padding: 0 0.35rem 0.75rem;
	}
	.about-heading::after {
		position: absolute;
		right: 0.35rem;
		bottom: 0;
		left: 0.35rem;
		height: 1px;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--primary) 46%, transparent),
			color-mix(in srgb, var(--mio-purple) 26%, transparent) 48%,
			transparent 88%
		);
		content: "";
		transform: scaleX(0);
		transform-origin: left center;
		animation: about-rule-in 900ms cubic-bezier(0.16, 1, 0.3, 1) 220ms forwards;
	}
	.about-heading-index {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		flex: none;
		border: 1px dashed color-mix(in srgb, var(--primary) 32%, transparent);
		border-radius: 0.78rem;
		background: color-mix(in srgb, var(--primary) 8%, transparent);
		color: color-mix(in srgb, var(--primary) 80%, var(--tea));
		font-family: ui-monospace, "JetBrains Mono", monospace;
		font-size: 0.68rem;
		font-weight: 850;
		transition: rotate 420ms cubic-bezier(0.2, 0.9, 0.28, 1.3);
	}
	.about-heading:hover .about-heading-index {
		rotate: -9deg;
	}
	.about-heading-copy p {
		margin: 0;
		color: var(--primary);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.16em;
	}
	.about-heading-copy h2 {
		margin: 0.22rem 0 0;
		color: color-mix(in srgb, var(--text-strong) 92%, #68493f);
		font-size: clamp(1.3rem, 2.4vw, 1.85rem);
		font-weight: 900;
		letter-spacing: -0.02em;
	}
	.about-heading-note {
		margin: 0 0 0.25rem auto;
		color: color-mix(in srgb, var(--text-muted) 96%, transparent);
		font-size: 0.68rem;
	}

	/* ------------------------------------------------------------------
	   Timeline
	   ------------------------------------------------------------------ */
	.about-favorites {
		position: relative;
	}
	.about-threads {
		position: relative;
		display: grid;
		margin: 0.2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.about-threads::before,
	.about-threads::after {
		position: absolute;
		top: 2.1rem;
		bottom: 2.1rem;
		left: 1.8rem;
		width: 1px;
		content: "";
		translate: -50% 0;
	}
	.about-threads::before {
		background-image: linear-gradient(
			180deg,
			color-mix(in srgb, var(--primary) 42%, transparent) 0 0.4rem,
			transparent 0.4rem 0.86rem
		);
		background-size: 1px 0.86rem;
		animation: about-march-y 2.2s linear infinite;
	}
	.about-threads::after {
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(
			180deg,
			var(--primary),
			color-mix(in srgb, var(--mio-purple) 62%, var(--primary))
		);
		box-shadow: 0 0 0.85rem color-mix(in srgb, var(--primary) 42%, transparent);
		transform: scaleY(var(--rail-progress, 0));
		transform-origin: top center;
		transition: transform 200ms linear;
	}

	.about-thread {
		position: relative;
		display: grid;
		grid-template-columns: 3.6rem minmax(0, 1fr) minmax(0, 12rem);
		align-items: start;
		gap: 0 1.2rem;
		padding: 1.15rem 0.9rem 1.15rem 0;
		border-bottom: 1px dashed color-mix(in srgb, var(--text-muted) 26%, transparent);
		transition: translate 320ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.about-thread:last-child {
		border-bottom: 0;
	}
	.about-thread::before {
		position: absolute;
		inset: 0.25rem 0;
		z-index: -1;
		border-radius: 1.35rem;
		background: radial-gradient(
			16rem 9rem at var(--mx, 22%) var(--my, 50%),
			color-mix(in srgb, var(--tone) 17%, transparent),
			transparent 72%
		);
		content: "";
		opacity: 0;
		transition: opacity 280ms ease;
	}
	.about-thread::after {
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			var(--tone),
			color-mix(in srgb, var(--primary) 50%, var(--tone)) 58%,
			transparent
		);
		content: "";
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 460ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.about-thread:hover {
		translate: 0.34rem 0;
	}
	.about-thread:hover::before,
	.about-thread:focus-within::before {
		opacity: 1;
	}
	.about-thread:hover::after,
	.about-thread:focus-within::after {
		transform: scaleX(1);
	}

	.about-thread-node {
		position: relative;
		display: grid;
		place-items: center;
		justify-self: center;
		width: 3.1rem;
		height: 3.1rem;
		border: 1px solid color-mix(in srgb, var(--tone) 26%, transparent);
		border-radius: 1.05rem;
		background: color-mix(in srgb, var(--tone) 11%, var(--glass-card));
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.6),
			0 0.5rem 1.1rem rgb(104 67 58 / 0.06);
		rotate: -4deg;
		transition:
			rotate 420ms cubic-bezier(0.2, 0.9, 0.28, 1.4),
			scale 420ms cubic-bezier(0.2, 0.9, 0.28, 1.4),
			box-shadow 320ms ease;
	}
	.about-thread-node :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
		color: color-mix(in srgb, var(--tone) 78%, var(--tea));
		transition: scale 420ms cubic-bezier(0.2, 0.9, 0.28, 1.4);
	}
	.about-thread:hover .about-thread-node,
	.about-thread:focus-within .about-thread-node {
		rotate: 4deg;
		scale: 1.08;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.7),
			0 0.9rem 1.8rem color-mix(in srgb, var(--tone) 26%, transparent);
	}
	.about-thread:hover .about-thread-node :global(svg) {
		scale: 1.1;
	}

	.about-thread-body {
		min-width: 0;
		max-width: 40rem;
	}
	.about-thread-kicker {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0.15rem 0 0;
		color: color-mix(in srgb, var(--tone) 72%, var(--tea));
		font-size: 0.56rem;
		font-weight: 900;
		letter-spacing: 0.15em;
		transition: letter-spacing 360ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.about-thread-kicker b {
		font-family: ui-monospace, "JetBrains Mono", monospace;
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		opacity: 0.55;
	}
	.about-thread:hover .about-thread-kicker {
		letter-spacing: 0.2em;
	}
	.about-thread h3 {
		margin: 0.3rem 0 0.35rem;
		color: color-mix(in srgb, var(--text-strong) 90%, #68483f);
		font-size: clamp(1rem, 1.5vw, 1.14rem);
		font-weight: 900;
		letter-spacing: -0.01em;
	}
	.about-thread-text {
		margin: 0;
		color: color-mix(in srgb, var(--text-body) 92%, transparent);
		font-size: 0.78rem;
		line-height: 1.8;
	}
	.about-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.32rem;
		margin: 0.65rem 0 0;
		padding: 0;
		list-style: none;
	}
	.about-chips li {
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--tone) 12%, transparent);
		color: color-mix(in srgb, var(--tone) 58%, var(--text-strong));
		font-size: 0.62rem;
		font-weight: 700;
		transition:
			translate 280ms cubic-bezier(0.2, 0.9, 0.28, 1.3),
			background 240ms ease;
	}
	.about-thread:hover .about-chips li:nth-child(1) {
		translate: 0 -0.16rem;
	}
	.about-thread:hover .about-chips li:nth-child(2) {
		translate: 0 -0.16rem;
		transition-delay: 40ms;
	}
	.about-thread:hover .about-chips li:nth-child(3) {
		translate: 0 -0.16rem;
		transition-delay: 80ms;
	}
	.about-thread:hover .about-chips li:nth-child(4) {
		translate: 0 -0.16rem;
		transition-delay: 120ms;
	}
	.about-thread:hover .about-chips li:nth-child(5) {
		translate: 0 -0.16rem;
		transition-delay: 160ms;
	}
	.about-chips li:hover {
		background: color-mix(in srgb, var(--tone) 22%, transparent);
	}

	.about-thread-aside {
		justify-self: end;
		max-width: 12rem;
		padding-top: 0.2rem;
		text-align: right;
	}
	.about-thread-note {
		display: inline-block;
		color: color-mix(in srgb, var(--tone) 62%, var(--text-muted));
		font-size: 0.68rem;
		rotate: -1.6deg;
		transition:
			scale 420ms cubic-bezier(0.2, 0.9, 0.28, 1.4),
			color 260ms ease;
	}
	.about-thread:hover .about-thread-note {
		scale: 1.06;
		color: color-mix(in srgb, var(--tone) 82%, var(--tea));
	}
	.about-thread-aside a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.34rem 0.62rem;
		border: 1px dashed color-mix(in srgb, var(--tone) 34%, transparent);
		border-radius: 999px;
		color: color-mix(in srgb, var(--tone) 70%, var(--tea));
		font-size: 0.64rem;
		font-weight: 800;
		text-decoration: none;
		transition:
			background 240ms ease,
			translate 260ms cubic-bezier(0.2, 0.9, 0.28, 1.3),
			border-color 240ms ease;
	}
	.about-thread-aside a :global(svg) {
		width: 0.72rem;
		height: 0.72rem;
	}
	.about-thread-aside a:hover {
		translate: 0 -0.12rem;
		border-color: color-mix(in srgb, var(--tone) 60%, transparent);
		background: color-mix(in srgb, var(--tone) 12%, transparent);
	}

	.about-signoff {
		display: block;
		justify-self: end;
		margin-top: 0.4rem;
		color: color-mix(in srgb, var(--primary) 48%, transparent);
		font-size: 0.66rem;
		rotate: -1.6deg;
		animation: about-wiggle 6.4s ease-in-out infinite;
	}

	/* ------------------------------------------------------------------
	   Wishes & hello
	   ------------------------------------------------------------------ */
	.about-outro {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(1.6rem, 4vw, 3.4rem);
	}
	.about-outro-rule {
		position: absolute;
		top: 0.4rem;
		bottom: 0.4rem;
		left: 50%;
		width: 1px;
		background-image: linear-gradient(
			180deg,
			color-mix(in srgb, var(--primary) 34%, transparent) 0 0.42rem,
			transparent 0.42rem 0.92rem
		);
		background-size: 1px 0.92rem;
		animation: about-march-y 2.6s linear infinite;
	}
	.about-outro-col {
		position: relative;
		min-width: 0;
	}
	.about-outro-kicker {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: var(--primary);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.15em;
	}
	.about-outro-kicker :global(svg) {
		width: 0.85rem;
		height: 0.85rem;
	}
	.about-outro-col h2 {
