	/* ------------------------------------------------------------------
	   Reveal on scroll
	   ------------------------------------------------------------------
	   Two mechanisms, because a page entered through Swup never re-runs
	   `about-reveal-pending` is set by the inline script in the head, before
	   the markup paints, so a block never flashes in place and then fades
	   out again; the client script arms the observer and hands out `is-in`.
	   If that script never arrives, the timer in the head drops the class
	   again — content is never left blank waiting for JavaScript.
	   ------------------------------------------------------------------ */
	:global(html.about-reveal-pending) .about-page [data-reveal]:not(.is-in) {
		opacity: 0;
		translate: 0 1.5rem;
	}
	.about-page [data-reveal].is-in {
		animation: about-reveal 780ms cubic-bezier(0.16, 1, 0.3, 1)
			var(--reveal-delay, 0ms) backwards;
	}

