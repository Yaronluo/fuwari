---
import MainGridLayout from '../layouts/MainGridLayout.astro';
import BangumiPanel from '@components/BangumiPanel.svelte';
import { getBangumiData } from '../data/bangumi';

const COLLECTION_TYPES = [
    { id: 3, label: '正在心动', emoji: '♡' },
    { id: 2, label: '完结撒花', emoji: '✦' },
    { id: 1, label: '预定入坑', emoji: '＋' },
    { id: 4, label: '时空凝结', emoji: '◷' },
    { id: 5, label: '物理斩断', emoji: '×' }
];

const GENRE_TAGS = new Set([
    '恋爱', '日常', '治愈', '奇幻', '战斗', '异世界', '校园', '喜剧', '科幻',
    '青春', '音乐', '冒险', '悬疑', '百合', '萌', '热血', '运动', '推理',
    '魔法', '机战', '后宫', '历史', '职场', '公路', '偶像', '美食'
]);

function selectDisplayTags(tags: Array<{ name?: string }> | undefined) {
    const names = Array.from(new Set((tags || []).map((tag) => tag?.name?.trim()).filter(Boolean))) as string[];
    const genres = names.filter((name) => GENRE_TAGS.has(name));
    if (genres.length >= 5) return genres.slice(0, 5);

    const fallback = names.filter((name) =>
        !genres.includes(name)
        && !/^\d{4}(年\d{1,2}月)?$/.test(name)
        && !/^(TV|WEB|OVA|OAD|动画|日本动画)$/.test(name)
        && !/(改|Pictures|Animation|Studio|制作)$/.test(name)
    );
    return [...genres, ...fallback].slice(0, 5);
}

const bangumiData = await getBangumiData();
const allCollections = bangumiData.collections;
const statusCounts: Record<string, number> = { '3': 0, '2': 0, '1': 0, '4': 0, '5': 0 };
allCollections.forEach((item) => {
    statusCounts[String(item.type)] = (statusCounts[String(item.type)] || 0) + 1;
});
const syncDate = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai', dateStyle: 'medium', timeStyle: 'short'
}).format(new Date(bangumiData.fetchedAt));

const userRatings = allCollections
    .map((item) => Number(item.rate || 0))
    .filter((rating) => rating > 0 && rating <= 10);
const ratingCount = userRatings.length;
const averageRating = ratingCount > 0
    ? userRatings.reduce((sum, rating) => sum + rating, 0) / ratingCount
    : 0;
const ratingStandardDeviation = ratingCount > 0
    ? Math.sqrt(userRatings.reduce((sum, rating) => sum + ((rating - averageRating) ** 2), 0) / ratingCount)
    : 0;
const completedCount = statusCounts['2'] || 0;
const completionRate = allCollections.length > 0 ? (completedCount / allCollections.length) * 100 : 0;
const ratingDistribution = Array.from({ length: 10 }, (_, index) => {
    const score = 10 - index;
    return { score, count: userRatings.filter((rating) => rating === score).length };
});
const maxRatingCount = Math.max(...ratingDistribution.map((item) => item.count), 1);
const favoriteRating = ratingDistribution.reduce(
    (best, item) => (item.count > best.count ? item : best),
    ratingDistribution[0]
);
// 首屏右侧扇形封面（左 → 中 → 右）。想换封面只要改这里的 Bangumi subject id 顺序即可，
// 找不到的 id 会被跳过，剩余位置自动用「我的评分最高」补齐。
const HERO_FAN_SUBJECT_IDS = [
    347887, // 擅长捉弄的高木同学 第三季
    1424, // 轻音少女
    638497, // 相反的你和我 第二季
];

const posterOf = (item: (typeof allCollections)[number]) => {
    const rawImage = item.subject.images?.large || item.subject.images?.common || '';
    return {
        name: item.subject.name_cn || item.subject.name || 'Anime',
        image: `https://images.weserv.nl/?url=${rawImage}`,
        rate: Number(item.rate || 0),
    };
};

const awardedCollections = allCollections
    .filter((item) => item.subject.images?.large || item.subject.images?.common)
    .sort((a, b) => {
        const myRatingDiff = Number(b.rate || 0) - Number(a.rate || 0);
        if (myRatingDiff !== 0) return myRatingDiff;
        return Number(b.subject.score || 0) - Number(a.subject.score || 0);
    });
const pinnedCollections = HERO_FAN_SUBJECT_IDS
    .map((subjectId) => awardedCollections.find((item) => item.subject.id === subjectId))
    .filter((item): item is (typeof awardedCollections)[number] => Boolean(item));
const pinnedIds = new Set(pinnedCollections.map((item) => item.subject.id));
const heroFan = [...pinnedCollections, ...awardedCollections.filter((item) => !pinnedIds.has(item.subject.id))]
    .slice(0, 3)
    .map(posterOf);
const reviews = allCollections
    .filter((item) => item.type === 2 && item.comment?.trim())
    .sort((a, b) => (b.updated_at || '').localeCompare(a.updated_at || ''));
const reviewDate = (value?: string) => value
    ? new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(value))
    : '';
---

<MainGridLayout title="番剧观测" description="我的追番记录墙">
    <main class="bangumi-page">
        <div class="bangumi-sticker-field" aria-hidden="true">
            <span class="sticker-star">✦</span>
            <span class="sticker-sakura">🌸</span>
            <span class="sticker-paw">🐾</span>
            <span class="sticker-game">🎮</span>
            <span class="sticker-note">♪</span>
            <span class="sticker-tv">📺</span>
        </div>
        <header class="bangumi-hero">
            <div class="bangumi-hero-glow" aria-hidden="true"></div>
            <div class="bangumi-hero-copy">
                <p class="bangumi-eyebrow">
                    今日也在快乐追番
                    <span class="bangumi-eyebrow-index">No.01</span>
                </p>
                <h1 aria-label="我的追番小窝">
                    <span class="bangumi-hero-title">
                        {'我的追番小窝'.split('').map((char, index) => (
                            <span class="bangumi-char" style={`--char-index: ${index}`}>{char}</span>
                        ))}
                    </span>
                    <span class="bangumi-hero-spark" aria-hidden="true">✧</span>
                </h1>
                <p class="bangumi-subtitle">看过的、正在追的、准备看的，统统收进来！下一部会遇见怎样的故事呢？(｡•̀ᴗ-)✧</p>
                <div class="bangumi-ledger" aria-label="追番概览">
                    <div class="bangumi-ledger-item" style="--ledger-index: 0">
                        <strong data-count={allCollections.length} data-decimals="0">{allCollections.length}</strong>
                        <span>部收藏</span>
                    </div>
                    <div class="bangumi-ledger-item" style="--ledger-index: 1">
                        <strong data-count={completedCount} data-decimals="0">{completedCount}</strong>
                        <span>部看完</span>
                    </div>
                    <div class="bangumi-ledger-item" style="--ledger-index: 2">
                        <strong data-count={averageRating.toFixed(2)} data-decimals="2">{averageRating.toFixed(2)}</strong>
                        <span>平均分</span>
                    </div>
                </div>
            </div>
            {heroFan.length > 0 && (
                <div class="bangumi-hero-fan" aria-hidden="true">
                    <span class="bangumi-fan-tape"></span>
                    {heroFan.map((poster, index) => (
                        <figure class={`bangumi-fan-card bangumi-fan-${index + 1}`}>
                            <img src={poster.image} alt="" title={poster.rate > 0 ? `${poster.name} · 我的评分 ${poster.rate}` : poster.name} loading="eager" decoding="async" referrerpolicy="no-referrer" />
                            {poster.rate > 0 && <span class="bangumi-fan-rate">{poster.rate}</span>}
                        </figure>
                    ))}
                    <span class="bangumi-fan-caption">我的评分最高 · TOP 3</span>
                </div>
            )}
        </header>

        {bangumiData.stale && (
            <p class="bangumi-sync-notice" role="status">Bangumi 暂时连接不上，先展示上次同步的收藏。更新于 <time datetime={bangumiData.fetchedAt}>{syncDate}</time></p>
        )}
        {allCollections.length === 0 ? (
            <div class="bangumi-state">
                <span class="bangumi-state-icon">✦</span>
                <strong>此处空空如也</strong>
                <span>快去捕捉新的奇迹吧。</span>
            </div>
        ) : (
            <>
                <section class="bangumi-insights" aria-label="我的 Bangumi 追番数据">
                    <div class="bangumi-insights-heading">
                        <div>
                            <span aria-hidden="true">✦</span>
                            <strong>评分档案</strong>
                            <span class="bangumi-insights-index">No.02</span>
                        </div>
                        <small>来自我的 Bangumi 收藏</small>
                    </div>
                    <div class="bangumi-insights-body">
                        <div class="bangumi-score-hero">
                            <span class="bangumi-score-hero-label">平均分</span>
                            <strong class="bangumi-score-hero-value">
                                <span data-count={averageRating.toFixed(2)} data-decimals="2">{averageRating.toFixed(2)}</span>
                                <span class="bangumi-score-hero-unit">/ 10</span>
                            </strong>
                            <span class="bangumi-score-stars" style={`--fill: ${(averageRating / 10) * 100}%`} aria-hidden="true">★★★★★</span>
                            <span class="bangumi-score-hero-meta">
                                <span><b data-count={ratingCount} data-decimals="0">{ratingCount}</b> 部有评分</span>
                                <span>标准差 <b data-count={ratingStandardDeviation.toFixed(2)} data-decimals="2">{ratingStandardDeviation.toFixed(2)}</b></span>
                                <span>看完 <b data-count={completedCount} data-decimals="0">{completedCount}</b> 部 · 完成率 <b data-count={completionRate.toFixed(1)} data-decimals="1" data-suffix="%">{completionRate.toFixed(1)}%</b></span>
                            </span>
                        </div>
                        <div class="bangumi-rating-chart" aria-label="评分分布">
                            <div class="bangumi-rating-head">
                                <strong>评分分布</strong>
                                <small>最常给出 <b>{favoriteRating.score}</b> 分 · <b>{favoriteRating.count}</b> 部</small>
                            </div>
                            <div class="bangumi-rating-bars">
                                {ratingDistribution.map((item, index) => (
                                    <div
                                        class="bangumi-rating-column"
                                        style={`--rating-index: ${index}; --rating-height: ${Math.min(86, Math.max(item.count > 0 ? 8 : 3, (item.count / maxRatingCount) * 100))}%`}
                                        title={`${item.score} 分：${item.count} 部`}
                                    >
                                        <span class="bangumi-rating-count">{item.count || ''}</span>
                                        <span class="bangumi-rating-bar"></span>
                                        <span class="bangumi-rating-label">{item.score}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </section>

                <nav class="bangumi-view-switch" aria-label="展示方式">
                    <button type="button" data-view="wall" aria-pressed="true" class="bangumi-view-active">
                        <span class="bangumi-view-icon" aria-hidden="true">❖</span>番剧墙
                    </button>
                    <button type="button" data-view="reviews" aria-pressed="false">
                        <span class="bangumi-view-icon" aria-hidden="true">✎</span>我的短评 <span class="bangumi-view-badge">{reviews.length}</span>
                    </button>
                </nav>

                <nav class="bangumi-tabs" id="bangumi-tabs-container" aria-label="番剧收藏状态">
                    <button data-status="all" data-accent="all" class="tab-btn bangumi-tab bangumi-tab-active" type="button" aria-pressed="true">
                        <span class="bangumi-tab-icon" aria-hidden="true">✧</span>全部 <span class="bangumi-tab-count">{allCollections.length}</span>
                    </button>
                    {COLLECTION_TYPES.map((collectionType) => (
                        <button data-status={collectionType.id} data-accent={collectionType.id} class="tab-btn bangumi-tab bangumi-tab-inactive" type="button" aria-pressed="false">
                            <span class="bangumi-tab-icon" aria-hidden="true">{collectionType.emoji}</span>{collectionType.label} <span class="bangumi-tab-count">{statusCounts[String(collectionType.id)]}</span>
                        </button>
                    ))}
                </nav>

                <section class="bangumi-wall" aria-label="番剧收藏列表">
                    <div class="bangumi-wall-glow" aria-hidden="true"></div>
                    <div class="bangumi-wall-bar" id="bangumi-wall-bar">
                        <span class="bangumi-wall-bar-title"><span aria-hidden="true">✦</span>放映墙<span class="bangumi-wall-bar-index">No.03</span></span>
                        <span class="bangumi-wall-bar-meta">
                            <span class="bangumi-wall-bar-hint">点击封面进入 Bangumi 条目</span>
                            <span class="bangumi-wall-bar-count">共 <strong id="bangumi-wall-count">{allCollections.length}</strong> 部</span>
                        </span>
                    </div>

                    <div class="bangumi-grid" id="bangumi-grid">
					{allCollections.map((item, index) => {
                        const statusInfo = COLLECTION_TYPES.find((collectionType) => collectionType.id === item.type);
                        const name = item.subject.name_cn || item.subject.name || 'Anime';
                        const scoreValue = Number(item.subject.score || 0);
                        const score = scoreValue > 0 ? scoreValue.toFixed(1) : '暂无';
                        const rawImage = item.subject.images?.large || item.subject.images?.common || '';
                        const hasImage = Boolean(rawImage);
                        const image = hasImage ? `https://images.weserv.nl/?url=${rawImage}` : '';
                        const totalEpisodes = Number(item.subject.eps || item.subject.total_episodes || 0);
                        const watchedEpisodes = Number(item.ep_status || 0);
                        const displayTags = selectDisplayTags(item.subject.tags);
                        const myRate = Number(item.rate || 0);
                        const episodeText = totalEpisodes > 0
                            ? item.type === 2
                                ? `共 ${totalEpisodes} 集`
                                : watchedEpisodes > 0
                                    ? `${watchedEpisodes} / ${totalEpisodes} 集`
                                    : `共 ${totalEpisodes} 集`
                            : watchedEpisodes > 0
                                ? `已看 ${watchedEpisodes} 集`
                                : statusInfo?.label || '收藏中';
                        const progress = totalEpisodes > 0 && watchedEpisodes > 0
                            ? Math.min(100, Math.round((watchedEpisodes / totalEpisodes) * 100))
                            : item.type === 2
                                ? 100
                                : null;

                        return (
                            <article class="bangumi-item" data-type={item.type} style={`--card-lean: ${((index % 3) - 1) * 0.42}deg`}>
                                <a class="bangumi-card" href={`https://bgm.tv/subject/${item.subject.id}`} target="_blank" rel="noopener noreferrer" aria-label={`在 Bangumi 查看 ${name}`}>
                                    <span class="bangumi-card-halo" aria-hidden="true"></span>
                                    <span class="bangumi-card-corners" aria-hidden="true"></span>
                                    <div class="bangumi-poster">
                                        <span class="bangumi-poster-skeleton" aria-hidden="true"></span>
                                        {hasImage ? (
                                            <>
                                                <img
                                                    src={image}
                                                    alt=""
                                                    loading="lazy"
                                                    decoding="async"
                                                    referrerpolicy="no-referrer"
                                                    onload="this.closest('.bangumi-poster').classList.add('is-loaded')"
                                                    onerror="this.style.display='none';this.closest('.bangumi-poster').classList.add('is-failed')"
                                                />
                                                <span class="bangumi-image-fallback">图片走丢了</span>
                                            </>
                                        ) : (
                                            <span class="bangumi-image-fallback bangumi-image-fallback-visible">暂无图片</span>
                                        )}
                                        <span class="bangumi-poster-tint" aria-hidden="true"></span>
                                        <span class="bangumi-poster-spot" aria-hidden="true"></span>
                                        <span class={`bangumi-status bangumi-status-${item.type}`}>
                                            <span class="bangumi-status-icon" aria-hidden="true">{statusInfo?.emoji}</span>{statusInfo?.label || '收藏中'}
                                        </span>
                                        {scoreValue > 0 && (
                                            <span class="bangumi-score-chip" aria-label={`Bangumi 评分 ${score}`}>
                                                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>{score}
                                            </span>
                                        )}
                                        <span class="bangumi-slip" aria-hidden="true">
                                            <span class="bangumi-slip-tape"></span>
                                            <span class="bangumi-slip-head">
                                                <span class="bangumi-slip-ep">{episodeText}</span>
                                                {myRate > 0 ? (
                                                    <span class="bangumi-slip-rate">
                                                        <strong>{myRate}</strong>
                                                        <span class="bangumi-slip-stars" style={`--fill: ${(myRate / 10) * 100}%`}>★★★★★</span>
                                                    </span>
                                                ) : (
                                                    <span class="bangumi-slip-rate bangumi-slip-rate-empty">未评分</span>
                                                )}
                                            </span>
                                            {progress !== null && (
                                                <span class="bangumi-progress"><i style={`--progress: ${progress}%`}></i></span>
                                            )}
                                            <span class="bangumi-slip-foot">
                                                <span class={`bangumi-slip-status bangumi-slip-status-${item.type}`}>{statusInfo?.label || '收藏中'}</span>
                                                <span class="bangumi-slip-cta">查看条目<span aria-hidden="true">↗</span></span>
                                            </span>
                                        </span>
                                    </div>
                                    <div class="bangumi-card-info">
                                        <h2>{name}</h2>
                                        <div class="bangumi-tags" aria-label="番剧标签">
                                            {displayTags.map((tag) => <span>{tag}</span>)}
                                        </div>
                                        <div class="bangumi-card-meta">
                                            <span class="bangumi-card-index" aria-hidden="true">No.{String(index + 1).padStart(3, '0')}</span>
                                            <span class="bangumi-ep">{episodeText}</span>
                                            <span class="bangumi-enter">详情<span class="bangumi-enter-icon" aria-hidden="true">↗</span></span>
                                        </div>
                                    </div>
                                    <span class="sr-only">状态：{statusInfo?.label || '收藏中'}；{episodeText}{myRate > 0 ? `；我的评分 ${myRate} 分` : ''}{scoreValue > 0 ? `；Bangumi 评分 ${score}` : ''}</span>
                                </a>
                            </article>
                        );
                    })}
                    </div>
                </section>

                <section id="bangumi-reviews" class="bangumi-reviews" aria-label="我的番剧短评" hidden>
                    <div class="bangumi-reviews-glow" aria-hidden="true"></div>
                    <header class="bangumi-review-heading">
                        <div class="bangumi-review-heading-text">
                            <p class="bangumi-eyebrow">故事结束，心动留在这里</p>
                            <h2>看完之后，想说的话</h2>
                        </div>
                        <div class="bangumi-review-tools">
                            <span class="bangumi-review-count"><strong>{reviews.length}</strong>篇短评 · <span data-review-order-label>最近更新在前</span></span>
                            <div class="bangumi-review-sort" role="group" aria-label="短评排序方式">
                                <button type="button" data-review-sort="updated" aria-pressed="true" class="is-active">最近更新</button>
                                <button type="button" data-review-sort="rating" aria-pressed="false">我的评分</button>
                            </div>
                        </div>
                    </header>
                    {reviews.length === 0 ? (
                        <div class="bangumi-state"><strong>还没有短评</strong><span>在 Bangumi 为看过的番剧写下感想，下次同步就会出现在这里。</span></div>
                    ) : (
                        <div class="bangumi-review-list">
                            {reviews.map((item, index) => {
                                const name = item.subject.name_cn || item.subject.name || 'Anime';
                                const rawImage = item.subject.images?.large || item.subject.images?.common;
                                const comment = item.comment!.trim();
                                const longComment = comment.length > 160 || comment.split('\n').length > 4;
                                const rate = Number(item.rate || 0);
                                const hasOriginalTitle = Boolean(item.subject.name_cn && item.subject.name && item.subject.name_cn !== item.subject.name);
                                const subjectUrl = `https://bgm.tv/subject/${item.subject.id}`;
                                return (
                                    <article class="bangumi-review-item" data-rate={rate} data-updated={item.updated_at || ''}>
                                        <span class="bangumi-review-accent" aria-hidden="true"></span>
                                        <span class="bangumi-review-spot" aria-hidden="true"></span>
                                        <span class="bangumi-review-ghost" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                                        <a class="bangumi-review-cover" href={subjectUrl} target="_blank" rel="noopener noreferrer" aria-label={`在 Bangumi 查看 ${name}`}>
                                            {rawImage ? <img src={`https://images.weserv.nl/?url=${encodeURIComponent(rawImage)}`} alt={name} loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none'" /> : null}
                                            <span class="bangumi-review-cover-fallback" aria-hidden="true">✦</span>
                                            <span class="bangumi-review-cover-sheen" aria-hidden="true"></span>
                                        </a>
                                        <div class="bangumi-review-body">
                                            <div class="bangumi-review-topline">
                                                <span class="bangumi-review-badge"><span aria-hidden="true">✦</span>完结撒花</span>
                                                {item.updated_at && <time datetime={item.updated_at}>更新于 {reviewDate(item.updated_at)}</time>}
                                            </div>
                                            <h3 class="bangumi-review-title">
                                                <a href={subjectUrl} target="_blank" rel="noopener noreferrer">{name}<span class="bangumi-review-arrow" aria-hidden="true">↗</span></a>
                                            </h3>
                                            {hasOriginalTitle && <p class="bangumi-review-original">{item.subject.name}</p>}
                                            <div class="bangumi-review-rating">
                                                <span class="bangumi-review-rating-label">我的评分</span>
                                                {rate > 0 ? (
                                                    <>
                                                        <span class="bangumi-review-score"><strong>{rate}</strong><small>/ 10</small></span>
                                                        <span class="bangumi-review-meter" aria-hidden="true">
                                                            {Array.from({ length: 10 }, (_, segmentIndex) => (
                                                                <i class={segmentIndex < rate ? 'is-on' : ''} style={`--segment-order: ${segmentIndex}`}></i>
                                                            ))}
                                                        </span>
                                                    </>
                                                ) : <span class="bangumi-review-score bangumi-review-score-empty">未评分</span>}
                                            </div>
                                            <div class={`bangumi-review-text${longComment ? ' is-collapsed' : ''}`} data-long={longComment ? 'true' : 'false'}>
                                                <div class="bangumi-review-clip">
                                                    <p class="bangumi-review-copy">{comment}</p>
                                                </div>
