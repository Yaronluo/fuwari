---
import MainGridLayout from '../layouts/MainGridLayout.astro';
import BangumiPanel from '@components/BangumiPanel.svelte';

const BANGUMI_USER = import.meta.env.PUBLIC_BANGUMI_USER || "yaron";
const BANGUMI_TOKEN = import.meta.env.PUBLIC_BANGUMI_TOKEN || "";

const COLLECTION_TYPES = [
    { id: 3, label: '正在心动', emoji: '♡' },
    { id: 2, label: '完结撒花', emoji: '✦' },
    { id: 1, label: '预定入坑', emoji: '＋' },
    { id: 4, label: '时空凝结', emoji: '◷' },
    { id: 5, label: '物理斩断', emoji: '×' }
];

const GENRE_TAGS = new Set([
    '恋爱', '日常', '治愈', '奇幻', '战斗', '异世界', '校园', '喜剧', '科幻',
    '青春', '音乐', '冒险', '悬疑', '百合', '萌', '热血', '运动', '推理',
    '魔法', '机战', '后宫', '历史', '职场', '公路', '偶像', '美食'
]);

function selectDisplayTags(tags: Array<{ name?: string }> | undefined) {
    const names = Array.from(new Set((tags || []).map((tag) => tag?.name?.trim()).filter(Boolean))) as string[];
    const genres = names.filter((name) => GENRE_TAGS.has(name));
    if (genres.length >= 5) return genres.slice(0, 5);

    const fallback = names.filter((name) =>
        !genres.includes(name)
        && !/^\d{4}(年\d{1,2}月)?$/.test(name)
        && !/^(TV|WEB|OVA|OAD|动画|日本动画)$/.test(name)
        && !/(改|Pictures|Animation|Studio|制作)$/.test(name)
    );
    return [...genres, ...fallback].slice(0, 5);
}

let allCollections: any[] = [];
let statusCounts: Record<string, number> = { '3': 0, '2': 0, '1': 0, '4': 0, '5': 0 };
let errorMessage: string | null = null;
let isLoading = true;

try {
    if (!BANGUMI_TOKEN) {
        throw new Error("未配置 BANGUMI_TOKEN 环境变量");
    }

    const fetchPromises = COLLECTION_TYPES.map(async (collectionType) => {
        const batchSize = 50;
        let offset = 0;
        const collections: any[] = [];

        while (true) {
            const url = `https://api.bgm.tv/v0/users/${BANGUMI_USER}/collections?subject_type=2&type=${collectionType.id}&limit=${batchSize}&offset=${offset}`;
            const response = await fetch(url, {
                headers: {
                    'User-Agent': 'Fuwari-Bangumi/1.0',
                    'Authorization': `Bearer ${BANGUMI_TOKEN}`
                }
            });
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`API 请求失败 (${response.status}): ${errorText}`);
            }

            const responseData = await response.json();
            const batch = responseData.data || [];
            collections.push(...batch.map((item: any) => ({ ...item, type: collectionType.id })));

            if (batch.length < batchSize) break;
            offset += batchSize;
        }

        return collections;
    });

    const results = await Promise.all(fetchPromises);
    allCollections = results.flat().filter((item) => item?.subject);

    allCollections.forEach((item: any) => {
        statusCounts[String(item.type)] = (statusCounts[String(item.type)] || 0) + 1;
    });
} catch (error) {
    console.error("获取 Bangumi 数据失败:", error);
    errorMessage = error instanceof Error ? error.message : "未知错误";
} finally {
    isLoading = false;
}

const userRatings = allCollections
    .map((item) => Number(item.rate || 0))
    .filter((rating) => rating > 0 && rating <= 10);
const ratingCount = userRatings.length;
const averageRating = ratingCount > 0
    ? userRatings.reduce((sum, rating) => sum + rating, 0) / ratingCount
    : 0;
const ratingStandardDeviation = ratingCount > 0
    ? Math.sqrt(userRatings.reduce((sum, rating) => sum + ((rating - averageRating) ** 2), 0) / ratingCount)
    : 0;
const completedCount = statusCounts['2'] || 0;
const completionRate = allCollections.length > 0 ? (completedCount / allCollections.length) * 100 : 0;
const ratingDistribution = Array.from({ length: 10 }, (_, index) => {
    const score = 10 - index;
    return { score, count: userRatings.filter((rating) => rating === score).length };
});
const maxRatingCount = Math.max(...ratingDistribution.map((item) => item.count), 1);
---

<MainGridLayout title="番剧观测" description="我的追番记录墙">
    <main class="bangumi-page">
        <div class="bangumi-sticker-field" aria-hidden="true">
            <span class="sticker-star">✦</span>
            <span class="sticker-sakura">🌸</span>
            <span class="sticker-paw">🐾</span>
            <span class="sticker-game">🎮</span>
            <span class="sticker-note">♪</span>
            <span class="sticker-tv">📺</span>
        </div>
        <header class="bangumi-hero">
            <div class="bangumi-hero-copy">
                <p class="bangumi-eyebrow">今日也在快乐追番</p>
                <h1>我的追番小窝</h1>
                <p class="bangumi-subtitle">看过的、正在追的、准备看的，统统收进来！下一部会遇见怎样的故事呢？(｡•̀ᴗ-)✧</p>
                <div class="bangumi-energy" aria-label="追番状态">
                    <span>追番能量 100%</span>
                    <span>今日也在补番中</span>
                </div>
            </div>
        </header>

        {isLoading ? (
            <div class="bangumi-state">
                <div class="bangumi-spinner" aria-label="正在加载"></div>
            </div>
        ) : errorMessage ? (
            <div class="bangumi-state bangumi-state-error">
                <span class="bangumi-state-icon">!</span>
                <strong>数据加载失败</strong>
                <span>{errorMessage}</span>
            </div>
        ) : allCollections.length === 0 ? (
            <div class="bangumi-state">
                <span class="bangumi-state-icon">✦</span>
                <strong>此处空空如也</strong>
                <span>快去捕捉新的奇迹吧。</span>
            </div>
        ) : (
            <>
                <section class="bangumi-insights" aria-label="我的 Bangumi 追番数据">
                    <div class="bangumi-insights-heading">
                        <div><span aria-hidden="true">✦</span><strong>追番数据</strong></div>
                        <small>来自我的 Bangumi 收藏</small>
                    </div>
                    <div class="bangumi-insights-content">
                        <div class="bangumi-metrics">
                            <div class="bangumi-metric metric-collection"><strong>{allCollections.length}</strong><span>收藏</span></div>
                            <div class="bangumi-metric metric-completed"><strong>{completedCount}</strong><span>完成</span></div>
                            <div class="bangumi-metric metric-rate"><strong>{completionRate.toFixed(1)}%</strong><span>完成率</span></div>
                            <div class="bangumi-metric metric-average"><strong>{averageRating.toFixed(2)}</strong><span>平均分</span></div>
                            <div class="bangumi-metric metric-deviation"><strong>{ratingStandardDeviation.toFixed(2)}</strong><span>标准差</span></div>
                            <div class="bangumi-metric metric-count"><strong>{ratingCount}</strong><span>评分数</span></div>
                        </div>
                        <div class="bangumi-rating-chart" aria-label="评分分布">
                            <strong>评分分布</strong>
                            <div class="bangumi-rating-bars">
                                {ratingDistribution.map((item) => (
                                    <div class="bangumi-rating-column" title={`${item.score} 分：${item.count} 部`}>
                                        <span class="bangumi-rating-count">{item.count || ''}</span>
                                        <span class="bangumi-rating-bar" style={`--rating-height: ${Math.max(item.count > 0 ? 8 : 2, (item.count / maxRatingCount) * 100)}%`}></span>
                                        <span class="bangumi-rating-label">{item.score}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </section>

                <nav class="bangumi-tabs" id="bangumi-tabs-container" aria-label="番剧收藏状态">
                    <button data-status="all" class="tab-btn bangumi-tab bangumi-tab-active" type="button" aria-pressed="true">
                        全部 <span>{allCollections.length}</span>
                    </button>
                    {COLLECTION_TYPES.map((collectionType) => (
                        <button data-status={collectionType.id} class="tab-btn bangumi-tab bangumi-tab-inactive" type="button" aria-pressed="false">
                            {collectionType.label} <span>{statusCounts[String(collectionType.id)]}</span>
                        </button>
                    ))}
                </nav>

                <section class="bangumi-grid" id="bangumi-grid" aria-label="番剧收藏列表">
                    {allCollections.map((item: any) => {
                        const statusInfo = COLLECTION_TYPES.find((collectionType) => collectionType.id === item.type);
                        const name = item.subject.name_cn || item.subject.name || 'Anime';
                        const scoreValue = Number(item.subject.score || 0);
                        const score = scoreValue > 0 ? scoreValue.toFixed(1) : '暂无';
                        const rawImage = item.subject.images?.large || item.subject.images?.common || '';
                        const hasImage = Boolean(rawImage);
                        const image = hasImage ? `https://images.weserv.nl/?url=${rawImage}` : '';
                        const totalEpisodes = Number(item.subject.eps || item.subject.total_episodes || 0);
                        const watchedEpisodes = Number(item.ep_status || 0);
                        const displayTags = selectDisplayTags(item.subject.tags);
                        const episodeText = totalEpisodes > 0
                            ? item.type === 2
                                ? `共 ${totalEpisodes} 集`
                                : watchedEpisodes > 0
                                    ? `${watchedEpisodes} / ${totalEpisodes} 集`
                                    : `共 ${totalEpisodes} 集`
                            : watchedEpisodes > 0
                                ? `已看 ${watchedEpisodes} 集`
                                : statusInfo?.label || '收藏中';

                        return (
                            <article class="bangumi-item" data-type={item.type}>
                                <a href={`https://bgm.tv/subject/${item.subject.id}`} target="_blank" rel="noopener noreferrer" aria-label={`在 Bangumi 查看 ${name}`}>
                                    <div class="bangumi-poster">
                                        {hasImage ? (
                                            <>
                                                <img src={image} alt={name} loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
                                                <div class="bangumi-image-fallback">图片加载失败</div>
                                            </>
                                        ) : (
                                            <div class="bangumi-image-fallback bangumi-image-fallback-visible">暂无图片</div>
                                        )}
                                        <span class={`bangumi-status bangumi-status-${item.type}`}>
                                            <span aria-hidden="true">{statusInfo?.emoji}</span>{statusInfo?.label || '收藏中'}
                                        </span>
                                    </div>
                                    <div class="bangumi-card-info">
                                        <h2>{name}</h2>
                                        {displayTags.length > 0 && (
                                            <div class="bangumi-tags" aria-label="番剧标签">
                                                {displayTags.map((tag) => <span>{tag}</span>)}
                                            </div>
                                        )}
                                        <div class="bangumi-card-meta">
                                            <span>{episodeText}</span>
                                            <span class="bangumi-score" aria-label={`评分 ${score}`}>
                                                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                                {score}
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        );
                    })}
                </section>

                <nav id="bangumi-pagination" class="bangumi-pagination" aria-label="番剧列表分页">
                    <span class="bangumi-page-deco" aria-hidden="true">♡</span>
                    <button id="btn-prev" type="button" aria-label="上一页"><span aria-hidden="true">←</span></button>
                    <span class="bangumi-page-ticket">
                        <small>NEXT EPISODE</small>
                        <strong id="page-indicator">01 / 01</strong>
                    </span>
                    <button id="btn-next" type="button" aria-label="下一页"><span aria-hidden="true">→</span></button>
                    <span class="bangumi-page-deco" aria-hidden="true">✦</span>
                </nav>

                <BangumiPanel client:load />
            </>
        )}
    </main>
</MainGridLayout>

<style is:global>
    .bangumi-page {
        position: relative;
        isolation: isolate;
        width: 100%;
        max-width: 68rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 3rem;
        color: var(--deep-text, var(--text-75));
    }

    .bangumi-page::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset: -2rem -10rem;
        pointer-events: none;
        opacity: 0.22;
        background-image:
            radial-gradient(circle, color-mix(in srgb, var(--primary) 28%, transparent) 1px, transparent 1.5px),
            repeating-linear-gradient(118deg, transparent 0 3.6rem, color-mix(in srgb, var(--primary) 12%, transparent) 3.65rem, transparent 3.75rem);
        background-size: 1.15rem 1.15rem, auto;
        mask-image: radial-gradient(ellipse at center, black 0, transparent 72%);
    }

    .bangumi-sticker-field {
        position: absolute;
        z-index: -1;
        inset: 0;
        pointer-events: none;
        color: var(--primary);
    }

    .bangumi-sticker-field span {
        position: absolute;
        display: grid;
        place-items: center;
        opacity: 0.2;
        filter: saturate(0.75);
        transform: rotate(var(--sticker-rotate, 0deg));
    }

    .sticker-star { top: 7rem; left: -5rem; font-size: 2rem; --sticker-rotate: -12deg; }
    .sticker-sakura { top: 24rem; right: -6rem; font-size: 2.35rem; --sticker-rotate: 14deg; }
    .sticker-paw { top: 43rem; left: -6rem; font-size: 2.1rem; --sticker-rotate: -18deg; }
    .sticker-game { top: 62rem; right: -6.5rem; font-size: 2.4rem; --sticker-rotate: 11deg; }
    .sticker-note { top: 80rem; left: -4.5rem; font-size: 2.4rem; --sticker-rotate: 8deg; }
    .sticker-tv { top: 98rem; right: -5rem; font-size: 2.2rem; --sticker-rotate: -10deg; }

    .bangumi-hero {
        margin: 0 0 2rem;
    }

    .bangumi-eyebrow {
        margin: 0 0 0.55rem;
        color: var(--primary);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.16em;
    }

    .bangumi-hero h1 {
        margin: 0;
        color: var(--deep-text, var(--text-90));
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1.05;
    }

    .bangumi-subtitle {
        max-width: 38rem;
        margin: 0.85rem 0 0;
        color: var(--text-50);
        font-size: 0.9rem;
        line-height: 1.75;
    }

    .bangumi-energy {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.85rem;
    }

    .bangumi-energy span {
        display: inline-flex;
        align-items: center;
        min-height: 1.65rem;
        padding: 0.35rem 0.65rem;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, transparent);
        border-radius: 999px;
        color: var(--primary);
        font-size: 0.66rem;
        font-weight: 900;
        background: color-mix(in srgb, var(--primary) 7%, var(--card-bg));
    }

    .bangumi-energy span:first-child::before {
        content: "⚡";
        margin-right: 0.25rem;
    }

    .bangumi-energy span:last-child::before {
        content: "●";
        margin-right: 0.3rem;
        font-size: 0.48rem;
        animation: bangumi-status-pulse 1.8s ease-in-out infinite;
    }

    .bangumi-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-bottom: 1.5rem;
    }

    .bangumi-insights {
        margin-bottom: 1.5rem;
        padding: 1rem;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, transparent);
        border-radius: 1.35rem;
        background: color-mix(in srgb, var(--card-bg) 82%, transparent);
        box-shadow: 0 14px 38px rgba(93, 69, 74, 0.08);
        backdrop-filter: blur(16px);
    }

    .bangumi-insights-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.8rem;
    }

    .bangumi-insights-heading div {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--primary);
    }

    .bangumi-insights-heading strong {
        color: var(--deep-text, var(--text-90));
        font-size: 0.85rem;
    }

    .bangumi-insights-heading small {
        color: var(--text-50);
        font-size: 0.64rem;
    }

    .bangumi-insights-content {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 1fr);
        gap: 1rem;
        align-items: stretch;
    }

    .bangumi-metrics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.55rem;
    }

    .bangumi-metric {
        min-width: 0;
        padding: 0.65rem 0.75rem;
        border-radius: 0.9rem;
        color: white;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 7px 18px rgba(79, 56, 67, 0.08);
    }

    .bangumi-metric strong,
    .bangumi-metric span {
        display: block;
    }

    .bangumi-metric strong {
        overflow: hidden;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.05;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-metric span {
        margin-top: 0.25rem;
        font-size: 0.67rem;
        font-weight: 800;
        opacity: 0.92;
    }

    .metric-collection { background: linear-gradient(135deg, #f28fa6, #ee9cae); }
    .metric-completed { background: linear-gradient(135deg, #77bd4d, #8acb58); }
    .metric-rate { background: linear-gradient(135deg, #69a9df, #80b9ea); }
    .metric-average { background: linear-gradient(135deg, #ee984e, #f1aa67); }
    .metric-deviation { background: linear-gradient(135deg, #8d65e2, #a177ee); }
    .metric-count { background: linear-gradient(135deg, #4f9ee3, #6db3ef); }

    .bangumi-rating-chart {
        min-width: 0;
        padding: 0.7rem 0.8rem 0.5rem;
        border-radius: 1rem;
        background: color-mix(in srgb, var(--primary) 5%, var(--card-bg));
    }

    .bangumi-rating-chart > strong {
        display: block;
        margin-bottom: 0.35rem;
        color: var(--text-50);
        font-size: 0.67rem;
        font-weight: 900;
    }

    .bangumi-rating-bars {
        display: grid;
        grid-template-columns: repeat(10, minmax(0, 1fr));
        gap: 0.25rem;
    }

    .bangumi-rating-column {
        display: grid;
        grid-template-rows: 0.9rem 5rem 0.9rem;
        align-items: end;
        min-width: 0;
        text-align: center;
    }

    .bangumi-rating-count,
    .bangumi-rating-label {
        color: var(--text-50);
        font-size: 0.55rem;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-rating-bar {
        width: min(1.1rem, 76%);
        height: var(--rating-height);
        min-height: 2px;
        margin: 0 auto;
        border-radius: 0.3rem 0.3rem 0.12rem 0.12rem;
        background: linear-gradient(to top, color-mix(in srgb, var(--primary) 76%, #a06de0), color-mix(in srgb, var(--primary) 58%, #ffb5cb));
        box-shadow: 0 4px 10px color-mix(in srgb, var(--primary) 16%, transparent);
    }

    .bangumi-tab {
        appearance: none;
        padding: 0.55rem 0.9rem;
        border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--card-bg) 88%, transparent);
        color: var(--text-50);
        font-size: 0.75rem;
        font-weight: 800;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(90, 65, 70, 0.05);
        transition: transform 180ms ease, color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
    }

    .bangumi-tab span {
        margin-left: 0.25rem;
        opacity: 0.72;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-tab:hover {
        color: var(--primary);
        transform: translateY(-1px);
    }

    .bangumi-tab-active {
        border-color: transparent;
        background: var(--primary);
        color: white;
        box-shadow: 0 10px 24px color-mix(in srgb, var(--primary) 28%, transparent);
    }

    .bangumi-tab-active:hover {
        color: white;
    }

    .bangumi-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.45rem 1.25rem;
        scroll-margin-top: 6rem;
    }

    .bangumi-item[hidden] {
        display: none !important;
    }

    .bangumi-item,
    .bangumi-item a {
        min-width: 0;
    }

    .bangumi-item a {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .bangumi-poster {
        position: relative;
        overflow: hidden;
        aspect-ratio: 3 / 4;
        border: 1px solid color-mix(in srgb, var(--primary) 13%, transparent);
        border-radius: 1.15rem;
        background: color-mix(in srgb, var(--card-bg) 88%, var(--primary) 12%);
        box-shadow: 0 14px 34px rgba(93, 69, 74, 0.11);
        transform: translateZ(0);
        transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease;
    }

    .bangumi-item a:hover .bangumi-poster {
        border-color: color-mix(in srgb, var(--primary) 42%, transparent);
        box-shadow: 0 22px 46px rgba(93, 69, 74, 0.18);
        transform: translateY(-0.3rem);
    }

    .bangumi-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 500ms ease;
    }

    .bangumi-item a:hover .bangumi-poster img {
        transform: scale(1.035);
    }

    .bangumi-image-fallback {
        display: none;
        place-items: center;
        width: 100%;
        height: 100%;
        color: var(--text-35);
