    .bangumi-eyebrow::before {
        content: "";
        width: 1.5rem;
        height: 1px;
        background: currentColor;
        opacity: 0.5;
        transform-origin: left;
        animation: bangumi-rule-draw 0.9s 0.08s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .bangumi-eyebrow-index {
        padding: 0.12rem 0.36rem;
        border: 1px solid color-mix(in srgb, var(--primary) 24%, transparent);
        border-radius: 0.32rem;
        font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
        font-size: 0.56rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        opacity: 0.75;
    }

    .bangumi-hero h1 {
        margin: 0;
        color: var(--deep-text, var(--text-strong));
        font-size: clamp(2.1rem, 5.4vw, 3.4rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.04;
    }

    .bangumi-hero-title {
        position: relative;
        display: inline-flex;
        padding-bottom: 0.08rem;
    }

    .bangumi-hero-title::after {
        content: "";
        position: absolute;
        left: -0.16rem;
        right: -0.22rem;
        bottom: -0.04rem;
        z-index: -1;
        height: 0.32rem;
        border-radius: 999px;
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 44%, transparent), color-mix(in srgb, #ffb0c8 28%, transparent) 64%, transparent);
        transform: scaleX(0);
        transform-origin: left;
        animation: bangumi-title-stroke 1s 0.64s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .bangumi-char {
        display: inline-block;
        transform-origin: 50% 100%;
        animation: bangumi-char-rise 0.84s cubic-bezier(0.22, 1, 0.36, 1) backwards;
        animation-delay: calc(0.06s + var(--char-index, 0) * 0.062s);
    }

    .bangumi-hero-spark {
        display: inline-block;
        margin-left: 0.45rem;
        color: var(--primary);
        font-size: 0.58em;
        vertical-align: 0.5em;
        animation:
            bangumi-spark-pop 0.9s 0.76s cubic-bezier(0.34, 1.56, 0.64, 1) backwards,
            bangumi-spark-twinkle 4.2s 2.4s ease-in-out infinite;
    }

    .bangumi-subtitle {
        max-width: 34rem;
        margin: 0.95rem 0 0;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.78;
        animation: bangumi-fade-up 0.7s 0.36s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .bangumi-ledger {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        margin-top: 1.2rem;
    }

    .bangumi-ledger-item {
        position: relative;
        padding-right: 1rem;
    }

    .bangumi-ledger-item + .bangumi-ledger-item {
        padding-left: 1rem;
    }

    .bangumi-ledger-item + .bangumi-ledger-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.3rem;
        bottom: 0.3rem;
        width: 1px;
        background: color-mix(in srgb, var(--primary) 22%, transparent);
        transform: scaleY(0);
        transform-origin: top;
        animation: bangumi-rule-grow 0.8s 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .bangumi-ledger-item strong {
        display: block;
        color: var(--deep-text, var(--text-strong));
        font-size: 1.4rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        animation: bangumi-stat-rise 0.72s cubic-bezier(0.22, 1, 0.36, 1) backwards;
        animation-delay: calc(0.44s + var(--ledger-index, 0) * 0.08s);
    }

    .bangumi-ledger-item span {
        display: block;
        margin-top: 0.34rem;
        color: var(--text-muted);
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        animation: bangumi-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
        animation-delay: calc(0.52s + var(--ledger-index, 0) * 0.08s);
    }

    /* 右上：三张封面扇形摊开 */
    .bangumi-hero-fan {
        position: relative;
        width: 13.2rem;
        height: 17.6rem;
        margin-right: 0.4rem;
        flex-shrink: 0;
    }

    .bangumi-fan-card {
        --fan-rotate: 0deg;
        --fan-x: -4.3rem;
        --fan-y: 0rem;
        position: absolute;
        top: 0.7rem;
        left: 50%;
        width: 8.4rem;
        margin: 0;
        aspect-ratio: 5 / 7;
        overflow: hidden;
        border-radius: 0.72rem;
        background: var(--card-bg);
        box-shadow:
            inset 0 0 0 1px rgba(255, 255, 255, 0.55),
            0 2px 8px rgba(93, 69, 74, 0.16),
            0 18px 34px -20px rgba(93, 69, 74, 0.8);
        transform: translateX(var(--fan-x)) translateY(var(--fan-y)) rotate(var(--fan-rotate));
        transform-origin: 50% 88%;
        transition: transform 0.62s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
        animation: bangumi-fan-deal 0.95s cubic-bezier(0.34, 1.36, 0.64, 1) backwards;
    }

    .bangumi-fan-card img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .bangumi-fan-rate {
        position: absolute;
        right: 0.4rem;
        bottom: 0.4rem;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.16rem;
        padding: 0.1rem 0.34rem 0.12rem;
        border-radius: 0.42rem;
        color: #ffd79a;
        background: color-mix(in srgb, #33232a 72%, transparent);
        box-shadow: inset 0 0 0 1px rgba(255, 215, 154, 0.22);
        font-size: 0.6rem;
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
        backdrop-filter: blur(6px);
    }

    .bangumi-fan-rate::before {
        content: '★';
        font-size: 0.5rem;
        opacity: 0.9;
    }

    .bangumi-fan-1 {
        --fan-rotate: -11deg;
        --fan-x: -5.4rem;
        --fan-y: 0.9rem;
        z-index: 1;
        animation-delay: 0.26s;
    }

    .bangumi-fan-2 {
        --fan-rotate: -2deg;
        --fan-x: -3.5rem;
        --fan-y: -0.2rem;
        z-index: 3;
        animation-delay: 0.38s;
    }

    .bangumi-fan-3 {
        --fan-rotate: 7deg;
        --fan-x: -1.6rem;
        --fan-y: 1.2rem;
        z-index: 2;
        animation-delay: 0.5s;
    }

    .bangumi-hero-fan:hover .bangumi-fan-1 {
        z-index: 4;
        transform: translateX(calc(var(--fan-x) - 0.6rem)) translateY(calc(var(--fan-y) - 0.4rem)) rotate(calc(var(--fan-rotate) - 4deg));
    }

    .bangumi-hero-fan:hover .bangumi-fan-2 {
        z-index: 5;
        transform: translateX(var(--fan-x)) translateY(calc(var(--fan-y) - 0.7rem)) rotate(var(--fan-rotate));
    }

    .bangumi-hero-fan:hover .bangumi-fan-3 {
        z-index: 4;
        transform: translateX(calc(var(--fan-x) + 0.6rem)) translateY(calc(var(--fan-y) - 0.3rem)) rotate(calc(var(--fan-rotate) + 4deg));
    }

    .bangumi-fan-tape {
        position: absolute;
        top: 0;
        left: 50%;
        z-index: 6;
        width: 4.4rem;
        height: 1.1rem;
        transform: translateX(-50%) rotate(-3.5deg);
        background: color-mix(in srgb, #ffe3a3 82%, transparent);
        box-shadow: 0 2px 6px rgba(158, 120, 66, 0.18);
        opacity: 0.9;
        animation: bangumi-fade-up 0.7s 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .bangumi-fan-caption {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        color: var(--text-muted);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        white-space: nowrap;
        animation: bangumi-fade-up 0.7s 1s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    /* 评分档案 */
    .bangumi-insights {
        position: relative;
        margin: 0 0 1.5rem;
        padding: 1.15rem 1.3rem 1.3rem;
        border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);
        border-radius: 1.1rem;
        background-color: color-mix(in srgb, var(--card-bg) 94%, transparent);
        background-image: radial-gradient(color-mix(in srgb, var(--primary) 9%, transparent) 1px, transparent 1px);
        background-size: 14px 14px;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.62),
            0 20px 44px -34px rgba(93, 69, 74, 0.75);
        clip-path: inset(0 0 100% 0);
        animation: bangumi-panel-unfold 1s 0.16s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .bangumi-insights-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.05rem;
    }

    .bangumi-insights-heading div {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--primary);
    }

    .bangumi-insights-heading strong {
        color: var(--deep-text, var(--text-strong));
        font-size: 0.92rem;
        font-weight: 900;
        letter-spacing: 0.02em;
    }

    .bangumi-insights-heading small {
        color: var(--text-muted);
        font-size: 0.64rem;
        letter-spacing: 0.08em;
    }

    .bangumi-insights-index {
        padding: 0.1rem 0.34rem;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
        border-radius: 0.3rem;
        color: var(--text-muted);
        font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
        font-size: 0.56rem;
        letter-spacing: 0.1em;
    }

    .bangumi-insights-body {
        display: grid;
        grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 2fr);
        gap: 1.4rem 1.8rem;
        align-items: end;
    }

    .bangumi-score-hero {
        display: flex;
        flex-direction: column;
        gap: 0.32rem;
        padding-bottom: 0.15rem;
    }

    .bangumi-score-hero-label {
        color: var(--text-muted);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.18em;
    }

    .bangumi-score-hero-value {
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
        color: var(--deep-text, var(--text-strong));
        font-size: clamp(2.3rem, 4vw, 3.1rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-score-hero-value > span:first-child {
        display: inline-block;
        animation: bangumi-stat-rise 0.8s 0.34s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .bangumi-score-hero-unit {
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    .bangumi-score-stars {
        --fill: 0%;
        width: fit-content;
        background-image: linear-gradient(90deg, #ffc861 var(--fill), color-mix(in srgb, #ffc861 20%, transparent) var(--fill));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-size: 0.86rem;
        letter-spacing: 0.14em;
        animation: bangumi-fade-up 0.7s 0.46s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .bangumi-score-hero-meta {
        display: flex;
        flex-direction: column;
        gap: 0.22rem;
        margin-top: 0.2rem;
        color: var(--text-muted);
        font-size: 0.64rem;
        line-height: 1.6;
        animation: bangumi-fade-up 0.7s 0.54s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .bangumi-score-hero-meta b {
        color: var(--primary);
        font-weight: 900;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-rating-chart {
        position: relative;
        min-width: 0;
    }

    .bangumi-rating-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.6rem;
        margin-bottom: 0.6rem;
    }

    .bangumi-rating-head strong {
        color: var(--deep-text, var(--text-strong));
        font-size: 0.76rem;
        font-weight: 900;
    }

    .bangumi-rating-head small {
        color: var(--text-muted);
        font-size: 0.62rem;
    }

    .bangumi-rating-head small b {
        color: var(--primary);
        font-weight: 900;
    }

    .bangumi-rating-bars {
        position: relative;
        display: grid;
        grid-template-columns: repeat(10, minmax(0, 1fr));
        gap: 0.44rem;
        align-items: end;
        height: 7.4rem;
        padding-bottom: 1.15rem;
        border-bottom: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    }

    .bangumi-rating-bars::before {
        content: "";
        position: absolute;
        inset: 0 0 1.15rem;
        pointer-events: none;
        background-image: linear-gradient(to top, color-mix(in srgb, var(--primary) 8%, transparent) 1px, transparent 1px);
        background-size: 100% 25%;
    }

    .bangumi-rating-column {
        position: relative;
        display: flex;
        align-items: flex-end;
        height: 100%;
    }

    .bangumi-rating-bar {
        width: 100%;
        height: var(--rating-height, 4%);
        min-height: 2px;
        border-radius: 0.3rem 0.3rem 0.08rem 0.08rem;
        background: linear-gradient(180deg, color-mix(in srgb, var(--primary) 58%, #ffffff) 0%, var(--primary) 100%);
        transform: scaleY(0);
        transform-origin: bottom;
        animation: bangumi-bar-grow 0.82s cubic-bezier(0.34, 1.28, 0.64, 1) forwards;
        animation-delay: calc(0.5s + var(--rating-index, 0) * 0.05s);
        transition: filter 0.3s ease;
    }

    .bangumi-rating-column:hover .bangumi-rating-bar {
        filter: saturate(1.15) brightness(1.06);
    }

    .bangumi-rating-count,
    .bangumi-rating-label {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        color: var(--text-muted);
        font-size: 0.6rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        pointer-events: none;
    }

    .bangumi-rating-count {
        bottom: calc(var(--rating-height, 4%) + 0.24rem);
        color: var(--text-body, var(--text-strong));
        font-weight: 800;
        opacity: 0;
        animation: bangumi-rating-num 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-delay: calc(0.66s + var(--rating-index, 0) * 0.05s);
    }

    .bangumi-rating-label {
        bottom: -1.1rem;
        font-weight: 700;
    }

    .bangumi-rating-column:hover .bangumi-rating-label {
        color: var(--primary);
    }

    @keyframes bangumi-hero-drift {
        from { transform: translate3d(0, 0, 0) scale(1); }
        to { transform: translate3d(2.4rem, -1.1rem, 0) scale(1.08); }
    }

    @keyframes bangumi-rule-draw {
        from { transform: scaleX(0); opacity: 0; }
        to { transform: scaleX(1); opacity: 0.5; }
    }

    @keyframes bangumi-rule-grow {
        from { transform: scaleY(0); }
        to { transform: scaleY(1); }
    }

    @keyframes bangumi-char-rise {
        from { opacity: 0; transform: translateY(0.85rem) rotate(-4deg) scale(0.94); }
        to { opacity: 1; transform: translateY(0) rotate(0deg) scale(1); }
    }

    @keyframes bangumi-title-stroke {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
    }

    @keyframes bangumi-spark-pop {
        from { opacity: 0; transform: scale(0.4) rotate(-40deg); }
        to { opacity: 1; transform: scale(1) rotate(0deg); }
    }

    @keyframes bangumi-spark-twinkle {
        0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }
        50% { opacity: 0.55; transform: scale(0.82) rotate(18deg); }
    }

    @keyframes bangumi-fade-up {
        from { opacity: 0; transform: translateY(0.5rem); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes bangumi-stat-rise {
        from { opacity: 0; transform: translateY(0.7rem) scale(0.96); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes bangumi-fan-deal {
        from { opacity: 0; transform: translateX(-3.6rem) translateY(1.4rem) rotate(0deg) scale(0.88); }
        to { opacity: 1; transform: translateX(var(--fan-x)) translateY(var(--fan-y)) rotate(var(--fan-rotate)) scale(1); }
    }

    @keyframes bangumi-panel-unfold {
        from { clip-path: inset(0 0 100% 0); }
        to { clip-path: inset(0 0 0 0); }
    }

    @keyframes bangumi-bar-grow {
        to { transform: scaleY(1); }
    }

    @keyframes bangumi-rating-num {
        to { opacity: 1; }
    }

    @keyframes bangumi-sticker-float {
        from { transform: translateY(-7px) rotate(calc(var(--sticker-rotate, 0deg) - 2.5deg)); }
        to { transform: translateY(7px) rotate(calc(var(--sticker-rotate, 0deg) + 2.5deg)); }
    }

    .bangumi-tab {
        --tab-accent: var(--primary);
        appearance: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.55rem 0.92rem;
        border: 1px solid color-mix(in srgb, var(--tab-accent) 18%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--card-bg) 88%, transparent);
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 800;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(90, 65, 70, 0.05);
        transition: transform 0.22s ease, color 0.22s ease, background-color 0.22s ease, border-color 0.22s ease, box-shadow 0.26s ease;
    }

    .bangumi-tab[data-accent='1'] { --tab-accent: #5e7ca8; }
    .bangumi-tab[data-accent='2'] { --tab-accent: #9d668d; }
    .bangumi-tab[data-accent='3'] { --tab-accent: #c44f75; }
    .bangumi-tab[data-accent='4'] { --tab-accent: #7b6aa5; }
    .bangumi-tab[data-accent='5'] { --tab-accent: #77727a; }

    .bangumi-tab-icon {
        font-size: 0.72rem;
        line-height: 1;
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bangumi-tab-count {
        opacity: 0.68;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-tab:hover {
        color: var(--tab-accent);
        border-color: color-mix(in srgb, var(--tab-accent) 36%, transparent);
        box-shadow: 0 10px 22px color-mix(in srgb, var(--tab-accent) 15%, transparent);
        transform: translateY(-2px);
    }

    .bangumi-tab:hover .bangumi-tab-icon {
        transform: scale(1.2) rotate(-8deg);
    }

    .bangumi-tab-active {
        border-color: color-mix(in srgb, var(--tab-accent) 48%, transparent);
        background-color: color-mix(in srgb, var(--tab-accent) 10%, var(--card-bg));
        background-image: linear-gradient(135deg, color-mix(in srgb, var(--tab-accent) 17%, transparent), color-mix(in srgb, var(--tab-accent) 5%, transparent));
        color: var(--tab-accent);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.55), 0 8px 20px color-mix(in srgb, var(--tab-accent) 18%, transparent);
    }

    .bangumi-tab-active .bangumi-tab-icon {
        animation: bangumi-tab-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ===== 番剧墙 ===== */
    .bangumi-wall {
        position: relative;
        isolation: isolate;
    }

    .bangumi-wall-glow {
        position: absolute;
        z-index: -1;
        inset: -2.5rem -2.5rem -1.5rem;
        pointer-events: none;
        background:
            radial-gradient(38% 26% at 2% 0%, color-mix(in srgb, var(--primary) 15%, transparent), transparent 72%),
            radial-gradient(34% 24% at 100% 10%, color-mix(in srgb, var(--mio-purple) 12%, transparent), transparent 74%),
            radial-gradient(52% 30% at 50% 104%, color-mix(in srgb, var(--primary) 9%, transparent), transparent 76%);
        animation: bangumi-wall-drift 26s ease-in-out infinite alternate;
    }

    .bangumi-wall-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin: 0 0 1.4rem;
        padding: 0.58rem 0.95rem;
        border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent);
        border-radius: 0.95rem;
        background-color: color-mix(in srgb, var(--card-bg) 80%, transparent);
        background-image: linear-gradient(100deg, color-mix(in srgb, var(--primary) 10%, transparent), transparent 44%, color-mix(in srgb, var(--mio-purple) 9%, transparent));
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.45),
            inset 0 -1px 0 color-mix(in srgb, var(--primary) 10%, transparent),
            0 10px 26px color-mix(in srgb, var(--primary) 7%, transparent);
        backdrop-filter: blur(14px);
    }

    .bangumi-wall-bar-title {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        color: var(--deep-text, var(--text-90));
        font-size: 0.86rem;
        font-weight: 900;
        letter-spacing: 0.03em;
    }

    .bangumi-wall-bar-title > span {
        color: var(--primary);
        animation: bangumi-wall-twinkle 2.8s ease-in-out infinite;
    }

    .bangumi-wall-bar-index {
        padding: 0.1rem 0.34rem;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
        border-radius: 0.3rem;
        color: var(--text-muted);
        font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
        font-size: 0.56rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        animation: none;
    }

    .bangumi-wall-bar-meta {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        color: var(--text-muted);
        font-size: 0.72rem;
    }

    .bangumi-wall-bar-hint {
        position: relative;
        padding-left: 0.85rem;
    }

    .bangumi-wall-bar-hint::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        width: 0.34rem;
        height: 0.34rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 70%, transparent);
        transform: translateY(-50%);
        animation: bangumi-status-pulse 2.2s ease-in-out infinite;
    }

    .bangumi-wall-bar-count {
        display: inline-flex;
        align-items: baseline;
        gap: 0.22rem;
        padding: 0.24rem 0.62rem 0.28rem;
        border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 8%, transparent);
        white-space: nowrap;
    }

    .bangumi-wall-bar-count strong {
        color: var(--primary);
        font-size: 0.98rem;
        font-weight: 900;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(13.1rem, 1fr));
        gap: 2.2rem 1.6rem;
        scroll-margin-top: 6rem;
    }

    .bangumi-item {
        min-width: 0;
    }

    .bangumi-item[hidden] {
        display: none !important;
    }

    .bangumi-wall.is-animated .bangumi-item {
        opacity: 0;
    }

    .bangumi-wall.is-animated .bangumi-item.is-revealed {
        opacity: 1;
        animation: bangumi-wall-in 0.78s cubic-bezier(0.22, 1, 0.36, 1) var(--card-delay, 0ms) backwards;
    }

    .bangumi-card {
        --lift: 0rem;
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        --turn: 0deg;
        position: relative;
        display: block;
        color: inherit;
        text-decoration: none;
        transform: perspective(1000px) translate3d(0, var(--lift), 0) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) rotate(calc(var(--card-lean, 0deg) + var(--turn)));
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bangumi-card-halo {
        position: absolute;
        z-index: -1;
        inset: -0.7rem -0.6rem -1.1rem;
        border-radius: 1.7rem;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(62% 54% at 50% 22%, color-mix(in srgb, var(--primary) 24%, transparent), transparent 72%);
        filter: blur(16px);
        transition: opacity 0.5s ease;
    }

    .bangumi-card-corners {
        position: absolute;
        z-index: 5;
        inset: -0.34rem;
        border-radius: 1.35rem;
        pointer-events: none;
        opacity: 0;
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 34%, transparent);
        transition: opacity 0.45s ease, inset 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bangumi-poster {
        --mat: color-mix(in srgb, #ffffff 88%, var(--primary) 12%);
        position: relative;
        overflow: hidden;
        aspect-ratio: 5 / 7;
        border-radius: 1.15rem;
        background: color-mix(in srgb, var(--card-bg) 86%, var(--primary) 14%);
        box-shadow:
            inset 0 0 0 1px color-mix(in srgb, var(--primary) 18%, transparent),
            0 0 0 0.3rem var(--mat),
            0 0 0 0.36rem color-mix(in srgb, var(--primary) 16%, transparent),
            0 2px 5px color-mix(in srgb, var(--primary) 10%, transparent),
            0 20px 38px rgba(93, 69, 74, 0.18);
        transform: translateZ(0);
        transition: box-shadow 0.45s ease;
    }

    .bangumi-poster-skeleton {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-color: color-mix(in srgb, var(--primary) 8%, var(--card-bg));
        background-image: radial-gradient(color-mix(in srgb, var(--primary) 20%, transparent) 1px, transparent 1.2px);
        background-size: 10px 10px;
        animation: bangumi-skeleton-breathe 2.4s ease-in-out infinite;
        transition: opacity 0.5s ease;
    }

    .bangumi-poster img {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.65s ease, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bangumi-poster.is-loaded img {
        opacity: 1;
    }

    .bangumi-poster.is-loaded .bangumi-poster-skeleton,
    .bangumi-poster.is-failed .bangumi-poster-skeleton {
        opacity: 0;
        animation: none;
    }

    .bangumi-image-fallback {
        position: absolute;
        inset: 0;
        display: none;
        place-items: center;
        color: var(--text-35);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        background: linear-gradient(145deg, color-mix(in srgb, var(--primary) 10%, var(--card-bg)), var(--card-bg));
    }

    .bangumi-image-fallback-visible,
    .bangumi-poster.is-failed .bangumi-image-fallback {
        display: grid;
    }

    .bangumi-poster-tint {
        position: absolute;
        z-index: 2;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(to top, rgba(38, 22, 30, 0.4), rgba(38, 22, 30, 0.08) 42%, transparent 68%);
    }

    .bangumi-poster-spot {
        position: absolute;
        z-index: 2;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(62% 42% at 50% 106%, color-mix(in srgb, var(--primary) 46%, transparent), transparent 72%);
        transition: opacity 0.45s ease;
    }

    .bangumi-status {
        position: absolute;
        z-index: 4;
        top: 0.62rem;
        left: 0.62rem;
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        padding: 0.3rem 0.58rem 0.32rem;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 999px;
        color: #bd5273;
        font-size: 0.65rem;
        font-weight: 900;
        line-height: 1;
        background: rgba(255, 251, 250, 0.92);
        box-shadow: 0 6px 16px rgba(50, 30, 36, 0.16);
        backdrop-filter: blur(10px);
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bangumi-status-icon {
        font-size: 0.6rem;
        line-height: 1;
        animation: bangumi-status-pulse 2.6s ease-in-out infinite;
    }

    .bangumi-status-3 { color: #c44f75; }
    .bangumi-status-2 { color: #9d668d; }
    .bangumi-status-1 { color: #5e7ca8; }
    .bangumi-status-4 { color: #7b6aa5; }
    .bangumi-status-5 { color: #77727a; }

    .bangumi-score-chip {
        position: absolute;
        z-index: 4;
        top: 0.62rem;
        right: 0.62rem;
        display: inline-flex;
        align-items: center;
        gap: 0.22rem;
        padding: 0.28rem 0.5rem 0.3rem;
        border-radius: 0.7rem;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 900;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        background: rgba(34, 22, 28, 0.52);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(8px);
    }

    .bangumi-score-chip svg {
        width: 0.72rem;
        height: 0.72rem;
        fill: #ffc861;
    }

    /* 悬停时推上来的索引卡 */
    .bangumi-slip {
        position: absolute;
        z-index: 3;
        left: 0.55rem;
        right: 0.55rem;
        bottom: 0.55rem;
        display: grid;
        gap: 0.4rem;
        padding: 0.72rem 0.75rem 0.58rem;
        border-radius: 0.5rem;
        color: #4a3238;
        background: linear-gradient(168deg, #fffaf3 0%, #fdf0e5 100%);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.85),
            0 10px 24px -12px rgba(40, 22, 30, 0.72);
        opacity: 0;
        transform: translateY(1.15rem) rotate(-2.6deg);
        transform-origin: 20% 100%;
        transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    .bangumi-slip-tape {
        position: absolute;
        top: -0.34rem;
        left: 50%;
        width: 2.6rem;
        height: 0.6rem;
        transform: translateX(-50%) rotate(-2deg);
        background: color-mix(in srgb, var(--primary) 22%, rgba(255, 255, 255, 0.72));
        opacity: 0.85;
    }

    .bangumi-slip-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.4rem;
    }

    .bangumi-slip-ep {
        color: #6b5157;
        font-size: 0.66rem;
        font-weight: 800;
    }

    .bangumi-slip-rate {
        display: inline-flex;
        align-items: baseline;
        gap: 0.22rem;
        color: #7d6068;
        font-size: 0.62rem;
        white-space: nowrap;
    }

    .bangumi-slip-rate strong {
        color: #e0658c;
        font-size: 0.95rem;
        font-weight: 900;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-slip-stars {
        --fill: 0%;
        background-image: linear-gradient(90deg, #ffb43d var(--fill), color-mix(in srgb, #ffb43d 24%, transparent) var(--fill));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-size: 0.6rem;
        letter-spacing: 0.1em;
    }

    .bangumi-slip-rate-empty {
        color: #a08b90;
        font-size: 0.62rem;
        font-weight: 700;
    }

    .bangumi-progress {
        display: block;
        height: 0.24rem;
        border-radius: 999px;
        overflow: hidden;
        background: color-mix(in srgb, var(--primary) 16%, transparent);
    }

    .bangumi-progress i {
        display: block;
        width: var(--progress, 0%);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 72%, #ffffff), var(--primary));
        transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s;
    }

    .bangumi-slip-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.4rem;
    }

    .bangumi-slip-status {
        padding: 0.12rem 0.34rem;
        border: 1px solid currentColor;
        border-radius: 0.3rem;
        font-size: 0.58rem;
        font-weight: 900;
        letter-spacing: 0.06em;
        opacity: 0.9;
    }

    .bangumi-slip-status-1 { color: #4a6285; }
    .bangumi-slip-status-2 { color: #8a5a7c; }
    .bangumi-slip-status-3 { color: #bb4869; }
    .bangumi-slip-status-4 { color: #6b5c96; }
    .bangumi-slip-status-5 { color: #6a656d; }

    .bangumi-slip-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        color: #8d7280;
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.04em;
    }

    .bangumi-card-info {
        padding: 0.85rem 0.15rem 0;
    }

    .bangumi-card-info h2 {
        overflow: hidden;
        margin: 0 0 0.45rem;
        color: var(--deep-text, var(--text-90));
        font-size: 0.95rem;
        font-weight: 900;
        line-height: 1.5;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.3s ease;
    }

    .bangumi-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.32rem;
        min-height: 1.32rem;
        margin: 0 0 0.5rem;
    }

    .bangumi-tags span {
        overflow: hidden;
        padding: 0.22rem 0.45rem;
        border-radius: 999px;
        color: color-mix(in srgb, var(--primary) 82%, var(--deep-text, var(--text-75)));
        font-size: 0.62rem;
        font-weight: 800;
        line-height: 1;
        text-overflow: ellipsis;
        white-space: nowrap;
        background: color-mix(in srgb, var(--primary) 9%, transparent);
        transition: background-color 0.35s ease, color 0.35s ease;
    }

    .bangumi-card-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.72rem;
    }

    .bangumi-card-index {
        color: color-mix(in srgb, var(--primary) 58%, transparent);
        font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.06em;
    }

    .bangumi-ep {
        margin-right: auto;
        color: var(--text-muted);
        font-variant-numeric: tabular-nums;
    }

    .bangumi-enter {
        display: inline-flex;
        align-items: center;
        gap: 0.22rem;
        color: color-mix(in srgb, var(--primary) 76%, transparent);
        font-weight: 900;
        opacity: 0;
        transform: translateX(-0.28rem);
        transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bangumi-enter-icon {
        display: inline-block;
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* 悬停 / 聚焦状态 */
    .bangumi-item:hover .bangumi-card,
    .bangumi-item:focus-within .bangumi-card {
        --lift: -0.5rem;
        --turn: -0.6deg;
    }

    .bangumi-item:hover .bangumi-card-halo,
    .bangumi-item:focus-within .bangumi-card-halo {
        opacity: 1;
    }

    .bangumi-item:hover .bangumi-card-corners,
    .bangumi-item:focus-within .bangumi-card-corners {
        inset: -0.55rem;
        opacity: 1;
    }

    .bangumi-item:hover .bangumi-poster,
    .bangumi-item:focus-within .bangumi-poster {
        box-shadow:
            inset 0 0 0 1px color-mix(in srgb, var(--primary) 30%, transparent),
            0 0 0 0.3rem var(--mat),
            0 0 0 0.42rem color-mix(in srgb, var(--primary) 26%, transparent),
            0 4px 10px color-mix(in srgb, var(--primary) 12%, transparent),
            0 28px 54px rgba(93, 69, 74, 0.22);
    }

    .bangumi-item:hover .bangumi-poster img,
    .bangumi-item:focus-within .bangumi-poster img {
        transform: scale(1.07);
    }

    .bangumi-item:hover .bangumi-poster-spot,
    .bangumi-item:focus-within .bangumi-poster-spot {
        opacity: 1;
    }

    .bangumi-item:hover .bangumi-slip,
    .bangumi-item:focus-within .bangumi-slip,
    .bangumi-card:active .bangumi-slip {
        opacity: 1;
        transform: translateY(0) rotate(-1.4deg);
    }

    .bangumi-item:hover .bangumi-card-info h2,
    .bangumi-item:focus-within .bangumi-card-info h2 {
        color: var(--primary);
    }

    .bangumi-item:hover .bangumi-tags span,
    .bangumi-item:focus-within .bangumi-tags span {
        color: color-mix(in srgb, var(--primary) 92%, var(--deep-text, var(--text-75)));
        background: color-mix(in srgb, var(--primary) 15%, transparent);
    }

    .bangumi-item:hover .bangumi-enter,
    .bangumi-item:focus-within .bangumi-enter {
        opacity: 1;
        transform: translateX(0);
    }

    .bangumi-item:hover .bangumi-enter-icon {
        transform: translate(0.14rem, -0.14rem);
    }

    @keyframes bangumi-wall-in {
        from { opacity: 0; transform: translateY(1rem); clip-path: inset(0 0 58% 0 round 1.15rem); }
        to { opacity: 1; transform: translateY(0); clip-path: inset(0 0 0 0 round 1.15rem); }
    }

    @keyframes bangumi-wall-drift {
        from { transform: translate3d(0, 0, 0) scale(1); }
        to { transform: translate3d(0, -1.7rem, 0) scale(1.07); }
    }

    @keyframes bangumi-wall-twinkle {
        0%, 100% { opacity: 0.42; transform: scale(0.86) rotate(0deg); }
        50% { opacity: 1; transform: scale(1.1) rotate(18deg); }
    }

    @keyframes bangumi-skeleton-breathe {
        0%, 100% { opacity: 0.68; }
        50% { opacity: 1; }
    }

    @keyframes bangumi-tab-pop {
        0% { transform: scale(0.68) rotate(-14deg); }
        62% { transform: scale(1.24) rotate(7deg); }
        100% { transform: none; }
    }

    .bangumi-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        margin-top: 2.5rem;
        color: var(--text-muted);
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    .bangumi-page-deco {
        color: var(--primary);
        font-size: 0.85rem;
        opacity: 0.7;
    }

    .bangumi-page-ticket {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 6.8rem;
        min-height: 3.15rem;
        padding: 0.45rem 1rem 0.4rem;
        border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
        border-radius: 1rem;
        background:
            radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 34%),
            color-mix(in srgb, var(--card-bg) 92%, transparent);
        box-shadow: 0 10px 26px rgba(93, 69, 74, 0.09);
        backdrop-filter: blur(12px);
    }

    .bangumi-page-ticket::before,
    .bangumi-page-ticket::after {
        content: "";
        position: absolute;
        top: -0.38rem;
        width: 0.72rem;
        height: 0.72rem;
        border-top: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
        background: color-mix(in srgb, var(--card-bg) 92%, var(--primary) 8%);
        transform: rotate(45deg);
    }

    .bangumi-page-ticket::before {
        left: 1rem;
        border-left: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
        border-radius: 0.12rem 0 0 0;
    }

    .bangumi-page-ticket::after {
        right: 1rem;
        border-right: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
        border-radius: 0 0.12rem 0 0;
    }

    .bangumi-page-ticket small {
        position: relative;
        z-index: 1;
        color: var(--primary);
        font-size: 0.5rem;
        font-weight: 900;
        letter-spacing: 0.13em;
        line-height: 1;
    }

    .bangumi-page-ticket strong {
        position: relative;
        z-index: 1;
        margin-top: 0.3rem;
        color: var(--deep-text, var(--text-75));
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.08em;
    }

    .bangumi-pagination[hidden] {
        display: none;
    }

    .bangumi-pagination button {
        display: grid;
        place-items: center;
        width: 2.65rem;
        height: 2.65rem;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
        border-radius: 50%;
        background: color-mix(in srgb, var(--card-bg) 92%, transparent);
        color: var(--primary);
        font-size: 1.05rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(93, 69, 74, 0.08);
        transition: transform 180ms ease, color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
    }

    .bangumi-pagination button:hover:not(:disabled) {
        color: white;
        background: var(--primary);
        box-shadow: 0 10px 24px color-mix(in srgb, var(--primary) 26%, transparent);
        transform: translateY(-2px) rotate(-4deg);
    }

    .bangumi-pagination button:last-of-type:hover:not(:disabled) {
        transform: translateY(-2px) rotate(4deg);
    }

    .bangumi-pagination button:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .bangumi-sync-notice {
        margin: 0 0 1.5rem;
        padding: 0.85rem 1.1rem;
        border-radius: 0.75rem;
        background: color-mix(in srgb, var(--primary) 8%, transparent);
        color: var(--text-body);
        font-size: 0.875rem;
        line-height: 1.7;
    }

    .bangumi-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        min-height: 18rem;
        padding: 2rem;
        border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
        border-radius: 1.5rem;
        color: var(--text-muted);
        background: color-mix(in srgb, var(--card-bg) 72%, transparent);
        box-shadow: 0 16px 45px rgba(93, 69, 74, 0.07);
    }

    .bangumi-state strong {
        color: var(--deep-text, var(--text-75));
        font-size: 0.95rem;
    }

    .bangumi-state span:last-child {
        font-size: 0.72rem;
    }

    .bangumi-state-icon {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 10%, transparent);
        font-weight: 900;
    }

    @keyframes bangumi-status-pulse {
        0%, 100% { opacity: 0.35; transform: scale(0.85); }
        50% { opacity: 1; transform: scale(1.15); }
    }

    @media (max-width: 1500px) {
        .bangumi-sticker-field span {
            opacity: 0.12;
        }
    }

    @media (max-width: 1080px) {
        .bangumi-hero-fan {
            display: none;
        }

        .bangumi-insights-body {
            grid-template-columns: 1fr;
            gap: 1.1rem;
        }
    }

    @media (max-width: 640px) {
        .bangumi-page {
            padding: 1.35rem 0.8rem 2.5rem;
        }

        .bangumi-hero {
            display: block;
            margin-bottom: 1.5rem;
        }

        .bangumi-insights {
            padding: 0.8rem;
            margin-bottom: 1rem;
        }

        .bangumi-insights-heading small {
            display: none;
        }

        .bangumi-score-hero-value {
            font-size: 2.3rem;
        }

