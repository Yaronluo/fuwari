<script>
    const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target)) return;

        const decimals = Number(el.dataset.decimals || 0);
        const suffix = el.dataset.suffix || "";
        const duration = 1000;
        const startAt = performance.now() + 120;

        const tick = (now: number) => {
            const progress = Math.min(1, Math.max(0, (now - startAt) / duration));
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = (target * eased).toFixed(decimals) + suffix;
            if (progress < 1) requestAnimationFrame(tick);
            else el.textContent = target.toFixed(decimals) + suffix;
        };

        el.textContent = (0).toFixed(decimals) + suffix;
        requestAnimationFrame(tick);
    };

    const startMetricCount = () => {
        const metrics = document.querySelectorAll<HTMLElement>("[data-count]");
        if (!metrics.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        metrics.forEach((el, index) => {
            window.setTimeout(() => countUp(el), 340 + index * 70);
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startMetricCount);
    } else {
        startMetricCount();
    }
</script>

