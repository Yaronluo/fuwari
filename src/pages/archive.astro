---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getArchivePostList } from "../utils/content-utils";

const archivePosts = await getArchivePostList();
const archiveGeneratedAt = new Date().toISOString();
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <ArchivePanel sortedPosts={archivePosts} initialNow={archiveGeneratedAt} client:load></ArchivePanel>
</MainGridLayout>

