---
import CollectionCabinet from "../components/CollectionCabinet.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="小小收藏馆" description="把喜欢的作品与旋律认真收藏起来">
	<div class="collection-page-shell">
		<CollectionCabinet />
	</div>
</MainGridLayout>

<style>
	.collection-page-shell {
		width: 100%;
		padding: 1.25rem 1rem 2rem;
	}

	@media (max-width: 640px) {
		.collection-page-shell { padding: 0.75rem 0.5rem 1.5rem; }
	}
</style>
