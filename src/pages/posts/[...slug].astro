---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import ArticleDescription from "../../components/ArticleDescription.astro";
import Series from "@components/widget/Series.astro";
import AnimeArticleHero from "@components/anime/AnimeArticleHero.astro";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const { remarkPluginFrontmatter } = await entry.render();
const anime = entry.data.anime;
const postBasePath = path.join("content/posts/", getDir(entry.id));
const animeThemeClass = anime ? `anime-theme anime-theme--${anime.theme}` : "";

const minHeadingDepth = headings.length ? Math.min(...headings.map((heading) => heading.depth)) : 0;
const mobileTocHeadings = headings.filter((heading) => heading.depth < minHeadingDepth + siteConfig.toc.depth);
const removeTailingHash = (text: string) => {
	const lastIndexOfHash = text.lastIndexOf("#");
	return lastIndexOfHash === text.length - 1 ? text.substring(0, lastIndexOfHash) : text;
};

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} series={entry.data.series} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class:list={["post-article-shell flex w-full card-base overflow-hidden relative mb-4", animeThemeClass]} data-anime-mood={anime ? (anime.theme === "k-on" ? "intro" : "rain") : undefined}>
        {anime && (
            <div class="anime-weather-layer" aria-hidden="true">
                <div class="anime-weather-clouds"></div>
                <div class="anime-weather-rain"></div>
            </div>
        )}
        <div id="post-container" class:list={["z-10 px-6 md:px-9 pt-6 pb-4 relative w-full max-w-4xl mx-auto",
            {}
        ]}>
            {anime ? (
                <AnimeArticleHero
                    anime={anime}
                    title={entry.data.title}
                    description={entry.data.description}
                    published={entry.data.published}
                    words={remarkPluginFrontmatter.words}
                    minutes={remarkPluginFrontmatter.minutes}
                    basePath={postBasePath}
                />
            ) : (
            <>
            <header class="post-journal-header">
            <span class="post-header-tape" aria-hidden="true"></span>
            <div class="post-header-eyebrow onload-animation"><span>✦</span> MY BLOG NOTE <b>(˶ᵔ ᵕ ᵔ˶)</b></div>
            <!-- word count and reading time -->
            <div class="post-reading-stats flex flex-row text-black/30 dark:text-white/30 gap-3 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <h1
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="post-title transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
                </h1>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>
            <span class="post-header-heart" aria-hidden="true">♡</span>
            <div class="post-header-stamp" aria-hidden="true">
                <span class="post-header-stamp__top">{profileConfig.name.toUpperCase()}</span>
                <span class="post-header-stamp__glyph">✿</span>
                <span class="post-header-stamp__year">{entry.data.published.getFullYear()}</span>
                <span class="post-header-stamp__bottom">BLOG<br/>NOTE</span>
            </div>
            </header>

            <ArticleDescription description={entry.data.description} />

            {!anime && mobileTocHeadings.length > 1 && (
                <details class="post-toc-mobile">
                    <summary>
                        <span class="post-toc-mobile__label">目录 <em>CONTENTS</em></span>
                        <span class="post-toc-mobile__count">{mobileTocHeadings.length} 节</span>
                        <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.1rem]" />
                    </summary>
                    <ol>
                        {mobileTocHeadings.map((heading) => (
                            <li style={`--toc-indent: ${(heading.depth - minHeadingDepth) * 0.85}rem`}>
                                <a href={`#${heading.slug}`}>{removeTailingHash(heading.text)}</a>
                            </li>
                        ))}
                    </ol>
                </details>
            )}


            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={postBasePath} class="mb-8 rounded-xl banner-container onload-animation"/>
            }
            </>
            )}

            {entry.data.series && (
                <div class="mb-8 onload-animation">
                    <Series series={entry.data.series} isCard={false} class="!px-0 !pb-0"></Series>
                </div>
            )}

            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>

</MainGridLayout>

<style>
    .post-article-shell:not(.anime-theme) {
        border: 1px solid color-mix(in srgb, var(--primary) 14%, var(--glass-border));
        border-radius: 1.8rem;
        background:
            linear-gradient(90deg, rgb(255 255 255 / 0.18), transparent 12% 88%, rgb(255 255 255 / 0.12)),
            linear-gradient(145deg, rgb(255 255 255 / 0.42), transparent 45%),
            color-mix(in srgb, var(--glass-card) 95%, var(--primary) 1.5%);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.72), 0 1.4rem 3.5rem rgb(104 67 58 / 0.08);
        backdrop-filter: blur(18px) saturate(116%);
    }

    .post-article-shell:not(.anime-theme)::before,
    .post-article-shell:not(.anime-theme)::after {
        position: absolute;
        z-index: 1;
        color: color-mix(in srgb, var(--primary) 30%, transparent);
        pointer-events: none;
    }

    .post-article-shell:not(.anime-theme)::before {
        top: 8rem;
        left: 1rem;
        content: "✦";
        font-size: 0.8rem;
        transform: rotate(-10deg);
    }

    .post-article-shell:not(.anime-theme)::after {
        right: 1.2rem;
        bottom: 1rem;
        content: "⌁ happy reading ♡";
        font-size: 0.58rem;
        transform: rotate(-2deg);
    }

    .post-journal-header {
        position: relative;
        margin: -0.2rem -0.65rem 1.4rem;
        padding: 1.45rem 1.55rem 1.1rem;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
        border-radius: 1.35rem;
        background:
            radial-gradient(circle at 92% 15%, color-mix(in srgb, var(--primary) 13%, transparent), transparent 30%),
            linear-gradient(145deg, color-mix(in srgb, var(--glass-card) 72%, rgb(255 255 255 / 0.2)), color-mix(in srgb, var(--primary) 3%, transparent));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.62);
    }

    .post-header-tape {
        position: absolute;
        top: 0;
        left: 3rem;
        width: 4.5rem;
        height: 0.5rem;
        border-radius: 0 0 0.3rem 0.3rem;
        background: repeating-linear-gradient(120deg, rgb(255 255 255 / 0.24) 0 0.4rem, transparent 0.4rem 0.72rem), color-mix(in srgb, var(--primary) 38%, transparent);
        transform: rotate(-1.5deg);
    }

    .post-header-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.38rem;
        margin-bottom: 0.7rem;
        color: var(--primary);
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.12em;
    }

    .post-header-eyebrow b { margin-left: 0.2rem; font-weight: 750; letter-spacing: 0; }

    .post-reading-stats > div {
        padding: 0.3rem 0.55rem;
        border: 1px solid color-mix(in srgb, var(--primary) 10%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--glass-card) 68%, transparent);
    }

    .post-reading-stats > div > div:first-child {
        width: 1.25rem;
        height: 1.25rem;
        margin-right: 0.35rem;
        background: color-mix(in srgb, var(--primary) 9%, transparent);
        color: color-mix(in srgb, var(--primary) 66%, var(--text-color));
    }

    .post-reading-stats > div > div:last-child { font-size: 0.68rem; }

    .post-title {
        padding-right: 2.6rem;
        color: color-mix(in srgb, var(--text-color) 88%, #65463e) !important;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .post-title::before { height: 1.8rem !important; top: 0.5rem !important; box-shadow: 0 0 0 0.28rem color-mix(in srgb, var(--primary) 8%, transparent); }

    .post-header-heart {
        position: absolute;
        right: 1.2rem;
        bottom: 0.8rem;
        color: color-mix(in srgb, var(--primary) 36%, transparent);
        font-size: 1.45rem;
        transform: rotate(-9deg);
    }

    .post-header-stamp {
        position: absolute;
        top: 1.05rem;
        right: 1.3rem;
        width: 4.7rem;
        padding: 0.42rem 0.28rem 0.36rem;
        border: 1px solid color-mix(in srgb, var(--primary) 34%, transparent);
        background: color-mix(in srgb, var(--glass-card) 90%, white 10%);
        box-shadow: 0.16rem 0.2rem 0 color-mix(in srgb, var(--primary) 10%, transparent);
        color: var(--primary);
        text-align: center;
        transform: rotate(4deg);
    }

    .post-header-stamp::before {
        position: absolute;
        inset: 0.2rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 26%, transparent);
        content: "";
        pointer-events: none;
    }

    .post-header-stamp__top {
        display: block;
        font-size: 0.42rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        line-height: 1.5;
        white-space: nowrap;
    }

    .post-header-stamp__glyph {
        display: block;
        margin: 0.06rem 0;
        font-size: 0.8rem;
        line-height: 1;
    }

    .post-header-stamp__year {
        display: block;
        font-family: "Palatino Linotype", "Songti SC", ui-serif, Georgia, serif;
        font-size: 1.02rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        line-height: 1.15;
    }

    .post-header-stamp__bottom {
        display: block;
        margin-top: 0.1rem;
        font-size: 0.3rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        line-height: 1.55;
    }

    :global(.post-article-shell:not(.anime-theme) .article-description) {
        margin: 0.2rem 0 2rem;
        padding: 1rem 1.15rem 1rem 3.2rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 18%, transparent);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--primary) 4%, var(--glass-card));
    }

    :global(.post-article-shell:not(.anime-theme) .article-description)::before {
        position: absolute;
		top: 50%;
        left: 1rem;
        display: grid;
        place-items: center;
        width: 1.55rem;
        height: 1.55rem;
        border-radius: 0.55rem;
        background: color-mix(in srgb, var(--primary) 10%, rgb(255 255 255 / 0.35));
        color: var(--primary);
		content: "✎";
		font-size: 0.72rem;
		transform: translateY(-50%);
    }

    .post-toc-mobile {
        margin: -0.3rem 0 1.5rem;
        padding: 0 0.95rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 20%, transparent);
        border-radius: 0.95rem;
        background: color-mix(in srgb, var(--primary) 4%, var(--glass-card));
    }

    .post-toc-mobile summary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.72rem 0;
        cursor: pointer;
        list-style: none;
    }

    .post-toc-mobile summary::-webkit-details-marker { display: none; }

    .post-toc-mobile__label {
        color: var(--primary);
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.14em;
    }

    .post-toc-mobile__label em {
        margin-left: 0.35rem;
        color: color-mix(in srgb, var(--text-color) 42%, transparent);
        font-size: 0.54rem;
        font-style: normal;
        letter-spacing: 0.12em;
    }

    .post-toc-mobile__count {
        margin-left: auto;
        color: color-mix(in srgb, var(--text-color) 45%, transparent);
        font-size: 0.62rem;
        font-variant-numeric: tabular-nums;
    }

    .post-toc-mobile summary :global(svg) {
        color: color-mix(in srgb, var(--primary) 62%, transparent);
    }

    .post-toc-mobile[open] summary :global(svg) { transform: rotate(180deg); }

    .post-toc-mobile ol {
        margin: 0 0 0.8rem;
        padding: 0.3rem 0 0;
        border-top: 1px dashed color-mix(in srgb, var(--primary) 16%, transparent);
        list-style: none;
    }

    .post-toc-mobile li a {
        display: block;
        padding: 0.4rem 0 0.4rem calc(0.2rem + var(--toc-indent, 0rem));
        color: color-mix(in srgb, var(--text-color) 74%, transparent);
        font-size: 0.8rem;
        line-height: 1.65;
        text-decoration: none;
    }

    .post-toc-mobile li + li a {
        border-top: 1px dashed color-mix(in srgb, var(--primary) 9%, transparent);
    }

    .post-toc-mobile li a:hover { color: var(--primary); }

    @media (min-width: 1536px) {
        .post-toc-mobile { display: none; }
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content) {
        color: color-mix(in srgb, var(--text-color) 72%, transparent);
        font-size: 0.98rem;
        line-height: 1.9;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content > section) {
        position: relative;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content h1) {
        position: relative;
        margin: 2.7rem 0 1.2rem;
        padding: 0 0 0.7rem 1.8rem;
        border-bottom: 1px dashed color-mix(in srgb, var(--primary) 18%, transparent);
        color: color-mix(in srgb, var(--text-color) 88%, #67483f);
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: -0.025em;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content h1)::before {
        position: absolute;
        top: 0.08em;
        left: 0;
        color: var(--primary);
        content: "✿";
        font-size: 1rem;
        transform: rotate(-8deg);
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content h2) {
        position: relative;
        margin: 2.8rem 0 1.15rem;
        padding: 0.62rem 1rem 0.62rem 2.8rem;
        border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
        border-radius: 0.95rem;
        background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 9%, var(--glass-card)), transparent);
        color: color-mix(in srgb, var(--text-color) 86%, #67483f);
        font-size: 1.45rem;
        font-weight: 900;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content h2)::before {
        position: absolute;
        top: 50%;
        left: 0.85rem;
        color: var(--primary);
        content: "✦";
        font-size: 0.9rem;
        transform: translateY(-50%) rotate(8deg);
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content h3) {
        position: relative;
        margin-top: 2rem;
        padding-left: 1rem;
        color: color-mix(in srgb, var(--text-color) 82%, #67483f);
        font-size: 1.15rem;
        font-weight: 850;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content h3)::before {
        position: absolute;
        top: 0.25em;
        left: 0;
        width: 0.28rem;
        height: 1em;
        border-radius: 999px;
        background: var(--primary);
        content: "";
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content blockquote:not(.admonition)) {
        position: relative;
        margin: 1.4rem 0;
        padding: 1rem 1.2rem 1rem 2.8rem;
        border: 1px dashed color-mix(in srgb, var(--primary) 20%, transparent);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--primary) 6%, var(--glass-card));
        color: color-mix(in srgb, var(--text-color) 62%, transparent);
        font-style: normal;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content blockquote:not(.admonition))::before {
        position: absolute;
        top: 0.8rem;
        left: 0.95rem;
        color: var(--primary);
        content: "♡";
        font-size: 1.15rem;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content a) {
        color: var(--primary);
        text-decoration-color: color-mix(in srgb, var(--primary) 34%, transparent);
        text-decoration-thickness: 0.12rem;
        text-underline-offset: 0.2rem;
    }

    :global(.post-article-shell:not(.anime-theme) .markdown-content img) {
        padding: 0.32rem;
        border: 1px solid color-mix(in srgb, var(--primary) 14%, transparent);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--glass-card) 75%, white 8%);
        box-shadow: 0 0.9rem 2rem rgb(83 55 49 / 0.1);
    }

    :global(.dark .post-article-shell:not(.anime-theme)) {
        border-color: color-mix(in srgb, var(--primary) 18%, rgb(255 255 255 / 0.07));
		background:
			linear-gradient(145deg, rgb(255 255 255 / 0.045), transparent 45%),
			color-mix(in srgb, var(--primary) 5%, rgb(42 34 36 / 0.9));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05), 0 1.4rem 3.5rem rgb(0 0 0 / 0.2);
    }

	:global(.dark .post-journal-header) {
		border-color: color-mix(in srgb, var(--primary) 20%, rgb(255 255 255 / 0.07));
		background:
			radial-gradient(circle at 92% 15%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 30%),
			linear-gradient(145deg, color-mix(in srgb, var(--primary) 8%, rgb(58 45 48 / 0.94)), rgb(43 34 37 / 0.94));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.065);
	}

	:global(.dark .post-header-stamp) {
		border-color: color-mix(in srgb, var(--primary) 42%, transparent);
		background: color-mix(in srgb, var(--primary) 8%, rgb(46 37 40 / 0.94));
		box-shadow: 0.16rem 0.2rem 0 rgb(0 0 0 / 0.28);
	}

	:global(.dark .post-toc-mobile) {
		border-color: color-mix(in srgb, var(--primary) 24%, rgb(255 255 255 / 0.06));
		background: color-mix(in srgb, var(--primary) 6%, rgb(46 37 40 / 0.82));
	}

    :global(.dark .post-article-shell:not(.anime-theme) .markdown-content h2),
    :global(.dark .post-article-shell:not(.anime-theme) .article-description),
    :global(.dark .post-article-shell:not(.anime-theme) .markdown-content blockquote:not(.admonition)) {
		border-color: color-mix(in srgb, var(--primary) 18%, rgb(255 255 255 / 0.07));
		background: color-mix(in srgb, var(--primary) 6%, rgb(49 39 42 / 0.86));
    }

